$" odbcsqlsupport.dgluinc" INCLUDEFILE$

$" skin.dgluinc" INCLUDEFILE$

LOADFORMVALUES

: showserverstat$ ( servervariablename$ -$- )
    ( load file data to result set ) 
    DEPTH$ 1 U< IF STRINGSTACKUNDERFLOWERROR PUSHOERROR0$ NAME>E EXIT THEN
     
    ." <tr><td>" DUP$ .$ ." </td><td>" 
    $" SELECT " SWAP$ $>$ con$ db$ GETRESULTSET

    ?ERRORIF
      ." Error getting stat from database." CRLF
      0 GETOERROR0$ O>P TYPE0$ ." </td></tr>" CRLF
      EMPTY-ERRORS
      EXIT
    THEN

    LATESTRESULTSET GETNUMBEROFROWSFROMRESULTSET 0= IF
      ." server variable not found</td></tr>" CRLF
    ELSE
      ( 1 1 LATESTRESULTSET GETDATA$FROMRESULTSET .$ ." </td></tr>" CRLF )
      1 1 LATESTRESULTSET GETDATA$FROMRESULTSET
      1 1 LATESTRESULTSET GETTRUECOLUMNTYPEFROMRESULTSET
      DRAWRESULTDATA$USINGDEFAULT
      ." </td></tr>" CRLF
    THEN
;

HEX
: drawpage ( -- )

