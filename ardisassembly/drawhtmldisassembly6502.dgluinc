' DRAWHTMLDISSASEMBLY6502.DGLU ENDOFWORDLIST = 0= ?END-EVALUATE

0 CONSTANT DRAWHTMLDISSASEMBLY6502.DGLU


HEX 100  100  NEWBUFFER CONSTANT OPCODETYPEBUFID
HEX 1000 10000  NEWBUFFER CONSTANT OPCODENAMEL$OFFSETBUFID
HEX 1000 100000 NEWBUFFER CONSTANT OPCODENAMEL$STRINGBUFID

HEX 1000 100000  NEWBUFFER CONSTANT LABELADDRESSBUFID
VARIABLE PGETLABELTEXT$FUNCTION


: DEFAULTLABELTEXT$FUNCTION ( offset -- ) ( -$- $ ) 
    NEW$
 
    DEPTH 1 U< 0= IF
      DROP
    THEN 
;

' DEFAULTLABELTEXT$FUNCTION PGETLABELTEXT$FUNCTION !

: >OPCODE ( opcodetype -- ) ( opcodename -$- )
    OPCODETYPEBUFID C>BUF
    
    0 GETP$
    OPCODENAMEL$OFFSETBUFID
    OPCODENAMEL$STRINGBUFID
    S>NEWL$ DROP$
;

( Opcode data types )
0 CONSTANT none
1 CONSTANT byte
2 CONSTANT address
3 CONSTANT branch
4 CONSTANT terminating
5 CONSTANT byteaddress

( 00 ) $" brk"         terminating   >OPCODE
( 01 ) $" ora(()+x)"   byteaddress   >OPCODE
( 02 ) $" ???"         terminating   >OPCODE
( 03 ) $" ???"         terminating   >OPCODE
