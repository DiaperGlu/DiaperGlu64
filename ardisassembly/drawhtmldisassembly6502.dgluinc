HEX 10000 10000 NEWBUFFER CONSTANT FALREADYDISASSEMBLEDBUFID
HEX 1000  -1    NEWBUFFER CONSTANT PSECTIONSTACKBUFID

10000 FALREADYDISASSEMBLEDBUFID GROWBUFFER

VARIABLE PENTRYADDRESS
VARIABLE PBASEADDRESS
VARIABLE PCURRENTADDRESS
VARIABLE PDATAADDRESS
VARIABLE PX
VARIABLE POPCODE 
VARIABLE POPCODETYPE 

HEX
: CHECKISADDRESSOK? ( address -- flag ) ( data$ -$- data$ )

    DEPTH 1 U< IF
      ( need to push underflow error here ) 
      FALSE EXIT
    THEN

    DEPTH$ 1 U< IF
      ( need to push underflow error here )
      DROP FALSE EXIT
    THEN

    DUP PBASEADDRESS @ U< IF
      DROP FALSE
      EXIT
    THEN

    DUP PBASEADDRESS @ LENGTH$ + U< 0= IF
      DROP FALSE
      EXIT
    THEN

    DUP FALREADYDISASSEMBLEDBUFID OC@ ( getting a byte so can't compare with true )
    0= IF
      ( DROP ) TRUE
      EXIT
    THEN

    ( ." <tr>
         <td>"
           U. ." already disassembled"
           
    ."   </td>
       </tr> " CRLF )

    FALSE
;

VARIABLE PFFOUNDADDRESS
: POPADDRESSFROMSECTIONSTACK ( -- uint16address|-1 ) 

    PSECTIONSTACKBUFID LENGTHBUF 8 U< IF
      -1
      EXIT
    THEN

    FALSE PFFOUNDADDRESS !
    BEGIN

      PSECTIONSTACKBUFID LENGTHBUF 8 U< IF
        -1
        TRUE PFFOUNDADDRESS !
      ELSE

        PSECTIONSTACKBUFID BUF>

        DUP CHECKISADDRESSOK? IF
          TRUE PFFOUNDADDRESS ! 
        ELSE
          DROP
        THEN

      THEN
    
      PFFOUNDADDRESS @
    UNTIL    
;

: ?NOTDONEDISASSEMBLING ( -- flag )

    ( see if address is ok )
    PX @ PBASEADDRESS @ + CHECKISADDRESSOK? IF TRUE EXIT THEN 

    ( address is not ok, see if we can get one from section stack )
    POPADDRESSFROMSECTIONSTACK
    
    DUP -1 = IF
      DROP FALSE EXIT 
    THEN

    PBASEADDRESS @ - PX ! TRUE

    ." <tr>
         <td>
           <hr>
         </td>
       </tr> " CRLF
;

HEX
: CSIGNEXTEND ( n -- n' ) ( bit7 is copied to all higher bits )
    ( Forth doesn't have a sign extend byte function? )

    FF AND

    DUP 80 U< IF
      EXIT
    THEN

    FFFFFFFFFFFFFF00 OR
;

VARIABLE PGETLABELTEXT$SCURRENTOFFSET
VARIABLE PGETLABELTEXT$SMATCHES
VARIABLE PGETLABELTEXT$SADDRESS

: GETLABELTEXT$SFORADDRESS ( address -- n ) ( labeltext1$ labeltext2$ ... labeltextn$ -$- )

    DEPTH 1 U< IF 
      ( underflow error )
      0  
    THEN
    
    PGETLABELTEXT$SADDRESS !

    0 PGETLABELTEXT$SMATCHES !
    0 PGETLABELTEXT$SCURRENTOFFSET !

    BEGIN

      ( offset of -1 will cause loop to exit )
      PGETLABELTEXT$SCURRENTOFFSET @ LABELADDRESSBUFID LENGTHBUF U<

    WHILE
      LABELADDRESSBUFID 
      PGETLABELTEXT$SCURRENTOFFSET @
      PGETLABELTEXT$SADDRESS @
      SCANBUF PGETLABELTEXT$SCURRENTOFFSET ! 

      PGETLABELTEXT$SCURRENTOFFSET @ -1 U< IF

        ( labelindex -- ) ( -$- labeltext$ )
        PGETLABELTEXT$SCURRENTOFFSET @ 
        PGETLABELTEXT$FUNCTION @ ( check end of wordlist? ) 
        EXECUTE

        1 PGETLABELTEXT$SMATCHES +!
        1 PGETLABELTEXT$SCURRENTOFFSET +!
      
      THEN
    REPEAT

    PGETLABELTEXT$SMATCHES @    
;

: DRAWLABELTEXT$S ( n -- ) ( label0text$ label1text$ ... labelntext$ -$- )

    DEPTH 1 U< IF
      ( data stack underflow error )
      EXIT
    THEN 

    DUP 0= IF
      DROP EXIT 
    THEN

    DUP DEPTH$ SWAP U< IF
      ( string stack underflow )
      DROP EXIT
    THEN

    0 DO
      .$ ." <br>"
    LOOP
;

HEX

: CLEARALREADYDISASSEMBLED ( -- )
    10000 0 DO 
      FALSE I FALREADYDISASSEMBLEDBUFID OC!
    LOOP
;

: DRAW$ASHTML6502DISASSEMBLYFOLLOWCODE ( entryaddress baseaddress -- ) 
                                       ( memorysection$ -$- memorysection$ )
                                       ( uses current BASE )
   
    PSECTIONSTACKBUFID EMPTYBUFFER

    DEPTH 2 U< IF
      ." <p>Data stack underflow trying to draw disassembly. Missing base and/or entry address.</p>" CRLF
      EXIT
    THEN   

    DEPTH$ 1 U< IF
      ." <p>String stack underflow trying to draw disassembly. Missing data$ to disassemble.</p>" CRLF
      DROP DROP EXIT
    THEN

    PBASEADDRESS !
    PENTRYADDRESS !

    ." <br><hr><br>Entry address of code = " PENTRYADDRESS @ U. ." </p>" CRLF

    LENGTH$ 0= IF
      ." <p>Memory section string is empty.</p>" CRLF
      EXIT
    THEN

    PBASEADDRESS @ 10000 U< 0= IF
      ." <p>Base address of memory section is not between 0 and 0xFFFF</p>" CRLF
      EXIT
    THEN

    PBASEADDRESS @ LENGTH$ + 10001 U< 0= IF 
      ." <p>Memory section addresses go past 0xFFFF</p>" CRLF
      EXIT
    THEN

    PENTRYADDRESS @ PBASEADDRESS @ U< IF
      ." <p>Entry address is before base address of memory section.</p>" CRLF
      EXIT
    THEN    

    PENTRYADDRESS @ PBASEADDRESS @ LENGTH$ + U< 0= IF
      ." <p>Entry address is after end of memory section.</p>" CRLF
      EXIT
    THEN

    PENTRYADDRESS @ PBASEADDRESS @ - PX !
    ( PENTRYADDRESS @ PCURRENTADDRESS ! )

    ."   <table>" CRLF

    BEGIN

      ( check address and pop section stack if needed )
      ( if bad address and nothing is on section stack we are done )
      ?NOTDONEDISASSEMBLING

    WHILE

      PX @ PBASEADDRESS @ + PCURRENTADDRESS ! 
      -1 PDATAADDRESS ! ( don't make a label for uint32 -1, using this as no data address flag :- )

      ( check to see if there are labels for this address )
      PCURRENTADDRESS @ 
      GETLABELTEXT$SFORADDRESS DUP 0= IF
        DROP
      ELSE
        0 DO
        ." <tr><th align=left colspan=3>" CRLF
        ( DRAWLABELTEXT$S ) .$
        ." </th></tr>" CRLF
        LOOP
      THEN
      
      ( draw address field )
      ."     <tr>" CRLF
      ."       <td align=top style='FONT-FAMILY: Monospace'>" 
      PCURRENTADDRESS @ 0 <#$ #S$ #>$ .$
      ." </td>" CRLF

      ( mark address as already disassembled )
      TRUE PCURRENTADDRESS @ FALREADYDISASSEMBLEDBUFID OC!

      ( draw opcode field )

        ( get and opcode type and opcode namel$ offset bufid )
        PX @ $C@ POPCODE !
        POPCODE @ OPCODETYPEBUFID OC@ POPCODETYPE !

        POPCODE @
        OPCODENAMEL$OFFSETBUFID
        OPCODENAMEL$STRINGBUFID
        GETPL$

        ."       <td align=topleft style='FONT-FAMILY: Monospace' width=30%>"
        TYPE 

        ( moving pointer to next address )
        PX @ 1+ PX !

        ( draw data for opcodes with one byte of data )
        POPCODETYPE @ byte = IF

          PX @ LENGTH$ U< IF
            ."  " 
            PX @ $C@  
            DRAWBASEBYTE
          THEN

          ( moving pointer to next address )
          PX @ 1+ PX !
        THEN

        POPCODETYPE @ byteaddress = IF
          PX @ LENGTH$ U< IF
            ."  " 
            PX @ $C@ DUP PDATAADDRESS !
            DRAWBASEBYTE
          THEN

          ( moving pointer to next address )
          PX @ 1+ PX !
        THEN

        ( draw address for opcodes with two bytes of data )
        POPCODETYPE @ address = IF
        
          PX @ 1+ LENGTH$ U< IF
            ."  "
        
            ( don't have $UINT16@ so... )
            PX @ 1+ $C@ 100 * PX @ $C@ + PDATAADDRESS !

            ( moving pointer to next address )
            PX @ 2 + PX !

            PDATAADDRESS @ 0 <#$ #S$ #>$ .$ 

            POPCODE @ 20 = IF
              PDATAADDRESS @ PSECTIONSTACKBUFID >BUF
            THEN

            POPCODE @ 4C = IF
              PDATAADDRESS @ PBASEADDRESS @ - PX !
            THEN

            POPCODE @ 6C = IF
              -1 PX !
            THEN

          THEN

        THEN

        ( draw branch address for branch opcodes )
        POPCODETYPE @ branch = IF

          PX @ $C@ CSIGNEXTEND

          PX @ 1+ PX !
          
          PX @ PBASEADDRESS @ + + FFFF AND PDATAADDRESS !

          ."  "
          PDATAADDRESS @ 0 <#$ #S$ #>$ .$

          PDATAADDRESS @ PSECTIONSTACKBUFID >BUF
          
        THEN

        ( found unknown opcode, RTS, RTI, or BRK. Popping disassembly stack. )
        POPCODETYPE @ terminating = IF
          -1 PX !
        THEN

        ." </td>" CRLF

        ( draw label text for data address )
        ."       <td align=topleft>"
        PDATAADDRESS @ 
        GETLABELTEXT$SFORADDRESS
        DRAWLABELTEXT$S
        ." </td>" CRLF

        ."     </tr>" CRLF

        ?ERRORIF 
          ."     </table>" CRLF
          EXIT
        THEN     
    REPEAT    

    ."   </table>" CRLF
;

CLEARALREADYDISASSEMBLED