( After this, add new definitions to original current wordlist. )

R> SET-CURRENT


( Support functions )

: DROP$> ( uint64$ -$- ) ( -- n )
    0 GETP$ 1 CELLS < IF
      DROP$ 0 EXIT
    THEN
    @ DROP$ 
;

// : >NEW$ ( n -- ) ( -$- uint32$ )
//    NEW$ 4 GROW$
//    0 GETP$ DROP ! 
// ;

HEX
: CRLF$ ( -- ) ( -$- CRLF$ )
    0D C>NEW$ 0A C>$
;

CREATEOC NOTA0$ERROR $" Not a 0$ error" $>0$ PCURRENTCOMPILEBUFFER @ $>BUF

: O0$>NEW$ ( 0$offset 0$bufferid -- ) ( -$- 0$ )
    DEPTH 2 U< IF
      DATASTACKUNDERFLOWERROR PUSHOERROR0$
      NAME>E EXIT
    THEN

    O>P 

    DUP -1 0 CSCAN 

    ?ERRORIF
      NAME>E EXIT 
    THEN

    DUP -1 = IF ( probably can't get this error )
      NOTA0$ERROR PUSHOERROR0$
      NAME>E EXIT
    THEN

    ( p0$ length )
    S>NEW$

    ?ERRORIF
      NAME>E EXIT
    THEN
;

: DEPTH>OFFSET ( desireddepth0based stackdepth -- offset | 0 )
    DUP 0= IF
      ( empty stack error )
      DROP DROP 0 EXIT
    THEN    

    OVER OVER U< IF
      SWAP - 1- 
      EXIT
    ELSE
      ( off stack error )
      DROP DROP 0
      EXIT
    THEN    
;

: BUFDEPTH32@ ( depthinintunits0based bufid -- n )
            ( depth goes from 0 at top to buffer length / 4 - 1 at bottom )
    DUP LENGTHBUF 0= IF 
      DROP DROP 0
      EXIT
    THEN

    >R 
    2* 2* 3 + ( 0 > 7, 1 > 15, 2 > 23 )
    R@ LENGTHBUF DEPTH>OFFSET ( offset in bytes )

    R> O32@
;

: BUFDEPTH32! ( n depthinintunits bufid -- )
            ( depth goes from 0 at top to buffer length / 4 - 1 at bottom )
    DUP LENGTHBUF 0= IF 
      DROP DROP DROP
      EXIT
    THEN

    >R 
    2* 2* 3 + ( 0 > 3, 1 > 7, 2 > 11 )
    R@ LENGTHBUF DEPTH>OFFSET ( offset in bytes )

    R> O32!
;

: BUFDEPTH64@ ( depthinintunits0based bufid -- n )
            ( depth goes from 0 at top to buffer length / 4 - 1 at bottom )
    DUP LENGTHBUF 0= IF 
      DROP DROP 0
      EXIT
    THEN

    >R 
    2* 2* 2* 7 + ( 0 > 7, 1 > 15, 2 > 23 )
    R@ LENGTHBUF DEPTH>OFFSET ( offset in bytes )

    R> O@
;

: BUFDEPTH64! ( n depthinintunits bufid -- )
            ( depth goes from 0 at top to buffer length / 4 - 1 at bottom )
    DUP LENGTHBUF 0= IF 
      DROP DROP DROP
      EXIT
    THEN

    >R 
    2* 2* 2* 7 + ( 0 > 3, 1 > 7, 2 > 11 )
    R@ LENGTHBUF DEPTH>OFFSET ( offset in bytes )

    R> O!
;

: GETPL$ATDEPTH ( desireddepth0based offsetbufid stringbufid -- pl$ length )
    >R >R
    R@ DEPTHL$
    DEPTH>OFFSET
    R> R> GETPL$    
;

HEX 
: HEXBYTE>NEW$ ( byte -- ) ( -$- hex$ )
    FF AND
    DUP 10 U< IF
      $" 0"
      BASE @ >R HEX 0 <#$ #S$ #>$ R> BASE ! $>$
    ELSE
      BASE @ >R HEX 0 <#$ #S$ #>$ R> BASE !
    THEN
;

DECIMAL
: DECIMALBYTE>NEW$ ( byte -- ) ( -$- dec$ )
    255 AND
    DUP 10 U< IF 
      $" 00"
      BASE @ >R DECIMAL 0 <#$ #S$ #>$ R> BASE ! $>$
      EXIT
    THEN
    DUP 100 U< IF
      $" 0"
      BASE @ >R DECIMAL 0 <#$ #S$ #>$ R> BASE ! $>$
      EXIT
    THEN
    BASE @ >R DECIMAL 0 <#$ #S$ #>$ R> BASE !
;

HEX 
: DRAWHEXBYTE ( byte -- )
    HEXBYTE>NEW$
    .$
;

DECIMAL
: DRAWDECIMALBYTE ( byte -- )
    DECIMALBYTE>NEW$
    .$
;

HEX
: DRAWBASEBYTE ( byte -- )
    BASE @ 10 = IF
      DRAWHEXBYTE
    ELSE
      DRAWDECIMALBYTE
    THEN
;

( Error functions )

CREATEOC OUNKNOWNSTATEERROR $" SQL Unknown error state message" $>0$ PCURRENTCOMPILEBUFFER @ $>BUF

: ERRORSTATE$>OERROR ( 5charstateerror$ -$- ) ( -- errormessageoffset errormessagebufid )
    ( Check for underflow? )
    0 GETP$ SQLSTATE-WORDLIST SEARCH-WORDLIST DROP$
    0= IF
      OUNKNOWNSTATEERROR 
      EXIT
    THEN
    EXECUTE ;
    
( Holds handle to the sql environment variable. )
( All calls to the sql driver can share the same enviroment handle. )

VARIABLE PHSQLENV
SQL_NULL_HANDLE PHSQLENV !

VARIABLE PSTRLENTEMP

HEX
: GETSQLERRORSTATE$ ( handle handletype -- sqlresult ) ( -$- asciierrorstate$ )
    OVER SQL_NULL_HANDLE = IF 
      2DROP NEW$ SQL_INVALID_HANDLE EXIT 
    THEN

    >R >R

    ( Call SQL driver's get error code function )

    PSTRLENTEMP ( This should be on a stack, but since we don't care about return value ... )
    NEW$ 6 2* 
    ( GROW$ ) $STACKOFFSETBUFFERID $STACKSTRINGBUFFERID GROWL$ ( garbage in string after grow )
    0 GETP$ SWAP ( unicode string, and yet buffer length is in bytes :-/ and you need to leave room for null terminator )
    SQL_DIAG_SQLSTATE
    1
    R>
    R>
    7
    SQLGetDiagFieldW CALLPROC FFFF AND
    ( if there is an error, there will be garbage in string )   

    UNICODE>ASCII$
    $>C DROP ( dropping null terminator )
;

CREATEOC GETOSQLERRORINVALIDHANDLEERROR 
$" GETOSQLERROR - Invalid handle or handle type used to get diagnostic error code" 
$>0$ PCURRENTCOMPILEBUFFER @ $>BUF

CREATEOC GETOSQLERRORMESSAGETOOBIGERROR 
$" GETOSQLERROR - Message buffer too small. Either sql driver is broken or fix sqlsupport.dglu script." 
$>0$ PCURRENTCOMPILEBUFFER @ $>BUF

CREATEOC GETOSQLERRORERROR 
$" GETOSQLERROR - Either no errors with this handle yet, problem with parameters, sql driver broken, or sqlsupport.dglu broken" 
$>0$ PCURRENTCOMPILEBUFFER @ $>BUF


: CHECKGETOSQLERRORSTATE$FORERROR ( sqlreturncode -- errormessageoffset errormessagebufid ) ( state$ -$- )
    DUP SQL_SUCCESS = IF
      DROP
      ERRORSTATE$>OERROR
      EXIT
    THEN
    DROP$
    DUP SQL_SUCCESS_WITH_INFO = IF
      DROP
      GETOSQLERRORMESSAGETOOBIGERROR
      EXIT
    THEN
    SQL_INVALID_HANDLE = IF
      GETOSQLERRORINVALIDHANDLEERROR
    ELSE
      GETOSQLERRORERROR
    THEN 
;

: GETOSQLERROR ( handle handletype -- errormessageoffset errormessagebufid )
    GETSQLERRORSTATE$
    CHECKGETOSQLERRORSTATE$FORERROR
;

CREATEOC SQLINVALIDHANDLEERROR 
$" SQL invalid handle" 
$>0$ PCURRENTCOMPILEBUFFER @ $>BUF

HEX
: CHECKSQLRETURNFORHENVERROR ( sqlreturncode -- )

    FFFF AND

    DUP SQL_SUCCESS = IF 
      DROP EXIT
    THEN

    SQL_INVALID_HANDLE = IF
      SQLINVALIDHANDLEERROR
      PUSHOERROR0$
      EXIT
    THEN

    ( success with info, or error )
    PHSQLENV @ SQL_HANDLE_ENV GETOSQLERROR 
    PUSHOERROR0$
;

HEX
: ALLOCATEHSQLENV ( -- returncode )

    PHSQLENV @ SQL_NULL_HANDLE = 0= IF
      EXIT
    THEN

    PHSQLENV SQL_NULL_HANDLE SQL_HANDLE_ENV 3 SQLAllocHandle CALLPROC FFFF AND 

    ( diagnostics are tied to input handle which is NULL in this case )
    ( so the return code is the only information ) 
;

HEX
: FREEHSQLENV ( -- )

    PHSQLENV @ SQL_NULL_HANDLE = IF 
      EXIT 
    THEN

    PHSQLENV @ SQL_HANDLE_ENV 2 SQLFreeHandle CALLPROC FFFF AND
    CHECKSQLRETURNFORHENVERROR

    ?ERRORIF
      NAME>E EXIT
    ELSE
      SQL_NULL_HANDLE PHSQLENV ! 
    THEN ;  


( make it so FREEHSQLENV is called automatically when program ends, this one will be called last )
(  things pushed later will be called first )

' FREEHSQLENV CLEANUPBUFFERID >BUF

HEX
: SETENVTOODBC3 ( -- )
    0
    SQL_OV_ODBC3
    SQL_ATTR_ODBC_VERSION
    PHSQLENV @ 
    4
    SQLSetEnvAttr CALLPROC FFFF AND
    CHECKSQLRETURNFORHENVERROR ?ERRORIF NAME>E THEN
;

HEX
1000 10000 NEWBUFFER CONSTANT HSQLCONNSTACKBUFFERID
1000 10000 NEWBUFFER CONSTANT HSQLSTMTSTACKBUFFERID

: GETPBUFFERDEPTH ( DEPTHINBYTES BUFFERID -- POINTER )
    DUP >R LENGTHBUF SWAP - R> GETPBUFFEROFFSET
;

HEX
: ALLOCATEHSQLCONN ( -- )
    PHSQLENV @ 0= IF
      ALLOCATEHSQLENV
    THEN
    
    ?ERRORIF EXIT THEN

    0 HSQLCONNSTACKBUFFERID >BUF ( allocate room for conn pointer )

    4 HSQLCONNSTACKBUFFERID GETPBUFFERDEPTH
    PHSQLENV @
    SQL_HANDLE_DBC
    3
    SQLAllocHandle CALLPROC FFFF AND

    CHECKSQLRETURNFORHENVERROR ?ERRORIF NAME>E THEN
;

: GETCURRENTHSQLCONN ( -- 0|hsqlconn )
    HSQLCONNSTACKBUFFERID LENGTHBUF 4 < IF
      ( push error? )
      0 EXIT
    THEN
    
    4 HSQLCONNSTACKBUFFERID GETPBUFFERDEPTH @
;

: GETCURRENTHSQLSTMT ( -- 0|hsqlstmt )
    HSQLSTMTSTACKBUFFERID LENGTHBUF 4 < IF
      ( push no statement handle error? )
      0 EXIT
    THEN
    
    4 HSQLSTMTSTACKBUFFERID GETPBUFFERDEPTH @
;

HEX
: CHECKSQLRETURNFORHDBCERROR ( sqlreturncode -- )

    FFFF AND

    DUP SQL_SUCCESS = IF 
      DROP EXIT
    THEN

    SQL_INVALID_HANDLE = IF
      SQLINVALIDHANDLEERROR
      PUSHOERROR0$
      EXIT
    THEN

    ( success with info, or error )
    GETCURRENTHSQLCONN SQL_HANDLE_DBC GETOSQLERROR 
    PUSHOERROR0$
;

HEX
: FREEHSQLCONN ( -- )

    HSQLCONNSTACKBUFFERID LENGTHBUF 4 < IF
      EXIT
    THEN

    GETCURRENTHSQLCONN SQL_NULL_HANDLE = IF
      HSQLCONNSTACKBUFFERID BUF> DROP
      EXIT
    THEN

    GETCURRENTHSQLCONN    
    SQL_HANDLE_DBC
    2
    SQLFreeHandle CALLPROC

    CHECKSQLRETURNFORHDBCERROR

    HSQLCONNSTACKBUFFERID BUF> DROP

    ?ERRORIF NAME>E THEN
;

: ALLOCATEHSQLSTMT ( -- )
    
    0 HSQLSTMTSTACKBUFFERID >BUF ( allocate room for conn pointer )

    HSQLCONNSTACKBUFFERID LENGTHBUF 4 < IF
      BUFFERUNDERFLOWERROR PUSHOERROR0$ 
      NAME>E
      EXIT
    THEN

    4 HSQLSTMTSTACKBUFFERID GETPBUFFERDEPTH
    GETCURRENTHSQLCONN
    SQL_HANDLE_STMT
    3
    SQLAllocHandle CALLPROC

    CHECKSQLRETURNFORHDBCERROR

    ?ERRORIF NAME>E THEN
;

HEX
: CHECKSQLRETURNFORHSTMTERROR ( sqlreturncode -- )

    FFFF AND

    DUP SQL_SUCCESS = IF 
      DROP EXIT
    THEN

    SQL_INVALID_HANDLE = IF
      SQLINVALIDHANDLEERROR PUSHOERROR0$
      EXIT
    THEN

    ( success with info, or error )
    GETCURRENTHSQLSTMT SQL_HANDLE_STMT GETOSQLERROR 
    PUSHOERROR0$
;

HEX
: FREEHSQLSTMT ( -- )

    HSQLSTMTSTACKBUFFERID LENGTHBUF 4 < IF
      BUFFERUNDERFLOWERROR PUSHOERROR0$ 
      NAME>E
      EXIT
    THEN

    GETCURRENTHSQLSTMT SQL_NULL_HANDLE = IF
      HSQLCONNSTACKBUFFERID BUF> DROP
      EXIT
    THEN

    GETCURRENTHSQLSTMT
    SQL_HANDLE_STMT
    2
    SQLFreeHandle CALLPROC

    CHECKSQLRETURNFORHSTMTERROR

    HSQLSTMTSTACKBUFFERID BUF> DROP

    ?ERRORIF NAME>E THEN
;

: DISCONNECTSQL ( -- )
    HSQLCONNSTACKBUFFERID LENGTHBUF 4 < IF
      BUFFERUNDERFLOWERROR PUSHOERROR0$ 
      NAME>E
      EXIT
    THEN

    GETCURRENTHSQLCONN SQL_NULL_HANDLE = IF
      EXIT
    THEN

    GETCURRENTHSQLCONN 1 SQLDisconnect CALLPROC

    CHECKSQLRETURNFORHDBCERROR

    ?ERRORIF NAME>E THEN
;
    


HEX
: SETHSQLCONNDATABASE ( -- ) ( asciidatabasename$ -$- )

    DEPTH$ 1 U< IF
      STRINGSTACKUNDERFLOWERROR PUSHOERROR0$
      NAME>E
      EXIT
    THEN
    
    SQL_NTS
    $>0$ ASCII>UNICODE$ 0 GETP$ DROP ( driver prefers null terminated string format )
    SQL_ATTR_CURRENT_CATALOG
    GETCURRENTHSQLCONN
    4
    SQLSetConnectAttrW CALLPROC

    DROP$

    CHECKSQLRETURNFORHDBCERROR

    ?ERRORIF NAME>E THEN
;


HEX
: SETHSQLCONNTIMEOUT ( n -- ) ( 0 = none )
    DEPTH 1 U< IF
      DATASTACKUNDERFLOWERROR PUSHOERROR0$
      NAME>E
      EXIT
    THEN

    0 SWAP
    SQL_ATTR_CONNECTION_TIMEOUT
    GETCURRENTHSQLCONN
    4
    SQLSetConnectAttrW CALLPROC

    CHECKSQLRETURNFORHDBCERROR

    ?ERRORIF NAME>E THEN
;

HEX
: CONNECTSQL ( -- ) ( asciiserver$ asciiuser$ asciipass$ -$- )
    DEPTH$ 3 U< IF 
      DATASTACKUNDERFLOWERROR PUSHOERROR0$
      NAME>E
      EXIT
    THEN

    $>0$ ASCII>UNICODE$ ROT$
    $>0$ ASCII>UNICODE$ ROT$
    $>0$ ASCII>UNICODE$ ROT$

    ( With MSSQL, driver requires null terminated strings in many places even though docs say length strings are ok )
    SQL_NTS
    0 GETP$ DROP ( pass )
    SQL_NTS 
    1 GETP$ DROP ( user )
    SQL_NTS 
    2 GETP$ DROP ( server )
    GETCURRENTHSQLCONN
    7
    SQLConnectW CALLPROC

    DROP$ DROP$ DROP$

    DUP FFFF AND SQL_SUCCESS_WITH_INFO = IF
      DROP
      EXIT
    THEN

    CHECKSQLRETURNFORHDBCERROR

    ?ERRORIF NAME>E THEN   
;

VARIABLE pGetInfoStrLen ( holds UINT16 in UINT32 space, assumes little endian )
: GETSQLINFO$ ( sqlinfotype -- ) ( -$- sqlinfo$ )

    0 pGetInfoStrLen !
    DEPTH 1 U< IF DATASTACKUNDERFLOWERROR PUSHOERROR0$ NAME>E EXIT THEN

    >R
    NEW$
    pGetInfoStrLen
    0 GETP$ SWAP
    R> DUP >R
    GETCURRENTHSQLCONN
    5
    SQLGetInfoA CALLPROC

    CHECKSQLRETURNFORHDBCERROR ?ERRORIF R> DROP NAME>E EXIT THEN

    pGetInfoStrLen @ ( assumes little endian, really need uint16@ ) 
    0= IF R> DROP EXIT THEN

    pGetInfoStrLen @ 1+ GROW$ ?ERRORIF R> DROP NAME>E EXIT THEN

    pGetInfoStrLen
    0 GETP$ SWAP
    R> 
    GETCURRENTHSQLCONN
    5
    SQLGetInfoA CALLPROC

    CHECKSQLRETURNFORHDBCERROR ?ERRORIF NAME>E EXIT THEN

    ( need to shorten the string because first call sometimes returns way oversize length )

    pGetInfoStrLen @ LENGTH$ U< IF
      LENGTH$ pGetInfoStrLen @ - SHORTEN$
    THEN

    
;

HEX
VARIABLE pGetInfoData 
: GETSQLINFO ( sqlinfotype -- sqlinfodata ) 

    0 pGetInfoStrLen !
    0 pGetInfoData !

    DEPTH 1 U< IF DATASTACKUNDERFLOWERROR PUSHOERROR0$ NAME>E EXIT THEN

    >R
    pGetInfoStrLen
    4
    pGetInfoData
    R>
    GETCURRENTHSQLCONN
    5
    SQLGetInfoA CALLPROC

    CHECKSQLRETURNFORHDBCERROR ?ERRORIF NAME>E THEN 

    pGetInfoData @ ( assumes little endian, should use a uint16@ )    
;

CREATEOC NOHSQLSTMTERROR $" SQL no statement handle allocated"             $>0$ PCURRENTCOMPILEBUFFER @ $>BUF

: DOSQLSTATEMENT$ ( -- ) ( asciisqlstatement$ -$- )
    GETCURRENTHSQLSTMT 0= IF
      NOHSQLSTMTERROR PUSHOERROR0$ 
      NAME>E
      DROP$
      EXIT
    THEN

    ( this driver routine does not accept SQL_NTS for the length )
    (  need to pass in length in characters of unicode string )

    ASCII>UNICODE$ 0 GETP$ 2/ SWAP
    GETCURRENTHSQLSTMT
    3
    SQLExecDirectW CALLPROC
    
    DROP$

    CHECKSQLRETURNFORHSTMTERROR

    ?ERRORIF NAME>E THEN   
;

: USEHSQLCONNDATABASE$ ( -- ) ( database$ -$- )
 
    DEPTH$ 1 U< IF 
      STRINGSTACKUNDERFLOWERROR PUSHOERROR0$ 
      NAME>E 
      EXIT 
    THEN

    LENGTH$ 0= IF DROP$ EXIT THEN

    $" USE " SWAP$ $>$
    DOSQLSTATEMENT$
    ?ERRORIF NAME>E THEN
;


: DOSQLSTATEMENT ( -- )
    GETCURRENTHSQLSTMT 0= IF
      NOHSQLSTMTERROR PUSHOERROR0$
      NAME>E
      EXIT
    THEN

    GETCURRENTHSQLSTMT
    1
    SQLExecute CALLPROC

    CHECKSQLRETURNFORHSTMTERROR
    ?ERRORIF NAME>E THEN
;

: PREPARESQLSTATEMENT$ ( -- ) ( asciisqlstatement$ -$- asciisqlstatement$ )
    DEPTH$ 1 U< IF
      STRINGSTACKUNDERFLOWERROR PUSHOERROR0$
      NAME>E
      EXIT
    THEN

    GETCURRENTHSQLSTMT 0= IF
      NOHSQLSTMTERROR PUSHOERROR0$
      NAME>E
      DROP$
      EXIT
    THEN

    ( ASCII>UNICODE$ ) 0 GETP$ ( 2/ ) SWAP
    GETCURRENTHSQLSTMT
    3
    SQLPrepareA CALLPROC
   
    CHECKSQLRETURNFORHSTMTERROR

    ?ERRORIF NAME>E THEN
;

: ISSQLINTTYPE? ( sqldatatype -- trueifinttype )
    DEPTH 1 U< IF
      DATASTACKUNDERFLOWERROR PUSHOERROR0$
      NAME>E
      EXIT
    THEN

    DUP SQL_INTEGER = 
    SWAP SQL_SMALLINT = OR
;

: ISSQLWCHARTYPE? ( sqldatatype -- trueifinttype )
    DEPTH 1 U< IF
      DATASTACKUNDERFLOWERROR PUSHOERROR0$
      NAME>E
      EXIT
    THEN

    DUP SQL_WCHAR = >R
    DUP SQL_WVARCHAR = >R
    SQL_WLONGVARCHAR = 
    R> OR R> OR
;

: CHANGESQLCOLTYPETOINTORBIN ( coltype -- SQL_INTEGER|SQL_BINARY )
    DEPTH 1 U< IF
      DATASTACKUNDERFLOWERROR PUSHOERROR0$
      NAME>E
      EXIT
    THEN

    ISSQLINTTYPE? IF
      SQL_INTEGER
    ELSE
      SQL_BINARY
    THEN
;

: CHANGESQLCOLTYPETOINTORBINORWCHAR ( coltype -- SQL_INTEGER|SQL_BINARY|SQL_WCHAR )
    DEPTH 1 U< IF
      DATASTACKUNDERFLOWERROR PUSHOERROR0$
      NAME>E
      EXIT
    THEN

    DUP ISSQLWCHARTYPE? IF
      DROP SQL_WCHAR EXIT
    THEN

    ISSQLINTTYPE? IF
      SQL_INTEGER
    ELSE
      SQL_BINARY
    THEN
;

: GETDEFAULTCTYPE ( sqltype -- ctype )
    DEPTH 1 U< IF 
      DATASTACKUNDERFLOWERROR PUSHOERROR0$
      NAME>E
      EXIT
    THEN 

    DUP SQL_CHAR            = IF DROP SQL_C_CHAR    EXIT THEN
    DUP SQL_INTEGER         = IF DROP SQL_C_LONG    EXIT THEN
    DUP SQL_SMALLINT        = IF DROP SQL_C_SHORT   EXIT THEN
    DUP SQL_REAL            = IF DROP SQL_C_FLOAT   EXIT THEN
    DUP SQL_DOUBLE          = IF DROP SQL_C_DOUBLE  EXIT THEN
    DUP SQL_NUMERIC         = IF DROP ( SQL_C_NUMERIC ) SQL_C_CHAR EXIT THEN ( docs have it one way, .h another )
    DUP SQL_DECIMAL         = IF DROP SQL_C_CHAR    EXIT THEN
    DUP SQL_VARCHAR         = IF DROP SQL_C_CHAR    EXIT THEN
    DUP SQL_LONGVARCHAR     = IF DROP SQL_C_CHAR    EXIT THEN
    DUP SQL_BIT             = IF DROP SQL_C_BIT     EXIT THEN
    DUP SQL_DATE            = IF DROP SQL_C_DATE    EXIT THEN
    DUP SQL_TIME            = IF DROP SQL_C_TIME    EXIT THEN
    DUP SQL_TIMESTAMP       = IF DROP SQL_C_TIMESTAMP EXIT THEN

    DUP SQL_FLOAT           = IF DROP SQL_C_DOUBLE  EXIT THEN
   
    DUP SQL_BINARY          = IF DROP SQL_C_BINARY  EXIT THEN
    DUP SQL_VARBINARY       = IF DROP SQL_C_BINARY  EXIT THEN
    DUP SQL_LONGVARBINARY   = IF DROP SQL_C_BINARY  EXIT THEN

    ( if it's an unlisted type, just gonna pass it through because most of them are the same )    
;

: >NAME$ ( executiontoken -- ) ( -$- name$ )
    0 GET-ELEMENT-NAME$ 
;

: SQLCOLTYPE>NEWTYPE$ ( columntype -- ) ( -$- columntype$ )
    DEPTH 1 U< IF 
      DATASTACKUNDERFLOWERROR PUSHOERROR0$
      NAME>E
      EXIT
    THEN 
    
    ( >ONAME O0$>NEW$ replaced with 0 GET-ELEMENT-NAME$ 12/1/2012 )
    DUP SQL_UNKNOWN_TYPE    = IF DROP ['] SQL_UNKNOWN_TYPE     >NAME$ EXIT THEN
    DUP SQL_CHAR            = IF DROP ['] SQL_CHAR             >NAME$ EXIT THEN
    DUP SQL_NUMERIC         = IF DROP ['] SQL_NUMERIC          >NAME$ EXIT THEN
    DUP SQL_DECIMAL         = IF DROP ['] SQL_DECIMAL          >NAME$ EXIT THEN
    DUP SQL_INTEGER         = IF DROP ['] SQL_INTEGER          >NAME$ EXIT THEN
    DUP SQL_SMALLINT        = IF DROP ['] SQL_SMALLINT         >NAME$ EXIT THEN
    DUP SQL_FLOAT           = IF DROP ['] SQL_FLOAT            >NAME$ EXIT THEN
    DUP SQL_REAL            = IF DROP ['] SQL_REAL             >NAME$ EXIT THEN
    DUP SQL_DOUBLE          = IF DROP ['] SQL_DOUBLE           >NAME$ EXIT THEN
    DUP SQL_DATETIME        = IF DROP ['] SQL_DATETIME         >NAME$ EXIT THEN
    DUP SQL_DATE            = IF DROP ['] SQL_DATE             >NAME$ EXIT THEN
    DUP SQL_INTERVAL        = IF DROP ['] SQL_INTERVAL         >NAME$ EXIT THEN
    DUP SQL_TIME            = IF DROP ['] SQL_TIME             >NAME$ EXIT THEN
    DUP SQL_TIMESTAMP       = IF DROP ['] SQL_TIMESTAMP        >NAME$ EXIT THEN
    DUP SQL_VARCHAR         = IF DROP ['] SQL_VARCHAR          >NAME$ EXIT THEN
    DUP SQL_LONGVARCHAR     = IF DROP ['] SQL_LONGVARCHAR      >NAME$ EXIT THEN
    DUP SQL_BINARY          = IF DROP ['] SQL_BINARY           >NAME$ EXIT THEN
    DUP SQL_VARBINARY       = IF DROP ['] SQL_VARBINARY        >NAME$ EXIT THEN
    DUP SQL_LONGVARBINARY   = IF DROP ['] SQL_LONGVARBINARY    >NAME$ EXIT THEN
    DUP SQL_BIGINT          = IF DROP ['] SQL_BIGINT           >NAME$ EXIT THEN
    DUP SQL_TINYINT         = IF DROP ['] SQL_TINYINT          >NAME$ EXIT THEN
    DUP SQL_BIT             = IF DROP ['] SQL_BIT              >NAME$ EXIT THEN
    DUP SQL_WCHAR           = IF DROP ['] SQL_WCHAR            >NAME$ EXIT THEN
    DUP SQL_WVARCHAR        = IF DROP ['] SQL_WVARCHAR         >NAME$ EXIT THEN
    DUP SQL_WLONGVARCHAR    = IF DROP ['] SQL_WLONGVARCHAR     >NAME$ EXIT THEN
    DUP SQL_GUID            = IF DROP ['] SQL_GUID             >NAME$ EXIT THEN
    DROP $" SQL_OTHER"
;

FFFB CONSTANT SQL_BIGINT
FFFA CONSTANT SQL_TINYINT
FFF9 CONSTANT SQL_BIT
FFF8 CONSTANT SQL_WCHAR
FFF7 CONSTANT SQL_WVARCHAR
FFF6 CONSTANT SQL_WLONGVARCHAR
FFF5 CONSTANT SQL_GUID
DECIMAL
VARIABLE PBINDBINARYSPLENGTH
VARIABLE PBINDBINARYSPARAMNUM
VARIABLE PBINDBINARYSPBUFFER
VARIABLE PBINDBINARYSTYPE
: BINDBINARYSFORSQLINSERT ( pbuffer plength 1basedparameternumber type -- )
    DEPTH 4 U< IF
      DATASTACKUNDERFLOWERROR PUSHOERROR0$
      NAME>E
      EXIT
    THEN

    GETCURRENTHSQLSTMT 0= IF
      NOHSQLSTMTERROR PUSHOERROR0$
      NAME>E
      DROP DROP DROP
      EXIT
    THEN

    PBINDBINARYSTYPE !
    PBINDBINARYSPARAMNUM !
    PBINDBINARYSPLENGTH !
    PBINDBINARYSPBUFFER !  

    PBINDBINARYSPLENGTH @
    DUP @
    PBINDBINARYSPBUFFER @
    0
    PBINDBINARYSPLENGTH @ U32@ ( why don't I just pass the length? why use a pointer to an array element? )
    PBINDBINARYSTYPE @ ( SQL type )
    PBINDBINARYSTYPE @ GETDEFAULTCTYPE ( ctype )
    SQL_PARAM_INPUT
    PBINDBINARYSPARAMNUM @ ( paramaternumber )
    GETCURRENTHSQLSTMT ( statementhandle )
    10
    SQLBindParameter CALLPROC

    CHECKSQLRETURNFORHSTMTERROR

    ?ERRORIF NAME>E THEN
;

VARIABLE PBINDBINARYSSFORSQLINSERTn
: BINDBINARYSSFORSQLINSERT ( pbuffer1 plength1 paramn1 type1 ... pbuffern plengthn typen paramn2 typen n -- )
    DEPTH 0= IF
      DATASTACKUNDERFLOWERROR PUSHOERROR0$
      NAME>E
      EXIT
    THEN

    PBINDBINARYSSFORSQLINSERTn !
    PBINDBINARYSSFORSQLINSERTn @ 0= IF EXIT THEN

    DEPTH PBINDBINARYSSFORSQLINSERTn @ 4 * U< IF
      DATASTACKUNDERFLOWERROR PUSHOERROR0$
      NAME>E
      EXIT
    THEN

    ( need to bind bottom to top )
    PBINDBINARYSSFORSQLINSERTn @ 0 DO
      PBINDBINARYSSFORSQLINSERTn @ 4 * I 4 * - 1- PICK 
      PBINDBINARYSSFORSQLINSERTn @ 4 * I 4 * - 1- PICK
      PBINDBINARYSSFORSQLINSERTn @ 4 * I 4 * - 1- PICK
      PBINDBINARYSSFORSQLINSERTn @ 4 * I 4 * - 1- PICK
      BINDBINARYSFORSQLINSERT
      ?ERRORIF LEAVE THEN
    LOOP
    ?ERRORIF NAME>E EXIT THEN

    ( dropping pairs )
    PBINDBINARYSSFORSQLINSERTn @ 0 DO DROP DROP DROP DROP LOOP
;

DECIMAL
: BINDBINARYBUFFERFORSQLINSERT ( bufferid 1basedparameternumber -- )
    DEPTH 2 U< IF
      DATASTACKUNDERFLOWERROR PUSHOERROR0$
      NAME>E
      EXIT
    THEN

    GETCURRENTHSQLSTMT 0= IF
      NOHSQLSTMTERROR PUSHOERROR0$
      NAME>E
      DROP DROP
      EXIT
    THEN

    >R

    DUP GETPBUFFERLENGTH SWAP ( plength bufferid )

    ?ERRORIF 
      R> DROP NAME>E 
      EXIT 
    THEN

    ( could be buffersize here to be reusable for fetches )
    ( but ODBCSQL32.dll gets confused and truncates )
    ( when you have multiple buffers so using length instead )
    DUP LENGTHBUF SWAP ( ... bufferlength bufferid )
    GETPBUFFER @       ( pbuffer )
    0 SWAP             ( decimaldigitsdontcare )
                       ( columnsize mysql doesn't care, mssql wants strlength )
    SQL_BINARY
    SQL_C_BINARY
    SQL_PARAM_INPUT
    R>                 ( paramaternumber )
    GETCURRENTHSQLSTMT ( statementhandle )
    10
    SQLBindParameter CALLPROC

    CHECKSQLRETURNFORHSTMTERROR

    ?ERRORIF NAME>E THEN
;

( reverse order )
: BINDBINARYBUFFERSFORSQLINSERT ( bufferidn paramn1 ... bufferid1 paramn2 n -- )
    DEPTH 0= IF
      DATASTACKUNDERFLOWERROR PUSHOERROR0$
      NAME>E
      EXIT
    THEN

    DUP 0= IF DROP EXIT THEN

    ( check depth for enough pairs here )

    0 DO
      SWAP GETPBUFFER ROT SQL_BINARY SWAP BINDBINARYSSFORSQLINSERT ( BINDBINARYBUFFERFORSQLINSERT )
      ?ERRORIF LEAVE THEN
    LOOP
    ?ERRORIF NAME>E THEN
;

HEX
: FETCHNEXTSQLROW ( -- flagtrueifrowfetched )

    GETCURRENTHSQLSTMT
    1
    SQLFetch CALLPROC FFFF AND
 
    DUP SQL_SUCCESS = IF
      DROP TRUE
      EXIT
    THEN

    DUP SQL_NO_DATA = IF
      DROP FALSE
      EXIT
    THEN

    CHECKSQLRETURNFORHSTMTERROR

    ?ERRORIF NAME>E THEN
;

VARIABLE PNUMCOLSTEMP

: GETNUMSQLRESULTCOLS ( -- 0|numcolsinresultset )
    0 PNUMCOLSTEMP !

    PNUMCOLSTEMP 
    GETCURRENTHSQLSTMT
    2
    SQLNumResultCols CALLPROC
    
    CHECKSQLRETURNFORHSTMTERROR

    ?ERRORIF
      0 NAME>E
    ELSE
      ( SQL is using UINT16 but in little endian system this will work )
      (  for hi byte first this will need to be fixed to UINT16@ )
      PNUMCOLSTEMP @ 
    THEN
;


// COLTYPE structure uses 32bit ints... need to convert subroutines that use it

HEX
1000 100000  NEWBUFFER CONSTANT SQLRESULTL$STACKOFFSETBUFFERID
1000 1000000 NEWBUFFER CONSTANT SQLRESULTL$STACKSTRINGBUFFERID
1000 100000  NEWBUFFER CONSTANT SQLCOLTYPEL$STACKOFFSETBUFFERID
1000 1000000 NEWBUFFER CONSTANT SQLCOLTYPEL$STACKSTRINGBUFFERID
1000 100000  NEWBUFFER CONSTANT SQLCOLNAMEL$STACKOFFSETBUFFERID
1000 1000000 NEWBUFFER CONSTANT SQLCOLNAMEL$STACKSTRINGBUFFERID

( need sqldecribecol to get col data type, sqlgetdata for int and string, and the gettable function )

: GETPRESULTL$ ( desireddepth0based -- presultl$ lengthresultl$ )
    DEPTH 1 U< IF
      DATASTACKUNDERFLOWERROR PUSHOERROR0$
      NAME>E
      EXIT
    THEN
    SQLRESULTL$STACKOFFSETBUFFERID SQLRESULTL$STACKSTRINGBUFFERID 
    GETPL$ATDEPTH
    ?ERRORIF NAME>E THEN
;

VARIABLE PCOLNAMELENGTH
VARIABLE PCOLDATATYPE
VARIABLE PCOLSIZE
VARIABLE PCOLDECIMALDIGITS
VARIABLE PCOLNULLABLE

HEX
: DESCRIBESQLCOL ( columnnumber -- ) ( -$- columnname )

    DEPTH 1 U< IF NAME>E EXIT THEN

    >R

    0 PCOLNAMELENGTH !
    0 PCOLDATATYPE !
    0 PCOLSIZE !
    0 PCOLDECIMALDIGITS !
    0 PCOLNULLABLE !

    NEW$

    PCOLNULLABLE
    PCOLDECIMALDIGITS
    PCOLSIZE
    PCOLDATATYPE
    PCOLNAMELENGTH
    0               ( calling with no room for name to find column name length )
    0 
    R@
    GETCURRENTHSQLSTMT
    9
    SQLDescribeColW CALLPROC FFFF AND

    ( expecting success or success with info )

    DUP SQL_SUCCESS = OVER SQL_SUCCESS_WITH_INFO = OR 0= IF
      ( an error occurred )
      R> DROP 
      CHECKSQLRETURNFORHSTMTERROR NAME>E
      EXIT
    THEN

    DROP

    PCOLSIZE 0= IF
      ( column has no name )
      R> DROP 
      EXIT
    THEN

    ( column has a name )

    PCOLNAMELENGTH @ 1+ 2* ( unicode maybe w/ null - should be U16@ but this will work in x86 low byte first system )
    $STACKOFFSETBUFFERID $STACKSTRINGBUFFERID GROWL$ ( there is garbage in string after this )

    PCOLNULLABLE
    PCOLDECIMALDIGITS
    PCOLSIZE
    PCOLDATATYPE
    PCOLNAMELENGTH
    0 GETP$ 2/ SWAP 
    R>
    GETCURRENTHSQLSTMT
    9
    SQLDescribeColW CALLPROC

    UNICODE>ASCII$ $>C DROP ( dropping null, might not be one )

    CHECKSQLRETURNFORHSTMTERROR ?ERRORIF NAME>E THEN
;

VARIABLE PRESULTLENGTH
VARIABLE PRESULTUINT32

: GETSQLINTDATA ( colnumber -- resultuint32 )
    DEPTH 1 U< IF 
      DATASTACKUNDERFLOWERROR PUSHOERROR0$
      NAME>E 
      EXIT 
    THEN

    >R

    ( make room for result on result stack - pushing uint32 = 0 onto resultl$stack )
    0 PRESULTLENGTH !
    
    PRESULTLENGTH
    4
    PRESULTUINT32
    SQL_INTEGER ( SQL_NUMERIC? )
    R>
    GETCURRENTHSQLSTMT
    6
    SQLGetData CALLPROC

    CHECKSQLRETURNFORHSTMTERROR    

    PRESULTUINT32 @

    ?ERRORIF NAME>E THEN
;

VARIABLE growlength

: GETSQLCHARDATA ( colnumber -- ) ( -$- result$ )
    DEPTH 1 U< IF 
      DATASTACKUNDERFLOWERROR PUSHOERROR0$
      NAME>E 
      EXIT
    THEN

    >R

    ( make room for result on result stack - pushing empty string onto $stack )
    0 PRESULTLENGTH !
    
    NEW$ ?ERRORIF R> DROP EXIT THEN
    [ HEX ] 40000 GROW$ DROP$ NEW$ ( kluge to prevent odbc from overflowing buffer )

    ( getting data with 0 length to determine length of character string )
    PRESULTLENGTH
    0 GETP$ SWAP
    SQL_BINARY ( SQL_CHAR? )
    R@
    GETCURRENTHSQLSTMT
    6
    SQLGetData CALLPROC FFFF AND

    ( expecting success or success with info )

    DUP SQL_SUCCESS = OVER SQL_SUCCESS_WITH_INFO = OR 0= IF
      ( an error occurred )
      R> DROP 
      CHECKSQLRETURNFORHSTMTERROR
      NAME>E
      EXIT
    THEN

    DROP

    PRESULTLENGTH @ 0= IF
      ( string is empty )
      R> DROP 
      EXIT
    THEN

    PRESULTLENGTH @ -1 = IF
      ( result is null )
      R> DROP
      EXIT
    THEN

    PRESULTLENGTH @ 1+ ( maybe w/ null - should be U16@ but this will work in x86 low byte first system )
    ( might want to limit max size of data fetched here and return 'data too big' instead )

    DUP growlength !

    GROW$ ( there is garbage in string after this )
    ( need to check for out of memory here )
    ?ERRORIF NAME>E R> DROP EXIT THEN

    PRESULTLENGTH    
    0 GETP$ ?ERRORIF 
      NAME>E R> DROP  
      ( ." <p>grow length = " growlength @ HEX U. ." <p> " ) 
      EXIT 
    THEN
    SWAP
    SQL_BINARY ( SQL_CHAR? )
    R>
    GETCURRENTHSQLSTMT
    6
    SQLGetData CALLPROC

    $>C DROP ( getting rid of null )

    CHECKSQLRETURNFORHSTMTERROR

    ?ERRORIF NAME>E THEN
;

: GETSQLDATAANDCOLTYPE ( columnnumber -- uint32 SQL_INTEGER | SQL_BINARY ) ( -$- | result$ )
    DEPTH 1 U< IF
      DATASTACKUNDERFLOWERROR PUSHOERROR0$
      NAME>E
      EXIT
    THEN

    >R
    
    R@ DESCRIBESQLCOL DROP$

    ?ERRORIF 
      R> DROP 
      0 SQL_INTEGER
      NAME>E
      EXIT
    THEN

    PCOLDATATYPE @ ISSQLINTTYPE? IF
      R> GETSQLINTDATA SQL_INTEGER
      ?ERRORIF NAME>E THEN
      EXIT
    THEN

    R> GETSQLCHARDATA SQL_BINARY

    ?ERRORIF NAME>E THEN
;

: GETSQLDATA$ ( columnnumber SQL_INTEGER|SQL_BINARY -- ) ( -$- result$ )
    DEPTH 2 U< IF
      DATASTACKUNDERFLOWERROR PUSHOERROR0$
      NAME>E
      EXIT
    THEN

    ISSQLINTTYPE? IF
      GETSQLINTDATA >NEW$
      ?ERRORIF NAME>E THEN
      EXIT
    THEN

    GETSQLCHARDATA

    ?ERRORIF NAME>E THEN
;

: GETSQLCOLTYPES&NAMES ( -- col1type col2type ... colxtype x ) 
                       ( -$- col1name$ col2name$ ... colxname$ )
    GETNUMSQLRESULTCOLS DUP 0= IF
      EXIT
    THEN

    DUP >R
    1+ 1 DO

      I DESCRIBESQLCOL ?ERRORIF LEAVE THEN

      PCOLDATATYPE @ 

    LOOP
    R>

    ?ERRORIF NAME>E THEN
;

: GETSQLRESULTDATAROW ( colxtype ... col2type col1type x -- ) ( reverse order! )
                      ( -$- col1data$ col2data$ ... colxdata$ )  

    ( check for underflow for x )
    DEPTH 1 U< IF
      DATASTACKUNDERFLOWERROR PUSHOERROR0$
      NAME>E
      EXIT
    THEN

    DUP 0= IF 
      DROP EXIT
    THEN

    ( check for underflow for column types here )

    1+ 1 DO
      
      I SWAP GETSQLDATA$

      ?ERRORIF
        LEAVE
      THEN

    LOOP

    ?ERRORIF NAME>E THEN
;

( Result Set Handle )
( column types for a result set will be stored on an lstring stack of column type structures )
( column names for a result set will be stored on an lstring stack of name strings )
( row data for a result set will be stored on an lstring stack of data strings )

( column type structure will look like this: )
(  offset length type    whatitis )
(  0      4      uint32  y number of rows )
(  4      4      uint32  x number of columns )
(  8      4      uint32  start index of this set's name strings in name string lstring stack )
(                         this is sum of number of columns of all previous result sets )
(  12     4      uint32  start index of this set's data strings in row data result set )
(                         this is sum of {number of rows * number of columns} of all previous result sets )
(  16     4      uint32  column 1's data type of either int or binary )
(  ...    ...    ...     ... )
(  x*4+12 4      uint32  column x's data type of either int or binary ) 

: LATESTRESULTSET ( -- index | -1 )
    SQLCOLTYPEL$STACKOFFSETBUFFERID DEPTHL$ 1- 
;


WORDLIST DUP [>ORDER]CONSTANT [HRESULTSET] >CURRENT 
  SIZED-CONSTANTS< 
    4 ou32rows
    ou32columns
    ou32colname$index
    ou32data$index
    ou32coltypes[]
>
CURRENT> DROP

: GETNUMBEROFCOLUMNSFROMRESULTSET ( resultsetindex0based -- numberofcolumns )
    DEPTH 1 U< IF
      DATASTACKUNDERFLOWERROR PUSHOERROR0$
      NAME>E
      EXIT
    THEN

    DUP SQLCOLTYPEL$STACKOFFSETBUFFERID DEPTHL$ U< IF
      SQLCOLTYPEL$STACKOFFSETBUFFERID
      SQLCOLTYPEL$STACKSTRINGBUFFERID
      GETPL$ DROP
      ( [HRESULTSET] ou32columns [ SEARCH-ORDER> DROP ] DROP ) 4 + U32@
    ELSE
      DROP 0
    THEN
;

: GETNUMBEROFROWSFROMRESULTSET ( resultsetindex0based -- numberofrows )
    
    DEPTH 1 U< IF
      DATASTACKUNDERFLOWERROR PUSHOERROR0$
      NAME>E
      EXIT
    THEN

    DUP SQLCOLTYPEL$STACKOFFSETBUFFERID DEPTHL$ U< IF
      SQLCOLTYPEL$STACKOFFSETBUFFERID
      SQLCOLTYPEL$STACKSTRINGBUFFERID
      GETPL$ DROP
      ( [HRESULTSET] ou32rows [ SEARCH-ORDER> DROP ] DROP ) ( 0 + ) U32@
    ELSE
      DROP 0
    THEN
;

VARIABLE PPCOLDATASTRUCT
VARIABLE PNUMROWS
VARIABLE PNUMCOLS
VARIABLE PCOLX
VARIABLE PROWY

DECIMAL
: NEWRESULTSET ( col1type col2type ... colxtype x -- ) ( column type is either SQL_INTEGER or SQL_BINARY )
               ( col1name$ col2name$ ... colxname$ -$- ) 
               ( -columntypesl$- newcoltypes ) ( rows = 0 )
               ( -columnnamesl$- col1name$ col2name$ ... colxname$ )

    ( check for x on data stack )
    DEPTH 1 U< IF
      DATASTACKUNDERFLOWERROR PUSHOERROR0$
      NAME>E
      EXIT
    THEN
    
    SQLCOLTYPEL$STACKOFFSETBUFFERID
    SQLCOLTYPEL$STACKSTRINGBUFFERID
    NEWL$

    DUP 2* 2* 16 +
    SQLCOLTYPEL$STACKOFFSETBUFFERID
    SQLCOLTYPEL$STACKSTRINGBUFFERID
    GROWL$ 

    LATESTRESULTSET 
    SQLCOLTYPEL$STACKOFFSETBUFFERID
    SQLCOLTYPEL$STACKSTRINGBUFFERID
    GETPL$ DROP PPCOLDATASTRUCT ! ( pointer valid until next time something pushed to coltypel$ stack )

    0 PPCOLDATASTRUCT @ ( 0 + ) U32!   ( number of rows )
    ( x ) PPCOLDATASTRUCT @ 4 + U32!  ( number of columns )
    SQLCOLNAMEL$STACKOFFSETBUFFERID DEPTHL$ PPCOLDATASTRUCT @ 8 + U32!  ( start index in column name l$ stack )
    SQLRESULTL$STACKOFFSETBUFFERID  DEPTHL$ PPCOLDATASTRUCT @ 12 + U32! ( start index in result data l$ stack )
    
    PPCOLDATASTRUCT @ 4 + U32@ 0= IF
      R> DROP
      EXIT
    THEN

    ( check depth of data stack and string stack, if not deep enough set #cols to 0 and exit )

    ( put column types into structure and names onto namel$ stack )
    PPCOLDATASTRUCT @ 4 + U32@ 0 DO

      ?ERRORIF
        R> DROP
        UNLOOP NAME>E
        EXIT
      THEN
      
      ( column type - need to reverse them )
      PPCOLDATASTRUCT @ 4 + U32@ 1- I - PICK
      PPCOLDATASTRUCT @ I 2* 2* + 16 + U32!
      
      ( column name - need to reverse them )
      PPCOLDATASTRUCT @ 4 + U32@ 1- I - GETP$
      SQLCOLNAMEL$STACKOFFSETBUFFERID
      SQLCOLNAMEL$STACKSTRINGBUFFERID
      S>NEWL$       
      
    LOOP

    PPCOLDATASTRUCT @ 4 + U32@ 0 DO
      DROP
      DROP$
    LOOP    
;

DECIMAL
: GETCOLUMNTYPESFROMRESULTSET ( -- colxtype ... col2type col1type x )

    LATESTRESULTSET DUP -1 = IF
      DROP 0 EXIT
    THEN

    GETNUMBEROFCOLUMNSFROMRESULTSET DUP 0= IF
      EXIT
    THEN

    DUP PNUMCOLS !

    LATESTRESULTSET 
    SQLCOLTYPEL$STACKOFFSETBUFFERID
    SQLCOLTYPEL$STACKSTRINGBUFFERID
    GETPL$ DROP PPCOLDATASTRUCT ! ( pointer valid until next time something pushed to coltypel$stack )

    0 DO 
    
      PPCOLDATASTRUCT @ 
      PNUMCOLS @ 1- I - 2* 2* +
      16 + 
      U32@ CHANGESQLCOLTYPETOINTORBIN
      
    LOOP

    PNUMCOLS @
;

DECIMAL
: ADDDATAROWTORESULTSET ( -- )  ( have to assume latest result set )
                           ( col1$ col2$ ... colx$ -$- )
                           ( coltypes -coltypesl$- coltypes' ) ( number of rows increased by 1 )
                           ( -resultsetl$- col1$ col2$ ... colx$ )
    LATESTRESULTSET DUP -1 = IF 
      DROP EXIT 
    THEN

    GETNUMBEROFCOLUMNSFROMRESULTSET DUP 0= IF
      DROP EXIT
    THEN

    ( check depth of string stack to make sure there is enough strings )
    DUP DEPTH$ SWAP U< IF
      STRINGSTACKUNDERFLOWERROR PUSHOERROR0$ NAME>E 
      DROP EXIT
    THEN

    PNUMCOLS !

    ( push copy of result row data$s to result l$ stack )
    PNUMCOLS @ 0 DO
      PNUMCOLS @ 1- I - GETP$
      SQLRESULTL$STACKOFFSETBUFFERID
      SQLRESULTL$STACKSTRINGBUFFERID
      S>NEWL$
    LOOP

    ( drop $s )
    PNUMCOLS @ 0 DO
      DROP$
    LOOP

    ( increment number of rows )
    LATESTRESULTSET 
    SQLCOLTYPEL$STACKOFFSETBUFFERID
    SQLCOLTYPEL$STACKSTRINGBUFFERID
    GETPL$ DROP

    DUP U32@ 1+ SWAP U32!
;

: GETALLDATAROWSTORESULTSET ( -- )

    BEGIN

      FETCHNEXTSQLROW ?ERRORIF NAME>E EXIT THEN

    WHILE

      GETCOLUMNTYPESFROMRESULTSET ?ERRORIF NAME>E EXIT THEN

      GETSQLRESULTDATAROW ?ERRORIF NAME>E EXIT THEN

      ADDDATAROWTORESULTSET ?ERRORIF NAME>E EXIT THEN

    REPEAT
;

HEX
( this should return the result set id or -1 if failure )
: GETRESULTSET ( select$ server$ user$ password$ database$ -$- ) 
               ( -coltypel$- coltypes )
               ( -colnamel$- col1name$ col2name$ ... colxname$ )
               ( -resultdatal$- row1col1data$ row1col2data$ ... rowycolxdata$ )

    ( need to add close and free handles on errors )

    DEPTH$ 5 U< IF STRINGSTACKUNDERFLOWERROR PUSHOERROR0$ NAME>E EXIT THEN

    ALLOCATEHSQLCONN ?ERRORIF NAME>E DROP$ DROP$ DROP$ DROP$ DROP$ EXIT THEN
   
    0 SETHSQLCONNTIMEOUT ?ERRORIF NAME>E DROP$ DROP$ DROP$ DROP$ FREEHSQLCONN EXIT THEN

    DUP$ SETHSQLCONNDATABASE ?ERRORIF NAME>E DROP$ DROP$ DROP$ DROP$ FREEHSQLCONN EXIT THEN
    3 ROLL$  3 ROLL$  3 ROLL$

    CONNECTSQL ?ERRORIF NAME>E DROP$ FREEHSQLCONN EXIT THEN

    ALLOCATEHSQLSTMT ?ERRORIF NAME>E DROP$ DISCONNECTSQL FREEHSQLCONN EXIT THEN

    ( DUP$ SETHSQLCONNDATABASE ?ERRORIF NAME>E DROP$ FREEHSQLSTMT DISCONNECTSQL FREEHSQLCONN EXIT THEN )

    USEHSQLCONNDATABASE$ ?ERRORIF NAME>E DROP$ FREEHSQLSTMT DISCONNECTSQL FREEHSQLCONN EXIT THEN

    DOSQLSTATEMENT$ ?ERRORIF NAME>E FREEHSQLSTMT DISCONNECTSQL FREEHSQLCONN EXIT THEN

    GETSQLCOLTYPES&NAMES ?ERRORIF NAME>E ( 0 should be on stack ) FREEHSQLSTMT DISCONNECTSQL FREEHSQLCONN DROP EXIT THEN

    NEWRESULTSET ?ERRORIF NAME>E FREEHSQLSTMT DISCONNECTSQL FREEHSQLCONN EXIT THEN

    GETALLDATAROWSTORESULTSET

    FREEHSQLSTMT

    DISCONNECTSQL 

    FREEHSQLCONN ?ERRORIF NAME>E THEN
;

HEX
: CONNECTSQLANDDOSTATEMENT$ ( select$ server$ user$ password$ database$ -$- )

    DEPTH$ 5 U< IF STRINGSTACKUNDERFLOWERROR PUSHOERROR0$ NAME>E EXIT THEN

    ALLOCATEHSQLCONN ?ERRORIF DROP$ DROP$ DROP$ DROP$ DROP$ NAME>E EXIT THEN

    0 SETHSQLCONNTIMEOUT ?ERRORIF DROP$ DROP$ DROP$ DROP$ FREEHSQLCONN NAME>E EXIT THEN

    DUP$ SETHSQLCONNDATABASE ?ERRORIF DROP$ DROP$ DROP$ DROP$ FREEHSQLCONN NAME>E EXIT THEN
    3 ROLL$  3 ROLL$  3 ROLL$

    CONNECTSQL ?ERRORIF DROP$ FREEHSQLCONN NAME>E EXIT THEN

    ALLOCATEHSQLSTMT ?ERRORIF DROP$ DISCONNECTSQL FREEHSQLCONN NAME>E EXIT THEN

    ( DUP$ SETHSQLCONNDATABASE ?ERRORIF DROP$ FREEHSQLSTMT DISCONNECTSQL FREEHSQLCONN NAME>E EXIT THEN )

    USEHSQLCONNDATABASE$ ?ERRORIF DROP$ FREEHSQLSTMT DISCONNECTSQL FREEHSQLCONN NAME>E EXIT THEN

    DOSQLSTATEMENT$ 

    FREEHSQLSTMT

    DISCONNECTSQL

    FREEHSQLCONN   

    ?ERRORIF NAME>E THEN
;

