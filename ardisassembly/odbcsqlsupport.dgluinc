( SQL state error messages for diagnostic functions. )
( Making separate wordlist for looking up 5 character state strings. )

WORDLIST DUP CONSTANT SQLSTATE-WORDLIST SET-CURRENT

CREATEOC 00000 $" SQL Success"                                $>0$ PCURRENTCOMPILEBUFFER @ $>BUF
CREATEOC 01000 $" SQL General warning. If trying to connect, check internet connection, server name, and server status."
                                                              $>0$ PCURRENTCOMPILEBUFFER @ $>BUF
CREATEOC 01001 $" SQL Cursor operation conflict"              $>0$ PCURRENTCOMPILEBUFFER @ $>BUF
CREATEOC 01002 $" SQL Disconnect error"                       $>0$ PCURRENTCOMPILEBUFFER @ $>BUF
CREATEOC 01003 $" SQL Null value eliminated in set function"  $>0$ PCURRENTCOMPILEBUFFER @ $>BUF
CREATEOC 01004 $" SQL String data, right truncated"           $>0$ PCURRENTCOMPILEBUFFER @ $>BUF
CREATEOC 01006 $" SQL Privelege not revoked"                  $>0$ PCURRENTCOMPILEBUFFER @ $>BUF
CREATEOC 01007 $" SQL Privelege not granted"                  $>0$ PCURRENTCOMPILEBUFFER @ $>BUF
CREATEOC 01S00 $" SQL Invalid connection string attribute"    $>0$ PCURRENTCOMPILEBUFFER @ $>BUF
CREATEOC 01S01 $" SQL Error in row"                           $>0$ PCURRENTCOMPILEBUFFER @ $>BUF
CREATEOC 01S02 $" SQL Option value changed"                   $>0$ PCURRENTCOMPILEBUFFER @ $>BUF
CREATEOC 01S06 $" SQL Attempt to fetch before the result set returned the first row set"  
                                                              $>0$ PCURRENTCOMPILEBUFFER @ $>BUF
CREATEOC 01S07 $" SQL Fractional truncation"                  $>0$ PCURRENTCOMPILEBUFFER @ $>BUF
CREATEOC 01S08 $" SQL Error saving file DSN"                  $>0$ PCURRENTCOMPILEBUFFER @ $>BUF
CREATEOC 01S09 $" SQL Invalid keyword"                        $>0$ PCURRENTCOMPILEBUFFER @ $>BUF
CREATEOC 07001 $" SQL Wrong number of parameters"             $>0$ PCURRENTCOMPILEBUFFER @ $>BUF
CREATEOC 07002 $" SQL Count field incorrect"                  $>0$ PCURRENTCOMPILEBUFFER @ $>BUF
CREATEOC 07005 $" SQL Prepared statement not a cursor specification"
                                                              $>0$ PCURRENTCOMPILEBUFFER @ $>BUF
CREATEOC 07006 $" SQL Restricted data type attribute violation"
                                                              $>0$ PCURRENTCOMPILEBUFFER @ $>BUF
CREATEOC 07009 $" SQL Invalid descriptor index"               $>0$ PCURRENTCOMPILEBUFFER @ $>BUF
CREATEOC 07S01 $" SQL Invalid use of default parameter"       $>0$ PCURRENTCOMPILEBUFFER @ $>BUF
CREATEOC 08001 $" SQL Client unable to establish connection"  $>0$ PCURRENTCOMPILEBUFFER @ $>BUF
CREATEOC 08002 $" SQL Connection name in use"                 $>0$ PCURRENTCOMPILEBUFFER @ $>BUF
CREATEOC 08003 $" SQL Connection does not exist"              $>0$ PCURRENTCOMPILEBUFFER @ $>BUF
CREATEOC 08004 $" SQL Server rejected the connection"         $>0$ PCURRENTCOMPILEBUFFER @ $>BUF
CREATEOC 08007 $" SQL Connection failure during transaction"  $>0$ PCURRENTCOMPILEBUFFER @ $>BUF
CREATEOC 08S01 $" SQL Communication link failure"             $>0$ PCURRENTCOMPILEBUFFER @ $>BUF
CREATEOC 21S01 $" SQL Insert value does not match column list"
                                                              $>0$ PCURRENTCOMPILEBUFFER @ $>BUF
CREATEOC 21S02 $" SQL Degree of derived table does not match column list"
                                                              $>0$ PCURRENTCOMPILEBUFFER @ $>BUF
CREATEOC 22001 $" SQL String data right truncated"            $>0$ PCURRENTCOMPILEBUFFER @ $>BUF
CREATEOC 22002 $" SQL Indicator variable required but not supplied"
                                                              $>0$ PCURRENTCOMPILEBUFFER @ $>BUF
CREATEOC 22003 $" SQL Numeric value out of range"             $>0$ PCURRENTCOMPILEBUFFER @ $>BUF
CREATEOC 22007 $" SQL Invalid datatime format"                $>0$ PCURRENTCOMPILEBUFFER @ $>BUF
CREATEOC 22008 $" SQL Datetime field overflow"                $>0$ PCURRENTCOMPILEBUFFER @ $>BUF
CREATEOC 22012 $" SQL Division by zero"                       $>0$ PCURRENTCOMPILEBUFFER @ $>BUF
CREATEOC 22015 $" SQL Interval field overflow"                $>0$ PCURRENTCOMPILEBUFFER @ $>BUF
CREATEOC 22018 $" SQL Invalid character value for cast specification"
                                                              $>0$ PCURRENTCOMPILEBUFFER @ $>BUF
CREATEOC 22019 $" SQL Invalid escape character"               $>0$ PCURRENTCOMPILEBUFFER @ $>BUF
CREATEOC 22025 $" SQL Invalid escape sequence"                $>0$ PCURRENTCOMPILEBUFFER @ $>BUF
CREATEOC 22026 $" SQL String data, length mismatch"           $>0$ PCURRENTCOMPILEBUFFER @ $>BUF
CREATEOC 23000 $" SQL Integrity constraint violation"         $>0$ PCURRENTCOMPILEBUFFER @ $>BUF
CREATEOC 24000 $" SQL Invalid cursor state"                   $>0$ PCURRENTCOMPILEBUFFER @ $>BUF
CREATEOC 25000 $" SQL Invalid transation state"               $>0$ PCURRENTCOMPILEBUFFER @ $>BUF
CREATEOC 25S01 $" SQL Transaction state"                      $>0$ PCURRENTCOMPILEBUFFER @ $>BUF
CREATEOC 25S02 $" SQL Transaction is still active"            $>0$ PCURRENTCOMPILEBUFFER @ $>BUF
CREATEOC 25S03 $" SQL Transaction is rolled back"             $>0$ PCURRENTCOMPILEBUFFER @ $>BUF
CREATEOC 28000 $" SQL Invalid authorization specification"    $>0$ PCURRENTCOMPILEBUFFER @ $>BUF
