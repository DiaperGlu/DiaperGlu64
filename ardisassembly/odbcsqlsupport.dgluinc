
( Version 1.3 )
( Last modified: August 13, 2008 )

( Jim Norris )
( dglu@rainbarrel.com )

( This file supports MYSQL through the odbc dll )

( Compile guard, don't include this file if it is already included. )
(  assumes wordlists containing compile guard words are in search order )

' odbcsqlsupport.dgluinc ENDOFWORDLIST = 0= ?END-EVALUATE

0 CONSTANT odbcsqlsupport.dgluinc


// Packed L$ 32bit header format
//   +0 size of this header in bytes
//   +4 magic
//   +8 size of L$ offset array in bytes

// WORDLIST DUP [>ORDER]CONSTANT [PACK32H] >CURRENT 
//  SIZED-CONSTANTS< 
//    4 hsize
//    magic
//    offsetsize
//  >
//  CURRENT> DROP

// Packed L$ 32bit format
// +0 Packed L$ 32bit header
// +0C L$ offset array using 32bit offset
// +0C + [+8] L$ string data

: insertvalueint$ok? ( value$ -$- value$ ) ( -- flag )

    DEPTH$ 1 U< IF
      FALSE EXIT
    THEN

    LENGTH$ 0= IF
      FALSE EXIT
    THEN

    0 [CHAR] ) CSCAN$ -1 = 0= IF
      FALSE EXIT
    THEN

    0 [CHAR] ; CSCAN$ -1 = 0= IF
      FALSE EXIT
    THEN

    0 [CHAR] | CSCAN$ -1 = 0= IF
      FALSE EXIT
    THEN

    0 [CHAR] % CSCAN$ -1 = 0= IF
      FALSE EXIT
    THEN

    0 [CHAR] \ CSCAN$ -1 = 0= IF
      FALSE EXIT
    THEN

    0 [CHAR] , CSCAN$ -1 = 0= IF
      FALSE EXIT
    THEN

    0 [CHAR] ' CSCAN$ -1 = 0= IF
      FALSE EXIT
    THEN

    0 BL CSCAN$ -1 = 0= IF
      FALSE EXIT
    THEN

    TRUE
;

: insertvalue$ok? ( value$ -$- value$ ) ( -- flag )

    DEPTH$ 1 U< IF
      FALSE EXIT
    THEN

    LENGTH$ 0= IF
      FALSE EXIT
    THEN

    0 [CHAR] ) CSCAN$ -1 = 0= IF
      FALSE EXIT
    THEN

    0 [CHAR] ; CSCAN$ -1 = 0= IF
      FALSE EXIT
    THEN

    0 [CHAR] | CSCAN$ -1 = 0= IF
      FALSE EXIT
    THEN

    0 [CHAR] % CSCAN$ -1 = 0= IF
      FALSE EXIT
    THEN

    0 [CHAR] \ CSCAN$ -1 = 0= IF
      FALSE EXIT
    THEN

    0 [CHAR] , CSCAN$ -1 = 0= IF
      FALSE EXIT
    THEN

    0 BL CSCAN$ -1 = 0= IF
      FALSE EXIT
    THEN

    TRUE
;

: O32@ ( o b -- U32 ) O>P U32@ ;
: O32! ( U32 o b -- ) O>P U32! ;

: U32>BUF { oldlength | u32 destbuf -- }
    destbuf LENGTHBUF TO oldlength
    4 destbuf GROWBUFFER
    u32 oldlength destbuf O>P U32! 
;

: BUF>U32 { | srcbuf -- }
    srcbuf LENGTHBUF 4 U< IF
      UNDERFLOWERROR >E
      NAME>E EXIT 
    THEN
    srcbuf LENGTHBUF 4 - 
    srcbuf
    O>P U32@
    4 srcbuf SHRINKBUFFER
;

: SU32[]>BUFU64[] { | psrc srclength destbuf -- }
    srclength 2/ 2/ 0= IF
      DROP EXIT
    THEN
    srclength 2/ 2/ 0 DO
      I 2* 2* psrc + U32@
      destbuf >BUF
    LOOP
;

: BUF64[]>BUF32[] { | srcbuf destbuf -- }
    srcbuf LENGTHBUF 2/ 2/ 2/ 
    DUP 0= IF
      DROP EXIT
    THEN
    0 DO
      I 2* 2* 2* srcbuf O>P U64@
      destbuf U32>BUF
    LOOP
;

: BUF>NEWL$ 
    ( srcbufferid l$offsetbufferid l$stringbufferid -- )
    ( -l$- copyofbuffer )
    ( whatever -src- whatever )

    DEPTH 3 U< IF
      DATASTACKUNDERFLOWERROR PUSHOERROR0$
      EXIT
    THEN

    >R >R
    GETPBUFFER @ ( pbuf length )
    R> R>

    ?ERRORIF
      DROP DROP DROP DROP
      EXIT
    THEN

    S>NEWL$
;

: L$>BUF 
    ( l$offsetbufferid l$stringbufferid destbufferid -- )
    ( topl$ -l$- )
    ( whatever -dest- whatever&topl$ )

    DEPTH 3 U< IF
      DATASTACKUNDERFLOWERROR PUSHOERROR0$
      ( push name to error here )
      EXIT
    THEN

    >R
    OVER DEPTHL$ 
    DUP 0= IF
      LSTRINGSTACKUNDERFLOWERROR PUSHOERROR0$
      ( push name to error here )
      R> DROP DROP DROP DROP
      EXIT
    THEN

    1- ( index of top l$ on l$stack )
    2 PICK 2 PICK 
    GETPL$
    ?ERRORIF
      R> DROP DROP DROP
      ( push name to error here )
      EXIT
    THEN

    ( l$offset l$string pl$ l$length -- )
    R> S>BUF
    ?ERRORIF
      ( push name to error here )
      EXIT
    THEN

    DROPL$

    ?ERRORIF
      ( push name to error here )
      EXIT
    THEN
;

: L$U32[]>BUFU64[]
    ( l$offsetbufferid l$stringbufferid destbufferid -- )
    ( topl$ -l$- )
    ( whatever -dest- whatever&topl$ )

    DEPTH 3 U< IF
      DATASTACKUNDERFLOWERROR PUSHOERROR0$
      ( push name to error here )
      EXIT
    THEN

    >R
    OVER DEPTHL$ 
    DUP 0= IF
      LSTRINGSTACKUNDERFLOWERROR PUSHOERROR0$
      ( push name to error here )
      R> DROP DROP DROP DROP
      EXIT
    THEN

    1- ( index of top l$ on l$stack )
    2 PICK 2 PICK 
    GETPL$
    ?ERRORIF
      R> DROP DROP DROP
      ( push name to error here )
      EXIT
    THEN

    ( l$offset l$string pl$ l$length -- )
    R> SU32[]>BUFU64[]
    ?ERRORIF
      ( push name to error here )
      EXIT
    THEN

    DROPL$

    ?ERRORIF
      ( push name to error here )
      EXIT
    THEN
;

( load sql odbc dll )
$" odbc32.dll" OPENLIBRARY$ CONSTANT ODBC32-HANDLE CONSTANT ODBC32-WORDLIST
 

ODBC32-HANDLE $" SQLGetDiagFieldW" FINDLIBRARYSYMBOL CONSTANT SQLGetDiagFieldW
ODBC32-HANDLE $" SQLAllocHandle" FINDLIBRARYSYMBOL CONSTANT SQLAllocHandle
ODBC32-HANDLE $" SQLFreeHandle" FINDLIBRARYSYMBOL CONSTANT SQLFreeHandle
ODBC32-HANDLE $" SQLSetEnvAttr" FINDLIBRARYSYMBOL CONSTANT SQLSetEnvAttr
ODBC32-HANDLE $" SQLDisconnect" FINDLIBRARYSYMBOL CONSTANT SQLDisconnect
ODBC32-HANDLE $" SQLSetConnectAttrW" FINDLIBRARYSYMBOL CONSTANT SQLSetConnectAttrW
ODBC32-HANDLE $" SQLConnectW" FINDLIBRARYSYMBOL CONSTANT SQLConnectW
ODBC32-HANDLE $" SQLGetInfoA" FINDLIBRARYSYMBOL CONSTANT SQLGetInfoA
ODBC32-HANDLE $" SQLExecDirectW" FINDLIBRARYSYMBOL CONSTANT SQLExecDirectW
ODBC32-HANDLE $" SQLExecute" FINDLIBRARYSYMBOL CONSTANT SQLExecute
ODBC32-HANDLE $" SQLPrepareA" FINDLIBRARYSYMBOL CONSTANT SQLPrepareA
ODBC32-HANDLE $" SQLBindParameter" FINDLIBRARYSYMBOL CONSTANT SQLBindParameter
ODBC32-HANDLE $" SQLNumResultCols" FINDLIBRARYSYMBOL CONSTANT SQLNumResultCols
ODBC32-HANDLE $" SQLGetData" FINDLIBRARYSYMBOL CONSTANT SQLGetData
ODBC32-HANDLE $" SQLFetch" FINDLIBRARYSYMBOL CONSTANT SQLFetch
ODBC32-HANDLE $" SQLDescribeColW" FINDLIBRARYSYMBOL CONSTANT SQLDescribeColW


( Add SQLSRV32-WORDLIST to the search order )
ODBC32-WORDLIST SEARCHORDERSTACKBUFFERID >BUF


( Make hlist for cgi post and get variables )
(  Using a wordlist has the moving buffer crash problem if the word that makes
     the post get variable words makes them to the same buffer so using an hlist instead )
NEW-HLIST CONSTANT POSTGET-HLIST
NEW$ $" root" ENDOFLIST POSTGET-HLIST NEW-ELEMENT CONSTANT POSTGET-HLIST-ROOT-ELEMENT ( is 0 )


HEX
1000 7FFF0000 NEWBUFFER CONSTANT myvarbuf
myvarbuf PCURRENTNEWVARIABLEBUFFER !

1000 7FFF0000 NEWBUFFER CONSTANT mycplbuf
mycplbuf PCURRENTCOMPILEBUFFER !


( Save the value for the old wordlist where new definitions were added. )
(  Can do >R in interpret mode in this forth because r-stack does not )
(  use processor's return stack. )

GET-CURRENT >R


( Add new definitions to the end of the SQLSRV32-WORDLIST )

ODBC32-WORDLIST SET-CURRENT



( SQL driver #defines )


(  return values from functions )

DECIMAL
0 CONSTANT SQL_SUCCESS
1 CONSTANT SQL_SUCCESS_WITH_INFO
100 CONSTANT SQL_NO_DATA

HEX
FFFF CONSTANT SQL_ERROR          ( really a UINT16 -1 )
FFFE CONSTANT SQL_INVALID_HANDLE ( really a UINT16 -2 )

DECIMAL
2 CONSTANT SQL_STILL_EXECUTING
99 CONSTANT SQL_NEED_DATA


(  flags for null-terminated string )

HEX
FFFD CONSTANT SQL_NTS
-3 CONSTANT SQL_NTSL   


(  maximum message length )

DECIMAL 
512 CONSTANT SQL_MAX_MESSAGE_LENGTH


(  date/time length constants )

DECIMAL
10 CONSTANT SQL_DATE_LEN
8 CONSTANT SQL_TIME_LEN        ( add P+1 if precision is nonzero )
19 CONSTANT SQL_TIMESTAMP_LEN  ( add P+1 if precision is nonzero )


