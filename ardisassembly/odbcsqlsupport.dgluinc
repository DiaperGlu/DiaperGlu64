HEX
: CONNECTSQLBINDBUFFERSANDDOINSERT$ 
    ( insert$ server$ user$ password$ database$ -$- )
    ( buffern paramn1 ... buffer2 paramn2 n -- )

    DEPTH$ 5 U< IF STRINGSTACKUNDERFLOWERROR PUSHOERROR0$ NAME>E EXIT THEN

    DEPTH 0= IF DATASTACKUNDERFLOWERROR PUSHOERROR0$ NAME>E EXIT THEN

    DUP DEPTH 1- U< 0= IF DATASTACKUNDERFLOWERROR PUSHOERROR0$ NAME>E EXIT THEN

    ALLOCATEHSQLCONN ?ERRORIF DROP$ DROP$ DROP$ DROP$ DROP$ NAME>E EXIT THEN

    0 SETHSQLCONNTIMEOUT ?ERRORIF DROP$ DROP$ DROP$ DROP$ FREEHSQLCONN NAME>E EXIT THEN

    DUP$ SETHSQLCONNDATABASE ?ERRORIF DROP$ DROP$ DROP$ DROP$ FREEHSQLCONN NAME>E EXIT THEN
    3 ROLL$  3 ROLL$  3 ROLL$

    CONNECTSQL ?ERRORIF DROP$ FREEHSQLCONN NAME>E EXIT THEN

    ALLOCATEHSQLSTMT ?ERRORIF DROP$ DISCONNECTSQL FREEHSQLCONN NAME>E EXIT THEN

    ( DUP$ SETHSQLCONNDATABASE ?ERRORIF DROP$ FREEHSQLSTMT DISCONNECTSQL FREEHSQLCONN NAME>E EXIT THEN )

    USEHSQLCONNDATABASE$ ?ERRORIF DROP$ FREEHSQLSTMT DISCONNECTSQL FREEHSQLCONN NAME>E EXIT THEN

    PREPARESQLSTATEMENT$ ?ERRORIF DROP$ FREEHSQLSTMT DISCONNECTSQL FREEHSQLCONN NAME>E EXIT THEN

    BINDBINARYBUFFERSFORSQLINSERT ?ERRORIF DROP$ FREEHSQLSTMT DISCONNECTSQL FREEHSQLCONN NAME>E EXIT THEN

    DROP$ DOSQLSTATEMENT 

    FREEHSQLSTMT

    DISCONNECTSQL

    FREEHSQLCONN

    ?ERRORIF NAME>E THEN 
;


DECIMAL
: GETCOLUMNNAME$FROMRESULTSET ( columnindex1based resultsetindex0based -- ) ( -$- columnname$ )

    ( check data stack depth )
    DEPTH 2 U< IF
      DATASTACKUNDERFLOWERROR PUSHOERROR0$
      NEW$ NAME>E EXIT
    THEN
 
    ( get pointer to column type structure )
    SQLCOLTYPEL$STACKOFFSETBUFFERID
    SQLCOLTYPEL$STACKSTRINGBUFFERID
    GETPL$ DROP PPCOLDATASTRUCT !

    ( check column index range )
    ( column index is 1 based and can not be 0 )
    DUP 0= IF
      DROP NEW$ EXIT
    THEN

    1- DUP PCOLX ! 

    ( get number of columns )
    PPCOLDATASTRUCT @ 4 + U32@ 

    ( see if columnindex is too big to be in in result set )
    U< 0= IF
      NEW$ 
      EXIT
    THEN

    ( get namel$stack start index or this result sets name$s )    
    PPCOLDATASTRUCT @ 8 + U32@

    ( get index of column's name$ in namel$stack )
    PCOLX @ +

    ( get pointer to and length of column's name$ in namel$stack )
    SQLCOLNAMEL$STACKOFFSETBUFFERID
    SQLCOLNAMEL$STACKSTRINGBUFFERID
    GETPL$

    ( move name$ to string stack )
    S>NEW$
;

DECIMAL
: GETTRUECOLUMNTYPEFROMRESULTSET ( columnindex1based resultsetindex0based -- coltype )

    ( check data stack depth )
    DEPTH 2 U< IF
      DATASTACKUNDERFLOWERROR PUSHOERROR0$ 
      NEW$ NAME>E EXIT
    THEN
 
    ( get pointer to structure )
    SQLCOLTYPEL$STACKOFFSETBUFFERID
    SQLCOLTYPEL$STACKSTRINGBUFFERID
    GETPL$ DROP PPCOLDATASTRUCT !

    ( check column index range )
    ( column index is 1 based and can not be 0 )
    DUP 0= IF
      DROP SQL_BINARY ( 0 ? ) EXIT
    THEN

    1- DUP PCOLX ! 

    ( get number of columns )
    PPCOLDATASTRUCT @ 4 + U32@ 

    ( see if columnindex is too big to be in in result set )
    U< 0= IF
      SQL_BINARY ( 0 ? ) 
      EXIT
    THEN

    ( get column type )
    PPCOLDATASTRUCT @ 16 + PCOLX @ 2* 2* + U32@    
;

: GETCOLUMNTYPEFROMRESULTSET ( columnindex1based resultsetindex0based -- SQL_INTEGER|SQL|BINARY )
    GETTRUECOLUMNTYPEFROMRESULTSET
    CHANGESQLCOLTYPETOINTORBIN
;

DECIMAL
: GETDATA$INDEXFROMRESULTSET ( columnXindex1based rowYindex1based resultsetindex0based -- l$index )
    ( check data stack depth )
    DEPTH 3 U< IF
      DATASTACKUNDERFLOWERROR PUSHOERROR0$
      NEW$ NAME>E EXIT
    THEN
 
    ( get pointer to column type structure )
    SQLCOLTYPEL$STACKOFFSETBUFFERID
    SQLCOLTYPEL$STACKSTRINGBUFFERID
    GETPL$ DROP PPCOLDATASTRUCT !


    ( row index is 1 based and can not be 0 )
    DUP 0= IF
      NEW$ DROP DROP EXIT
    THEN

    1- DUP PROWY !
  
    ( get number of rows )
    PPCOLDATASTRUCT @ ( 0 + ) U32@

    ( see if row index is too big to be in result set )
    U< 0= IF
      DROP NEW$
      EXIT
    THEN


    ( column index is 1 based and can not be 0 )
    DUP 0= IF
      NEW$ DROP EXIT
    THEN

    1- DUP PCOLX ! 

    ( get number of columns )
    PPCOLDATASTRUCT @ 4 + U32@ DUP PNUMCOLS !

    ( see if column index is too big to be in result set )
    U< 0= IF
      NEW$ 
      EXIT
    THEN


    ( get datal$stack start index of this result set's data$s )    
    PPCOLDATASTRUCT @ 12 + U32@

    ( get index of row & column's data$ in datal$stack )
    PROWY @ PNUMCOLS @ * PCOLX @ + +
;

DECIMAL
: GETSDATA$FROMRESULTSET ( columnXindex1based rowYindex1based resultsetindex0based -- pdata$ data$length )
    ( check data stack depth )
    DEPTH 3 U< IF
      DATASTACKUNDERFLOWERROR PUSHOERROR0$
      NEW$ NAME>E EXIT
    THEN
 
    ( get pointer to column type structure )
    SQLCOLTYPEL$STACKOFFSETBUFFERID
    SQLCOLTYPEL$STACKSTRINGBUFFERID
    GETPL$ DROP PPCOLDATASTRUCT !


    ( row index is 1 based and can not be 0 )
    DUP 0= IF
      NEW$ DROP DROP EXIT
    THEN

    1- DUP PROWY !
  
    ( get number of rows )
    PPCOLDATASTRUCT @ ( 0 + ) U32@

    ( see if row index is too big to be in result set )
    U< 0= IF
      DROP NEW$
      EXIT
    THEN


    ( column index is 1 based and can not be 0 )
    DUP 0= IF
      NEW$ DROP EXIT
    THEN

    1- DUP PCOLX ! 

    ( get number of columns )
    PPCOLDATASTRUCT @ 4 + U32@ DUP PNUMCOLS !

    ( see if column index is too big to be in result set )
    U< 0= IF
      NEW$ 
      EXIT
    THEN


    ( get datal$stack start index of this result set's data$s )    
    PPCOLDATASTRUCT @ 12 + U32@

    ( get index of row & column's data$ in datal$stack )
    PROWY @ PNUMCOLS @ * PCOLX @ + +

    ( get pointer to and length of row and column's data$ in datal$stack )
    SQLRESULTL$STACKOFFSETBUFFERID
    SQLRESULTL$STACKSTRINGBUFFERID
    GETPL$
;

DECIMAL
: GETDATA$FROMRESULTSET ( columnXindex1based rowYindex1based resultsetindex0based -- )
                        ( -$- data$ )
    ( check data stack depth )
    DEPTH 3 U< IF
      DATASTACKUNDERFLOWERROR PUSHOERROR0$
      NEW$ NAME>E EXIT
    THEN
 
    ( get pointer to column type structure )
    SQLCOLTYPEL$STACKOFFSETBUFFERID
    SQLCOLTYPEL$STACKSTRINGBUFFERID
    GETPL$ DROP PPCOLDATASTRUCT !


    ( row index is 1 based and can not be 0 )
    DUP 0= IF
      NEW$ DROP DROP EXIT
    THEN

    1- DUP PROWY !
  
    ( get number of rows )
    PPCOLDATASTRUCT @ ( 0 + ) U32@

    ( see if row index is too big to be in result set )
    U< 0= IF
      DROP NEW$
      EXIT
    THEN


    ( column index is 1 based and can not be 0 )
    DUP 0= IF
      NEW$ DROP EXIT
    THEN

    1- DUP PCOLX ! 

    ( get number of columns )
    PPCOLDATASTRUCT @ 4 + U32@ ?ERRORIF NAME>E EXIT THEN DUP PNUMCOLS !

    ( see if column index is too big to be in result set )
    U< 0= IF
      NEW$ 
      EXIT
    THEN


    ( get datal$stack start index of this result set's data$s )    
    PPCOLDATASTRUCT @ 12 + U32@

    ( get index of row & column's data$ in datal$stack )
    PROWY @ PNUMCOLS @ * PCOLX @ + +

    ( get pointer to and length of row and column's data$ in datal$stack )
    SQLRESULTL$STACKOFFSETBUFFERID
    SQLRESULTL$STACKSTRINGBUFFERID
    GETPL$

    ( move data$ to string stack )
    S>NEW$
;

: INT$>NUMBER ( data$ -$- ) ( -- u )
      DEPTH$ 1 U< IF
        0
        EXIT
      THEN

      0 GETP$ ( -- pdata$ data$length ) ( data$ -- )

      ( get int from data$ as UINT32 or UINT64 )
      [ EMES, ]
        ( 4 ) U32@
      [ EME, ]
        ( 8 ) @
      [ ENDEMES, ]

      [ 4 8 2 CASES, ]
        2DROP 0
      [ ENDCASES, ]
      DROP$
;

: GETNUMBERFROMRESULTSET ( columnXindex1based rowYindex1based resultsetindex0based -- number )
    GETDATA$FROMRESULTSET INT$>NUMBER
    ( 0 GETS$[ND]
    DUP 4 = IF
      DROP U32@
    ELSE
      8 = IF
        @
      ELSE
        DROP -1
      THEN
    THEN
    DROP$ )
;

HEX
: UINT32>NEWDEC$ ( n -- ) ( -$- dec$ )
    DEPTH 0= IF EXIT THEN
    BASE @ >R
    0A BASE !
    0 <#$ #S$ #>$ 
    R> BASE ! 
;

HEX 1000 7FFF0000 NEWBUFFER CONSTANT BUILDINSERT$FROMRESULTSETROWlengtharraybufid

VARIABLE BUILDINSERT$FROMRESULTSETROWrow
VARIABLE BUILDINSERT$FROMRESULTSETROWresultset
VARIABLE BUILDINSERT$FROMRESULTSETROWnumbuf

: BUILDINSERT$FROMRESULTSETROW 
  ( rowyindex1based resultsetindex0based -- pbuf1 plength1 paramn1 type1 ... pbufn plengthn paramn typen n )
  ( tablename$ -$- insert$ )
  
  DEPTH 2 U< IF
    DATASTACKUNDERFLOWERROR PUSHOERROR0$
    0 EXIT
  THEN

  DEPTH$ 1 U< 
    IF STRINGSTACKUNDERFLOWERROR PUSHOERROR0$ 
    EXIT 
  THEN

  BUILDINSERT$FROMRESULTSETROWresultset !
  BUILDINSERT$FROMRESULTSETROWrow !
  0 BUILDINSERT$FROMRESULTSETROWnumbuf !

  BUILDINSERT$FROMRESULTSETROWresultset @
  GETNUMBEROFCOLUMNSFROMRESULTSET 0= IF
    DROP DROP 0 EXIT
  THEN

  ( set up length array )
  BUILDINSERT$FROMRESULTSETROWlengtharraybufid EMPTYBUFFER
  BUILDINSERT$FROMRESULTSETROWresultset @
  GETNUMBEROFCOLUMNSFROMRESULTSET 4 * ( size of UINT32 ) 
  BUILDINSERT$FROMRESULTSETROWlengtharraybufid GROWBUFFER
  ?ERRORIF
    ( push name error here )
    EXIT
  THEN 

  $" INSERT INTO " SWAP$ $>$ $"  ( " $>$

  BUILDINSERT$FROMRESULTSETROWresultset @ 
  GETNUMBEROFCOLUMNSFROMRESULTSET 1+ 1 DO

    I 1 = 0= IF
      $" , " $>$
    THEN

    I BUILDINSERT$FROMRESULTSETROWresultset @ 
    GETCOLUMNNAME$FROMRESULTSET $>$
    
  LOOP

  $" ) VALUES ( " $>$

  BUILDINSERT$FROMRESULTSETROWresultset @ 
  GETNUMBEROFCOLUMNSFROMRESULTSET 1+ 1 DO

    I 1 = 0= IF
      $" , " $>$
    THEN

    $" ?" $>$
    I 
    BUILDINSERT$FROMRESULTSETROWrow @ 
    BUILDINSERT$FROMRESULTSETROWresultset @
    GETSDATA$FROMRESULTSET ?ERRORIF
      LEAVE
    THEN
    
    ( putting length in length array )
    I 1- 4 * BUILDINSERT$FROMRESULTSETROWlengtharraybufid O32!
    
    ( getting pointer to length )
    I 1- 4 * BUILDINSERT$FROMRESULTSETROWlengtharraybufid O>P

    ( it seems like parameter number only counts ? )
    ( not sure what docs mean so binding all parameters ? )
    1 BUILDINSERT$FROMRESULTSETROWnumbuf +!
    BUILDINSERT$FROMRESULTSETROWnumbuf @ 

    I BUILDINSERT$FROMRESULTSETROWresultset @ 
    GETTRUECOLUMNTYPEFROMRESULTSET
    
  LOOP
 
  $" )" $>$
  BUILDINSERT$FROMRESULTSETROWnumbuf @  
;

VARIABLE CONNECTSQLANDINSERTRESULTSETINTOTABLE$resultset

: CONNECTSQLANDINSERTRESULTSETINTOTABLE$ 
    ( table$ server$ user$ password$ database$ -$- )
    ( resultsetid -- )

    DEPTH$ 5 U< IF STRINGSTACKUNDERFLOWERROR PUSHOERROR0$ NAME>E EXIT THEN

    DEPTH 0= IF DATASTACKUNDERFLOWERROR PUSHOERROR0$ NAME>E EXIT THEN

    ALLOCATEHSQLCONN ?ERRORIF DROP$ DROP$ DROP$ DROP$ DROP$ NAME>E EXIT THEN

    DUP$ SETHSQLCONNDATABASE ?ERRORIF DROP$ DROP$ DROP$ DROP$ FREEHSQLCONN NAME>E EXIT THEN
    3 ROLL$  3 ROLL$  3 ROLL$

    0 SETHSQLCONNTIMEOUT ?ERRORIF DROP$ DROP$ DROP$ DROP$ FREEHSQLCONN NAME>E EXIT THEN

    CONNECTSQL ?ERRORIF DROP$ FREEHSQLCONN NAME>E EXIT THEN

    CONNECTSQLANDINSERTRESULTSETINTOTABLE$resultset !

    CONNECTSQLANDINSERTRESULTSETINTOTABLE$resultset @
    GETNUMBEROFROWSFROMRESULTSET 0= IF
      DROP$ ( drop table$ )
      DISCONNECTSQL
      FREEHSQLCONN
      EXIT   
    THEN

    ALLOCATEHSQLSTMT ?ERRORIF NAME>E EXIT THEN

    ( DUP$ SETHSQLCONNDATABASE ?ERRORIF DROP$ FREEHSQLSTMT DISCONNECTSQL FREEHSQLCONN NAME>E EXIT THEN )

    USEHSQLCONNDATABASE$ ?ERRORIF DROP$ FREEHSQLSTMT DISCONNECTSQL FREEHSQLCONN NAME>E EXIT THEN

    CONNECTSQLANDINSERTRESULTSETINTOTABLE$resultset @
    GETNUMBEROFROWSFROMRESULTSET 1+ 1 DO

      DUP$
      I
      CONNECTSQLANDINSERTRESULTSETINTOTABLE$resultset @ 

      BUILDINSERT$FROMRESULTSETROW ?ERRORIF LEAVE THEN

      DUP$ ." <br>about to prepare: " .$ CRLF

      PREPARESQLSTATEMENT$ ?ERRORIF FREEHSQLSTMT LEAVE THEN

      BINDBINARYSSFORSQLINSERT ?ERRORIF FREEHSQLSTMT LEAVE THEN

      DROP$ DOSQLSTATEMENT ?ERRORIF FREEHSQLSTMT LEAVE THEN
 
    LOOP

    ?ERRORIF 
      DROP$
      DISCONNECTSQL
      FREEHSQLCONN
      NAME>E EXIT
    THEN

    FREEHSQLSTMT

    DROP$ ( tablename$ )
    DISCONNECTSQL
    FREEHSQLCONN

    ?ERRORIF NAME>E THEN
;

HEX
: CONNECTSQLBINDSSANDDOSTATEMENT$ 
    ( table$ server$ user$ password$ database$ -$- )
    ( pbuffer1 plength1 paramn1 type1 ... pbuffern plengthn typen paramn2 typen n -- )

    DEPTH$ 5 U< IF STRINGSTACKUNDERFLOWERROR PUSHOERROR0$ NAME>E EXIT THEN

    DEPTH 0= IF DATASTACKUNDERFLOWERROR PUSHOERROR0$ NAME>E EXIT THEN

    ALLOCATEHSQLCONN ?ERRORIF DROP$ DROP$ DROP$ DROP$ DROP$ NAME>E EXIT THEN

    DUP$ SETHSQLCONNDATABASE ?ERRORIF DROP$ DROP$ DROP$ DROP$ FREEHSQLCONN NAME>E EXIT THEN
    3 ROLL$  3 ROLL$  3 ROLL$

    0 SETHSQLCONNTIMEOUT ?ERRORIF DROP$ DROP$ DROP$ DROP$ FREEHSQLCONN NAME>E EXIT THEN

    CONNECTSQL ?ERRORIF DROP$ FREEHSQLCONN NAME>E EXIT THEN  
      
    ALLOCATEHSQLSTMT ?ERRORIF DISCONNECTSQL FREEHSQLCONN NAME>E EXIT THEN
 
    ( DUP$ SETHSQLCONNDATABASE ?ERRORIF DROP$ FREEHSQLSTMT DISCONNECTSQL FREEHSQLCONN NAME>E EXIT THEN )

    USEHSQLCONNDATABASE$ ?ERRORIF DROP$ FREEHSQLSTMT DISCONNECTSQL FREEHSQLCONN NAME>E EXIT THEN

    PREPARESQLSTATEMENT$ ?ERRORIF FREEHSQLSTMT DISCONNECTSQL FREEHSQLCONN NAME>E EXIT THEN DROP$

    BINDBINARYSSFORSQLINSERT ?ERRORIF DISCONNECTSQL FREEHSQLCONN NAME>E EXIT THEN

    DOSQLSTATEMENT ?ERRORIF DISCONNECTSQL FREEHSQLCONN NAME>E EXIT THEN

    FREEHSQLSTMT 
    DISCONNECTSQL 
    FREEHSQLCONN 
    ?ERRORIF NAME>E THEN
;


VARIABLE PDESTBUFID
VARIABLE PDATASTARTINDEX
DECIMAL
: RESULTSETINTCOL>BUF ( columnindex1based resultsetindex0based destbufid -- )
                      ( -destbuf- row1int row2int ... rowyint )
    DEPTH 3 U< IF
      DATASTACKUNDERFLOWERROR PUSHOERROR0$
      EXIT
    THEN

    PDESTBUFID !

    ( get pointer to column type structure )
    SQLCOLTYPEL$STACKOFFSETBUFFERID
    SQLCOLTYPEL$STACKSTRINGBUFFERID
    GETPL$ DROP PPCOLDATASTRUCT !

    PCOLX !

    ( get number of columns in result set )
    PPCOLDATASTRUCT @ 4 + U32@ PNUMCOLS !

    ( get number of rows in result set )
    PPCOLDATASTRUCT @ U32@ PNUMROWS !

    ( get base index of this result sets data$ in datal$stack )
    PPCOLDATASTRUCT @ 12 + U32@ PDATASTARTINDEX !

    ( check number rows )
    PNUMROWS @ 0= IF 
      EXIT
    THEN

    ( check column index )
    PCOLX @ 0= IF
      EXIT
    THEN

    PCOLX @ 1- PCOLX !

    PCOLX @ PNUMCOLS @ U< 0= IF
      EXIT
    THEN

    ?ERRORIF
      EXIT
    THEN

    PNUMROWS @ 0 DO
      
      ( calculate index of data$ in datal$stack )
      PDATASTARTINDEX @
      I PNUMCOLS @ * + 
      PCOLX @ +  

      ( get start address and length of data$ )
      SQLRESULTL$STACKOFFSETBUFFERID
      SQLRESULTL$STACKSTRINGBUFFERID
      GETPL$ S>NEW$ INT$>NUMBER

      ( see if data$ has length of an int )
      ( if not push a 0 )
      ( 4 = IF
        U32@ 
      ELSE
        DROP 0 
      THEN )

      PDESTBUFID @ >BUF

      ?ERRORIF
        LEAVE
      THEN
      
    LOOP    
;

DECIMAL
: .HTMLSPECIALCHAR ( char -- ) 
    ( &#x00; doesn't work if I remember correctly )
    DEPTH 1 U< IF EXIT THEN

    DUP 2 U< IF
      DROP [CHAR] . EMIT
      EXIT
    THEN

    DUP BL = IF
      DROP ." &nbsp"
      EXIT
    THEN

    DUP 128 U< IF

    DUP 2 U< IF
      DROP [CHAR] . EMIT
      EXIT
    THEN

    DUP BL = IF
      DROP ." &nbsp"
      EXIT
    THEN

    ." &#x" 
    ( doing conversion this way instead of U. so there is no space after number )
    BASE @ >R 16 BASE !
    0 <#$ #S$ #>$ .$ 
    R> BASE !
    ." ;"

    ELSE

    128 -

    DUP 2 U< IF
      DROP ." <span style='color: red'>.</span>"
      EXIT
    THEN

    DUP BL = IF
      DROP ." <span style='color: red'>&nbsp</span>"
      EXIT
    THEN

    ." <span style='color: red'>&#x" 
    ( doing conversion this way instead of U. so there is no space after number )
    BASE @ >R 16 BASE !
    0 <#$ #S$ #>$ .$ 
    R> BASE !
    ." ;</span>"

    THEN
;

DECIMAL
: chtml>&#xx$ ( char -- ) ( $ -$- $' )
    DEPTH 0= IF 
      DATASTACKUNDERFLOWERROR PUSHOERROR0$
      EXIT 
    THEN

    DEPTH$ 0= IF
      STRINGSTACKUNDERFLOWERROR PUSHOERROR0$
      EXIT
    THEN

    $" &#x" $>$
    ( doing conversion this way instead of U. so there is no space after number )
    BASE @ >R 16 BASE !
    0 <#$ #S$ #>$ $>$ 
    R> BASE !
    $" ;" $>$
;

DECIMAL
: chtml>$ ( char -- ) ( $ -$- $' )
    ( &#x00; doesn't work if I remember correctly )
    DEPTH 0= IF 
      DATASTACKUNDERFLOWERROR PUSHOERROR0$
      EXIT 
    THEN

    DEPTH$ 0= IF
      STRINGSTACKUNDERFLOWERROR PUSHOERROR0$
      EXIT
    THEN

    DUP 2 U< IF
      DROP [CHAR] . C>$ EXIT
    THEN

    DUP BL = IF
      DROP $" &nbsp" $>$ EXIT
    THEN

    DUP [CHAR] 0 U< IF
      chtml>&#xx$ EXIT
    THEN

    DUP [CHAR] 9 1+ U< IF
      C>$ EXIT
    THEN
 
    DUP [CHAR] A U< IF            
      chtml>&#xx$ EXIT
    THEN

    DUP [CHAR] Z 1+ U< IF
      C>$ EXIT
    THEN

    DUP [CHAR] a U< IF
      chtml>&#xx$ EXIT
    THEN
  
    DUP [CHAR] z 1+ U< IF
      C>$ EXIT
    THEN
               
    chtml>&#xx$
;

DECIMAL
: chtmlinv>$ ( char -- ) ( $ -$- $' )
    DEPTH 0= IF 
      DATASTACKUNDERFLOWERROR PUSHOERROR0$
      EXIT 
    THEN

    DEPTH$ 0= IF
      STRINGSTACKUNDERFLOWERROR PUSHOERROR0$
      EXIT
    THEN

    DUP 128 U< IF
      chtml>$
    ELSE
      128 -

      $" <span style='color: red'>" $>$
      chtml>$
      $" </span>" $>$
    THEN
;

HEX
1000 1000000 NEWBUFFER CONSTANT ascii$>html$bufid
: ascii$>html$ ( ascii$ -$- html$ )
    ( can't get pointer if pushing to string stack )
    ( could use insert... but is there a better way? )
    ( could copy string to a temporary buffer... )

    DEPTH$ 0= IF 
      STRINGSTACKUNDERFLOWERROR PUSHOERROR0$
      EXIT 
    THEN

    LENGTH$ 0= IF EXIT THEN

    ascii$>html$bufid EMPTYBUFFER

    ascii$>html$bufid $>BUF

    NEW$

    ascii$>html$bufid LENGTHBUF 0 DO
      I ascii$>html$bufid OC@
      chtmlinv>$
      ?ERRORIF LEAVE THEN
    LOOP
;

HEX
: .HTML$ ( ascii$ -$- )
    ( building a string instead of doing separate emits for speed )
    ( individual emits seem to be slow )
    ascii$>html$ .$
;

HEX
: .HTML$2 ( ascii$ -$- )
         ( really just want to do non alphanumeric characters but doing all )
         ( need to convert most non alphanumeric characters to &xxx; format to avoid confusion )
         ( with special characters such as < > & )
         ( doing single character emits is slow... need to convert then emit whole string )
          
         LENGTH$ 0= IF
           DROP$ ." null" CRLF
           EXIT
         THEN
  
         LENGTH$ 0 DO

           I $C@ 

             ( DUP BL = IF
               EMIT
             ELSE ) 

               DUP [CHAR] 0 U< IF
                 .HTMLSPECIALCHAR
               ELSE

                 DUP [CHAR] 9 1+ U< IF
                   EMIT
                 ELSE
 
                   DUP [CHAR] A U< IF            
                     .HTMLSPECIALCHAR
                   ELSE

                     DUP [CHAR] Z 1+ U< IF
                       EMIT
                     ELSE
                       DUP [CHAR] a U< IF
                         .HTMLSPECIALCHAR 
                       ELSE
  
                         DUP [CHAR] z 1+ U< IF
                           EMIT
                         ELSE
                           .HTMLSPECIALCHAR
                         THEN
                       THEN
                     THEN
                   THEN
                 THEN
               THEN
             ( THEN )

         LOOP

         DROP$
;

DECIMAL
80 CONSTANT MAXDRAWDATA$LENGTH
: INT$>NUMBER$ ( data$ -$- number$ )
      DEPTH$ 1 U< IF
        $" error- data$ missing"
        EXIT
      THEN

      0 GETP$

      ( get int from data$ as UINT32 or UINT64 )
      [ EMES, ]
        ( 0 ) DROP DROP$ $" null" EXIT
      [ EME, ]
        ( 4 ) U32@
      [ EME, ]
        ( 8 ) @
      [ ENDEMES, ]

      [ 0 4 8 3 CASES, ]
        DROP$
        $" error - int length not 4 or 8 bytes, got lenth " U.
        EXIT
      [ ENDCASES, ]

      
      ( @ ) DROP$ 0 

      ( convert UINT64 to ascii string representation using current value of BASE )
      
      <#$ #S$ #>$

      BASE @ 16 = IF
        $" 0x" SWAP$ $>$
      THEN
;

: FORMATRESULTDATA$USINGDEFAULT ( SQL_INTEGER|SQL_BINARY|SQL_WCHAR -- ) ( data$ -$- ) ( uses current BASE )
    DEPTH 1 U< IF
      $" error - data type missing"
      EXIT
    THEN

    DEPTH$ 1 U< IF
      $" error- data$ missing"
      EXIT
    THEN

    DUP SQL_WCHAR = IF
      UNICODE>ASCII$
    THEN

    SQL_INTEGER = IF
      INT$>NUMBER$   
      EXIT
    THEN

    ( do sql binary / ascii text )

    ( empty string case )

    LENGTH$ 0= IF
      DROP$
      $" null"
      EXIT
    THEN

    ( string longer than MAXDRAWDATA$LENGTH - 1 characters case )
    LENGTH$ MAXDRAWDATA$LENGTH U< 0=  IF
      $" <div class=resultsettablesection>" CRLF$ $>$
      SWAP$ $>$
      $" </div>" $>$ CRLF$ $>$
    THEN

    ( convert special characters )
    ascii$>html$
;

: DRAWRESULTDATA$USINGDEFAULT ( SQL_INTEGER|SQL_BINARY|SQL_WCHAR -- ) ( data$ -$- ) ( uses current BASE )

    DEPTH 1 U< IF
      ." error - data type missing"
      EXIT
    THEN

    DEPTH$ 1 U< IF
      ." error- data$ missing"
      EXIT
    THEN

    DUP SQL_WCHAR = IF
      UNICODE>ASCII$
    THEN

    SQL_INTEGER = IF
      INT$>NUMBER$       
      .$
      EXIT
    THEN

    ( do sql binary )

    ( empty string case )
    LENGTH$ 0= IF
      ." null"
      DROP$
      EXIT
    THEN

    ( string longer than MAXDRAWDATA$LENGTH - 1 characters case )
    LENGTH$ MAXDRAWDATA$LENGTH U< 0=  IF
      ." <div class=resultsettablesection>" CRLF
      .$
      ." </div>" CRLF
      EXIT
      ( LENGTH$ DUP MAXDRAWDATA$LENGTH - SHORTEN$
    
      .HTML$
      ." ... length = "
      BASE @ 16 = IF
        ." 0x"
      THEN
      0 <#$ #S$ #>$ .$
      EXIT )
    THEN

    ( normal case )
    ( convert special characters )
    .HTML$
;

: DRAWRESULTDATA$USINGDEFAULTNOCONVERT ( SQL_INTEGER|SQL_BINARY|SQL_WCHAR -- ) ( data$ -$- ) ( uses current BASE )

    DEPTH 1 U< IF
      ." error - data type missing"
      EXIT
    THEN

    DEPTH$ 1 U< IF
      ." error- data$ missing"
      EXIT
    THEN

    DUP SQL_WCHAR = IF
      UNICODE>ASCII$
    THEN

    SQL_INTEGER = IF
      INT$>NUMBER$      
      .$
      EXIT
    THEN

    ( do sql binary )

    ( empty string case )
    LENGTH$ 0= IF
      ." null"
      DROP$
      EXIT
    THEN

    ( string longer than MAXDRAWDATA$LENGTH - 1 characters case )
    LENGTH$ MAXDRAWDATA$LENGTH U< 0=  IF
      ." <div class=resultsettablesection>" CRLF
      .$
      ." </div>" CRLF
      EXIT
      ( LENGTH$ DUP MAXDRAWDATA$LENGTH - SHORTEN$
    
      .HTML$
      ." ... length = "
      BASE @ 16 = IF
        ." 0x"
      THEN
      0 <#$ #S$ #>$ .$
      EXIT )
    THEN

    ( normal case )
    .$
;

VARIABLE PRESULTSETINDEX
: DRAWRESULTSETASHTMLTABLE ( resultsetindex -- ) ( tableattribute$ -$- ) ( uses current BASE )
   
    DEPTH 1 U< IF
      ." <P>Data stack underflow while trying to draw result set as an html table. " CRLF
      ." Missing result set index on data stack.</P>" CRLF
      EXIT
    THEN

    DEPTH$ 1 U< IF
      ." <P>String stack underflow while trying to draw result set as an html table. " CRLF
      ." Missing <table> tag attributes string. </P>" CRLF
      EXIT
    THEN

    DUP PRESULTSETINDEX !

    ( get pointer to column type structure )
    SQLCOLTYPEL$STACKOFFSETBUFFERID
    SQLCOLTYPEL$STACKSTRINGBUFFERID
    GETPL$ DROP PPCOLDATASTRUCT !

    ?ERRORIF 
      EMPTY-ERRORS
      ." <P>Error trying to get pointer to result set " PRESULTSETINDEX @ U.
      ."  while trying to draw it as an html table. " CRLF
      ." Has result set " PRESULTSETINDEX @ U. 
      ."  been loaded? </P>" CRLF
      EXIT
    THEN

    PRESULTSETINDEX @ GETNUMBEROFCOLUMNSFROMRESULTSET PNUMCOLS !
    PRESULTSETINDEX @ GETNUMBEROFROWSFROMRESULTSET PNUMROWS !

    PNUMCOLS @ 0= IF
      ." <p>Result set has no columns.</p>" CRLF
      EXIT
    THEN

    PNUMROWS @ 0= IF
      ." <p>Result set has no rows.</p>" CRLF
      EXIT
    THEN
    
    ." <table " .$ ." >" CRLF

    
    $"   <tr>" CRLF$ $>$
    PNUMCOLS @ 0 DO 

      $"     <th>" $>$ CRLF$ $>$
      I 1+ PRESULTSETINDEX @ GETCOLUMNNAME$FROMRESULTSET $>$
      $"     </th>" $>$ CRLF$ $>$

    LOOP
    $"   </tr>" $>$ CRLF$ $>$ .$

    PNUMROWS @ 0 DO

      $"   <tr>" CRLF$ $>$ .$
      PNUMCOLS @ 0 DO

        $"     <td>" CRLF$ $>$ .$
        I 1+ J 1+ PRESULTSETINDEX @ GETDATA$FROMRESULTSET
        I 1+ PRESULTSETINDEX @ GETTRUECOLUMNTYPEFROMRESULTSET 
        CHANGESQLCOLTYPETOINTORBINORWCHAR
        DRAWRESULTDATA$USINGDEFAULT
        $" </td>" CRLF$ $>$ .$

        ?ERRORIF LEAVE THEN

      LOOP
      $"   </tr>" CRLF$ $>$ .$

      ?ERRORIF LEAVE THEN

    LOOP
    
    ." </table>" CRLF   
;

VARIABLE PROWINDEX
: DRAWRESULTSETROWASHTMLEDITTABLEWCOLTYPES 
    ( rowindex resultsetindex -- ) 
    ( tablename$ tableattribute$ formattribute$ -$- )
    ( uses current BASE )

    DEPTH 2 U< IF
      ." <P>Data stack underflow while trying to draw result set row as an html edit table. " CRLF
      ." Missing result set index on data stack.</P>" CRLF
      EXIT
    THEN

    DEPTH$ 1 U< IF
      ." <P>String stack underflow while trying to draw result set as an html table. " CRLF
      ." Missing <table> tag attributes string. </P>" CRLF
      EXIT
    THEN

    DUP PRESULTSETINDEX !

    ( get pointer to column type structure )
    SQLCOLTYPEL$STACKOFFSETBUFFERID
    SQLCOLTYPEL$STACKSTRINGBUFFERID
    GETPL$ DROP PPCOLDATASTRUCT !

    ?ERRORIF 
      EMPTY-ERRORS
      ." <P>Error trying to get pointer to result set " PRESULTSETINDEX @ U.
      ."  while trying to draw it as an html table. " CRLF
      ." Has result set " PRESULTSETINDEX @ U. 
      ."  been loaded? </P>" CRLF
      EXIT
    THEN

    DUP PROWINDEX !

    0= IF
      ." <p>Row index is 1 based and can not be 0.</p>" CRLF
      EXIT
    THEN

    PRESULTSETINDEX @ GETNUMBEROFCOLUMNSFROMRESULTSET PNUMCOLS !
    PRESULTSETINDEX @ GETNUMBEROFROWSFROMRESULTSET PNUMROWS !

    PNUMCOLS @ 0= IF
      ." <p>Result set has no columns.</p>" CRLF
      EXIT
    THEN

    PROWINDEX @ 1- PNUMROWS @ U< 0= IF 
      ." <p>Row index off end of result set.</p>" CRLF
      EXIT
    THEN

    ." <form " .$ ." >" CRLF

    ." <table " .$ ." >" CRLF

    ."   <input type=hidden name='tablename' value='" .$ ." '>" CRLF

    
    $"   <tr>" CRLF$ $>$
    PNUMCOLS @ 0 DO 

      $"     <th>" $>$ CRLF$ $>$
      I 1+ PRESULTSETINDEX @ GETCOLUMNNAME$FROMRESULTSET $>$
      $"     </th>" $>$ CRLF$ $>$

    LOOP
    $"   </tr>" $>$ CRLF$ $>$ .$

    $"   <tr>" CRLF$ $>$
    PNUMCOLS @ 0 DO 

      $"     <th>" $>$
      I 1+ PRESULTSETINDEX @ GETTRUECOLUMNTYPEFROMRESULTSET SQLCOLTYPE>NEWTYPE$ $>$
      $"     </th>" $>$ CRLF$ $>$

    LOOP
    $"   </tr>" $>$ CRLF$ $>$
    .$

    

    $"   <tr>" CRLF$ $>$ .$
    PNUMCOLS @ 0 DO

      $"     <td>" CRLF$ $>$ .$
      ( eventually will need special one for column type of binary to do file upload instead )
      ."       <input type=text name='"
      I 1+ PRESULTSETINDEX @ GETCOLUMNNAME$FROMRESULTSET .$
      I 1+ PROWINDEX @ PRESULTSETINDEX @ GETDATA$FROMRESULTSET
      I 1+ PRESULTSETINDEX @ GETTRUECOLUMNTYPEFROMRESULTSET 
      CHANGESQLCOLTYPETOINTORBINORWCHAR
      ." ' value='" DRAWRESULTDATA$USINGDEFAULTNOCONVERT
      ." '>"
      $"     </td>" CRLF$ $>$ .$

      ?ERRORIF LEAVE THEN

    LOOP

    $"   </tr>" CRLF$ $>$ .$

    ." </table>" CRLF

    ."   <input type=submit value=Submit>" CRLF

    ." </form>" CRLF    
;

: DRAWRESULTSETASHTMLTABLEWCOLTYPES ( resultsetindex -- ) ( tableattribute$ -$- ) ( uses current BASE )
   
    DEPTH 1 U< IF
      ." <P>Data stack underflow while trying to draw result set as an html table. " CRLF
      ." Missing result set index on data stack.</P>" CRLF
      EXIT
    THEN

    DEPTH$ 1 U< IF
      ." <P>String stack underflow while trying to draw result set as an html table. " CRLF
      ." Missing <table> tag attributes string. </P>" CRLF
      EXIT
    THEN

    DUP PRESULTSETINDEX !

    ( get pointer to column type structure )
    SQLCOLTYPEL$STACKOFFSETBUFFERID
    SQLCOLTYPEL$STACKSTRINGBUFFERID
    GETPL$ DROP PPCOLDATASTRUCT !

    ?ERRORIF 
      EMPTY-ERRORS
      ." <P>Error trying to get pointer to result set " PRESULTSETINDEX @ U.
      ."  while trying to draw it as an html table. " CRLF
      ." Has result set " PRESULTSETINDEX @ U. 
      ."  been loaded? </P>" CRLF
      EXIT
    THEN

    PRESULTSETINDEX @ GETNUMBEROFCOLUMNSFROMRESULTSET PNUMCOLS !
    PRESULTSETINDEX @ GETNUMBEROFROWSFROMRESULTSET PNUMROWS !

    PNUMCOLS @ 0= IF
      ." <p>Result set has no columns.</p>" CRLF
      EXIT
    THEN
    
    ." <table " .$ ." >" CRLF

    
    $"   <tr>" CRLF$ $>$
    PNUMCOLS @ 0 DO 

      $"     <th>" $>$ CRLF$ $>$
      I 1+ PRESULTSETINDEX @ GETCOLUMNNAME$FROMRESULTSET $>$
      $"     </th>" $>$ CRLF$ $>$

    LOOP
    $"   </tr>" $>$ CRLF$ $>$ .$

    $"   <tr>" CRLF$ $>$
    PNUMCOLS @ 0 DO 

      $"     <th>" $>$
      I 1+ PRESULTSETINDEX @ GETTRUECOLUMNTYPEFROMRESULTSET SQLCOLTYPE>NEWTYPE$ $>$
      $"     </th>" $>$ CRLF$ $>$

    LOOP
    $"   </tr>" $>$ CRLF$ $>$
    .$

    PNUMROWS @ 0= 0= IF

      PNUMROWS @ 0 DO

        $"   <tr>" CRLF$ $>$ .$
        PNUMCOLS @ 0 DO

          $"     <td>" CRLF$ $>$ .$
          I 1+ J 1+ PRESULTSETINDEX @ GETDATA$FROMRESULTSET
          I 1+ PRESULTSETINDEX @ GETTRUECOLUMNTYPEFROMRESULTSET 
          CHANGESQLCOLTYPETOINTORBINORWCHAR
          DRAWRESULTDATA$USINGDEFAULT
          $" </td>" CRLF$ $>$ .$

          ?ERRORIF LEAVE THEN

        LOOP
        $"   </tr>" CRLF$ $>$ .$

        ?ERRORIF LEAVE THEN

      LOOP

    THEN

    ." </table>" CRLF      
;


VARIABLE PLEFTOVERBYTES
VARIABLE PBASEADDRESS

HEX
10 CONSTANT BYTEDUMPROWSIZE
1000 1000000 NEWBUFFER CONSTANT DRAW$ASHTMLBYTEDUMPbufid
: DRAW$ASHTMLBYTEDUMP ( src$ -$- ) ( baseaddress -- ) ( uses current BASE )

    DEPTH$ 1 U< IF
      ." <p>Object to viex as byte dump is missing from string stack.</p>" CRLF      
      EXIT
    THEN

    DEPTH 1 U< IF
      ." <p>Base address for object to view as byte dump is missing from data stack.</p>" CRLF
      EXIT
    THEN

    LENGTH$ 0= IF    
      ." <p>Object to view as byte dump is empty.</p>" CRLF
      EXIT
    THEN

    DRAW$ASHTMLBYTEDUMPbufid EMPTYBUFFER
    DRAW$ASHTMLBYTEDUMPbufid $>BUF

    PBASEADDRESS !

    DRAW$ASHTMLBYTEDUMPbufid LENGTHBUF ( LENGTH$ ) BYTEDUMPROWSIZE / PNUMROWS !
    DRAW$ASHTMLBYTEDUMPbufid LENGTHBUF ( LENGTH$ ) BYTEDUMPROWSIZE MOD PLEFTOVERBYTES !

    ." <table border=1>" CRLF
    ."   <tr><th>offset</th><th>address</th><th>byte dump</th><th>ascii</th></tr>" CRLF

    PNUMROWS @ 0= 0= IF
    
      PNUMROWS @ 0 DO
        ."   <tr>" CRLF
          ( offset )
          $"     <td>" I BYTEDUMPROWSIZE * 0 <#$ #S$ #>$ $>$ $" </td>" $>$ .$ CRLF

          ( address )
          $"     <td>" I BYTEDUMPROWSIZE * PBASEADDRESS @ + 0 <#$ #S$ #>$ $>$ $" </td>" $>$ .$ CRLF

          ( hex view of bytes )
          $"     <td STYLE='font-family: monospace'>"
          BYTEDUMPROWSIZE 0 DO

            ( get byte from string )     
            J BYTEDUMPROWSIZE * I + DRAW$ASHTMLBYTEDUMPbufid OC@ 

            ( draw byte - it will look pretty if either decimal or hex. might not be in other bases )
            BASE @ 0A = IF
              DECIMALBYTE>NEW$ $>$
            ELSE
              HEXBYTE>NEW$ $>$
            THEN

            ( space between bytes )
            I 1+ BYTEDUMPROWSIZE = 0= IF
              $"  " $>$
            THEN

            ?ERRORIF LEAVE THEN
     
          LOOP
          $" </td>" $>$ .$ CRLF

          ( ascii )
          $"     <td STYLE='font-family: monospace'>" 
          I BYTEDUMPROWSIZE * DRAW$ASHTMLBYTEDUMPbufid BYTEDUMPROWSIZE ( GETMID$ ) OS>NEW$ ascii$>html$ $>$
          $" </td>" $>$ .$ CRLF
          
        ."   </tr>" CRLF

        ?ERRORIF LEAVE THEN
      LOOP
    THEN

    ?ERRORIF EXIT THEN

    PLEFTOVERBYTES @ 0= 0= IF

      ."   <tr>" CRLF

      ( offset )
      ."     <td>" PNUMROWS @ BYTEDUMPROWSIZE * 0 <#$ #S$ #>$ .$ ." </td>" CRLF

      ( address )
      ."     <td>" PNUMROWS @ BYTEDUMPROWSIZE * PBASEADDRESS @ + 0 <#$ #S$ #>$ .$ ." </td>" CRLF

      ( dump of bytes )
      ."     <td STYLE='font-family: monospace'>"
      PLEFTOVERBYTES @ 0 DO

        ( get byte from string )     
        PNUMROWS @ BYTEDUMPROWSIZE * I + DRAW$ASHTMLBYTEDUMPbufid OC@ ( $C@ )

        ( draw bytes )
        BASE @ 10 ( hex ) = IF
          DRAWHEXBYTE
        ELSE
          DRAWDECIMALBYTE
        THEN

        ( space between bytes )    
        ."  "
            
        ?ERRORIF LEAVE THEN
        
      LOOP
      ." </td>" CRLF

      ( ascii )
      ."     <td STYLE='font-family: monospace'>"
      PNUMROWS @ BYTEDUMPROWSIZE * DRAW$ASHTMLBYTEDUMPbufid PLEFTOVERBYTES @ ( GETMID$ ) OS>NEW$ .HTML$
      ." </td>" CRLF
          
      ."   </tr>" CRLF
      
    THEN
    ." </table>" CRLF
;

: DRAWRESULTSETCOLUMNASHTMLSELECTLIST ( 1basedcolumnid 0basedresultsetid -- ) ( selectattribute$ -$- )

    DEPTH 2 U< IF
      DATASTACKUNDERFLOWERROR PUSHOERROR0$
      NAME>E
      EXIT
    THEN

    DEPTH$ 1 U< IF
      DROP DROP
      STRINGSTACKUNDERFLOWERROR PUSHOERROR0$
      NAME>E
      EXIT
    THEN

    PRESULTSETINDEX !
    PCOLX !

    ( get pointer to column type structure )
    PRESULTSETINDEX @
    SQLCOLTYPEL$STACKOFFSETBUFFERID
    SQLCOLTYPEL$STACKSTRINGBUFFERID
    GETPL$ DROP PPCOLDATASTRUCT !

    ?ERRORIF 
      EMPTY-ERRORS
      ." <P>Error trying to get pointer to result set " PRESULTSETINDEX @ DECIMAL U.
      ."  while trying to draw column as an html select list. " CRLF
      ." Has result set " PRESULTSETINDEX @ U. 
      ."  been loaded? </P>" CRLF
      DROP$
      EXIT
    THEN

    ( get number of columns in result set )
    PPCOLDATASTRUCT @ 4 + U32@ PNUMCOLS !

    ( get number of rows in result set )
    PPCOLDATASTRUCT @ U32@ PNUMROWS !

    PNUMCOLS @ 0= IF
      ." <p>Result set has no columns.</p>" CRLF
      EXIT
    THEN

    PNUMROWS @ 0= IF
      ." <p>Result set has no rows.</p>" CRLF
      EXIT
    THEN

    ( make sure column index is not 0 )
    PCOLX @ 0= IF
      ." <p>Result set columns are 1 based. Column 0 bookmarks are not in result set.</p>" CRLF
    THEN

    ( make column index 0 based and see if column is in result set )
    PCOLX @ 1- DUP PCOLX ! PNUMCOLS @ U< 0= IF
      ." <p>Column not in result set.</p>" CRLF
      EXIT
    THEN

    ( draw selection list )
    ."     <SELECT " .$ ." >" CRLF 

    PNUMROWS @ 0 DO

      ."       <OPTION>"
      PCOLX @ 1+ I 1+ PRESULTSETINDEX @ GETDATA$FROMRESULTSET
      PCOLX @ 1+ PRESULTSETINDEX @ GETTRUECOLUMNTYPEFROMRESULTSET 
        CHANGESQLCOLTYPETOINTORBINORWCHAR
      DRAWRESULTDATA$USINGDEFAULT
      ." </OPTION>" CRLF
      
      ?ERRORIF
        LEAVE
      THEN
      
    LOOP       

    ."     </SELECT>" CRLF    
;

: ?0$>$ ( a$ -$- a$' )

    DEPTH$ 1 U< IF
      STRINGSTACKUNDERFLOWERROR PUSHOERROR0$
      NAME>E
      EXIT
    THEN

    LENGTH$ 0= IF
      EXIT
    THEN

    $>C DUP 0= IF
      DROP EXIT
    ELSE
      C>$
    THEN
;

( If this word makes new definitions then it is a compiling word and the compile functions it calls WILL crash if the buffer moves... )
(   So either A: this word compiles to a different buffer than the one it is in )
(   or B: store the name value pairs in a hierarchical list... )
: LOADNAMEVALUEPAIRDEFINITIONS ( n -- ) ( value0$ name0$ value1$ name1$ ... valuen$ namen$ )

    DEPTH 1 U< IF
      DATASTACKUNDERFLOWERROR PUSHOERROR0$
      NAME>E 
      EXIT 
    THEN

    DUP 0= IF
      DROP 
      EXIT
    THEN

    0 DO

      LENGTH$ 0= IF
        DROP$ DROP$
      ELSE

        ( make sure no delimiters in name$ here )

        ( add name$ to the post get hlist )
        0 POSTGET-HLIST NEW-ELEMENT ?ERRORIF NAME>E EXIT THEN DROP

      THEN

    LOOP
; 

: POSTGETNAME$>VALUE$ ( name$ -$- value$ )
    0 POSTGET-HLIST ?NAME$>VALUE$ 
    ?ERRORIF NAME>E EXIT THEN
    IF EXIT THEN NEW$
;

: LOADFORMVALUES ( -- ) ( -$- )

    ( could check method$ here but it really doesn't matter as far as I know )
    ( apache leaves one empty, not sure about windows )
    GETPOST$ ?ERRORIF NAME>E EXIT THEN
    FORM$>VALUE$NAME$U ?ERRORIF NAME>E EXIT THEN
    LOADNAMEVALUEPAIRDEFINITIONS ?ERRORIF NAME>E EXIT THEN
    GETQUERY$ ?ERRORIF NAME>E EXIT THEN
    FORM$>VALUE$NAME$U ?ERRORIF NAME>E EXIT THEN
    LOADNAMEVALUEPAIRDEFINITIONS ?ERRORIF NAME>E EXIT THEN
; 


DECIMAL
: getbase ( -- 10|16 ) ( -$- )
    
    $" base" POSTGETNAME$>VALUE$ 
    LENGTH$ 0= IF
      DROP$ 16 EXIT
    THEN 

    $" decimal" COMPARE$ 0= IF
      DROP$ DROP$ 10 
      EXIT
    THEN
  
    DROP$

    $" DECIMAL" COMPARE$ 0= IF
      DROP$ DROP$ 10 
      EXIT
    THEN
  
    DROP$

    $" 10" COMPARE$ 0= IF
      DROP$ DROP$ 10 
      EXIT
    THEN
  
    DROP$ DROP$

    16
;


( : DROPRESULTSET ) ( resultsetcolumntypes -columntypesl$- )
                ( resultsetcolumnnames -columnnamesl$- )
                ( resultsetdata        -datal$- )
( ; )

( need drop l$ to index )


( Packed 32bit L$ looks like this )
( Pack buffer: )
(   0: header size in bytes )
(   4: magic id = ascii 'PKL$' )
(   8: size of l$offset buffer in bytes )
(   0x0C - 0x0C + offset buffer size: l$offset buffer )
(   rest of buffer: l$string buffer )

VARIABLE PACKL$>BUFdestbuf
VARIABLE PACKL$>BUFoffsetbuf
VARIABLE PACKL$>BUFstringbuf

HEX
: PACKL$>BUF // Packs 64 bit array of offsets as 32 bit array of offsets
    { | srcoffsetbuf srcstringbuf destbuf -- }
    ( l$n ... l$1 -l$- l$n ... l$1 ) 
    ( -destbuf- packedl$ ) 

    destbuf EMPTYBUFFER
    ?ERRORIF 
      ( destination buffer does not exist )
      EXIT 
    THEN

    0C destbuf U32>BUF     ( +0 is size of pack header )
    $" PKL$" destbuf $>BUF ( +4 is magic id PKL$ )
    srcoffsetbuf LENGTHBUF 2/ ( to get size in UINT32s )
    ?ERRORIF
      ( l$offsetbuffer does not exist )
      EXIT
    THEN
    destbuf U32>BUF           ( +8 is length of offset buffer )

    srcoffsetbuf destbuf BUF64[]>BUF32[]
    ?ERRORIF
      ( something wrong with l$offsetbuffer )
      EXIT
    THEN

    srcstringbuf GETSBUFFER
    destbuf S>BUF  ( pushing string buffer )    
;

: O32@ ( offset bufferid -- u )
    O>P U32@
;


HEX
: UNPACKBUF>L$ ( srcbufid l$offsetbufid l$stringbufid -- )
    { ostringbuf stringbuflength | srcbuf destoffsetbuf deststringbuf --}

    destoffsetbuf EMPTYBUFFER
    ?ERRORIF 
      ( l$ string buffer does not exist )
      EXIT 
    THEN

    deststringbuf EMPTYBUFFER
    ?ERRORIF 
      ( l$ offset buffer does not exist )
      EXIT 
    THEN

    ( check header )
    ( checking header size for >= C )
    0 srcbuf O32@ 0C U< IF
      ( header too small to have magic and offset )
      SUBROUTINEERROR PUSHOERROR0$
      EXIT
    THEN

    ( checking magic id for PKL$ )
    4 srcbuf 4 OS>NEW$ $" PKL$" COMPARE$ DROP$ DROP$ 0= 0= IF
      ( magic id incorrect )
      SUBROUTINEERROR PUSHOERROR0$
      EXIT
    THEN


    ( extract offset buffer )
    0 srcbuf O32@ ( offset of l$offset buffer )
    srcbuf        ( srcbufferid )
    8 srcbuf O32@ ( length of l$offset buffer )
    GETPBUFFERSEGMENT ( doing it this way to make sure segment is in buffer )
    
    ?ERRORIF
      ( couldn't get pointer, source buffer probably too small )
      SUBROUTINEERROR PUSHOERROR0$
      EXIT
    THEN

    8 srcbuf O32@ ( poffsetbuffer offsetbufferlength-- )

    destoffsetbuf SU32[]>BUFU64[]

    ?ERRORIF
      ( couldn't push to l$offset buffer, it probably doesn't exist )
      SUBROUTINEERROR PUSHOERROR0$
      EXIT
    THEN


    ( extract string buffer )
    0 srcbuf O32@
    8 srcbuf O32@ +  ( offset of l$string buffer )
    TO ostringbuf
    srcbuf LENGTHBUF ostringbuf - TO stringbuflength
    
    ostringbuf srcbuf stringbuflength GETPBUFFERSEGMENT
    
    ?ERRORIF
      ( couldn't get pointer, this shouldn't happen )
      SUBROUTINEERROR PUSHOERROR0$
      EXIT
    THEN 

    stringbuflength deststringbuf S>BUF

    ?ERRORIF
      ( couldn't push to l$string buffer, it probably doesn't exist )
      SUBROUTINEERROR PUSHOERROR0$
      EXIT
    THEN      
;


ALLOCATEHSQLENV DROP
SETENVTOODBC3 

( Need to add flag to freehstatement that releases bindings )

