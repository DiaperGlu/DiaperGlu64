
$" odbcsqlsupport.dgluinc" INCLUDEFILE$

$" skin.dgluinc" INCLUDEFILE$


LOADFORMVALUES

: getpassword$ ( -- ) ( -$- password$|empty$ )
    
    $" password" POSTGETNAME$>VALUE$
;

: gethiddenpassword$ ( -- ) ( -$- hiddenpassword$|empty$ )
    
    $" hiddenpassword" POSTGETNAME$>VALUE$
;

: getdbtable$ ( -- ) ( -$- dbtable$|empty$ )
    
    $" dbtable" POSTGETNAME$>VALUE$
;

: getcolname$ ( -- ) ( -$- colname$|empty$ )
    
    $" colname" POSTGETNAME$>VALUE$
;

: getcolvalue$ ( -- ) ( -$- colvalue$|empty$ )
    
    $" colvalue" POSTGETNAME$>VALUE$
;

: getcoltype ( -- SQL_INTEGER|SQL_BINARY )
    $" coltype" POSTGETNAME$>VALUE$
    LENGTH$ 0= IF
      DROP$ SQL_BINARY EXIT
    THEN

    $" binary" COMPARE$ 0= IF
      DROP$ DROP$ SQL_BINARY
      EXIT
    THEN
  
    DROP$ DROP$

    SQL_INTEGER
;

    

: selectrowtodelete$ 
    $" SELECT * "
    $" FROM " $>$
    getdbtable$ $>$ 
    $"  WHERE " $>$
    getcolname$ $>$
    $" =" $>$      
    getcoltype SQL_BINARY = IF $" '" $>$ THEN
    getcolvalue$ $>$ 
    getcoltype SQL_BINARY = IF $" '" $>$ THEN
;

DECIMAL
: getbase ( -- 10|16 ) ( -$- )
    
    ['] base DUP ENDOFWORDLIST = IF
      16 EXIT
    THEN
    
    EXECUTE 

    $" decimal" COMPARE$ 0= IF
      DROP$ DROP$ 10 
      EXIT
    THEN
  
    DROP$

    $" DECIMAL" COMPARE$ 0= IF
      DROP$ DROP$ 10 
      EXIT
    THEN
  
    DROP$

    $" 10" COMPARE$ 0= IF
      DROP$ DROP$ 10 
      EXIT
    THEN
  
    DROP$ DROP$

    16
;

HEX
: drawpage ( -- )

    ." CONTENT-TYPE: text/html" CRLF 
    ." Cache-Control: no-cache, must-revalidate" CRLF
    ." Expires: Mon, 12 Jul 1997 05:00:00 GMT" CRLF
    CRLF

    drawprojectheader

    ." <h3 align='center'>Confirming delete.</h3>" CRLF

    ( check password )
    
    getpassword$ formpassword$ COMPARE$ DROP$ DROP$ 0= 0= IF

      ( they don't match )
      ." <p>Password is incorrect.<p>" CRLF
      // ." </body></html>" CRLF
      drawprojectfooter
      EXIT
    THEN

    ( check hidden password )
    
    gethiddenpassword$ hiddendeletepassword$ COMPARE$ DROP$ DROP$ 0= 0= IF

      ( they don't match )
      ." <p>You didn't come to this page through the form, access is denied.<p>" CRLF
      drawprojectfooter
      EXIT
    THEN
 
    ( checking table name for problems )
    getdbtable$ insertvalue$ok? DROP$ 0= IF

      ." <p>Something wrong with table name '"
      getdbtable$ .$
      ." ' you are trying to delete from. Please try another name.</p>" CRLF
      drawprojectfooter
      EXIT
    THEN

    ( checking column name for problems )
    getcolname$ insertvalue$ok? DROP$ 0= IF

      ." <p>Something wrong with column name '"
      getcolname$ .$
      ." ' you are using to identify the row for deletion. Please try another name.</p>" CRLF
      drawprojectfooter
      EXIT
    THEN

    ( checking column value for problems )
    getcolvalue$ insertvalue$ok? DROP$ 0= IF

      ." <p>Something wrong the column value '"
      getcolvalue$ .$
      ." ' you are using to identify the row for deletion. Please try another value.</p>" CRLF
      drawprojectfooter
      EXIT
    THEN

    ( load row to delete to result set )      
    selectrowtodelete$ con$ db$ GETRESULTSET

    ?ERRORIF
      ." <p>Error getting row to delete from database.</p>" CRLF
      drawprojectfooter
      EXIT
    THEN

    0 GETNUMBEROFROWSFROMRESULTSET 0= IF
      ." <p>Row not found in database.</p>" CRLF
      ." </body></html>" CRLF
    ELSE
      ." <p>Are you sure you want to delete this row?<br>" CRLF
      getbase BASE !
      0 $" border=1" DRAWRESULTSETASHTMLTABLE
      ." </p>" CRLF
    THEN

    ."   <form action='deleterow.dglu' runat=server method=post>" CRLF
    ."     <input type=hidden name=hiddenpassword value='" gethiddenpassword$ .$ ." '>" CRLF
    ."     <input type=hidden name=dbtable value='" getdbtable$ .$  ." '>" CRLF
    ."     <input type=hidden name=colname value='" getcolname$ .$  ." '>" CRLF
    ."     <input type=hidden name=colvalue value='" getcolvalue$ .$ ." '>" CRLF
    ."     <input type=hidden name=coltype value='" getcoltype SQL_BINARY = IF
             ." binary" ELSE ." integer" THEN  ." '>" CRLF
    ."     <br>Enter password again: <input type=password name=password>" CRLF
    ."     <br><input type=submit value='Delete!'>" CRLF
    ."   </form>"

    
    drawprojectfooter
;

drawpage


