    55
    TestL$[]obuf TestL$[]dbuf TestDestBuffer PACKL$>BUF ?ERRORIF NAME>E EXIT THEN
    TestDestBuffer TestL$[]obuf2 TestL$[]dbuf2 UNPACKBUF>L$
    TestL$[]obuf2 GETSBUFFER TestL$[]obuf GETSBUFFER COMPARE 0 <> IF .TESTFAILED EXIT THEN
    TestL$[]dbuf2 GETSBUFFER TestL$[]dbuf GETSBUFFER COMPARE 0 <> IF .TESTFAILED EXIT THEN

    ?STACKS
