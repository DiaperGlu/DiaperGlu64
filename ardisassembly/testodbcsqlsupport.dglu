$" config.dgluinc" INCLUDEFILE$
$" odbcsqlsupport.dgluinc" INCLUDEFILE$

CRLF ." Testing odbcsqlsupport.dgluinc"
CRLF

HEX
1000 -1 NEWBUFFER CONSTANT TestBuffer

HEX
: initTestBuffer
    TestBuffer EMPTYBUFFER
    1716151413121110 TestBuffer >BUF 1F1E1D1C1B1A1918 TestBuffer >BUF
    2726252423222120 TestBuffer >BUF 2F2E2D2C2B2A2928 TestBuffer >BUF
;

initTestBuffer

1000 -1 NEWBUFFER CONSTANT TestL$[]obuf
1000 -1 NEWBUFFER CONSTANT TestL$[]dbuf
$" moo" 0 GETS$[ND] TestL$[]obuf TestL$[]dbuf S>NEWL$ DROP$
$" cows" 0 GETS$[ND] TestL$[]obuf TestL$[]dbuf S>NEWL$ DROP$
$" drizzle" 0 GETS$[ND] TestL$[]obuf TestL$[]dbuf S>NEWL$ DROP$
$" thorn" 0 GETS$[ND] TestL$[]obuf TestL$[]dbuf S>NEWL$ DROP$

1000 -1 NEWBUFFER CONSTANT TestDestBuffer

1000 -1 NEWBUFFER CONSTANT TestL$[]obuf2
1000 -1 NEWBUFFER CONSTANT TestL$[]dbuf2

: .TESTFAILED CRLF ." - test failed" ;
HEX
: ?DSMARKER 55 <> IF CRLF ." - data stack marker missing" THEN ;
: ?$SEMPTY DEPTH$ 0<> IF CRLF ." string stack not empty after test" THEN ;
: ?STACKS ?DSMARKER ?$SEMPTY ;

CREATEOC OTEST0$ $" lift" $>0$ PCURRENTCOMPILEBUFFER @ $>BUF


