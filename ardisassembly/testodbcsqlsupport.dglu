TESTGETCOLUMNTYPESFROMRESULTSET

: TESTNEWRESULTSET

    CRLF ." testing NEWRESULTSET"
    55
    MakeTestResultSet

    SQL_BINARY SQL_BINARY SQL_INTEGER 3
    $" col3" $" col2" $" col1" 
    NEWRESULTSET

    GETCOLUMNTYPESFROMRESULTSET ?ERRORIF NAME>E EXIT THEN
      3 <> IF .TESTFAILED CRLF ." expected 3 columns" EXIT THEN
      SQL_BINARY <> IF .TESTFAILED CRLF ." expected SQL_BINARY on top" EXIT THEN
      SQL_BINARY <> IF .TESTFAILED CRLF ." expected SQL_BINARY second" EXIT THEN
      SQL_INTEGER <> IF .TESTFAILED CRLF ." expected SQL_INTEGER third" EXIT THEN

      2 GETNUMBEROFROWSFROMRESULTSET ?ERRORIF NAME>E EXIT THEN 0 <> IF .TESTFAILED CRLF ." expected 0 rows" EXIT THEN
      2 GETNUMBEROFCOLUMNSFROMRESULTSET ?ERRORIF NAME>E EXIT THEN 3 <> IF .TESTFAILED CRLF ." expected 3 columns" EXIT THEN
   

    ?STACKS
;

TESTNEWRESULTSET

HEX
: TESTADDDATAROWTORESULTSET

    CRLF ." testing ADDDATAROWTORESULTSET"
    55
    MakeTestResultSet
    
    ( top result set has 1 column )
    $" arctic" ADDDATAROWTORESULTSET

    GETCOLUMNTYPESFROMRESULTSET ?ERRORIF NAME>E EXIT THEN
      1 <> IF .TESTFAILED CRLF ." expected 1 columns" EXIT THEN
      SQL_BINARY <> IF .TESTFAILED CRLF ." expected SQL_BINARY on top" EXIT THEN

      1 GETNUMBEROFROWSFROMRESULTSET ?ERRORIF NAME>E EXIT THEN 6 <> IF .TESTFAILED CRLF ." expected 6 rows" EXIT THEN
      1 GETNUMBEROFCOLUMNSFROMRESULTSET ?ERRORIF NAME>E EXIT THEN 1 <> IF .TESTFAILED CRLF ." expected 3 columns" EXIT THEN
   

    // could test set with more than one column...

    ?STACKS
;

TESTADDDATAROWTORESULTSET


