TESTUNPACKBUF>L$


// allocate result handle in data space buffer
3 CONSTANT myRESULTSETROWS
2 CONSTANT myRESULTSETCOLUMNS

5 CONSTANT myRESULTSETROWS2
1 CONSTANT myRESULTSETCOLUMNS2

[HRESULTSET]
CREATE pmyHRESULTSET ( 3 rows 2 columns )
  ou32coltypes[] ( initialsize coltypesize -- ) myRESULTSETCOLUMNS * + ALLOT
  myRESULTSETROWS     pmyHRESULTSET ou32rows DROP + U32!
  myRESULTSETCOLUMNS  pmyHRESULTSET ou32columns DROP + U32!
  0                   pmyHRESULTSET ou32colname$index DROP + U32!
  0                   pmyHRESULTSET ou32data$index DROP + U32!
  // start of column type array 
  SQL_INTEGER         pmyHRESULTSET ou32coltypes[] DROP + U32!
  SQL_BINARY          pmyHRESULTSET ou32coltypes[] + + U32!

// pmyHRESULTSET ou32coltypes[] DROP 8 + DUMP

  CREATE pmyHRESULTSET2 ( 5 rows 1 columns )
  ou32coltypes[] ( initialsize coltypesize -- ) myRESULTSETCOLUMNS * + ALLOT
  myRESULTSETROWS2    pmyHRESULTSET2 ou32rows DROP + U32!
  myRESULTSETCOLUMNS2 pmyHRESULTSET2 ou32columns DROP + U32!
  2                   pmyHRESULTSET2 ou32colname$index DROP + U32!
  6                   pmyHRESULTSET2 ou32data$index DROP + U32!
  // start of column type array 
  SQL_BINARY          pmyHRESULTSET2 ou32coltypes[] DROP + U32!

// pmyHRESULTSET2 ou32coltypes[] DROP 4 + DUMP
  
SEARCH-ORDER> DROP


: MakeTestResultSet ( -- )
    SQLCOLTYPEL$STACKOFFSETBUFFERID EMPTYBUFFER
    SQLCOLTYPEL$STACKSTRINGBUFFERID EMPTYBUFFER
    SQLCOLNAMEL$STACKOFFSETBUFFERID EMPTYBUFFER
    SQLCOLNAMEL$STACKSTRINGBUFFERID EMPTYBUFFER
    SQLRESULTL$STACKOFFSETBUFFERID EMPTYBUFFER
    SQLRESULTL$STACKSTRINGBUFFERID EMPTYBUFFER

    // pushing result set 1
    pmyHRESULTSET [HRESULTSET] ou32coltypes[] ( p o l -- ) 2* + 
      SQLCOLTYPEL$STACKOFFSETBUFFERID SQLCOLTYPEL$STACKSTRINGBUFFERID S>NEWL$

    $" ID" 0 GETS$[ND] 
      SQLCOLNAMEL$STACKOFFSETBUFFERID SQLCOLNAMEL$STACKSTRINGBUFFERID S>NEWL$ DROP$

    $" VALUE" 0 GETS$[ND] 
      SQLCOLNAMEL$STACKOFFSETBUFFERID SQLCOLNAMEL$STACKSTRINGBUFFERID S>NEWL$ DROP$

    1 >NEW$ 0 GETS$[ND] DROP 4 ( changing length to size of a UINT32 )
      SQLRESULTL$STACKOFFSETBUFFERID SQLRESULTL$STACKSTRINGBUFFERID S>NEWL$ DROP$

    $" value1" 0 GETS$[ND] 
      SQLRESULTL$STACKOFFSETBUFFERID SQLRESULTL$STACKSTRINGBUFFERID S>NEWL$ DROP$

    2 >NEW$ 0 GETS$[ND] DROP 4 ( changing length to size of a UINT32 )
      SQLRESULTL$STACKOFFSETBUFFERID SQLRESULTL$STACKSTRINGBUFFERID S>NEWL$ DROP$

    $" value2" 0 GETS$[ND] 
      SQLRESULTL$STACKOFFSETBUFFERID SQLRESULTL$STACKSTRINGBUFFERID S>NEWL$ DROP$

    3 >NEW$ 0 GETS$[ND] DROP 4 ( changing length to size of a UINT32 )
      SQLRESULTL$STACKOFFSETBUFFERID SQLRESULTL$STACKSTRINGBUFFERID S>NEWL$ DROP$

    $" value3" 0 GETS$[ND] 
      SQLRESULTL$STACKOFFSETBUFFERID SQLRESULTL$STACKSTRINGBUFFERID S>NEWL$ DROP$

   // pushing result set 2
    pmyHRESULTSET2 [HRESULTSET] ou32coltypes[] ( p o l -- ) 1 * + 
      SQLCOLTYPEL$STACKOFFSETBUFFERID SQLCOLTYPEL$STACKSTRINGBUFFERID S>NEWL$

    $" STATUS" 0 GETS$[ND] 
      SQLCOLNAMEL$STACKOFFSETBUFFERID SQLCOLNAMEL$STACKSTRINGBUFFERID S>NEWL$ DROP$

    $" hot" 0 GETS$[ND] 
      SQLRESULTL$STACKOFFSETBUFFERID SQLRESULTL$STACKSTRINGBUFFERID S>NEWL$ DROP$

    $" cold" 0 GETS$[ND] 
      SQLRESULTL$STACKOFFSETBUFFERID SQLRESULTL$STACKSTRINGBUFFERID S>NEWL$ DROP$

    $" warm" 0 GETS$[ND] 
      SQLRESULTL$STACKOFFSETBUFFERID SQLRESULTL$STACKSTRINGBUFFERID S>NEWL$ DROP$

    $" tepid" 0 GETS$[ND] 
      SQLRESULTL$STACKOFFSETBUFFERID SQLRESULTL$STACKSTRINGBUFFERID S>NEWL$ DROP$

    $" frozen" 0 GETS$[ND] 
      SQLRESULTL$STACKOFFSETBUFFERID SQLRESULTL$STACKSTRINGBUFFERID S>NEWL$ DROP$
;



: TESTGETNUMBEROFCOLUMNSFROMRESULTSET

    CRLF ." testing GETNUMBEROFCOLUMNSFROMRESULTSET"
    55
    MakeTestResultSet
    
    0 GETNUMBEROFCOLUMNSFROMRESULTSET ?ERRORIF NAME>E EXIT THEN 2 <> IF .TESTFAILED EXIT THEN
    1 GETNUMBEROFCOLUMNSFROMRESULTSET ?ERRORIF NAME>E EXIT THEN 1 <> IF .TESTFAILED EXIT THEN

    ?STACKS
;

TESTGETNUMBEROFCOLUMNSFROMRESULTSET


