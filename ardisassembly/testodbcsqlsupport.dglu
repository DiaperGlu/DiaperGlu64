HEX
: TESTPACKL$>BUF
    CRLF ." testing PACKL$>BUF"
    55
    TestL$[]obuf TestL$[]dbuf TestDestBuffer PACKL$>BUF ?ERRORIF NAME>E EXIT THEN
    TestDestBuffer LENGTHBUF 2F <> IF .TESTFAILED ."  length test" EXIT THEN
    0 TestDestBuffer O>P U32@ 0C <> IF .TESTFAILED EXIT THEN
    4 TestDestBuffer O>P 4 S>NEW$ $" PKL$" COMPARE$ 0 <> IF .TESTFAILED EXIT THEN 
      DROP$ DROP$
    8 TestDestBuffer O>P U32@ 10 <> IF .TESTFAILED EXIT THEN
    0C TestDestBuffer O>P U32@ 3 <> IF .TESTFAILED EXIT THEN
    10 TestDestBuffer O>P U32@ 7 <> IF .TESTFAILED EXIT THEN
    14 TestDestBuffer O>P U32@ 0E <> IF .TESTFAILED EXIT THEN
    18 TestDestBuffer O>P U32@ 13 <> IF .TESTFAILED EXIT THEN
    1C TestDestBuffer O>P 3 S>NEW$ $" moo" COMPARE$ 0 <> IF .TESTFAILED EXIT THEN
      DROP$ DROP$
    1F TestDestBuffer O>P 4 S>NEW$ $" cows" COMPARE$ 0 <> IF .TESTFAILED EXIT THEN
      DROP$ DROP$
    23 TestDestBuffer O>P 7 S>NEW$ $" drizzle" COMPARE$ 0 <> IF .TESTFAILED EXIT THEN
      DROP$ DROP$
    2A TestDestBuffer O>P 5 S>NEW$ $" thorn" COMPARE$ 0 <> IF .TESTFAILED EXIT THEN
      DROP$ DROP$
    ?STACKS
