HEX
: TESTGETDATA$FROMRESULTSET

    CRLF ." testing GETDATA$FROMRESULTSET"
    55
    MakeTestResultSet

    1 1 0 GETDATA$FROMRESULTSET ?ERRORIF NAME>E EXIT THEN 
      0 GETS$[ND] DROP U32@ 1 <> 
      IF .TESTFAILED CRLF ." expected 1" EXIT THEN DROP$

    2 1 0 GETDATA$FROMRESULTSET ?ERRORIF NAME>E EXIT THEN 
      $" value1" COMPARE$ 0<> 
      IF .TESTFAILED CRLF ." expected value1" EXIT THEN DROP$ DROP$

    1 2 0 GETDATA$FROMRESULTSET ?ERRORIF NAME>E EXIT THEN 
      0 GETS$[ND] DROP U32@ 2 <>
      IF .TESTFAILED CRLF ." expected 2" EXIT THEN DROP$

    2 2 0 GETDATA$FROMRESULTSET ?ERRORIF NAME>E EXIT THEN 
      $" value2" COMPARE$ 0<> 
      IF .TESTFAILED CRLF ." expected value2" EXIT THEN DROP$ DROP$

    1 3 0 GETDATA$FROMRESULTSET ?ERRORIF NAME>E EXIT THEN 
      0 GETS$[ND] DROP U32@ 3 <>
      IF .TESTFAILED CRLF ." expected 3" EXIT THEN DROP$ 

    2 3 0 GETDATA$FROMRESULTSET ?ERRORIF NAME>E EXIT THEN 
      $" value3" COMPARE$ 0<> 
      IF .TESTFAILED CRLF ." expected value3" EXIT THEN DROP$ DROP$

    1 1 1 GETDATA$FROMRESULTSET ?ERRORIF NAME>E EXIT THEN 
      $" hot" COMPARE$ 0<> 
      IF .TESTFAILED CRLF ." expected hot" EXIT THEN DROP$ DROP$

    1 2 1 GETDATA$FROMRESULTSET ?ERRORIF NAME>E EXIT THEN 
      $" cold" COMPARE$ 0<> 
      IF .TESTFAILED CRLF ." expected cold" EXIT THEN DROP$ DROP$

    1 3 1 GETDATA$FROMRESULTSET ?ERRORIF NAME>E EXIT THEN 
      $" warm" COMPARE$ 0<> 
      IF .TESTFAILED CRLF ." expected warm" EXIT THEN DROP$ DROP$

    1 4 1 GETDATA$FROMRESULTSET ?ERRORIF NAME>E EXIT THEN 
      $" tepid" COMPARE$ 0<> 
      IF .TESTFAILED CRLF ." expected tepid" EXIT THEN DROP$ DROP$

    1 5 1 GETDATA$FROMRESULTSET ?ERRORIF NAME>E EXIT THEN 
      $" frozen" COMPARE$ 0<> 
      IF .TESTFAILED CRLF ." expected frozen" EXIT THEN DROP$ DROP$

    ?STACKS
;

TESTGETDATA$FROMRESULTSET


HEX
: TESTUINT32>NEWDEC$

    CRLF ." testing UINT32>NEWDEC$"
    55
    MakeTestResultSet

    FF UINT32>NEWDEC$ $" 255" COMPARE$ 0<>
      IF .TESTFAILED CRLF ." expected 1" EXIT THEN DROP$ DROP$

    ?STACKS
;

TESTUINT32>NEWDEC$


