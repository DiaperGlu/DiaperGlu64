: TESTCONNECTSQLANDDOSTATEMENT$
    CRLF ." testing CONNECTSQLANDDOSTATEMENT$"
    55

    ?ERRORIF ERROR" had error before test started" NAME>E EXIT THEN

    $" DROP DATABASE mytestdb"
    con$ NEW$ CONNECTSQLANDDOSTATEMENT$ ( will get error if database does not exist )
    ?ERRORIF EES ( ignoring errors ) THEN

    $" CREATE DATABASE mytestdb" 
    con$ NEW$ CONNECTSQLANDDOSTATEMENT$ ( seeing if there are any errors )
    ?ERRORIF ERROR" got error trying to create new database" NAME>E EXIT THEN

    ?STACKS
;

TESTCONNECTSQLANDDOSTATEMENT$

