// Source EFT18M.ASM line 3720
BARHERE CONSTANT ENDSSN

  // Add reinforcement units that arrive on this turn 
  DOARRIVALS U16 JSR,

  // See if units have 'lost supply' and divide hp by 2 if they did
  DOLOGISTICS U16 JSR,

  // CALC SOME POINTS
  CALCPOINTSFORGERMANPOSITION U16 JSR,
  CALCPOINTSFORRUSSIANPOSITION U16 JSR,
  GETSCORE U16 JSR, 
  DRAWSCORE U16 JSR,  

