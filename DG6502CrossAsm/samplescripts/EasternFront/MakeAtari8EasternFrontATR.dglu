  // Source EFT18M.ASM line 4850
  // Z00 
  0 U8 LDA,
  BUTMSK [U] STA, // enable pressing fire button
  CORPS [U] STA,

  TXTMSG U16 JSR, // draw Please Enter Your Orders message

  RUSSIANAI U16 JSR, // 4700 artificial intelligence routine - returns when user presses START

  // disable pressing fire button
  1 U8 LDA,
  BUTMSK [U] STA, 

  // draw Figuring Move: No Orders Allowed
  2 U8 LDA,
  TXTMSG U16 JSR, 

  // Source EFT18M.ASM line 4950
  // movement execution phase
  0 U8 LDA,
  TICK [U] STA, // there are 32 ticks per turn, faster units move first

  // determine on which tick armies move
  DINGOALL U16 JSR,

  // BEGIN,  
  BARHERE CONSTANT LOOP33

    // DrawTICK U16 JSR,
    NUMBEROFUNITS U8 LDX,
    // BEGIN,  
    BARHERE CONSTANT LOOP32

      ARMY [U] STX,
      // DrawMOVEMENT U16 JSR, // for testing
      // ARMY [U] LDX, // for testing

      // each tick give army back 1 or 2 points of combat strength
      // armies with high initial strength that are more beat down are more likely to get 2
      MSTRNG [U+X] LDA,
      SEC,
      CSTRNG [U+X] SBC,
      2 U8 CMP,
      CS IF,
        CSTRNG [U+X] INC,
        RANDOM [U] CMP, // mstrng[x] - cstrng[x] >= random
        CS IF,
          CSTRNG [U+X] INC,
        THEN,
      THEN, 

      EXEC [U+X] LDA,
      PL IF, CONSTANT toA60a // to a60
        // unit does move

        TICK [U] CMP,
        EQ IF, CONSTANT toA60b // to a60

          // unit moves on this tick 

          // get order ... an order is a move to N E S or W
          //   2 bits are used to encode each order         
          WHORDS [U+X] LDA,
          3 U8 AND,
          TAY, // Y = order

          // get destinationx into [LONG] [ACCLO]
          CORPSX [U+X] LDA,
          CLC,
          XINC [U+Y] ADC,
          LONG [U] STA,
          ACCLO [U] STA,

          // get destinationy into [LAT] [ACCHI] 
          CORPSY [U+X] LDA,
          CLC,
          YINC [U+Y] ADC,
          LAT [U] STA,
          ACCHI [U] STA,

          // get what terrain and/or unit is in destination square
          TERR U16 JSR,

          // is there a unit on destination square?
          UNITNO [U] LDA, 
          NE IF, CONSTANT toDOMOVEa // to domove 
            
            // there is a unit on destination square
            // is the unit on destination square Russian?
            FIRSTRUSSIANUNIT U8 CMP,
            CS IF, // to GERMAN

              // unit on destination square is russian
              // is the unit moving German?
              ARMY [U] LDA,
              FIRSTRUSSIANUNIT U8 CMP,
              NC IF, CONSTANT toTRJAMa  // to trjam
              CS IF, CONSTANT toCOMBATa // to combat

            // GERMAN  
            THEN,
            ARMY [U] LDA,
            FIRSTRUSSIANUNIT U8 CMP,
              NC IF, CONSTANT toCOMBATb // to combat
              
              // destination unit is friendly... try to move again in 2 ticks
              BARHERE CONSTANT TRJAM 
              toTRJAMa THEN,
              ARMY [U] LDX,
              TICK [U] LDA,
              CLC,
              2 U8 ADC,
              EXEC [U+X] STA,

BARHERE CONSTANT A60 
        // A60
        toA60a THEN,
      toA60b THEN,
      0 U16 JMP, BARHERE CONSTANT toY06a // to next army

                // COMBAT 
                toCOMBATa THEN,
                toCOMBATb THEN,
      OCOMBAT U16 JSR, // combat routine should be call to $4eD8
      VICTRY [U] LDA,
