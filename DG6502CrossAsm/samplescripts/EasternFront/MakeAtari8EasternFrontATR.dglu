BARHERE CONSTANT RUSSIANAI // was 4700 

  // Get sum of combat strengths for each team
  //   [TOTRS] = high byte of 0x101 + sum of Russian combat strengths
  //   [TOTGS] = high byte of 0x100 + left over low byte of Russian combat strengths +
  //     sum of German combat strengths  
  GETTOTALCOMBATSTRENGTHS U16 JSR,

  // Scale German and Russian combat strength totals
  //  shift copy of German sum to the left up to 4 times until highest set bit is in highest position
  //  using highest bit of German sum from before shift, scale Russian sum
  //  if bit 7 was highest, divide russian sum by 16 
  //  if bit 6 was highest, divide russian sum by 8 
  //  if bit 5 was highest, divide russian sum by 4
  //  if bit 4 was highest, divide russian sum by 2
  //  [TOTGS]=germansum [TOTRS]=russiansum -mem- [TOTRS]=scaledrussiansum
  SCALETOTALCOMBATSTRENGTHS U16 JSR,
  
  CALCOFR U16 JSR, // [OFR] = 0xFF/[TOTRS]
                   // [OBJX+x] = [CORPSX+x]; [OBJY+x] = [CORPSY+x]
      
