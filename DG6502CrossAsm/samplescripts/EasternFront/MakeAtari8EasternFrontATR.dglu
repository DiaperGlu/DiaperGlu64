  BARHERE CONSTANT DigitToChar ( RA=u - RA=c )
    0F U8 AND,
    0A U8 CMP,
    CS IF, 
      20 0A - U8 ADC,
      RTS,
    THEN,
    // carry is not set
    10 U8 ADC,
    RTS,

  BARHERE CONSTANT DrawHexByte ( RA=byte Y=TXTWDWTOPoffset -- )
    INY,
    TAX,
    DigitToChar U16 JSR,
    TXTWDWTOP [U+Y] STA,
    TXA, RA LSR, RA LSR, RA LSR, RA LSR,
    DigitToChar U16 JSR,
    DEY,
    TXTWDWTOP [U+Y] STA, 
    NOP,
    // INY,
    RTS,

  BARHERE CONSTANT DrawHexByte2 ( RA=byte Y=TXTWDWoffset -- )
    INY,
    TAX,
    DigitToChar U16 JSR,
    TXTWDW [U+Y] STA,
    TXA, RA LSR, RA LSR, RA LSR, RA LSR,
    DigitToChar U16 JSR,
    DEY,
    TXTWDW [U+Y] STA,
    NOP,
    // INY,
    RTS,

