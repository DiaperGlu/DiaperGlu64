// Display list has to go in ram and lms is needed in order to do the scrolling of the oversize map
// Also, game uses wide playfield, so left and right most pixels are not shown... 
//   wide playfield is 384 pixels. So 64 extra pixels or 4 extra characters in antic mode 7, but you lose 1 1/2 character on each side)
//   emulator default mode only shows 336 characters. 
HEX
BARHERE CONSTANT DISPLAYLIST CRLF ." display list starts at " DISPLAYLIST U.
( +00 ) 70 CC, 70 CC, 70 CC,                                // 24 blank lines
( +03 ) C6 CC, TXTWDWTOP DUP CC, 8 RSHIFT CC,               // dli, lms 64E0, 40x24 5 color text mode
( +06 ) 90 CC, 90 CC,                                       // 2 blank lines with dli 
( +08 ) F7 CC, MAPDATA                DUP CC, 8 RSHIFT CC,  // vscroll, hscroll, dli, lms 64FE 40x12 5 color text mode - upper 2 bits select foreground color
( +0B ) F7 CC, MAPDATA 1 MAPWIDTH * + DUP CC, 8 RSHIFT CC,  // vscroll, hscroll, dli, lms 652E 40x12 5 color text mode - upper 2 bits select foreground color
( +0E ) F7 CC, MAPDATA 2 MAPWIDTH * + DUP CC, 8 RSHIFT CC,  // vscroll, hscroll, dli, lms 655E 40x12 5 color text mode - upper 2 bits select foreground color
( +11 ) F7 CC, MAPDATA 3 MAPWIDTH * + DUP CC, 8 RSHIFT CC,  // vscroll, hscroll, dli, lms 658E 40x12 5 color text mode - upper 2 bits select foreground color
( +14 ) F7 CC, MAPDATA 4 MAPWIDTH * + DUP CC, 8 RSHIFT CC,  // vscroll, hscroll, dli, lms 65BE 40x12 5 color text mode - upper 2 bits select foreground color
( +17 ) F7 CC, MAPDATA 5 MAPWIDTH * + DUP CC, 8 RSHIFT CC,  // vscroll, hscroll, dli, lms 64EE 40x12 5 color text mode - upper 2 bits select foreground color
( +1A ) F7 CC, MAPDATA 6 MAPWIDTH * + DUP CC, 8 RSHIFT CC,  // vscroll, hscroll, dli, lms 661E 40x12 5 color text mode - upper 2 bits select foreground color
( +1D ) F7 CC, MAPDATA 7 MAPWIDTH * + DUP CC, 8 RSHIFT CC,  // vscroll, hscroll, dli, lms 664E 40x12 5 color text mode - upper 2 bits select foreground color
( +20 ) F7 CC, MAPDATA 8 MAPWIDTH * + DUP CC, 8 RSHIFT CC,  // vscroll, hscroll, dli, lms 667E 40x12 5 color text mode - upper 2 bits select foreground color
( +23 ) 57 CC, MAPDATA 9 MAPWIDTH * + DUP CC, 8 RSHIFT CC,  // hscroll, lms 66AE 40 x 12 5 color text mode
( +26 ) 90 CC,                                              // blank line with dli 
( +27 ) C2 CC, TXTWDW DUP CC, 8 RSHIFT CC,                  // dli, lms 6450, 40x24 8x8 1 1/2 color text mode  
