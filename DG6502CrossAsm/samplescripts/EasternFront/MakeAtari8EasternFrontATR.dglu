  INY,
  INY,
  11 U8 LDA,
  TXTWDW [U+Y] STA,
  INY,
  19 U8 LDA,
  TXTWDW [U+Y] STA,
  INY,
  14 U8 LDA,
  TXTWDW [U+Y] STA,
  INY,

  // draw last digit of year
  YEAR [U] LDX,
  ODIGIT [U+X] LDA,
  CLC,
  10 U8 ADC,
  TXTWDW [U+Y] STA,

  RTS,

// Source EFT18M.ASM line 3110
HEX
BARHERE CONSTANT GETFREEZELAT ( -reg- ra=newfreezelat )
  RANDOM [U] LDA,
  7 U8 AND,
  CLC, // ?
  // [SEASN2] = FF in feb and 0 in apr
  SEASN2 [U] EOR, 
  TEMPR [U] STA, // = [SEASN2] xor rnd(0-7)

  // [TEMPR] = 0-7 in not winter and -1 to -8 in winter 

  ICELAT [U] LDA,
  OLDLAT [U] STA,

  SEC,
  TEMPR [U] SBC, 

  // clamp to map
  NE IF,
    MI IF,
  SWAP THEN,
  1 U8 LDA, // if <= 0 set to 1
    THEN,
  MAPHEIGHT 1- U8 CMP,
  CS IF, // to X93
    MAPHEIGHT 1- U8 LDA, // if >= MAPHEIGHT set to MAPHEIGHT - 1
  THEN,
  RTS,

HEX
BARHERE CONSTANT DOFREEZE
  GETFREEZELAT U16 JSR,

// Source EFT18M.ASM line 3290 tag X93
// should be terrain@ isterrainfreezable ifso changeterraincolor terrain! then
BARHERE CONSTANT FREEZERIVERS
  ICELAT [U] STA,

  1 U8 LDA,
  CHUNKX [U] STA,
  LONG [U] STA,

  OLDLAT [U] LDA, // start at old freeze lat
  CHUNKY [U] STA,
  LAT [U] STA,

  // for each square from old icelat to new icelat do
  BEGIN, // LOOP40
    TERRAIN@ U16 JSR,     
    3F U8 AND,        // terrain code without color

    // if not border or plain (compares with first city code)
    0B U8 CMP,        
    CS IF, // to notch

      // is not border or plain
      // if less than frozen river
      29 U8 CMP,
      NC IF, // to notch

        // is less than frozen river and not border or plain
        // if current y is >= 0E
        CHUNKY [U] LDX,
        0E U8 CPX,
        NC IF, // to dotch

          // current y is < 23
          23 U8 CMP,
          NC IF, // to notch

            // current y is < 23
        SWAP THEN,
          // dotch
          SEASN1 [U] ORA, // [SEASN1] is 0x80 in february and 0x40 in april.. so um.. winter?
          TERRAIN! U16 JSR,

          THEN,
      THEN,
    THEN,

    // notch - next square
    CHUNKX [U] INC,
    CHUNKX [U] LDA,
    LONG [U] STA,
    2E U8 CMP,
  DUP EQ UNTIL, // to loop 40
    0 U8 LDA,
    CHUNKX [U] STA,
    LONG [U] STA,
    CHUNKY [U] LDA,
    ICELAT [U] CMP,
    EQ IF, // to endssn
      RTS,
      // ENDSSN U16 JMP,
    THEN,
    SEC,
    SEASN3 [U] SBC,
    CHUNKY [U] STA,
    LAT [U] STA,
  U16 JMP, // to loop 40


// Source EFT18M.ASM line 2690
HEX
BARHERE CONSTANT CALCSEASON

  MONTH [U] LDA,
  4 U8 CMP, // April
  EQ IF,
    2 U8 LDA,
    EARTH [U] STA,
    40 U8 LDA,
    SEASN1 [U] STA,
    1 U8 LDA,
    SEASN3 [U] STA,
    0 U8 LDA,
    SEASN2 [U] STA,
    // ENDSSN U16 JMP,
    RTS,
  THEN,

  0A U8 CMP, // October
  EQ IF,
    2 U8 LDA,
    EARTH [U] STA,
    // ENDSSN U16 JMP,
    RTS,
  THEN,

  5 U8 CMP, // March
  EQ IF,
    10 U8 LDA,
    EARTH [U] STA, 
    // ENDSSN U16 JMP,
    RTS, 
  THEN,

  0B U8 CMP, // November
  EQ IF,
    0A U8 LDA,
    EARTH [U] STA,
    DOFREEZE U16 JSR,
    RTS,
  THEN,

  01 U8 CMP, // February
  EQ IF,
    80 U8 LDA,
    SEASN1 [U] STA,
    FF U8 LDA,
    SEASN2 [U] STA,
    SEASN3 [U] STA,
    // ENDSSN U16 JMP,
    RTS,
  THEN,

  3 U8 CMP, // March
  NE IF, // to X91
    // ENDSSN U16 JMP,
    RTS, 
  THEN,

  DOFREEZE U16 JSR,
  RTS,


