BARHERE CONSTANT DRAWUNITSPECS ( x=unitnumber -- )
  // display unit specs
  CORPS [U] STX,
  0D U8 LDY,
  CORPNO [U+X] LDA, // ID number
  DNUMBR U16 JSR,

  INY,
  CORPS [U] LDX,
  CORPT [U+X] LDA, // unit name
  TEMPI [U] STA,
  F0 U8 AND,
  RA LSR,
  ENTRY2 U16 JSR,

  0F U8 AND, // second name
  CLC,
  08 U8 ADC,
  DWORDS U16 JSR,

  1E U8 LDA, // "ARMY" for Russian
  CORPS [U] LDX,
  FIRSTRUSSIANUNIT U8 CPX,
  NC IF,
    1D U8 LDA, // "CORP" for German
  THEN,
  DWORDS U16 JSR, // display unit size (corps or army)

  38 U8 LDY,
  1F U8 LDA, // "MUSTER"
  DWORDS U16 JSR,

  DEY,
  1A U8 LDA, // ":" 
  TXTWDW [U+Y] STA,

  INY,
  INY,
  CORPS [U] LDX,
  MSTRNG [U+X] LDA,
  DNUMBR U16 JSR,

  INY,
  INY,
  20 U8 LDA, // "COMBAT"
  DWORDS U16 JSR,

  21 U8 LDA, // "STRENGTH"
  DWORDS U16 JSR,

  DEY,
  1A U8 LDA, // ":"
  TXTWDW [U+Y] STA, 

  INY,
  INY,
  CORPS [U] LDX,
  CSTRNG [U+X] LDA, // combat strength
  DNUMBR U16 JSR,

  RTS,

// Source EFT18I.ASM line 3720
BARHERE CONSTANT GETCOORDS

  // [TXH:L] <- [CURSXH:L] + 6
  CURSXL [U] LDA,
  CLC,
  06 U8 ADC,
  TXL [U] STA,
  CURSXH [U] LDA,
  0 U8 ADC,
  TXH [U] STA,

  // [TYH:L] <- [CURSYH:L] + 9
  CURSYL [U] LDA,
  CLC,
  9 U8 ADC,
  TYL [U] STA,
  CURSYH [U] LDA,
  0 U8 ADC,
  TYH [U] STA,

  // [CHUNKX] <- [TXH:L] / 16 using bits 4-8
  TXH [U] LDA,
  RA LSR,
  TXL [U] LDA,
  RA ROR,
  RA LSR,
  RA LSR,

  // coords of cursor (pixel frame)
  CHUNKX [U] STA, // changes CHUNKX

  // [CHUNKY] <- [TYH:L] / 16 using bits 4-9
  TYH [U] LDA,
  RA LSR,       // bit 8 is now in carry bit
  TAX,          // X now has bits 8-15 shifted right once
  TYL [U] LDA,
  RA ROR,
  TAY,          // Y now has bits 1-8 shifted right once
  TXA,
  RA LSR,       // bit 9 is now in carry bit 
  TYA,          // RA now has bits 1-8 shifted once
  RA ROR,       // RA now has bits 2-9 shifted twice
  RA LSR,       // RA now has bits 3-9 shifted 3 times
  RA LSR,       // RA now has bits 4-9 shifted 4 times
  CHUNKY [U] STA, // changes CHUNKY
  RTS,


// Source EFT18I.ASM line 4330
BARHERE CONSTANT DOUNITMATCHES
  // match obtained - x = unit number
  0 U8 LDA,
  HITFLG [U] STA, // note match
  CH [U] STA,

  5C U8 LDA,
  PCOLR0 [U] STA, // light up cursor

  // display unit specs - also stores x in corps
  DRAWUNITSPECS U16 JSR,

  // flip unit with terrain
  SWITCH U16 JSR, // !!! uses SWITCH
  CORPS [U] LDA,
  FIRSTRUSSIANUNIT U8 CMP,
  CS IF, // Russian?
    FF U8 LDA, // yes, mask orders and exit
    HITFLG [U] STA,
    PL IF,  // to X75
  SWAP THEN,
  // German unit, set up orders display
  //   first calculate starting coords (BASEX, BASEY)
  1 U8 LDA,
  ORDCNT [U] STA,
  0 U8 LDA,
  STPCNT [U] STA,

  TXL [U] LDA,
  7 U8 LDA,
  CLC,
  1 U8 ADC,
  CLC,
  SHPOS0 [U] ADC,
  BASEX [U] STA,
  STEPX [U] STA,

  TYL [U] LDA,
  0F U8 AND,
  RA LSR,
  SEC,
  1 U8 SBC,
  CLC,
  SCY [U] ADC,
  BASEY [U] STA,
  STEPY [U] STA,

  // now set up page 6 values
  CORPS [U] LDX,
  HMORDS [U+X] LDA,
  HOWMNY [U] STA,
  WHORDS [U+X] LDA,
  ORD1 [U] STA,
  WHORDH [U+X] LDA,
  ORD2 [U] STA,
    ( this was x75 )
    THEN,
  RTS,

