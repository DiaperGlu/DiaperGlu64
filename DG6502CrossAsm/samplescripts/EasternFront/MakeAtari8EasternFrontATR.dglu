BARHERE CONSTANT OINIT // init game

// DLSTPT   zero page pointer to display list
// DLSTPTHI
//  MAPLO
//  MAPHI
//  CORPS   number of unit under window
//  CURSXL
//  CURSXH  cursor coordinates on screen (map frame)
//  CURSYL
//  CURSYH

  INITMAPUNITS U16 JSR,

  // Source EFT18M.ASM line 1270
  08 U8 LDX,
  BEGIN,
    ZPVAL [U+X] LDA,
    DLSTPT [U+X] STA,
    COLTAB [U+X] LDA,
    PCOLR0 [U+X] STA,
    DEX,
  MI UNTIL,

// XPOSL  ( was 0x600 )
// YPOSL  ( 601 )
// YPOSH  ( 602 )
// SCY    ( 603 )
// SHPOS0 ( 604 )
// TRCOLR ( 605 )
// EARTH  ( 606 )
// ICELAT ( 607 )
// SEASN1 ( 608 )
// SEASN2 ( 609 )
// SEASN3 ( 60A )
// DAY    ( 60B )
// MONTH  ( 60C )
// YEAR   ( 60D )
// BUTFLG ( 60E )
// BUTMSK ( 60F )

  0F U8 LDX,
  BEGIN,
    PSXVAL [U+X] LDA,
    XPOSL [U+X] STA,
    DEX,
  MI UNTIL,

  DLSTPT [U] LDA,
  DLSTLO [U] STA,
  DLSTPTHI [U] LDA,
  DLSTHI [U] STA,

  0 U8 LDA,  // really should be [XPOSL] AND 7
  HSCROL [U] STA,
  VSCROL [U] STA,

  0 U8 LDX,
  BEGIN,
    MSTRNG [U+X] LDA, // initial combat strength - muster strength
    CSTRNG [U+X] STA, // combat strength
    0 U8 LDA,
    HMORDS [U+X] STA, // how many orders
    FF U8 LDA,      // FF = never
    EXEC [U+X] STA, // on which tick to execute order
    INX,
    NUMBEROFUNITS 1+ U8 CPX,
  EQ UNTIL,

  // Source EFT18M.ASM line 1600
  // Set up player window
  PLAYERWINDOWHI U8 LDA,
  PMBASE [U] STA,

  // here follow various initializations
  // wide playfield is 384 pixels but only 352 are visible... 
  //  so two extra characters on each side, but you can only see part of one of them.
  2F U8 LDA,       // wide playfield, missile dma, player dma, 
                   //  two line player resolution, dma enabled
  SDMCTL [U] STA,
  03 U8 LDA,       // players on, missiles on
  GRACTL [U] STA,
  PM0INITIALXPOS U8 LDA,   
  HPOSP0 [U] STA,
  01 U8 LDA,
  HANDCP [U] STA,
  GPRIOR [U] STA,
  SIZEP0 [U] STA,
  
  // init player 0 graphics
  33 U8 LDX,
  FF U8 LDA,
  PLYR0 [U+X] STA,
  INX,
  PLYR0 [U+X] STA,
  INX,
  81 U8 LDA,
  BEGIN,
    PLYR0 [U+X] STA,
    INX,
    3F U8 CPX,
  EQ UNTIL,
  FF U8 LDA,
  PLYR0 [U+X] STA,
  TURN [U] STA,
  INX,
  PLYR0 [U+X] STA,

  // Source EFT18M.ASM line 1950
  // Enable deferred vertical blank interrupt
  OVBI FF AND U8 LDY,  // was 0
  OVBI 8 RSHIFT U8 LDX, // was 74
  07 U8 LDA,
  SETVBV U16 JSR,

  // For testing
  // ENDISR FF AND U8 LDY,  
  // ENDISR 8 RSHIFT U8 LDX, 
  // 07 U8 LDA,
  // SETVBV U16 JSR,

  // set up dli vector
  DLISRV U8 LDA, // was 0
  VDSLST [U] STA,
  DLISRV 8 RSHIFT U8 LDA, // was 74
  VDSLST 1+ [U] STA,
  C0 U8 LDA,
  NMIEN [U] STA, // enable dli and vbi interrupts
  RTS, 


BARHERE CONSTANT MEGASTALL
  FF U8 LDX,
  BEGIN,
    STALL U16 JSR,
    DEX,
  EQ UNTIL,
  RTS,


// TERRTY determines the type of terrain in a square
//    type     name        code
//      0      plain         0
//     7F (3F) border        9
//    <07      mountain      1
//    <4B (0B) city          2
//    <4F (0F) frozen swamp  3
//    <69 (29) frozen river  4
//    <8F (0F) swamp         5
//    <A4 (24) river         6   if [LAT] < 0E  and <A9 is also 6
//    <BA (3A) coastline     7   if [LAT] < 0E  and <BB is also 7
//    <BD (3D) unit          8
//   >=BD      ?             9   
// Source EFT18M.ASM lie 8160
BARHERE CONSTANT TERRTY ( was 7369 ) ( [TNRCOD] -mem- [TRNTYP]=terraintype ) 
                                     ( -reg- y=terraintype )
  0 U8 LDY,
  TRNCOD [U] LDA, // terrain code
  NE IF, // to done
    7F U8 CMP, // border?
    EQ IF, // to Y04
      09 U8 LDY,
      EQ IF, // to done
    ( Y04 ) 
    SWAP THEN,
    INY,
    7 U8 CMP, // mountain?
    CS IF, // to done
      INY,
      4B U8 CMP, // city?
      CS IF, // to done
        INY,
        4F U8 CMP, // frozen swamp?
          CS IF, // to done
            INY,
            69 U8 CMP, // frozen river?
            CS IF, // to done
              INY,
              8F U8 CMP, // swamp?
              CS IF, // to done
                INY,
                A4 U8 CMP, // river?
                CS IF, // to done
                  LAT [U] LDX,
                  0E U8 CPX,
                  CS IF, // to next
                    A9 U8 CMP,
                    CS IF, // to done
                  ( next )
                  SWAP THEN,
                  INY,
                  BA U8 CMP, // coastline?
                  CS IF, // to done
                    0E U8 CPX,
                    CS IF, // to next2
                      BB U8 CMP, 
                      CS IF, // to done
                    ( next2 )
                    SWAP THEN,
                    INY,
                    BD U8 CMP,
                    CS IF, // to done
                      INY,
                    ( done )
                    THEN,
                      THEN,
                  THEN,
                    THEN,
                THEN,
              THEN,
            THEN,
          THEN,
        THEN,
      THEN,
    THEN,
  THEN,
  TRNTYP [U] STY, // terrain type
  RTS,

// Source EFT18M.ASM line 6720
HEX
BARHERE CONSTANT TERRB 
  //  [LAT] [LONG] -mem- [TRNCOD]
  //    [LAT] = map ypos
  //    [LONG] = map xpos
  //    [TRNCOD] = character at displayed map[x,y], which includes the unit characters 
  //  -reg- zfcf 
  //    zflag is set if it's a military unit, 
  //    carry is set if it's a military unit or impassible

  0 U8 LDA, 
  UNITNO [U] STA, // some parent routines also calculate the unit on this square

  LOCTOMAPPTR U16 JSR,

  MAPPTR [[U8]+Y] LDA,
  TRNCOD [U] STA,
  3F U8 AND,
  3D U8 CMP,
  NE IF,
    3E U8 CMP,
  THEN,
  RTS, 


// Source EFT18M.ASM line 6690
BARHERE CONSTANT TERR // was 7240 - determines what terrain and unit is in a square
  //  [LAT] [LONG] -mem- [TRNCOD] [UNITNO]
  //    [LAT] = map ypos
  //    [LONG] = map xpos
  //    [TRNCOD] = terrain character, does not have unit characters
  //      this is the terrain under a character if there is a character on the square
  //    [UNITNO] = 0 if no unit on square, is unit number if unit is on square
  TERRB U16 JSR,
  NE IF, 
    RTS, // [UNITNO] = 0; [TRNCOD] = terrain on square
  THEN,

  // terrain code is 3D or 3E indicating a unit is there.
  TRNCOD [U] LDA,
  UNTCOD [U] STA,

  LOCTOUNIT U16 JSR,

  EQ IF,

    // J.N. run time error check added. no unit found on square, display message and lock up
    DrawLOC U16 JSR,
    BEGIN, CLC, CS UNTIL, // lock up...

  THEN,

  UNITNO [U] STA,
  SWAPIT [U+X] LDA, 
  TRNCOD [U] STA, // [UNITNO] = unit on square; [TRNCOD] = terrain on square
  RTS,


// DINGO determines on which tick the unit will move
//   there are 32 ticks per turn
//   the order in which units move is determined by
//    their type (infantry vs armor), the season, 
//    and what terrain they are on
//    [TICK] is the current tick
//    [EXEC+armyid] is the tick the unit will move on
// Source EFT18M.ASM line 7440
BARHERE CONSTANT DINGO // CRLF ." DINGO = " DINGO HEX U.
  // DrawDINGO U16 JSR,
  // does army have any orders?
  ARMY [U] LDX,
  HMORDS [U+X] LDA,  // HMORDS = how many orders
  EQ IF,
    // no, set exec to FF and exit does FF mean 'no time'?
    FF U8 LDA,
    EXEC [U+X] STA,
    RTS,
  THEN,

// Source EFT18M.ASM line 7500
BARHERE CONSTANT Y00
  // get army type from map (3D for infantry or 3E for tank) 
  CORPSX [U+X] LDA,
  LONG [U] STA,
  CORPSY [U+X] LDA,
  LAT [U] STA,

  // why do this when terrain is already swapped?
  TERR U16 JSR,
  UNTCOD [U] LDA,
  UNTCD1 [U] STA, // 3D for infantry or 3E for tank

  // get order
  ARMY [U] LDX,
  WHORDS [U+X] LDA,
  2 U8 EOR,
  3 U8 AND,

  // get terrain type of next square unit is ordered to move onto into [LAT]=y [LONG]=x 
  TAY,
  CORPSX [U+X] LDA,
  CLC,
  XADD [U+Y] ADC,
  LONG [U] STA,
  CORPSY [U+X] LDA,
  CLC,
  YADD [U+Y] ADC,
  LAT [U] STA,

  TERR U16 JSR,    // [UNITNO] = 0 or unit on square; [TRNCOD] = terrain on square
  TERRTY U16 JSR,  // [TRNTYP]=terraintype y=terraintype

  // get delay table start offset - infantry offset is 0, tank offset is 0A
  UNTCD1 [U] LDA,
  3F U8 AND,
  0 U8 LDX,
  3D U8 CMP, // is infantry?
  NE IF, 
    0A U8 LDX, // armor
  THEN,

  // add season offset to delay table offset
  TXA,
  MONTH [U] LDX,
  CLC,
  SSNCOD 1- [U+X] ADC, // add season index

  // add terrain offset to delay table offset
  TRNTYP [U] ADC, // add terrain index
  
  // get delay from delay table
  TAX,
  TRNTAB [U+X] LDA, // get net delay

  // set army's exec to when move will finish
  CLC,
  TICK [U] ADC,
  ARMY [U] LDX,
  EXEC [U+X] STA,

  // makes a unit not move if destination is coast unit or border and
  //   the square the unit is ordered to move onto is in the bad ocean crossing list
  // -- so what happens if you try to order a unit to move onto the border?
  TRNTYP [U] LDA,
  // moving onto coast unit or border? ... but really only coast matters
  // is destination terrain is coast, unit, or border?
  7 U8 CMP,
  CS IF, // to Y02
    // terrain is coast unit or border
    15 U8 LDY,
    BEGIN, // loop35
      // check destination square against BH list1
      LAT [U] LDA,
      BHY1 [U+Y] CMP,
      EQ IF, // to Y03
        LONG [U] LDA,
        BHX1 [U+Y] CMP,
        EQ IF,
          // check current square against BH list2
          ARMY [U] LDX,
          CORPSX [U+X] LDA,
          BHX2 [U+Y] CMP,
          EQ IF,
            CORPSY [U+X] LDA,
            BHY2 [U+Y] CMP,
            EQ IF,
              // if a match, make tick of move = never
              FF U8 LDA,
              EXEC [U+X] STA,
              RTS,
            THEN,
          THEN,
        THEN,
      THEN,
      ( Y03 )
      DEY,
    MI UNTIL, // to loop35
  THEN,
  ( Y02 )
  RTS,

// check for zone of control - 
//   returns 2 for other team unit on square 
//   + 2 for each other team unit on N E S W
//   + 1 for each other team unit on NE NW SE SW

// Source EFT18C.ASM line 4260
// HEX
BARHERE CONSTANT CHKZOC ( x=unit -reg- ) ( [LAT] [LONG] -mem- [ZOC] )
  0 U8 LDA,
  ZOC [U] STA,
  40 U8 LDA, // map font color code = 1 for German
  FIRSTRUSSIANUNIT U8 CPX,
  NC IF,
    // unit is German
    C0 U8 LDA, // map font color code = 3 for Russian
  THEN,
  TEMPR [U] STA,
  TERRB U16 JSR,
  EQ IF, // to a74 - is it a military unit?
    // yes, there is a military unit on this square
    TRNCOD [U] LDA,
    C0 U8 AND,
    TEMPR [U] CMP,
    NE IF, // to a71 // does color code match?
      // no, the color code does not match
      //   if the unit's lat and long also match then return
      //     maybe this can happen if the unit is dead...
      CORPSX [U+X] LDA,
      LONG [U] CMP,
      EQ IF, // to A79
        CORPSY [U+X] LDA,
        LAT [U] CMP,
        NE IF, // to a74
      SWAP THEN,
      // A79
      RTS,
    SWAP THEN,
    // A71
    2 U8 LDA, // 2 points for a match
    ZOC [U] STA,
    RTS,
        // A74
        THEN,
  THEN,

  7 U8 LDX, 
  BEGIN, // I think this checks color codes on map squares 
    JSTP 10 + [U+X] LDY, // table of directions N E S S W W N N - goes around original square
                         
    // move [LAT] and [LONG] by direction from table
    LONG [U] LDA,
    CLC,
    XINC [U+Y] ADC, // 0 FF 0 1
    LONG [U] STA,
    LAT [U] LDA,
    CLC,
    YINC [U+Y] ADC, // 1 0 FF 0
    LAT [U] STA,
    TERRB U16 JSR,
    EQ IF,
      // yes there is a military unit on the square
      TRNCOD [U] LDA,
      C0 U8 AND,
      TEMPR [U] CMP, 
      EQ IF, // does the map font color code match?
        // yes, if x is odd add 2 to [zoc] otherwise add 1
        TXA,
        1 U8 AND,
        CLC,
        1 U8 ADC, // +2 points for unit on same team N E S W, 1 point for NE NW SE SW
        ZOC [U] ADC,
        ZOC [U] STA,
      THEN,
    THEN,
    DEX,
  MI UNTIL,

  // restore [LAT] and [LONG] to original square
  LAT [U] DEC,
  LONG [U] DEC,
  ARMY [U] LDX,
  RTS,

// Subroutine CALIFR determines individual force ratios in all four directions for a Russian unit
// Source EFT18T.ASM line 8390
BARHERE CONSTANT CALIFRINIT
  0 U8 LDY,
  IFR0 [U] STY,  // force ratio for direction 0
  IFR1 [U] STY,  // force ratio for direction 1
  IFR2 [U] STY,  // force ratio for direction 2
  IFR3 [U] STY,  // force ratio for direction 3
  IFRHI [U] STY,  // sum of all 4 ifrs / 16
  INY,
  RFR [U] STY, // russian force ratio in all directions
  CORPSX [U+X] LDA,
  XLOC [U] STA, // xloc of unit to check
  CORPSY [U+X] LDA,
  YLOC [U] STA, // yloc of unit to check
  RTS,

// Source EFT18T.ASM line 8550
BARHERE CONSTANT UNITABSDELTA 
  // y=indexofotherunit -reg-  
  // [XLOC] [YLOC] = loc of origin unit  
  //   -mem- [TEMPX]=deltax [TEMPY]=deltay [TEMPR]=|deltax|+|deltay| 

  CORPSY [U+Y] LDA,
  SEC,
  YLOC [U] SBC,
  TEMPY [U] STA, // y signed distance to unit being checked 
  ABSA U16 JSR, // abs
  TEMPR [U] STA, // absolute y distance to unit being checked

  CORPSX [U+Y] LDA,
  SEC,
  XLOC [U] SBC,
  TEMPX [U] STA,
  ABSA U16 JSR,
  CLC,
  TEMPR [U] ADC, // absolute x + absolute y distance to unit being checked
  RTS,


// Source EFT18T.ASM line 9080 tag Z11
BARHERE CONSTANT UNITADDTOIFR
  // RA=otherunitcombatstrength/4 X=direction 0-3 Y=unit being checked -reg-
  // -mem- [RFR] [IFR+X] 

  FIRSTRUSSIANUNIT U8 CPY,
  CS IF,
    // is a russian unit
    //   add combat strength / 4 to [RFR] and saturate at 0xFF 
    CLC,
    RFR [U] ADC,
    CS IF,
      FF U8 LDA,
    THEN,
    RFR [U] STA, 
  ELSE,
    // is a german unit
    //   add combat strength / 4 to [IFR] for direction the unit is in and saturate at 0xFF
    CLC,
    IFR0 [U+X] ADC,
    CS IF,
      FF U8 LDA,
    THEN,
    IFR0 [U+X] STA,
  THEN,
  RTS,

// Source EFT18T.ASM line 8750
BARHERE CONSTANT GETDIRECTION
  // [TEMPX] [TEMPY] -mem-
  // -reg- x=direction 

  TEMPX [U] LDA,
    MI IF, CONSTANT toZ00a
      // deltax is negative
      TEMPY [U] LDA,
      MI IF, CONSTANT toZ01a
        // deltax and deltay are negative
        2 U8 LDX,
        TEMPX [U] CMP,
        NC IF, CONSTANT toZ02a
          // deltax < deltay
          1 U8 LDX, // direction 1
          CS IF, CONSTANT toZ02b // branch always taken
    
    toZ00a THEN,
    // Z00
    // deltax is positive
    TEMPY [U] LDA,
    MI IF, CONSTANT toZ03a
      // deltay is negative
      NEGA U16 JSR,
      2 U8 LDX,
      TEMPX [U] CMP,
      NC IF, // to Z02
        // deltax < deltay
        3 U8 LDX, // direction 3
        CS IF, // to Z02 // branch always taken
        
    // Z03
    toZ03a THEN,
    // deltax is positive and deltay is positive
    0 U8 LDX,
    TEMPX [U] CMP,
    NC IF, // to Z02
      03 U8 LDX,
      CS IF, // to Z02 // branch always taken
            
    // Z01 
    toZ01a THEN,
      // deltax is negative deltay is positive
      TEMPX [U] LDA,
      NEGA U16 JSR,
      1 U8 LDX, // direction 1
      TEMPY [U] CMP,
      NC IF, // to Z02
        // deltax < deltay
        0 U8 LDX, // direction 0
      // Z02 
            THEN,
          THEN,
        THEN,
      THEN,
    THEN,
    toZ02a THEN,
    toZ02b THEN,
  RTS,

// Source EFT18T.ASM line 8360
// initialize vectors
BARHERE CONSTANT CALIFR ( X=russianunitid [ARMY]=russianunitid -reg- )

  NUMBEROFUNITS 1+ U8 CPX,
  CS IF, // U>=
    DrawCALIFRbadunit U16 JSR,
    BEGIN, CLC, CS UNTIL,
  THEN,
  FIRSTRUSSIANUNIT U8 CPX, 
  NC IF, // U<
    DrawCALIFRbadunit U16 JSR,
    BEGIN, CLC, CS UNTIL,
  THEN,

  // init 
    // [IFR0-3] <- 0 // set force ratio for all 4 directions to 0
    // [IFRHI] <- 0  // set sum of all 4 force ratios / 16 to 0 
    // [RFR] <- 1    // russian force ratio in all directions
    // copy unit's location to XLOC YLOC
  CALIFRINIT U16 JSR,


  // sum combat strength/16 of all units |deltax|+|deltay|< 9 squares away
  NUMBEROFUNITS U8 LDY,
  BEGIN, // loop53
    // has unit arrived?  is arrive >= turn?
    ARRIVE [U+Y] LDA,
    PL IF, // J.N. added this, although the combat strength of dead units should be 0
      TURN [U] CMP,
      CS IF,
        // Unit has arrived. Is |deltax| + |deltay| < 9?
        UNITABSDELTA U16 JSR, // RA = |deltax| + |deltay|
        9 U8 CMP, // no point in checking if he's too far
        NC IF, 
      
          // unit has arrived and |deltax| + |deltay| is < 9
          RA LSR,
          TEMPR [U] STA, // this is half of range to unit |deltax| + |deltay| / 2 which is 0-4

          GETDIRECTION U16 JSR,

          // X=direction 0-3
          // Y=unit being checked

          CSTRNG [U+Y] LDA, // unit being checked combat strength
          RA LSR, RA LSR, RA LSR, RA LSR,  // unit being checked combat strength / 16

          // For Russian units add combat strength / 16 to IFR for direction saturated at 0xFF
          // For German units add combat strength / 16 to RFR for direction saturated at 0xFF
          UNITADDTOIFR U16 JSR, 

        // Y48 
        THEN, 
      THEN,
    THEN,
    DEY,
  EQ UNTIL,

  // get sum of all 4 German IFRs saturated at 0xFF
  3 U8 LDX,
  0 U8 LDA,
  BEGIN,
    CLC,
    IFR0 [U+X] ADC,
    CS IF,
      FF U8 LDA,
    THEN,
    DEX,
  MI UNTIL,

  // multiply sum of German IRFs by 16 and keep upper 4 bits in [IFRHI]
  RA ASL, IFRHI [U] ROL,
  RA ASL, IFRHI [U] ROL,
  RA ASL, IFRHI [U] ROL,
  RA ASL, IFRHI [U] ROL,

  // divide sum of German IRFs * 16 by the russian force ratio (x = result)
  //   using repetitive subtraction
  0 U8 LDX,
  SEC,
  BEGIN, // Z16 
    RFR [U] SBC,
    NC IF, // to Z14
      IFRHI [U] DEC,
      SEC,
      PL IF, // to Z15
    // Z14
    SWAP THEN,
    INX,
  SWAP U16 JMP, // to Z16
      // Z15 
      THEN,

  
  TXA,
  ARMY [U] LDX,
  CLC,
  OFR [U] ADC, // remember strategic situation - add overall force ratio
  RA ROR, // average strategic with tactical - divide by 2 to capture carry bit from add
  IFR FIRSTRUSSIANUNIT - [U] STA, // store russian force ratio...

  // keep a record of danger
  IFR0 [U] LDA,
  IFRN FIRSTRUSSIANUNIT - [U+X] STA,
  IFR1 [U] LDA,
  IFRE FIRSTRUSSIANUNIT - [U+X] STA,
  IFR2 [U] LDA,
  IFRS FIRSTRUSSIANUNIT - [U+X] STA,
  IFR3 [U] LDA,
  IFRW FIRSTRUSSIANUNIT - [U+X] STA,
  RTS,

// For testing
BARHERE CONSTANT WAITFORSTART
  BEGIN,
    8 U8 LDA,
    CONSOL [U] STA, // clear consol latches
    CONSOL [U] LDA, // get start-1 select-2 option-4 status
    1 U8 AND, // is start pressed?
  EQ UNTIL, 
  RTS,

// get 2 + sum of combat strengths + left over low russian strength for german units 
//   and 2 + sum of combat strengths for russian units
//   this uses left over low sum from russian units for german units

// Source EFT18T.ASM line 1660
BARHERE CONSTANT GETTOTALCOMBATSTRENGTHS
  // [CSTRNG[]] -mem- [TOTGS] [TOTRS] [TEMPR]

  1 U8 LDX,      // X = 1 indexes russian combat strength total - TOTGS + 1 is TOTRS
  TEMPR [U] STA, // low byte of sum accumulator
  TOTRS [U] STA, // total russian strength - 
                 //   sum of all carrys from adding russian unit combat strengths and 0x101
  TOTGS [U] STA, // total german strength - 
                 //   sum of all carrys from adding german unit combat strengths, 0x100, and 
                 //   lo byte of sum of all russian combat strengths

  NUMBEROFUNITS U8 LDY,
  BEGIN, // loop80
    BEGIN, // loop80
      ARRIVE [U+Y] LDA,
      TURN [U] CMP,
      NC IF, // to Z50
        // unit has arrived 
        //   adds dead units but combat strength of dead should be 0
        TEMPR [U] LDA,
        CLC,
        CSTRNG [U+Y] ADC,
        TEMPR [U] STA,
        CS IF, // to Z50
          // if there was a carry then increment combat strength total for russians or germans
          TOTGS [U+X] INC, // X=1 = russian, X=0 = german
        // Z50
        THEN,
      THEN,
      DEY,
      FIRSTRUSSIANUNIT U8 CPY,
    NC UNTIL, // ULT UNTIL, goes to loop80 while UGE
    0 U8 LDX,
    0 U8 CPY,
  EQ UNTIL, // to loop80
  RTS,


  // now shift values 4 places right
  //   shift copy of german sum to the left up to 4 times 
  //     until highest set bit is in highest position
  //       if hi bit of german sum is set, divide russian sum by 16 
  //       if 2nd hi bit of german sum is set, divide russian sum by 8 
  //       if 3rd hi bit of german sum is set, divide russian sum by 4
  //       if 4th hi bit of german sum is set, divide russian sum by 2
  //  [TOTGS]=germansum [TOTRS]=russiansum -mem- [TOTRS]=scaledrussiansum
  
// Source EFT18T.ASM line 1910
BARHERE CONSTANT SCALETOTALCOMBATSTRENGTHS
  TOTRS [U] LDA, 
  TEMPR [U] STA,
  TOTGS [U] LDA,

  04 U8 LDX,
  BEGIN, // loop81
    RA ASL,
    CS IF, // to z51
      RA ROR, 
      BEGIN, // loop82
        TEMPR [U] LSR,
        DEX,
      EQ UNTIL, // to loop82
      NE IF, // to z52
    // z51 
    SWAP THEN,
    DEX,
  SWAP EQ UNTIL, // to loop81
      THEN,
      // z52
  RTS,

  // now calculate overall force ratio - basically [OFR] = 0xFF/[totrs]
  //  this calculates FF/[TEMPR] using repetitive subtraction
  //  also initializes unit's objective square to unit's current location
  //  also calculates the individual force ratios for each unit

// Source EFT18T.ASM line 2180
BARHERE CONSTANT CALCOFR
  // now calculate individual force ratios for each Russian unit
  NUMBEROFUNITS U8 LDX,
  BEGIN, // loop50
    ARMY [U] STX,
    ARRIVE [U+X] LDA,
    TURN [U] CMP,
    NC IF, // to Y44
      // unit has arrived ... but not this turn
      CALIFR U16 JSR,
      ARMY [U] LDX, // technically shouldn't need this...
      CORPSX [U+X] LDA,
      OBJX FIRSTRUSSIANUNIT - [U+X] STA,
      CORPSY [U+X] LDA,
      OBJY FIRSTRUSSIANUNIT - [U+X] STA,
    // Y44
    THEN,
    DEX,
    FIRSTRUSSIANUNIT U8 CPX,
  NC UNTIL, // to loop50
  RTS,
  

// Source EFT18T.ASM line 2510
// Go through all Russian units and find the location of the unit with |deltax| + |deltay|
//   with values in ranges 4-7, C-F, 14-17, 1C-1F, etc.. that has the
//   greatest IFR - (|deltax| + |deltay| / 8)
// X=srcunit -reg-
// -mem- [OBJX+srcunit]=beleaguredunitx [OBJY+srcunit]=beleaguredunity
// requires initialized [BVAL] and [BONE] on entry for 
//   the case where a beleaguredunit is not found
BARHERE CONSTANT FINDBELEAGUREDARMY
  // find nearby beleaguered army
  // J.N.  I'm not sure this section does what it says it does....
  NUMBEROFUNITS U8 LDY,
  BEGIN, // loop52
    ARRIVE [U+Y] LDA,
    TURN [U] CMP,
    NC IF, // to Y54
      // arrive of unit to try < turn... so unit has arrived yet but not this turn
      CORPSX [U+Y] LDA,
      SEC,
      CORPSX [U+X] SBC,
      ABSA U16 JSR,
      TEMPR [U] STA, // |deltax|

      CORPSY [U+Y] LDA,
      SEC,
      CORPSY [U+X] SBC,
      ABSA U16 JSR,
       CLC,
      TEMPR [U] ADC, // |deltax| + |deltay|
      RA LSR, RA LSR, RA LSR, // |deltax| + |deltay| / 8
      NC IF, // to Y54 -- shouldn't this be EQ IF, ???
        // ??? so if bit 2 was clear from |deltax| + |deltay| do this?
        // if |deltax| + |deltay| was 0-7, then this gets done on 4-7
        //   if > 0-7, then this gets done on 4-7, C-F, 14-17, 1C-1F, etc...
        TEMPR [U] STA, // this will be 0 if unit was nearby
        IFR FIRSTRUSSIANUNIT - [U+Y] LDA,
        SEC,
        TEMPR [U] SBC, // getting (IFR of unit to try) - (|deltax| + |deltay| / 8)
        CS IF, // to Y54 no good using nearby armies
          // IFR is >= distance/8...
          BVAL [U] CMP,
          CS IF, // to Y54
            // (IFR of unit to try) - (|deltax| + |deltay| / 8) >= [OFR]/2
            BVAL [U] STA, // (IFR of unit to try) - (|deltax| + |deltay| / 8)
            BONE [U] STY, // Unit to try
          // Y54
          THEN,
        THEN,
      THEN,
    THEN,
    DEY,
    FIRSTRUSSIANUNIT U8 CPY,
  NC UNTIL, // to loop52

  // save target unit to help
  BONE [U] LDY, // beleagueredest army
  CORPSX [U+Y] LDA,
  OBJX FIRSTRUSSIANUNIT - [U+X] STA,
  CORPSY [U+Y] LDA,
  OBJY FIRSTRUSSIANUNIT - [U+X] STA,
  RTS,

// Source EFT18T.ASM line 3130
// get russian unit's next objective square from current objective square
// uses direction to get square adjacent to unit's current objective square
// [OBJX+unit] [OBJY+unit] [DIR] -mem- [TARGX] [TARGY]
BARHERE CONSTANT GETRUSSIANUNITNEXTSQUARE
  OBJX FIRSTRUSSIANUNIT - [U+X] LDA,
  DIR [U] LDY,
  PL IF,
    // unit is moving off current square 
    CLC,
    XINC [U+Y] ADC,
  THEN,
  TARGX [U] STA,

  OBJY FIRSTRUSSIANUNIT - [U+X] LDA,
  DIR [U] LDY,
  PL IF,
    // unit is moving off current square
    CLC,
    YINC [U+Y] ADC,
  THEN,
  TARGY [U] STA,
  RTS,

// get next target square using current direction from movement table
// [SQX] [SQY] [DIR] -mem- [SQX] [SQY]
// Y=dir -reg- 
BARHERE CONSTANT GETNEXTTARGETSQUARE // - Source EFT18T.ASM line 1620 
  SQX [U] LDA,
  CLC,
  XINC [U+Y] ADC,
  SQX [U] STA,
  SQY [U] LDA,
  CLC,
  YINC [U+Y] ADC,
  SQY [U] STA,
  RTS,


BARHERE CONSTANT FILLLINARR
  // get combat strengths of other units around a unit's proposed next square in 5x5 area
    //   results are stored in LINARR, with middle square holding the muster strength of
    //   the original unit
    17 U8 LDY, // index of last movement in movement table (24)
    BEGIN, // loop56
      JCNT [U] STY, // current movement
      JSTP [U+Y] LDA, // movement table
        // this is a series of movements to get the coordinates 
        //  of each square around a square in 5x5 area
        // 0 CC, 0 CC, 0 CC, 0 CC, 3 CC, 3 CC, 3 CC, 3 CC,
        // 2 CC, 2 CC, 2 CC, 2 CC, 1 CC, 1 CC, 1 CC, 0 CC,
        // 0 CC, 0 CC, 3 CC, 3 CC, 2 CC, 2 CC, 1 CC, 0 CC,
        // going through table backwards gives:
        //   N E S S W W N N - goes around original square
        //   N E E E S S S S - goes up to 2 away then goes across top and right
        //   W W W W N N N N - goes across bottom and up left side
