// Source EFT18I.ASM line 3630
// first button pass
//   looks for a unit inside cursor
//   if there is one, puts unit info into text window
BARHERE CONSTANT FBUTPS
  FF U8 LDA,
  BUTFLG [U] STA,

  // first gets coords of center of cursor (map frame) 
  GETCOORDS U16 JSR,

  // ra=[CHUNKY] from GETCOORDS

  CHUNKTOUNIT U16 JSR,
  
  0 U8 CPX,
  NE IF,
    DOUNITMATCHES U16 JSR,
    ENDISR U16 JMP,
  THEN,

  // no units match
  CORPS [U] STX, // change CORPS to 0
  DEX,
  HITFLG [U] STX, // hitflg = -1
  ENDISR U16 JMP,
  

// this routine assumes CURSXH:CURSXL/8 XPOSL are in alignment and OFFLO is 0
//   probably be better to calculate one from the other... but not faster...
HEX
BARHERE CONSTANT CURSR // move cursor right
  // if cursor is 0 then do nothing
  CURSXL [U] LDA,
  64 U8 CMP,
  EQ IF,
    CURSXH [U] LDX,
    NE IF,
      RTS,
    THEN,
  THEN,

  CLC,
  1 U8 ADC,
  CURSXL [U] STA,
  CS IF,
    CURSXH [U] INC,
  THEN,

  SHPOS0 [U] LDA,
  36 U8 CMP,
  NE IF,
    SEC,
    1 U8 SBC,
    SHPOS0 [U] STA,
    HPOSP0 [U] STA,
    RTS,
  THEN,

  XPOSL [U] LDA,
  CLC, // no, increment x-coordinate
  1 U8 ADC,
  XPOSL [U] STA,
  7 U8 AND,
  HSCROL [U] STA, // fine scroll
  NE IF, RTS, THEN,

  OFFLO [U] LDA, // yes, set up offset for character scroll
  SEC,
  1 U8 SBC,
  OFFLO [U] STA,
  OFFHI [U] LDA,
  0 U8 SBC,
  OFFHI [U] STA,
  RTS,

HEX
BARHERE CONSTANT CURSL // move cursor left
  // XPOSL starts at E0; SHPOS0 HPOS0 start at 78; CURSXL should start at 164 - 78

  // if cursorxpos > 0 then move cursor left 1
  CURSXL [U] LDA,
  EQ IF,
    CURSXH [U] LDX,
    EQ IF,
      RTS,
    THEN,
  THEN,

  SEC,
  1 U8 SBC,
  CURSXL [U] STA,
  NC IF,
    CURSXH [U] DEC,
  THEN,

  SHPOS0 [U] LDA,
  BA U8 CMP,
  NE IF,
    CLC,
    1 U8 ADC,
    SHPOS0 [U] STA,
    HPOSP0 [U] STA,
    RTS,
  THEN,

  XPOSL [U] LDA,
  SEC, // decrement x-coordinate
  1 U8 SBC,
  XPOSL [U] STA,
  7 U8 AND,
  HSCROL [U] STA, // fine scroll
  7 U8 CMP, // scroll overflow?
  NE IF, RTS, THEN,
  // yes, mark it for offset
  OFFLO [U] INC,
  EQ IF,
    OFFHI [U] INC, // probably not possible
  THEN,
  RTS,
    

HEX
BARHERE CONSTANT CURSU // move cursor up

  // if CURSY is max 2FE then exit
  CURSYL [U] LDA,
  5E U8 CMP,
  EQ IF,
    CURSYH [U] LDX,
    2 U8 CPX,
    EQ IF,
      RTS,
    THEN,
  THEN,

  // inc CURSY
  CURSYL [U] INC,
  EQ IF,
    CURSYH [U] INC,
  THEN,

  // looks like cursor moves up and down 2 pixels
  SCY [U] LDX, // player0 vertical position
  1B U8 CPX,
  NE IF,
    CURSYL [U] INC,
    EQ IF,
      CURSYH [U] INC,
    THEN,

    DEX,
    SCY [U] STX,

    TXA, CLC,
    12 U8 ADC,
    TEMPI [U] STA,

    BEGIN,
      PLYR0 [U+X] LDA,
      PLYR0 1- [U+X] STA,
      INX,
      TEMPI [U] CPX,
    EQ UNTIL,
    RTS,
  THEN,

  YPOSL [U] LDA,
  YPOSH [U] ORA,
  EQ IF,
    RTS,
  THEN,

  YPOSL [U] LDA,
  SEC,
  1 U8 SBC,
  NC IF,
    YPOSH [U] DEC,
  THEN,
  YPOSL [U] STA,

  0F U8 AND,
  VSCROL [U] STA, // fine scroll
  0F U8 CMP,
  NE IF, 
    RTS,
  THEN,

  OFFLO [U] LDA, // yes, set up offset for character scroll
  SEC,
  30 U8 SBC,
  OFFLO [U] STA,
  OFFHI [U] LDA,
  0 U8 SBC,
  OFFHI [U] STA,
  RTS,

HEX
BARHERE CONSTANT CURSD // move cursor down

  CURSYL [U] LDA,
  2 U8 CMP,
  EQ IF,
    CURSYH [U] LDX,
    EQ IF, RTS, THEN,
  THEN,
  SEC,
  1 U8 SBC,
  CURSYL [U] STA,
  NC IF,
    CURSYH [U] DEC,
  THEN,

  SCY [U] LDX,
  4E U8 CPX,
  NE IF, // to x8

    SEC,
    1 U8 SBC,
    CURSYL [U] STA,
    NC IF,
      CURSYH [U] DEC,
    THEN,

    INX,
    SCY [U] STX,

    TXA, 
    CLC,
    12 U8 ADC,
    DEX, DEX,
    TEMPI [U] STX,
    TAX,
    BEGIN,
      PLYR0 1- [U+X] LDA,
      PLYR0 [U+X] STA,
      DEX,
      TEMPI [U] CPX,
    EQ UNTIL,
    RTS,
  THEN,

  YPOSL [U] LDA,
  CLC, // no, decrement y-coordinate
  1 U8 ADC,
  YPOSL [U] STA,
  CS IF,
    YPOSH [U] INC,
  THEN,

  0F U8 AND,
  VSCROL [U] STA, // fine scroll
  NE IF, RTS, THEN,

  OFFLO [U] LDA, // yes, mark offset
  CLC,
  30 U8 ADC,
  OFFLO [U] STA,
  OFFHI [U] LDA,
  0 U8 ADC,
  OFFHI [U] STA,
  RTS,

// Source JN replacement for code at EFT18I.ASM line 6930
BARHERE CONSTANT MOVECURS // move cursor according to joystick position
  0 U8 LDA,
  OFFLO [U] STA,
  OFFHI [U] STA,

  STICK0 [U] LDA,

  RA ROR, // get up bit
  StickTemp [U] STA,
  NC IF,
    CURSU U16 JSR,
    StickTemp [U] ROR, // drop down bit
  ELSE,
    StickTemp [U] ROR, // get down bit
    NC IF,
      CURSD U16 JSR,
    THEN,
  THEN,
  
  StickTemp [U] ROR, // get right bit
  NC IF,
    CURSR U16 JSR,
    StickTemp [U] ROR, // drop left bit... probably not needed
  ELSE,
    StickTemp [U] ROR, // get left bit
    NC IF,
      CURSL U16 JSR,
    THEN,
  THEN,  

  CHGDLSUB U16 JSR,
  RTS,


// Source EFT18I.ASM line 6610
BARHERE CONSTANT NOBUT // vbi no button is pressed routine

  DBTIMR [U] STA,
  STICK0 [U] LDA,
  0F U8 AND,
  0F U8 EOR,
  EQ IF, // to scroll
    AUDC1 [U] STA,
    STKFLG [U] STA,
    8 U8 LDA,
    DELAY [U] STA,
    CLC,
    RTCLOCK0 [U] ADC,
    TIMSCL [U] STA,
    ERRCLR U16 JSR,
  
    // toexitia THEN,
BARHERE CONSTANT EXITI
    ENDISR U16 JMP,
  THEN,

// Source EFT18I.ASM line 6750
BARHERE CONSTANT SCROLL // vbi move cursor routine
  0 U8 LDA,
  ATRACT [U] STA,
  // acceleration feature of cursor
  TIMSCL [U] LDA,
  RTCLOCK0 [U] CMP,
  EXITI EQ UNTIL,
  DELAY [U] LDA,
  1 U8 CMP,
  NE IF,
    SEC,
    1 U8 SBC,
    DELAY [U] STA,
  THEN,
  CLC,
  RTCLOCK0 [U] ADC,
  TIMSCL [U] STA,

  MOVECURS U16 JSR,
  ENDISR U16 JMP,

// Source EFT18I.ASM line 1650
BARHERE CONSTANT OVBI // vbi routine, handles player input
  // TRIG1 [U] LDA,         // check for break button ( debugging routine )
  // EQ IF,                 // no, check next
  //   DECIMAL 62 U8 LDY,   // reset 60 hz vector
  //   233 U8 LDX,          // E93E ... won't work for xl/xe
  //   7 U8 LDA,
  //   SETVBV U16 JSR,
  //   PLA, PLA, PLA,       // reset stack
  //   BREAKROUTINE U16 JMP,
  // THEN,

  HANDCP [U] LDA,
  NE IF, // toA31
    // handicap is not already activated
    TRIG0 [U] LDA,
    NE IF, // toA31
      // button is not pressed
      08 U8 LDA,
      CONSOL [U] STA,  // reset latches for start select option
      CONSOL [U] LDA,  // get status of start select option
      4 U8 AND,        // is option pressed? - 0 means pressed
      EQ IF, // toA31
        // option is pressed
        HANDCP [U] STA, // activate handicap
        HEX 30 U8 LDA,
        // 7B7A [U] STA, 
        DLISRV 7A + [U] STA,  // this modifies the dli routine's screen saver color cycling xor value... Crawford's trademark 

        FIRSTRUSSIANUNIT 1- U8 LDX, 
        BEGIN, // LOOPJ
          MSTRNG [U+X] LDA,
          TEMPI [U] STA,
          RA LSR,
          TEMPI [U] ADC,
          CS IF, // toA22
            HEX FF U8 LDA,
          // A22 
          THEN,
          MSTRNG [U+X] STA, // changes MSTRNG
          DEX,
        EQ UNTIL, // toLOOPJ
      // A31 
      THEN,
    THEN,
  THEN,

  TRIG0 [U] LDA, // button status
  BUTMSK [U] ORA, // button allowed? - this is the main semaphore
  NE IF, // to X17

    // no button now; previous status
    BUTFLG [U] LDA,  
    EQ IF,
      NOBUT U16 JMP, 
    THEN,

    HEX 58 U8 LDA,
    PCOLR0 [U] STA,

    0 U8 LDA,
    BUTFLG [U] STA,
    KRZFLG [U] STA,
    AUDC1 [U] STA,

    // Clear TXTWDW
    HEX 52 U8 LDX,
    BEGIN,
      TXTWDW 8 + [U+X] STA, // changes TXTWDW
      DEX,
    MI UNTIL,

    8 U8 LDA,
    DELAY [U] STA,
    CLC,
    RTCLOCK0 [U] ADC,
    TIMSCL [U] STA,

    // button was released... put terrain back... assumes switch params are correct
    //  from when button was pressed
    SWITCH U16 JSR,

    0 U8 LDA,
    CORPS [U] STA,
    // clear maltakreuze and arrow I think
    CLRP1 U16 JSR,
    CLRP2 U16 JSR,
    ENDISR U16 JMP,
  THEN,

  ( X17 )
  // button is pressed
  ATRACT [U] STA,
  STICK0 [U] LDA,
  HEX 0F U8 AND,
  0F U8 EOR,
  NE IF, // joystick active?
    ORDERS U16 JMP,
  THEN,
  // no, set debounce
  DBTIMR [U] STA,
  AUDC1 [U] STA,
  STKFLG [U] STA,
  BUTFLG [U] LDA,
  EQ IF, // is this the first button pass?
    FBUTPS U16 JMP, // if there is a unit under cursor, display unit terrain & info
  THEN,

  // button is held
  ERRCLR U16 JSR, // changes TXTWDW
  HITFLG [U] LDA, // 0 means there is a unit under the cursor
  NE IF, // anybody in the window?
    ENDISR U16 JMP, // no
  THEN,

  CH [U] LDA, // get keypress
  HEX 21 U8 CMP, // is space bar pressed?
  EQ IF, // to x80
    // yes, check for Russian
    CORPS [U] LDX, 
    FIRSTRUSSIANUNIT U8 CPX,
    NC IF,
      0 U8 LDA,
      CH [U] STA,
      HMORDS [U+X] STA,
      HOWMNY [U] STA,
      STPCNT [U] STA,
      01 U8 LDA,
      ORDCNT [U] STA,
      CLRP1 U16 JSR,
      CLRP2 U16 JSR,
      BASEX [U] LDA,
      STEPX [U] STA,
      BASEY [U] LDA,
      STEPY [U] STA,
    THEN,
  THEN,

  RTCLOCK0 [U] LDA,
  3 U8 AND,
  NE IF, // time to move arrow?
    ENDISR U16 JMP,
  THEN,
  
  HOWMNY [U] LDY,
  EQ IF, // any orders to show?
    0 U16 JMP, // COMPILE unresolved jump for PCURSE no, go ahead to maltakreuze
    BARHERE CONSTANT toPCURSE
  THEN,

  CLRP1 U16 JSR, // yes, clear old arrow
  ORDCNT [U] LDA,
  0 U8 LDX,
  5 U8 CMP,
  CS IF, // second or third byte?
    INX, // second byte
  THEN,
  03 U8 AND,
  TAY,
  BITTAB [U+Y] LDA, // get mask
  ORD1 [U+X] AND,
  // right justify orders
  DEY,
  MI IF,
    3 U8 LDY,
  THEN,
  NE IF,
    BEGIN,
      RA LSR,
      RA LSR,
      DEY,
    EQ UNTIL,
  THEN,
  ARRNDX [U] STA,
  RA ASL,
  RA ASL,
  RA ASL,
  // get arrow image and store it to player RAM
  TAX,
  STEPY [U] LDY,
  BEGIN,
    ARRTAB [U+X] LDA,
    80 U8 CPY,
    NC IF,
      PLYR1 [U+Y] STA,
    THEN,
    INX, INY, TXA,
    7 U8 AND,
  EQ UNTIL,
  STEPX [U] LDA, // position arrow
  HPOSP1 [U] STA,
  // now step arrow
  ARRNDX [U] LDX,
  STEPX [U] LDA,
  CLC,
  XADD [U+X] ADC,
  STEPX [U] STA,
  STEPY [U] LDA,
  CLC,
  YADD [U+X] ADC,
  STEPY [U] STA,

  STPCNT [U] INC,
  STPCNT [U] LDA,
  7 U8 AND,
  EQ IF, // if not done end isr
    STPCNT [U] STA, // end of steps
    ORDCNT [U] INC, // next order
    ORDCNT [U] LDA,
    HOWMNY [U] CMP,
    CS IF, // no, out
      NE IF, // no, out
        1 U8 LDA,
        ORDCNT [U] STA, // yes, reset to start of arrow's path
        // display maltese cross
        // resolve PCURSE
        toPCURSE LONGTHEN,
        STEPY [U] LDY,
        KRZY [U] STY,
        HEX FF U8 LDA,
        KRZFLG [U] STA,
        0 U8 LDX,
        BEGIN,
          MLTKRZ [U+X] LDA,
          HEX 80 U8 CPY,
          NC IF,
            PLYR2 [U+Y] STA,
          THEN,
          INY, INX,
          HEX 08 U8 CPX,
        EQ UNTIL,
        STEPX [U] LDA,
        SEC,
        1 U8 SBC,
        KRZX [U] STA,
        HPOSP2 [U] STA,
        CLRP1 U16 JSR, // clear arrow
        BASEX [U] LDA, // reset arrow's coords
        STEPX [U] STA,
        BASEY [U] LDA,
        STEPY [U] STA,
      THEN,
    THEN,
  THEN,
  ENDISR U16 JMP,

