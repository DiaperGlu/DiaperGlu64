// Source EFT18I.ASM line 5370
// player orders input routine
BARHERE CONSTANT ORDERS
  STKFLG [U] LDA,
  ENDISR EQ UNTIL, ( was x75 )

  CORPS [U] LDX, 
  FIRSTRUSSIANUNIT U8 CPX,
  CS IF, // Russian?
    ( yes, error - can't give orders to a Russian unit )
    0 U8 LDX,
    SQUAWK U16 JMP,
  THEN,

  HMORDS [U+X] LDA,
  8 U8 CMP,
  CS IF, // only 8 orders allowed
    20 U8 LDX,
    SQUAWK U16 JMP,
  THEN,

  KRZFLG [U] LDA,
  EQ IF, // must wait for maltakreuze
    40 U8 LDX,
    SQUAWK U16 JMP,
  THEN,

  DBTIMR [U] INC,
  DBTIMR [U] LDA, // wait for debounce time
  10 U8 CMP,
  NC IF,
    ENDISR U16 JMP, // was bcc to a jump to endisr
  THEN,

  0 U8 LDA,
  DBTIMR [U] STA, // reset debounce timer
  STICK0 [U] LDX,
  STKTAB [U+X] LDA,
  MI IF, 
    60 U8 LDX, // no diagonal orders allowed
    SQUAWK U16 JMP,
  THEN,

  // OK, this is a good order
  TAY,
  STICKI [U] STA,
  BEEPTB [U+Y] LDA,
  AUDF1 [U] STA, // "BEEP!"
  A8 U8 LDA,
  AUDC1 [U] STA,
  FF U8 LDA,
  STKFLG [U] STA,

  CORPS [U] LDX,
  HMORDS [U+X] INC,
  HMORDS [U+X] LDA,
  HOWMNY [U] STA,
  SEC,
  01 U8 SBC,
  03 U8 AND,
  TAY,
  TEMPI [U] STY, // lower 2 bits of which order - 1
  HMORDS [U+X] LDA,
  SEC,
  1 U8 SBC,
  RA LSR,
  RA LSR,
  TAX, // x = 0 for orders 1-4, x = 1 for orders 5-8
  STICKI [U] LDA, // which direction to move

  // isolate order 
  //   y = 0 - 3 which is low 2 bits of which order - 1
  //   shift order into position.. each 2 bits is which direction to move
  BEGIN,
    DEY,
  PL WHILE, // pl while,
    RA ASL, RA ASL,
  REPEAT,

  // weird way to replace 2 bits in [ORD1] [ORD1+1]
  //  then copy result to WHORDS WHORDH... 
  TEMPI [U] LDY,
  ORD1 [U+X] EOR, // fold in new order (sneaky code)
  MASKO [U+Y] AND,
  ORD1 [U+X] EOR, 
  ORD1 [U+X] STA,
  ORD1 [U] LDA,
  CORPS [U] LDX,
  WHORDS [U+X] STA, // what the orders are for orders 1-4
  ORD2 [U] LDA, // this is ord1 + 1
  WHORDH [U+X] STA, // what the orders are for orders 5-8

  // move maltakreuze... moves in steps of 8
  MOVEMALTAKREUZE U16 JSR,
  ENDISR U16 JMP,

// Source JN replacement using table lookup for multiple places
//   one source at EFT18I.ASM line 9500
BARHERE CONSTANT CHUNKTOMAPHILO ( [CHUNKY] [CHUNKX] -mem- [MAPHI:MAPLO] ) ( -reg- Y )
  MAPHEIGHT 1- U8 LDA,  // 39 - [lat] // mapheight - 1
  SEC,
  CHUNKY [U] SBC,
  RA ASL,
  CLC,
  TAY,
  MAPROWOFFSETTBL [U+Y] LDA,
  MAPLO [U] STA,
  MAPROWOFFSETTBL 1+ [U+Y] LDA,
  MAPLO 1+ [U] STA,

  MAPWIDTH 2 - U8 LDA, // 46 - [LONG] // mapwidth - 2
  SEC,
  CHUNKX [U] SBC,
  TAY,
  RTS,


// Source EFT18I.ASM line 9480
HEX
// exchanges terrain on map with character in unit's swapit array
BARHERE CONSTANT SWITCH ( was 0x79EF ) ( [CHUNKX] [CHUNKY] [CORPS] -- )
  CORPS [U] LDX,
  EQ IF,
    RTS,
  THEN,

  // J.N. added - run time error check for x, display message and hang on error 
  CHUNKX [U] LDA,
  MAPWIDTH 2 - U8 CMP,
  CS IF,
    DrawSWITCHbadx U16 JSR,
    BEGIN, CLC, CS UNTIL,
  THEN,

  // J.N. added - run time error check for y, display message and hang on error
  CHUNKY [U] LDA,
  MAPHEIGHT 1- U8 CMP,
  CS IF,
    DrawSWITCHbady U16 JSR,
    BEGIN, CLC, CS UNTIL,
  THEN,
 
  CHUNKTOMAPHILO U16 JSR, // does not use reg X

                     // if [corps] is not 0 then
  MAPLO [[U8]+Y] LDA, //   exchange [[maplo]+y] with [swapit+[corps]]
  
  PHA,
  SWAPIT [U+X] LDA,
  MAPLO [[U8]+Y] STA,
  PLA,
  SWAPIT [U+X] STA,
 
  RTS,

