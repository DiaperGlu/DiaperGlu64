  93 U8 LDY,
  TXA,
  CLC,
  10 U8 ADC,
  DWORDS U16 JSR,

  // draw day  
  DAY [U] LDA,
  DNUMBR U16 JSR,
  0C U8 LDA,
  TXTWDW [U+Y] STA,

