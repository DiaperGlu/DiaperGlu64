        toDOMOVEa THEN,

        // check zone of control
        ARMY [U] LDX,
        CORPS [U] STX,

        CORPSY [U+X] LDA,
        CHUNKY [U] STA,
        LAT [U] STA,

        CORPSX [U+X] LDA,
        CHUNKX [U] STA,
        LONG [U] STA,

        CHKZOC U16 JSR,

        ACCHI [U] LDA,
