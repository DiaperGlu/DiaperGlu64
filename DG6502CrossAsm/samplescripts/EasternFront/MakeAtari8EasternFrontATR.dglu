oNumberOfBootSectors PCURRENTCOMPILEBUFFER @ O>P C!


// This converts the program into a .ATR disk image and saves it to a file
$" EasternFront.atr" PCURRENTCOMPILEBUFFER @ Buf>ATRFile


TRUE ?END-EVALUATE






// //////////////////////////////////
// Old versions of the subroutines //
// //////////////////////////////////


// old scroll
( 0 U8 LDA,
  OFFLO [U] STA,
  OFFHI [U] STA, // zero the offset

  STICK0 [U] LDA, // get joystick reading
  
  PHA, // save on stack for other bit checks
  8 U8 AND, // is stick left?
  EQ IF, CONSTANT tochkrt1

  

  // if cursorxpos > 0 then move cursor left 1
  CURSXL [U] LDA,
  EQ IF,
    CURSXH [U] LDX,
    NE IF, CONSTANT tochkup1
  THEN,
  SEC,
  1 U8 SBC,
  CURSXL [U] STA,
  NC IF,
    CURSXH [U] DEC,
  THEN,
  SHPOS0 [U] LDA,
  BA U8 CMP,
  NE IF,
    CLC,
    1 U8 ADC,
    SHPOS0 [U] STA,
    HPOSP0 [U] STA,
    EQ IF, CONSTANT tochkup2
  THEN,
  XPOSL [U] LDA,
  SEC, // decrement x-coordinate
  1 U8 SBC,
  XPOSL [U] STA,
  7 U8 AND,
  HSCROL [U] STA, // fine scroll
  7 U8 CMP, // scroll overflow?
  EQ IF, CONSTANT tochkup3 // no, move one
  // yes, mark it for offset
  OFFLO [U] INC,
  CLV,
  VS IF, CONSTANT tochkup4 // no point in checking for joystick right 

BARHERE CONSTANT CHKRT
  tochkrt1 THEN,
  PLA, // get back joystick byte
  PHA, // save it again
  4 U8 AND, // joystick right?
  EQ IF, CONSTANT tochkup5 // no, move on

  CURSXL [U] LDA,
  64 U8 CMP,
  EQ IF,
    CURSXH [U] LDX,
    EQ IF, CONSTANT tochkup6
  THEN,
  CLC,
  1 U8 ADC,
  CURSXL [U] STA,
  CS IF,
    CURSXH [U] INC,
  THEN,
  SHPOS0 [U] LDA,
  36 U8 CMP,
  NE IF,
    SEC,
    1 U8 SBC,
    SHPOS0 [U] STA,
    HPOSP0 [U] STA,
    EQ IF, CONSTANT tochkup7
  THEN,
  XPOSL [U] LDA,
  CLC, // no, increment x-coordinate
  1 U8 ADC,
  XPOSL [U] STA,
  7 U8 AND,
  HSCROL [U] STA, // fine scroll
  EQ IF, CONSTANT tochkup8 // scroll overflow? if not, move on
  OFFLO [U] DEC, // yes, set up offset for character scroll
  OFFHI [U] DEC,

  CURSL U16 JSR,

  // CHKUP 
  tochkup1 THEN,
  tochkup2 THEN,
  tochkup3 THEN,
  tochkup4 THEN,
  tochkup5 THEN,
  tochkup6 THEN,
  tochkup7 THEN,

  PLA, // joystick up?
  RA LSR,
  PHA,
  NC IF, CONSTANT tochkdn1 // no, ramble on

  CURSU U16 JSR,

  CURSYL [U] LDA,
  5E U8 CMP,
  EQ IF,
    CURSYH [U] LDX,
    2 U8 CPX,
    NE IF, CONSTANT tochkdn2
  THEN,
  CURSYL [U] INC,
  EQ IF,
    CURSYL [U] INC,
  THEN,
  SCY [U] LDX,
  1B U8 CPX,
  NE IF, // to X6
    CURSYL [U] INC,
    EQ IF,
      CURSYL [U] INC,
    THEN,
    DEX,
    SCY [U] STX,
    TXA, CLC,
    12 U8 ADC,
    TEMPI [U] STA,
    BEGIN,
      PLYR0 [U+X] LDA,
      PLYR0 1- [U+X] STA,
      INX,
      TEMPI [U] CPX,
    EQ UNTIL,
    NE IF, CONSTANT tochkdn3
  // X6 
  THEN,
  YPOSL [U] LDA,
  SEC,
  1 U8 SBC,
  NC IF,
    YPOSH [U] DEC,
  THEN,
  YPOSL [U] STA,
  0F U8 AND,
  VSCROL [U] STA, // fine scroll
  0F U8 CMP,
  EQ IF, CONSTANT tochkdn4 // scroll overflow? If not, amble on
  OFFLO [U] LDA, // yes, set up offset for character scroll
  SEC,
  30 U8 SBC,
  OFFLO [U] STA,
  OFFHI [U] LDA,
  0 U8 SBC,
  OFFHI [U] STA,

  // CHKDN 
  tochkdn1 THEN,
  tochkdn2 THEN,
  tochkdn3 THEN,
  tochkdn4 THEN,

  PLA, // joystick down?
  RA LSR,
  NC IF, CONSTANT tochgdl1 // no trudge on

  CURSD U16 JSR,

  CURSYL [U] LDA,
  2 U8 CMP,
  EQ IF,
    CURSYH [U] LDX,
    NE IF, CONSTANT tochgdl2
  THEN,
  SEC,
  1 U8 SBC,
  CURSYL [U] STA,
  NC IF,
    CURSYH [U] DEC,
  THEN,

  SCY [U] LDX,
  4E U8 CPX,
  NE IF, // to x8
    SEC,
    1 U8 SBC,
    CURSYL [U] STA,
    NC IF,
      CURSYH [U] DEC,
    THEN,
    INX,
    SCY [U] STX,
    TXA, 
    CLC,
    12 U8 ADC,
    DEX, DEX,
    TEMPI [U] STX,
    TAX,
    BEGIN,
      PLYR0 1- [U+X] LDA,
      PLYR0 [U+X] STA,
      DEX,
      TEMPI [U] CPX,
    EQ UNTIL,
    NE IF, CONSTANT tochgdl3
  THEN,

  YPOSL [U] LDA,
  CLC, // no, decrement y-coordinate
  1 U8 ADC,
  YPOSL [U] STA,
  CS IF,
    YPOSH [U] INC,
  THEN,
  0F U8 AND,
  VSCROL [U] STA, // fine scroll
  EQ IF, CONSTANT tochgdl4 // no, move on
  OFFLO [U] LDA, // yes, mark offset
  CLC,
  30 U8 ADC,
  OFFLO [U] STA,
  OFFHI [U] LDA,
  0 U8 ADC,
  OFFHI [U] STA,

  // Update display list map window line start offsets
  tochgdl1 THEN,
  tochgdl2 THEN,
  tochgdl3 THEN,
  tochgdl4 THEN, )

  ( CHGDL )
  ( 09 U8 LDY,
  BEGIN,
    DLSTPT [[U8]+Y] LDA,
    CLC,
    OFFLO [U] ADC,
    DLSTPT [[U8]+Y] STA,
    INY,
    DLSTPT [[U8]+Y] LDA,
    OFFHI [U] ADC,
    DLSTPT [[U8]+Y] STA,
    INY, INY,
    27 U8 CPY,
  EQ UNTIL, )

// TERR determines what terrain is in a square
BARHERE CONSTANT TERROLD ( was 7240 ) ( [LAT] [LONG] -mem- [UNITNO] [TRNCOD] )
  TERRB U16 JSR,
  NE IF, 
    RTS,
  THEN,

  // terrain code is 3D or 3E indicating a unit is there.
  TRNCOD [U] LDA,
  UNTCOD [U] STA,

  // is unit German or Russian?
  C0 U8 AND,
  NUMBEROFUNITS U8 LDX,
  40 U8 CMP, // is terrain color code 01?
  EQ IF,
    // terrain color code was 1 indicating German unit
    FIRSTRUSSIANUNIT U8 LDX,
  THEN,

  LAT [U] LDA,
  BEGIN, // loop30
    CORPSY [U+X] CMP, // does [LAT] match unit's Y?
    NE IF, // to mightb
      // y does not match, do next unit.
    BEGIN, // X97
      DEX,
  ROT EQ UNTIL, ( to loop30 )
  
  // no units match, error - put asterix on screen
  FF U8 LDA,
  TXTWDW 80 + [U] STA,
  // J.N. added this to make sure if no unit is found, memory is not trashed
  0 U8 LDA,
  UNITNO [U] STA,
  TRNCOD [U] STA,
  RTS,

  PL IF, // to match
    // mightb  
    ROT THEN,
    // does [LONG] match unit's X?
    LONG [U] LDA,
    CORPSX [U+X] CMP,
    EQ IF, // to x99
      // yes
      CSTRNG [U+X] LDA,
      NE IF, // to x99
        // has unit already left?
        ARRIVE [U+X] LDA,
        PL IF, // to x99
          // unit has not left, has unit arrived?
          TURN [U] CMP,
          CS IF, // to match
            NE IF, // to match
        ( x99 ) ROT THEN,
      ROT THEN,
    ROT THEN,
    ( X99 ) LAT [U] LDA,
    3 ROLL U16 JMP, // to X97
  THEN, 
          THEN, 
            THEN,
  // Match
  UNITNO [U] STX,
  SWAPIT [U+X] LDA, 
  TRNCOD [U] STA,
  RTS,

HEX
// assumes map starts on page aligned address
BARHERE CONSTANT TERRBOLD ( [LAT] [LONG] -mem- [TRNCOD] ) ( -reg- zc )
  0 U8 LDA,
  MAPPTR 1+ [U] STA,
  0 U8 LDA, 
  UNITNO [U] STA, // some parent routines also calculate the unit on this square
  MAPHEIGHT 1- U8 LDA,  // 39 - [lat] // mapheight - 1
  SEC,
  LAT [U] SBC,
  // looks like *48
  RA ASL,
  MAPPTR 1+ [U] ROL,
  RA ASL,
  MAPPTR 1+ [U] ROL,
  RA ASL,
  MAPPTR 1+ [U] ROL,
  RA ASL,
  MAPPTR 1+ [U] ROL, 
  TLO [U] STA,
  MAPPTR 1+ [U] LDY,
  THI [U] STY,
  RA ASL,
  MAPPTR 1+ [U] ROL,
  CLC,
  TLO [U] ADC,
  MAPPTR [U] STA,
  MAPPTR 1+ [U] LDA,
  THI [U] ADC,
  MAPSTART 8 RSHIFT U8 ADC, // was 65
  MAPPTR 1+ [U] STA,
  MAPWIDTH 2 - U8 LDA, // 46 - [LONG] // mapwidth - 2
  SEC,
  LONG [U] SBC,
  TAY,
  MAPPTR [[U8]+Y] LDA,
  TRNCOD [U] STA,
  3F U8 AND,
  3D U8 CMP,
  NE IF,
    3E U8 CMP,
  THEN,
  RTS, ( zflag is set if it's a military unit, carry is set if it's a military unit or impassible )

HEX
BARHERE CONSTANT OLDTERRB ( [LAT] [LONG] -mem- [TRNCOD] ) ( -reg- zc )

  0 U8 LDA, 
  UNITNO [U] STA, // some parent routines also calculate the unit on this square

  MAPHEIGHT 1- U8 LDA,  // 39 - [lat] // mapheight - 1
  SEC,
  LAT [U] SBC,
  RA ASL,
  CLC,
  TAY,
  MAPROWOFFSETTBL [U+Y] LDA,
  MAPPTR [U] STA,
  MAPROWOFFSETTBL 1+ [U+Y] LDA,
  MAPPTR 1+ [U] STA,

  MAPWIDTH 2 - U8 LDA, // 46 - [LONG] // mapwidth - 2
  SEC,
  LONG [U] SBC,
  TAY,

  MAPPTR [[U8]+Y] LDA,
  TRNCOD [U] STA,
  3F U8 AND,
  3D U8 CMP,
  NE IF,
    3E U8 CMP,
  THEN,
  RTS, ( zflag is set if it's a military unit, carry is set if it's a military unit or impassible )

HEX
// for swapping corps with terrain
BARHERE CONSTANT SWITCHOLD ( was 0x79EF ) ( [CHUNKX] [CHUNKY] [CORPS] -- )
  CHUNKX [U] LDA,
  MAPWIDTH 2 - U8 CMP,
  CS IF,
    DrawSWITCHbadx U16 JSR,
    BEGIN, CLC, CS UNTIL,
  THEN,

  CHUNKY [U] LDA,
  MAPHEIGHT 1- U8 CMP,
  CS IF,
    DrawSWITCHbady U16 JSR,
    BEGIN, CLC, CS UNTIL,
  THEN,
 
  // seems like this is a ypos * 48 routine.. so *16 + *32
  0 U8 LDA,
  MAPHI [U] STA,       // 0->[MAPHI]
  MAPHEIGHT 1- U8 LDA,           // 39 decimal may be map height... are y coords reversed? 
  SEC,
  CHUNKY [U] SBC,      // (27 - [CHUNKY]) * 0x10 -> [MAPHI:TEMPLO]
  RA ASL,
  MAPHI [U] ROL,
  RA ASL,
  MAPHI [U] ROL,
  RA ASL,
  MAPHI [U] ROL,
  RA ASL,
  MAPHI [U] ROL,
  TEMPLO [U] STA, 

  MAPHI [U] LDX,      // [MAPHI]->[TEMPHI]
  TEMPHI [U] STX,
  RA ASL,             // 2*[MAPHI:TEMPLO] 
  MAPHI [U] ROL,
  CLC,
  TEMPLO [U] ADC,
    // if map is not xx00 aligned add MAPSTART U8 ADC, but may put vbi over 2000 cycle budget
    // MAPSTART U8 ADC,
  MAPLO [U] STA,
  MAPHI [U] LDA,
  TEMPHI [U] ADC,
  MAPSTART 8 RSHIFT U8 ADC,  // map used to start at 6500, I moved it to 700
  MAPHI [U] STA,  

  MAPWIDTH 2 - U8 LDA,        // 2E - [CHUNKX] -> Y seems to be map width... are x coords also reversed?
  SEC,
  CHUNKX [U] SBC,
  TAY,
                     // if [corps] is not 0 then
  MAPLO [[U8]+Y] LDA, //   exchange [[maplo]+y] with [swapit+[corps]]
  CORPS [U] LDX,
  NE IF,
    PHA,
    SWAPIT [U+X] LDA,
    MAPLO [[U8]+Y] STA,
    PLA,
    SWAPIT [U+X] STA,
  THEN,
  RTS,

BARHERE CONSTANT DOARRIVALSOLD
  NUMBEROFUNITS U8 LDX, // any reinforcements?
  BEGIN,
    // does unit arrive this turn?
    ARRIVE [U+X] LDA,
    TURN [U] CMP,
    EQ IF, // to x33
      // yes, unit arrives this turn
      CORPSX [U+X] LDA,
      CHUNKX [U] STA,
      LONG [U] STA,
      CORPSY [U+X] LDA,
      CHUNKY [U] STA,
      LAT [U] STA,
      CORPS [U] STX,
      TERRB U16 JSR, // probably is something is already there?
      NE IF, // to sorry
        // arrival square is clear
        FIRSTRUSSIANUNIT U8 CPX, // russian unit check
        NC IF, // to a51
          // is a German unit... show something in text window... I think this means German units arrived
          0A U8 LDA,
          TXTWDW 24 + [U] STA,
        THEN,
        // swap units
        // A51
        SWITCH U16 JSR, // trashes X but restores it using [CORPS]
      //  0 U16 JMP, BARHERE CONSTANT toX33a // an unresolved jump to X33 
      // THEN, 
      // sorry
      ELSE,  
        TURN [U] LDA,
        CLC,
        1 U8 ADC,
        ARRIVE [U+X] STA,
        // X33 
        // toX33a LONGTHEN,
      THEN,
    THEN,
    DEX,
  EQ UNTIL,
  RTS,

// This routine checks to see if a unit 'has supply'
//   If not, the unit's combat strength is divided by 2 rounded down
//   German units do not have supply in spring or fall due to 'mud' and lose half their strength
//   German units also do not have supply in winter
//     if 4 * distance from E edge + 0x4A is < [RANDOM]
//   Russian units and German units in summer do not have supply if there are too many enemy
//     units along path in the direction they get supplies from.
//     The path goes 1 square towards the supply direction for first square and if no
//       enemy units are N E S W of the square or only 1 enemy unit to NE NW SE SW of square.  
//     A square randomly N or S of the path is checked if there is an enemy unit 
//       on square or to N E S W of square or if there are two enemy units on square to the 
//       NE NW SE SW using the same check for the square N or S.
//       If the check to the N or S fails, it tries randomly checking N or S of the original
//         square again until either the check passes, or until the number of checks is exhausted. 
//         (this means the loop can get stuck going randomly N and S until the supply check fails)
BARHERE CONSTANT OLDLOGSTC // ( x=unit -r- ) ( -mem- [CSTRNG+unit]=supply )
// supply evaluation routine
  // if the unit hasn't arrived yet or unit arrived this turn, do nothing
  ARRIVE [U+X] LDA,
  TURN [U] CMP,
  NE IF,
    CS IF,
      RTS,
    THEN,
  THEN,

  18 U8 LDA,
  FIRSTRUSSIANUNIT U8 CPX,
  NC IF, CONSTANT toa13a

    // is a German unit
    18 U8 LDA, // this is probably not needed
    EARTH [U] LDY, // background color for top of map set during calcseason
    2 U8 CPY, // 2 means spring or fall --- but Chris's comment is 'mud?'
    NE IF, CONSTANT toa12a // so if it's a german unit and spring or fall,
                           //   combat strength gets divided by 2
                           // or if it's a german unit and summer and
                           //   it fails a roll based on distance into
                           //   Russian territory, divide combat strength
                           //   by 2

      // background color for top of map means it is not spring or fall
      0A U8 CPY, // 0x0A means winter
      EQ IF, CONSTANT toa13b

        // it is winter and unit is German, roll against distance into 
        //   into Russian territory 
        CORPSX [U+X] LDA, // this discourages gung-ho corps - distance from E edge
        RA ASL, // double distance from E edge
        RA ASL, // 4 * distance from E edge
        4A U8 ADC, // 4 * distance from E edge + 0x4A
        RANDOM [U] CMP, 
        CS IF, CONSTANT toa12b

          // 4 * distance from E edge + 0x4A is >= [RANDOM]
          10 U8 LDA, // harder to get supplies in winter
          // A13
   toa13a THEN,
   toa13b THEN,

        // unit is Russian, 
        // or unit is German and it is summer
        // or unit is German and it is winter
        //   and 4 * distance of unit from E edge + 0x4A >= [RANDOM]
        ACCLO [U] STA, // I'm guessing how easy it is to get supplies
                       // holds 0x18 if unit is Russian
                       // holds 0x18 if unit is German and top of map is
                       //   not showing mud or snow
                       // holds 0x10 if unit is German and 
                       //   top of map is not showing mud but is showing snow
                       //   and and 4 * distance of unit from E edge + 0x4A >= [RANDOM]

        // get supply direction into Y and [HOMEDR]
        1 U8 LDY, // Russians go east
        FIRSTRUSSIANUNIT U8 CPX,
        NC IF,
          3 U8 LDY, // Germans go west
        THEN,
        HOMEDR [U] STY,

        // unit's x,y -> [LONG] [LAT]
        CORPSX [U+X] LDA,
        LONG [U] STA,
        CORPSY [U+X] LDA,
        LAT [U] STA,

        // 0->[RFR]
        0 U8 LDA,
        RFR [U] STA,

        BEGIN, 
          // this checks to see if there are enough friendly units along path
          //   to either the edge of the map or to a lake
         
          BEGIN,
            // copy unit position to [SQX] [SQY]
            LONG [U] LDA,
            SQX [U] STA,
            LAT [U] LDA,
            SQY [U] STA,

            BEGIN,
              // get next coordinate in direction supplies come from
              SQX [U] LDA,
              CLC,
              XINC [U+Y] ADC,
              LONG [U] STA,
              SQY [U] LDA,
              CLC,
              YINC [U+Y] ADC,
              LAT [U] STA,

              // check zone of control for coordinate next to unit in direction
              //   supplies come from
              CHKZOC U16 JSR, // ( x=unit -reg- ) ( [LAT] [LONG] -mem- [ZOC] )
                              // returns 2 for other team unit on square 
                              //  + 2 for each other team unit N E S W
                              //  + 1 for each other team unit NE NW SE SW

              FIRSTRUSSIANUNIT U8 CPX,
              CS IF, CONSTANT toA80a // to a80
                // unit is Russian
                TERRB U16 JSR,
                TRNCOD [U] LDA,
                BF U8 CMP, // terrain 143 which is probably a lake
                NE IF, CONSTANT toA77a // to a77
                  // terrain is not a lake
                  // a80 
              toA80a THEN,
              // unit is German
              // or unit is Russian and terrain code is not 0xBF which is 143
              //   terrain code 0xBF is 0x3F with color 2 which is probably a lake
 
             ZOC [U] LDA,
             2 U8 CMP,
                  // CS IF, // CONSTANT toz81a // cs while,
            CS WHILE,
              // [ZOC] >= 2 which means other team units are at loc or nearby
              RFR [U] INC, // +1 to [RFR]
              // a77 
              toA77a THEN,
            
              // terrain is a lake or enemy units are nearby
              RFR [U] INC, // +1 to [RFR]
              RFR [U] LDA,
              ACCLO [U] CMP, // how easy it is to get supplies
              CS IF, CONSTANT toA84a // to Z84
              // [RFR] >= [ACCLO]

        // a12
        toa12a THEN,
        toa12b THEN,
          // unit is German and it is spring or fall 
          // or unit is German and it is winter 
          //   and 4 * distance from E edge + 0x4A is < [RANDOM]
          // or unit is German and too many other team units are along path to W
          // or unit is Russian and too many other team units are along path to E

          // divide combat strength by 2
          CSTRNG [U+X] LSR,
          EQ IF,
            // if combat strength is 0 unit dies
            DEADSUB U16 JSR,
          THEN,
          RTS,
      toA84a THEN,
      // [RFR] < [ACCLO] - which means not enough enemy units along path yet to block supply
      //   but enemy units nearby WERE found... go up or down
      // Z84 
      // randomly choose N or S -- shouldn't choice be remembered? 
      //   in other words, if Y is already 0 or 2... don't randomize it again?
      RANDOM [U] LDA,
      2 U8 AND,
      TAY, 
    REPEAT, 
    // Z81
    // a square with no enemy units nearby was found
    HOMEDR [U] LDY, // go back to going in direction of supply
    LONG [U] LDA,
    1 U8 CPY,
    EQ IF, CONSTANT toz85
      // is Russian
      FF U8 CMP,
  EQ UNTIL,
  // reached right edge of map
  //   so umm... isn't MSTRNG in ROM in original game?
  //   if not... this will probably only affect the check if unit breaks calculation

  MSTRNG [U+X] INC, // Russian replacements
  MSTRNG [U+X] INC,
  RTS,
    // is German
    toz85 THEN,
    2E U8 CMP,
  EQ UNTIL,
  // reached left edge of map
  RTS,

BARHERE CONSTANT CHUNKTOUNITOLD
  // [CHUNKX] [CHUNKY] [TURN] [ARRIVE[]] -mem-
  // ra=[CHUNKY] -reg- x=unit  // x=0 means no unit found
  // CHUNKY [U] LDA, - not really needed if after GETCOORDS... but could you add this 
  //   to make testing simpler
  NUMBEROFUNITS U8 LDX,
  BEGIN,
    CORPSY [U+X] CMP,
    EQ IF,
      // y loc matches
      CHUNKX [U] LDA,
      CORPSX [U+X] CMP,
      EQ IF, 
        // x loc matches
        ARRIVE [U+X] LDA,
        PL IF, 
          // unit has not left
          TURN [U] CMP,
          EQ IF, 
            // unit arrived this turn
            RTS,
          THEN,
          NC IF,
            // unit arrived on a previous turn
            RTS,
          THEN,
        THEN,
      THEN,
      CHUNKY [U] LDA,
    THEN,
    // this unit doesn't match, onto the next
    DEX,
  EQ UNTIL,
  RTS,


// this seems to add the high byte of the sum of each 
//   unit's x location * (combat strength/8) to ACCLO and saturate at FF
//   I guess this could sort of figure out where the front is approximately...
//   ACCHI:LO = the sum of (distance into Russian territory * muster strength) on entry
BARHERE CONSTANT OLDNOTSUREWHATTHISDOES // X=0 on entry
  BEGIN, // loopc
    CORPSX [U+X] LDA, // unit's x location
    TEMPR [U] STA,    // copy of unit's x location
    CSTRNG [U+X] LDA, // unit's combat strength aka hp
    RA LSR, RA LSR, RA LSR,
    NE IF, // to A02
      // if combat strength /8 is not 0 then
 
      TAY,  // y = combat strength /8
      0 U8 LDA, 
      CLC,
      // multiply combat strength / 8 by unit's x location using repetitive addition
      // saturate at ff
      BEGIN, // loopd
        TEMPR [U] ADC, // add unit's x location
        CS IF, // to A03
          ACCLO [U] INC, // add 1 to acclo if total rolled over 8 bits
          CLC,  
          EQ IF, // to A03 // saturate at FF
            ACCLO [U] DEC,
          THEN,
        THEN,
        // A03 
        DEY,
      EQ UNTIL, // to loopd
    // A02  
    THEN,
    INX,
    NUMBEROFUNITS U8 CPX, // this won't do the last unit...
  EQ UNTIL, // to loopc
  RTS,

BARHERE CONSTANT OLDSEARCHRUSSIANUNITS

      NUMBEROFUNITS U8 LDX,
      BEGIN, // loop55

        // has unit arrived?
        ARRIVE [U+X] LDA,
        TURN [U] CMP,
        NE IF, // to Z25
          NC IF, // to Y58 - to next russian unit
        ( Z25 )
        SWAP THEN,
        
        // does unit's x match target square?
        OBJX FIRSTRUSSIANUNIT - [U+X] LDA,
        SQX [U] CMP,
        EQ IF, // to Y58
          // unit's x matches target square
          OBJY FIRSTRUSSIANUNIT - [U+X] LDA,
 
          // does unit's y match target square?
          SQY [U] CMP,
          EQ IF, // to Y58

            // unit's y matches target square
            // make sure this isn't the same unit that is moving
            ARMY [U] CPX,
            NE IF, // to Y31
              // this is not the same unit
              // is the unit already dead?
              MSTRNG [U+X] LDA, // initial combat strength
              EQ IF, // to Y59
                // yes unit is dead
          ( Y58 - next russian unit )
           ROT THEN,
         ROT THEN,
           ROT THEN,

        DEX,
        FIRSTRUSSIANUNIT U8 CPX,
       ROT NC UNTIL, // to loop 55
           ( Y31 )
            SWAP THEN,
      // other unit is either dead, the same unit, had not arrived, or no unit on square
      0 U8 LDA,
             ( Y59 )
             THEN,
      RTS,

BARHERE CONSTANT OLD5X
  // multiply column number by 5 to get LINARR index and loop 
      1 U8 CPX,
      EQ IF, // to Y91
        05 U8 LDX,
    Y92 EQ UNTIL, 
      THEN, // Y91
      2 U8 CPX,
      EQ IF, // to Y93
        0A U8 LDX,
    Y92 EQ UNTIL, 
      ( Y93 )
      THEN,
      03 U8 CPX,
      EQ IF, // to Z40
        0F U8 LDX,
    Y92 EQ UNTIL, 
      ( Z40 )
      THEN,
      04 U8 CPX,
      EQ IF, // to Z41
        14 U8 LDX,
    Y92 EQ UNTIL, 
      ( Z41 )
      THEN,

BARHERE CONSTANT OLDMULTIPLYIFR
    // multiply IFR for current direction by point total and add to ACCHI:ACCLO 
    // [ACCHI:ACCLO] = 0 on entry to Y88       
    TEMPR [U] STA, // should be IFR for current direction in [SECDIR]
    LPTS [U] LDX, // point total
    NE IF,  // to Z49
      ACCLO [U] LDA,
      CLC,
      BEGIN, // LOOP75
        TEMPR [U] ADC,
        CS IF, // to Y34
          ACCHI [U] INC,
          CLC,
          EQ IF, // to Y34
            FF U8 LDA,
            ACCHI [U] STA,
          ( Y34 )
          THEN,
        THEN,
        DEX,
      EQ UNTIL, // loop LOOP75
    // Z49 
    THEN,

BARHERE CONSTANT OLDMULTIPLYNBVAL
    // multiply ([NBVAL] + terrain's defense bonus) with [TEMPR] and saturate at 0xFF
    0 U8 LDA,
    CLC,
    BEGIN, // loop60
      TEMPR [U] ADC, // I think this is [TEMPR] = unit's IFR or if IFR > 0x0F 2*(0x0F - IFR)
      CS IF, // to y69
        FF U8 LDA,
        PL IF, // to Y71
      // y69 
      SWAP THEN,
      DEY,
    SWAP EQ UNTIL, // to loop60
        // Y71
        THEN,

// Source JN
BARHERE CONSTANT ISUNITATCHUNK
  // [CORPSX+unit] [CORPSY+unit] [ARRIVE+unit] [CHUNKX]  [CHUNKY] [TURN] -mem-
  // X=unit -reg- 
  // -flag- CS=unitatchunk
  CHUNKY [U] LDA,
  CORPSY [U+X] CMP,
  NE IF,
    CLC,
    RTS,
  THEN,
  CHUNKX [U] LDA,
  CORPSX [U+X] CMP,
  NE IF,
    CLC,
    RTS,
  THEN,
  ARRIVE [U+X] LDA,
  MI IF,
    CLC,
    RTS,
  THEN,
  TURN [U] CMP,
  // carry is set if unit has arrived
  RTS,

BARHERE CONSTANT OLDQUERYUNITUNDERCURSOR
  // -flag- cs=unitmatched
  ISUNITATCHUNK U16 JSR,
  CS IF,
    DOUNITMATCHES U16 JSR,
    SEC,
  THEN,
  RTS,

HEX
// first button pass
//   looks for a unit inside cursor
//   if there is one, puts unit info into text window
// Source EFT18I.ASM line 3670
BARHERE CONSTANT OLDFBUTPS
  FF U8 LDA,
  BUTFLG [U] STA,
   
  // first gets coords of center of cursor (map frame)
  GETCOORDS U16 JSR,

  // now look for a match with unit coordinates
    // looking for if x, y, not left, and already arrived
  NUMBEROFUNITS U8 LDX,
  BEGIN,
    QUERYUNITUNDERCURSOR U16 JSR,    
  NC IF,
    DEX,  
  SWAP EQ UNTIL,
  THEN,

  // no unit matches
  CORPS [U] STX, // change CORPS to 0
  DEX,
  HITFLG [U] STX, // change hitflg to -1
  ENDISR U16 JMP,


