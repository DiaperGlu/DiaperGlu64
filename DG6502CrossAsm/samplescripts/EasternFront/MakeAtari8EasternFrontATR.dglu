      TICK [U] INC,
      TICK [U] LDA,
      20 U8 CMP,
  LOOP33 EQ UNTIL,

  // end of movement phase
  // 0 U16 JMP, BARHERE CONSTANT toNEWTRNa
  RTS, // I think this is an RTS now...


// Days go from 1 to length of month
// Months go from 1 to 12
// Years are represented with one byte but only 1944 leapyear will be calculated correctly
//   which is ok because 1944 is the only leapyear in the game

// Source EFT18M.ASM line 2120
DECIMAL
BARHERE CONSTANT NEXTWEEK
  DAY [U] LDA,
  CLC,
  7 U8 ADC,
  MONTH [U] LDX,  // if month is 0, monlen is 0
  MONLEN [U+X] CMP,
  NE IF, // is day <> monlen?
    CS IF, 
      // day is > monlen
      2 U8 CPX, // is month february?
      EQ IF,
        // month is february
        YEAR [U] LDY, // is year 1944? (leapyear?)
        44 U8 CPY,
        EQ IF,
          // it's leapyear, fake day 29 by subtracting 1 from day- this will work as long as you don't end up on day 29 on a leap year
          SEC,
          1 U8 SBC,
        THEN,
      THEN,

      SEC,
      MONLEN [U+X] SBC, // subtracts month length of month from day

      INX, // next month
      13 U8 CPX,
      EQ IF, // was month December?
        YEAR [U] INC,  // year = next year
        01 U8 LDX,     // month = January
      THEN,
      MONTH [U] STX,   // save month
      TRTAB [U+X] LDY,
      TRCOLR [U] STY,  // set TRCOLR to the current month's color
    THEN,
  THEN,
  DAY [U] STA, // save day
  RTS,

