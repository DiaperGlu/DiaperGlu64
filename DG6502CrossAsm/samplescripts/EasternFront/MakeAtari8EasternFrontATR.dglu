    CORPSX [U+X] SBC, // subtract Russian unit's x location
    MI IF,
      // if unit's target X is less that unit's current x 
      1 U8 LDY, // set direction to E
      NEGA U16 JSR, // invert delta x
    THEN,
    HDIR [U] STY, // save horizontal direction of Russian unit
    HRNGE [U] STA, // save Russian unit's delta X to target
    0 U8 LDY, // set direction to N
    OBJY FIRSTRUSSIANUNIT - [U+X] LDA, // Russian unit's target y
    SEC,
    CORPSY [U+X] SBC, // subtract Russian unit's y location
    SEC,
    MI IF,
      // if unit's target Y is less than unit's current y
      2 U8 LDY, // set direction to N
      NEGA U16 JSR, // invert delta y
    THEN,
    VDIR [U] STY, // save vertical direction of Russian unit
    VRNGE [U] STA, // save Russian unit's delta y to target
    HRNGE [U] CMP, // see if vertical distance to target is greater or equal to horizontal
    CS IF, // to Y81
      // vertical distance to target is greater or equal to horizontal
      LRNGE [U] STA, // save vertical distance to target in LRNGE
      HRNGE [U] LDA, // get horizontal distance to target
      SRNGE [U] STA, // save horizontal distance to target HRNGE -> SRNGE
      HDIR [U] LDA, // get horizontal direction
      SDIR [U] STA, // save horizontal direction in SDIR
      LDIR [U] STY, // save vertical direction in LDIR
    ELSE, // to Y82 
      // Y81
      SRNGE [U] STA, // save vertical distance to target in SRNGE
      SDIR [U] STY, // save vertical direction in SDIR
      HRNGE [U] LDA, // get horizontal distance to target
      LRNGE [U] STA, // save horizontal distance to target in LRNGE
      HDIR [U] LDY, // get horizontal direction 
      LDIR [U] STY, // save horizontal direction in LDIR
    THEN,
    // Y82
    0 U8 LDA,
    RCNT [U] STA, // I think this holds which order for the russian unit
    RORD1 [U] STA,
    RORD2 [U] STA,

    // [LRNGE] + [SRNGE] -> [RANGE]
    LRNGE [U] LDA,
    CLC,
    SRNGE [U] ADC,
    RANGE [U] STA, 
    NE IF, // to Y86
      // unit's target location is not equal to current location
        // [LRNGE]/2 -> [CHRIS]
      LRNGE [U] LDA,
      RA LSR,
      CHRIS [U] STA, 

      // build order list to move unit from current location to target location
      BEGIN, // loop61
        // add [SRNGE] to [CHRIS]
        CHRIS [U] LDA,
        CLC,
        SRNGE [U] ADC,
        CHRIS [U] STA,

        // subtract [LRNGE] + [SRNGE] from [CHRIS]
        SEC,
        RANGE [U] SBC, 
        NC IF, // to ovrflo
          // [CHRIS] was < [LRNGE] + [SRNGE]
          LDIR [U] LDA, // load longer direction into RA 
          CS IF, // to STIP  // this is a jump
        // ovrflo 
        SWAP THEN,
        CHRIS [U] STA,

        SDIR [U] LDA, // load shorter direction into RA
          // stip
          THEN,
        DIR [U] STA, // save chosen direction  

        // get which 2 bits (0 - 3) of the order list byte will get the order into Y
        RCNT [U] LDA, // which order is being stored
        3 U8 AND,
        TAY, // y = lower two bits of [RCNT]

        TEMPR [U] STA, // copy of which 2 bits (0-3) of the order will get the order

        // get which byte of the order list (0 or 1) will get the order into X
        RCNT [U] LDA, // is 0 - 7
        RA LSR,
        RA LSR,
        TAX, // x = [RCNT] / 2 which is 0 or 1 ... used to index RORD1 or RORD2

        DIR [U] LDA, // get the order into A (0 - 3)

        // Y = which bit pair (0-3) get replaced
        // X = which byte of the order list (0 or 1) gets the order
        // RA = the order

        // shift the order into position
        BEGIN, // y85
          DEY,
        PL WHILE, // to y84
          RA ASL, // multiply direction by 4 which is also the order
          RA ASL,
        REPEAT,
        
        TEMPR [U] LDY, // which 2 bits (0-3) of the order will get the order
  
        // This puts the order into RORD1 or RORD2 at the correct spot
        // - EFT18T.ASM line 8110
        RORD1 [U+X] EOR, //   
        MASKO [U+Y] AND, // select only the bits for the order

        RORD1 [U+X] EOR, // get the bits for the rest of the order, and invert the order bits
        RORD1 [U+X] STA, // save the order

        // increment order index
        RCNT [U] LDX,
        INX,
        RCNT [U] STX, // next order
        
        08 U8 CPX, // if < than 8 orders keep going
        NC IF,
          RANGE [U] CPX, // if target range > than the current order (step) keep going
      SWAP CS UNTIL,
        THEN,
    THEN,

    // Y86
    // save the order list for the unit
    ARMY [U] LDX,
    RORD1 [U] LDA,
    WHORDS [U+X] STA,
    RORD2 [U] LDA,
    WHORDH [U+X] STA,
    RCNT [U] LDA,
    HMORDS [U+X] STA,

    // Y77
    TOY77 LONGTHEN,
    DEX,
    FIRSTRUSSIANUNIT U8 CPX,
    CS IF, // to y87
  // beginaddr 
  SWAP U16 JMP, 
    THEN,
  RTS,

// Source EFT18C.ASM line 4960
// see if a unit breaks
BARHERE CONSTANT BRKCHK ( x=unit )
  FIRSTRUSSIANUNIT U8 CPX,
  NC IF,
    // is a German unit
    CORPT [U+X] LDA, // unit's name
    F0 U8 AND,
    EQ IF,
      // I believe this path means unit does not have a last name
      MSTRNG [U+X] LDA, // initial combat strength - muster strength
      RA LSR, // get muster strength / 2
      0 U16 JMP, BARHERE ( put after branch offset on stack )
    SWAP THEN,
  SWAP THEN,
  // This path means this is a German unit with a last name or a Russian unit
  //   get last name index * 2 I think (divides *16 by 8)
  RA LSR,
  RA LSR,
  RA LSR,
  // Get muster strength - (last name index * 2)
  TEMPR [U] STA,
  MSTRNG [U+X] LDA, // initial combat strength - muster strength
  SEC,
  TEMPR [U] SBC,

      LONGTHEN,
  CSTRNG [U+X] CMP, // combat strength
  CS IF,
    // combat strength <= than modified muster strength... so unit breaks
    FF U8 LDA,
    EXEC [U+X] STA,
    // so if a unit breaks, the number of orders is set to 0...
    //   this causes the arrow to top of screen problem with the original code
    0 U8 LDA,
    HMORDS [U+X] STA,
  THEN,
  RTS,

// Source EFT18C.ASM line 4880
BARHERE CONSTANT UNITLEAVE // could restore terrain from copy of original map
                           //  and not use SWAPIT[UNIT]
  // X=unit
  CORPS [U] STX, // unit to swap with terrain
  CORPSX [U+X] LDA, // unit x location
  CHUNKX [U] STA, // x location of terrain to swap
  CORPSY [U+X] LDA, // unit y location
  CHUNKY [U] STA, // y location of terrain to swap

  SWITCH U16 JSR, // restore terrain from unit // assumes unit is on map

  CHUNKTOMAPUNITSPTR U16 JSR,
  0 U8 LDA,
  MAPPTR [[U8]+Y] STA, 
  RTS,

// Source EFT18C.ASM line 4810
BARHERE CONSTANT DEADSUB // changed name due to conflict with hex number
  0 U8 LDA,
  MSTRNG [U+X] STA, // initial combat strength - muster strength
  CSTRNG [U+X] STA, // combat strength
  HMORDS [U+X] STA, // how many orders
  FF U8 LDA,       // tick 'never'
  EXEC [U+X] STA, // which tick to do next order
  ARRIVE [U+X] STA, // what turn unit arrives
  UNITLEAVE U16 JSR,
  RTS,

// Source EFT18C.ASM line 4050
BARHERE CONSTANT NOSUPPLIES // keep in mind units heal 32-64 hp per turn
  // divide combat strength aka hp by 2
  CSTRNG [U+X] LSR,
  EQ IF,
    // if combat strength is 0 unit dies
    DEADSUB U16 JSR,
  THEN,
  RTS,

// Source EFT18C.ASM line 3500
BARHERE CONSTANT GERMANLOGSTC
 
  18 U8 LDA, // this is probably not needed

  EARTH [U] LDY, // background color for top of map set during calcseason
  2 U8 CPY, // 2 means spring or fall --- Chris's comment: mud?
  EQ IF,  
    // so if it's a german unit and spring or fall, combat strength gets divided by 2
    NOSUPPLIES U16 JMP,
  THEN,

  // background color for top of map means it is not spring or fall
  0A U8 CPY, // 0x0A means winter
  EQ IF, 

    // it is winter, roll against distance into into Russian territory 
    //   Chris's comment: this discourages gung-ho corps 
    CORPSX [U+X] LDA,             
    RA ASL,  RA ASL,  4A U8 ADC,  // 4 * distance from E edge + 0x4A     
       
    RANDOM [U] CMP, 
    NC IF, 
      // 4 * distance from E edge + 0x4A is < [RANDOM]
      NOSUPPLIES U16 JMP,
    THEN,

    // 4 * distance from E edge + 0x4A is >= [RANDOM]
    10 U8 LDA, // harder to get supplies in winter

  THEN,
 
  // it is summer
  //   or it is winter and 4 * distance of unit from E edge + 0x4A >= [RANDOM]
  ACCLO [U] STA, // How easy it is to get supplies
                 //   0x18 if summer
                 //   0x10 if winter

  // get supply direction into Y and [HOMEDR]
  3 U8 LDY, // Germans go west
  HOMEDR [U] STY,

  // unit's x,y -> [LONG] [LAT] - this is the start of the path
  CORPSX [U+X] LDA,
  LONG [U] STA,
  CORPSY [U+X] LDA,
  LAT [U] STA,

  // 0->[RFR] - [RFR] gets 2 points each time a zoc check fails
  0 U8 LDA,
  RFR [U] STA,

  // do a zone of control check along a path in direction supplies come from unit either
  //   the edge is reached or the too many zoc checks failed count is reached
  //   a zone of control check passes if there are no enemy units N E S W or on square
  //     or if there is only one enemy unit NE NW SE SW

  //   if the zoc check passes- enemies not blocking, contine towards the direction of supply
  //   if the zoc check fails- enemies are blocking, randomly check either N or S of the square
  //     if the check fails again, it keeps randomly checking N or S of the square
  //     so if both N and S are blocked, the supply will be blocked
  //     or if it randomly keeps picking the one N or S that fails, the supply will be blocked
 
  BEGIN,

    // copy path's current position to [SQX] [SQY]
    LONG [U] LDA,
    SQX [U] STA,
    LAT [U] LDA,
    SQY [U] STA,

    BEGIN,

      // get next square from last square where enemies were not blocking
      //   at start and if enemies are not blocking go towards supply direction
      //   if enemies are blocking go randomly N or S
      SQX [U] LDA,
      CLC,
      XINC [U+Y] ADC,
      LONG [U] STA,
      SQY [U] LDA,
      CLC,
      YINC [U+Y] ADC,
      LAT [U] STA,

      // check zone of control for square
      CHKZOC U16 JSR, // ( x=unit -reg- ) ( [LAT] [LONG] -mem- [ZOC] )
                      // returns 2 for enemy team unit on square 
                      //  + 2 for each enemy team unit N E S W
                      //  + 1 for each enemy team unit NE NW SE SW

      // is ZOC >= 2?
      // this means an enemy unit is on square, or N E S W of square
      //   or two or more enemies on NE NW SE SW
      ZOC [U] LDA,
      2 U8 CMP,
    CS WHILE,

      // square is blocked, add 2 points to [RFR]
      // [ZOC] >= 2 which means other team units are at loc or nearby
      RFR [U] INC, // +1 to [RFR]
      RFR [U] INC, // +1 to [RFR]

      RFR [U] LDA,
      ACCLO [U] CMP, // how easy it is to get supplies - either 0x18 summer or 0x10 winter
      CS IF, 
          
        // [RFR] >= [ACCLO] - too many enemy units blocking supply path
        NOSUPPLIES U16 JMP,
      THEN,
      
      // [RFR] < [ACCLO] - which means not enough enemy units along path yet to block supply
      //   but enemy units nearby WERE found... go up or down

      // randomly choose N or S, current square is not updated
      RANDOM [U] LDA,
      2 U8 AND,
      TAY, 
    REPEAT, 

    // a square with no enemy units nearby was found, current square will be updated
    HOMEDR [U] LDY, // continue going in direction of supply

    LONG [U] LDA,         
    2E U8 CMP,
  EQ UNTIL,

  // reached left edge of map
  RTS,

// Source EFT18C.ASM line 3660
BARHERE CONSTANT RUSSIANLOGSTC

  18 U8 LDA, // from lines 3500 3510 when unit is Russian
  ACCLO [U] STA, 

  // get supply direction into Y and [HOMEDR]
  1 U8 LDY, // Russians go East
  HOMEDR [U] STY,

  // unit's x,y -> [LONG] [LAT] - this is the start of the path
  CORPSX [U+X] LDA,
  LONG [U] STA,
  CORPSY [U+X] LDA,
  LAT [U] STA,

  // 0->[RFR] - [RFR] gets 1 or 2 points each time a zoc check fails
  0 U8 LDA,
  RFR [U] STA,

  // do a zone of control check along a path in direction supplies come from unit either
  //   the edge is reached or the too many zoc checks failed count is reached
  //   a zone of control check passes if there are no enemy units N E S W or on square
  //     or if there is only one enemy unit NE NW SE SW
  //   if the zoc check passes- enemies not blocking, contine towards the direction of supply
  //   if the zoc check fails- enemies are blocking, randomly go N or S 
  //     (yes this means the path can go up and down on the same squares)
  BEGIN, 

    // update path's current position to [SQX] [SQY]
    LONG [U] LDA,
    SQX [U] STA,
    LAT [U] LDA,
    SQY [U] STA,

    BEGIN,

      // check next square in current direction
      //   current direction is supply direction at start and if enemies are not blocking
      //   current direction is randomly N or S if enemies are blocking
      SQX [U] LDA,
      CLC,
      XINC [U+Y] ADC,
      LONG [U] STA,
      SQY [U] LDA,
      CLC,
      YINC [U+Y] ADC,
      LAT [U] STA,

      // square is a lake - [RFR] <- [RFR] + 1
      // square is not a lake and ZOC blocked - [RFR] <- [RFR] + 2
      // square is not a lake and ZOC clear - next  
      TERRB U16 JSR,
      TRNCOD [U] LDA,
      BF U8 CMP, // terrain 143 (0xBF is 0x3F with color 2) which is a lake
      NE IF, CONSTANT toA77a // to a77

      // check zone of control for square
      CHKZOC U16 JSR, // ( x=unit -reg- ) ( [LAT] [LONG] -mem- [ZOC] )
                        // returns 2 for enemy team unit on square 
                        //  + 2 for each enemy team unit N E S W
                        //  + 1 for each enemy team unit NE NW SE SW

      // terrain is not a lake
      ZOC [U] LDA,
      2 U8 CMP,
    CS WHILE,

      // [ZOC] >= 2 which means other team units are at loc or nearby
      RFR [U] INC, // +1 to [RFR]
      toA77a THEN,
            
      // terrain is a lake 
      RFR [U] INC, // +1 to [RFR]

      RFR [U] LDA,
      ACCLO [U] CMP, // how easy it is to get supplies, 0x18 
      CS IF, 
          
        // [RFR] >= [ACCLO] - too many enemy units blocking supply path
        NOSUPPLIES U16 JMP,
      THEN,
      
      // a lake was found or
      // [RFR] < [ACCLO] - which means not enough enemy units along path yet to block supply
      //   but enemy units nearby WERE found... go up or down

      // randomly choose N or S, current square is not updated
      RANDOM [U] LDA,
      2 U8 AND,
      TAY, 
    REPEAT, 

    // a square with no enemy units nearby was found, current square is updated
    HOMEDR [U] LDY, // continue going in direction of supply

    LONG [U] LDA,
  EQ UNTIL,
       
  // reached right edge of map
  //   so umm... isn't MSTRNG in ROM in original game?
  //   if not... this will probably only affect the check if unit breaks calculation

  MSTRNG [U+X] INC, // Russian replacements
  MSTRNG [U+X] INC,
  RTS,

// This routine checks to see if a unit 'has supply'
//   If not, the unit's combat strength is divided by 2 rounded down
//   German units do not have supply in spring or fall due to 'mud' and lose half their strength
//     but... during the 32 tick movement phase armies are given back 1 or 2 points each tick
//   German units also do not have supply in winter if 4 * distance from E edge + 0x4A is < [RANDOM]
//     but... during the 32 tick movement phase armies are given back 1 or 2 points each tick
//   Russian units all year and German units in summer do not have supply if the supply 
//     path is blocked.
//     The path goes 1 square towards the supply direction for the first square 
//       and when no enemy units on the square or N E S W of the square
//         or only 1 enemy unit is NE NW SE SW of square.
//     Otherwise one square N or S of the path is repeatedly randomly checked 
//       until clear path is found... I think after this check, if a way around is found,
//       the path continues along the original line... but I'm not sure.
//
//       If there are no enemy units on the chosen square to the N or S 
//         or to the N E S W of the chosen square to the N or S
//         or there is only one enemy unit NE NW SE SW of the chosen square to the N or S, 
//         the path is clear
//       this means if the two squares N and S of the enemy unit are blocked, 
//         the unit does not have supply
//       this means if for any square along the path if two squares N and S 
//         of the path are blocked, the unit does not have supply
//       it also means if one direction N or S is randomly chosen over and over that is blocked,
//         the unit does not have supply
//       it also means if there is an enemy unit directly on the supply path, the unit does not
//         have supply
//       this means if for any square along the path if one square N or S 
//         of the path is blocked, after too many of these, the unit does not have supply

// Source EFT18C.ASM line 3430
BARHERE CONSTANT LOGSTC // ( x=unit -r- ) ( -mem- [CSTRNG+unit]=supply )
// supply evaluation routine
  // if the unit hasn't arrived yet or unit arrived this turn, do nothing
  ARRIVE [U+X] LDA,
  TURN [U] CMP,
  NE IF,
    CS IF,
      RTS,
    THEN,
  THEN,

  FIRSTRUSSIANUNIT U8 CPX,
  NC IF,
    GERMANLOGSTC U16 JMP,
  THEN,
  RUSSIANLOGSTC U16 JMP,
  

// Source EFT18C.ASM line 2800
// Subroutines for combat
//   RETRET checks square to N S E or W to see if a unit can move onto it
//   retreatdir determines N S E or W
//   destination is blocked if:
//     there is a unit on destination square
//     destination square is border
//     destination square is coast and in bad ocean crossing list
//     destination square has an enemy unit on it (redundant check)
//     destination square has an enemy unit to the N S E W
//     destination square has two or more enemy units to NE NW SE and/or SW
//   if destination square is blocked, enemy unit loses 5 combat strength (hp) and may die
BARHERE CONSTANT RETRET 
  // [DEFNDR]=defenderid -mem-
  // X=defenderid Y=retreatdir -reg- CF=true=defenderlivesflag ZF=true=retreatopenflag

  // J.N. added this but it probably isn't necessary
  DEFNDR [U] STX,  
 
  // get destination: [LAT]=desty [LONG]=destx
  CORPSX [U+X] LDA,
  CLC,
  XINC [U+Y] ADC,
  LONG [U] STA,
  CORPSY [U+X] LDA,
  CLC,
  YINC [U+Y] ADC,
  LAT [U] STA,

  TERR U16 JSR,   // [UNITNO] = 0 or unit on square; [TRNCOD] = terrain on square
  TERRTY U16 JSR, // [TRNTYP] = terrain type; Y=terrain type
  DEFNDR [U] LDX,

  // anybody in this square?
  UNITNO [U] LDA, 
  EQ IF, CONSTANT toy22a 

    // nobody in square
    TRNTYP [U] LDA,
  
    // check for bad ocean crossings
    // is terrain coast unit or border?
    7 U8 CMP, 
    CS IF, CONSTANT toy41a

    // terrain is coast unit or border
    // is terrain border? 
    9 U8 CMP,
    NE IF, CONSTANT toy22b

    // terrain is not border, check for bad ocean crossing 
    15 U8 LDY,
    BEGIN,
      LAT [U] LDA,
      BHY1 [U+Y] CMP,
      EQ IF, CONSTANT toy43a 
      LONG [U] LDA,
      BHX1 [U+Y] CMP,
      EQ IF, CONSTANT toy43b 
      CORPSX [U+X] LDA,
      BHX2 [U+Y] CMP,
      EQ IF, CONSTANT toy43c 
      CORPSY [U+X] LDA,
      BHY2 [U+Y] CMP,
      NE IF, CONSTANT toy22c 
      // Y43
      toy43a THEN,
      toy43b THEN,
      toy43c THEN,    
      DEY,
    MI UNTIL,

    // Y41
    toy41a THEN,

    // any blocking ZOC's? 
    // J.N. added this but it probably isn't necessary
    DEFNDR [U] LDX,

    CHKZOC U16 JSR,
    DEFNDR [U] LDX,
    ZOC [U] LDA,
    2 U8 CMP,
    NC IF, // no retreat into ZOC
      0 U8 LDA, // retreat is possible
      SEC,
      RTS,
    // Y22
  THEN,
  toy22a THEN,
  toy22b THEN,
  toy22c THEN,

  // retreat is not possible, extract penalty
  CSTRNG [U+X] LDA,
  SEC,
  5 U8 SBC,
  CSTRNG [U+X] STA,
  NE IF, 
    NC IF,
  SWAP THEN,
  DEADSUB U16 JSR,
  CLC,
    THEN,
  FF U8 LDA,
  RTS, 

// assumes destination square does not already have a unit
// Source JN replacement for moving a unit
BARHERE CONSTANT UNITMOVE ( X=unit -reg- ) ( [LAT]=newy [LONG]=newx -mem- ) 
  CORPS [U] STX,

  // added run time error check - if there is a unit at destination give error and lock up
  LOCTOMAPUNITSPTR U16 JSR, // does not trash x
  MAPPTR [[U8]+Y] LDA,
  NE IF,
    DrawUNITMOVEEr U16 JSR,
    CLC, BEGIN, CS UNTIL,    // lock up
  THEN,

  CORPSX [U+X] LDA,
  CHUNKX [U] STA,
  CORPSY [U+X] LDA,
  CHUNKY [U] STA,

  CHUNKTOMAPUNITSPTR U16 JSR, // does not trash x
  0 U8 LDA,
  MAPPTR [[U8]+Y] STA, 

  SWITCH U16 JSR,

  CORPS [U] LDX,
  LAT [U] LDA,
  CHUNKY [U] STA,
  CORPSY [U+X] STA,
  LONG [U] LDA,
  CHUNKX [U] STA,
  CORPSX [U+X] STA,

  CHUNKTOMAPUNITSPTR U16 JSR,
  TXA,
  MAPPTR [[U8]+Y] STA, 

  SWITCH U16 JSR,
  RTS,

// J.N. added for debugging - makes sure unit map matches main map
BARHERE CONSTANT CHECKMAPSQUARE 
  // [LONG]=x [LAT]=y -mem-
  
  LOCTOMAPPTR U16 JSR,
  MAPPTR [[U8]+Y] LDA,
  3F U8 AND,
  3D U8 CMP,
  NE IF,
    3E U8 CMP,
    NE IF,
      // map says there is no unit on square
      LOCTOMAPUNITSPTR U16 JSR,
      MAPPTR [[U8]+Y] LDA,
      NE IF,
        // there is a unit... show error and lock up
        DrawHiddenUnit U16 JSR,
        DrawLOC U16 JSR,
        CLC, BEGIN, CS UNTIL,
      THEN,
      RTS,
    THEN,
  THEN,

  LOCTOMAPUNITSPTR U16 JSR,
  MAPPTR [[U8]+Y] LDA,
  EQ IF,
    // there is a unit... show error and lock up
    DrawMissngUnit U16 JSR,
    DrawLOC U16 JSR,
    CLC, BEGIN, CS UNTIL,
  THEN,
  RTS,

// J.N. added for debugging - makes sure unit map matches main map
BARHERE CONSTANT CHECKMAPSQUARES
  MAPHEIGHT 1- U8 LDA,
  LAT [U] STA,
  BEGIN,
    MAPWIDTH 2 - U8 LDA,
    LONG [U] STA,
    BEGIN,
      CHECKMAPSQUARE U16 JSR,
      LONG [U] DEC,
    EQ UNTIL,
    LAT [U] DEC,
  EQ UNTIL,
  RTS, 

