// Compile the 6502 cross assembler
$" ../../DG6502CrossAsm.dglu" INCLUDEFILE$

// Compile the .atr disk file maker
$" ../BufToATR.dglu" INCLUDEFILE$

// Load the Atari 8 bit labels.
$" ../AtariLabels.dglu" INCLUDEFILE$

: CODE-ICODE$, ( a$ -$- ) ( -ccbuf- a$ )
    0 GETS$[ND] PCURRENTCOMPILEBUFFER @ S>BUF DROP$
;


// User labels
HEX
230 CONSTANT DLSTLO // other name is SDLSTL
231 CONSTANT DLSTHI

HEX
70 CONSTANT PLAYERWINDOWHI
7200 CONSTANT PLYR0
7280 CONSTANT PLYR1
7300 CONSTANT PLYR2
7380 CONSTANT PLYR3

HEX
9E CONSTANT NUMBEROFUNITS
37 CONSTANT FIRSTRUSSIANUNIT 
67 CONSTANT NUMBEROFRUSSIANUNITS
78 CONSTANT PM0INITIALXPOS ( for cursor )
36 CONSTANT PM0MINXPOS
BA CONSTANT PM0MAXXPOS
30 CONSTANT MAPWIDTH
28 CONSTANT MAPHEIGHT

: BUILDROWOFFSETTABLE { | columns rows baseaddr -- }
    rows 0 DO
      I columns * baseaddr + CODE-U16,
    LOOP
;

// Initialize the cross assembler. This makes the disk image buffer.
//   600 NEWCROSSBUFFER means make a new current compile buffer using relative base address 600
//   Only compile code for the 6502 program in this buffer.
//   (In other words, don't make any : definitions that the host computer will execute.)
//   This buffer will end up being your disk image.
HEX 
600 NEWCROSSBUFFER  


// /////////////////////////////////////////////////////
// This is where your assembly language program goes. //
// /////////////////////////////////////////////////////


// Cross compile the Atari810 Disk Header 

( 0x600 ) 0 CC,           // probably has to be 0 ( disassemble OS to find out for sure )
OHERE CONSTANT oNumberOfBootSectors  // this makes a label so the script can automatically set the correct number of sectors
( 0x601 ) 1 CC,           // number of boot sectors
( 0x602 ) 600 CODE-U16,   // boot load address
( 0x604 ) 606 CODE-U16,   // boot init routine address 
   // code at load address + 6 is executed, then RTS, takes you to init address
   //   I should probably make init take you to an error

0 U16 JMP, BARHERE CONSTANT toCode 

// MAPPTR is a main program variable

// VBI variables ... protected by BUTFLG I think 
// CORPS CHUNKX CHUNKY SWAPIT[] MAPLO MAPHI and the MAP
// HMORDS[] HOWMNY STPCNT BASEX STEPX BASEY STEPY ORDCNT
// CORPSX[] CORPSY[] TURN
// WHORDS WHORDH
// TEMPLO TEMPHI

// page zero game variables
HEX 1 80
ENUM<
  DLSTPT
  DLSTPTHI
  MAPLO
  MAPHI
  CORPS
  CURSXL
  CURSXH
  CURSYL
  CURSYH
  OFFLO
  OFFHI
  TEMPI
  CNT1
  CNT2
  CHUNKX
  CHUNKY
  MAPPTR
  MAPPTRHI
  ARMY 
  UNITNO
  DEFNDR
  TEMPR
  TEMPZ
  ACCLO
  ACCHI
  TURN
  LAT
  LONG
  RFR
  TRNTYP
  SQVAL
> DROP

( 0x609 )
HEX
BARHERE CONSTANT TXTWDW (  was $6450 ) 90 CODE-ALLOT
BARHERE CONSTANT TXTWDWTOP ( was $64E0 ) 20 CODE-ALLOT // adding 1 to original code

( 0x6B9 )
HEX
2 CODE-ALLOT // to cover the corner case where BARHERE is at xxFE or xxFF 
             // this will allow for putting 2 bytes before aligned MAPDATA no matter what

CRLF ." before align for MAPSTART " BARHERE U.
BARHERE 100 ROUNDUP 2 - BARHERE - CODE-ALLOT // to align MAPSTART to 700
CRLF ." after align for mapdata " BARHERE U.

DECIMAL
BARHERE CONSTANT MAPDATA // only initial display list uses MAPDATA
0 CC, // adding one since original display list starts 1 before map data which 
// may have been part of the top text line's data
( this was originally at $64FF )
127 CC, 

// 48x41 map  code routines hardcode mapwidth and height such as the *48 calculation

( this was originally at $6500 ... if this location is page aligned it speeds up calculations )
BARHERE CONSTANT MAPSTART // start address for functions using map
