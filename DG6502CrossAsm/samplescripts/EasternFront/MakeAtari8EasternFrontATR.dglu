  TXTMSG U16 JSR,
  RTS,

// Source EFT18M.ASM line 5890
BARHERE CONSTANT DROPORDER
  WHORDH [U+X] LSR,
  WHORDS [U+X] ROR,
  WHORDH [U+X] LSR,
  WHORDS [U+X] ROR,
  RTS,

// Source EFT18M.ASM line 5930
BARHERE CONSTANT DIDUNITCAPTURECITY
  // if unit is on a scoring city, set true false flag for that city
  //   -reg- X = unit
  //   MOSCOW[4] = scoreflags
  //     FF = german unit on scoring city
  //     00 = russian unit on scoring city
  //   MOSCX[4] = scoring city x
  //   MOSCY[4] = scoring city y
        
  3 U8 LDY,
  BEGIN,
    CORPSX [U+X] LDA,
    MOSCX [U+Y] CMP,
    EQ IF,
      CORPSY [U+X] LDA,
      MOSCY [U+Y] CMP,
      EQ IF, 
        FF U8 LDA,
        FIRSTRUSSIANUNIT U8 CPX,
        CS IF, 
          0 U8 LDA,
        THEN,
        MOSCOW [U+Y] STA,
      THEN,
    THEN,
    DEY,
  MI UNTIL,
  RTS,

