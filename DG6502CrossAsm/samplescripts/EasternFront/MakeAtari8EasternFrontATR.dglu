  MAPPTR [[U8]+Y] LDA, // ra=0 or unit
  NE IF,
    // there is a unit, the terrain code is held in the swapit array
    TAX, // x=unit
    SWAPIT [U+X] LDA,
    RTS,
  THEN,

  CHUNKTOMAPHILO U16 JSR,
  MAPLO [[U8]+Y] LDA,
  RTS,

BARHERE CONSTANT TERRAIN! ( [CHUNKY] [CHUNKX] -mem- [MAPPTRHI:MAPPTRLO] ) ( RA=terrain -reg- )
  PHA,
  // check to see if there is a unit on the square
  CHUNKTOMAPUNITSPTR U16 JSR, 
  MAPPTR [[U8]+Y] LDA, // ra=0 or unit
  NE IF,
    // there is a unit, the terrain code is held in the swapit array
    TAX, // x=unit
    PLA,
    SWAPIT [U+X] STA,
    RTS,
  THEN,

  CHUNKTOMAPHILO U16 JSR,
  PLA,
  MAPLO [[U8]+Y] STA,
  RTS,


