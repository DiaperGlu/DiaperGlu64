HEX
BARHERE CONSTANT DRAWDATE ( X=month [DAY]=day [YEAR]=year -- ) // only year mod 0x0A is used, rest of year is hardcoded to "194"

  // clear text window
  93 U8 LDY,
  0 U8 LDA,
  BEGIN,
    TXTWDW [U+Y] STA,
    INY,
    A7 U8 CPY,
  EQ UNTIL,

