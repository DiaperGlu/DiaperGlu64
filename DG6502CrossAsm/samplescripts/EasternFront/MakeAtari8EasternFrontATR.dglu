BARHERE CONSTANT DETERMINESTRATEGY
    // now determine whether to use offensive or defensive strategy
    ARMY [U] LDX,
    IFR FIRSTRUSSIANUNIT - [U+X] LDA, // get unit's IFR
    TEMPR [U] STA, // save IFR
    0F U8 LDA, 
