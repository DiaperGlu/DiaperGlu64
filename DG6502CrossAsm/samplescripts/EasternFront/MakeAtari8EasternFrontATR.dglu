// Source EFT18T.ASM line 9710
HEX
BARHERE CONSTANT ABSA
BARHERE CONSTANT INVERT // aka ABS ( ra -reg- |ra| ) 
                        // assumes flag is set correctly on ra i.e. it was just loaded
    MI IF,
 
// Source EFT18T.ASM line 9720
  BARHERE CONSTANT NEGA
  BARHERE CONSTANT INVERT+2 // aka NEG ( ra -reg- -ra )
    FF U8 EOR,
      CLC,
      1 U8 ADC,
    THEN,
    RTS,

// Source JN replacement for repetitive add multiplies
BARHERE CONSTANT U8MUL8PLUSSAT 
  // mprod = ([m1] * [m2lo]) + mprod
  //   trashes RA; does not trash X or Y
  TXA,
  PHA,
  0 U8 LDA, 
  M2HI [U] STA,
  8 U8 LDX,
  BEGIN,
    M1 [U] ROR,
    CS IF,
      M2LO [U] LDA,
      CLC,
      MPRODLO [U] ADC,
      MPRODLO [U] STA,
      M2HI [U] LDA,
      MPRODHI [U] ADC,
      MPRODHI [U] STA,
      CS IF,
        FF U8 LDA,
        MPRODLO [U] STA,
        MPRODHI [U] STA,
        RTS,
      THEN,
    THEN,
    M2LO [U] ASL,
    M2HI [U] ROL,
    DEX,
  EQ UNTIL,
  PLA,
  TAX,
  CLC, // probably not necessary... M2HI [U] ROL, should leave carry clear...
  RTS,

BARHERE CONSTANT INITMAPUNITS
  MAPUNITS DUP U8 LDA,  MAPPTR [U] STA,
  8 RSHIFT U8 LDA,      MAPPTRHI [U] STA,

  MAPWIDTH MAPHEIGHT * DUP U8 LDY,
  8 RSHIFT U8 LDX,

// Source JN 
BARHERE CONSTANT ERASE
  // [MAPPTR:MAPPTRLO] = pdest
  // X:Y = length
  0 U8 LDA,
BARHERE CONSTANT FILL // length of 0 is treated as 0
  // X=lengthhi
  // Y=lengthlo
  0 U8 CPX,
  NE IF,
    FILTMP [U] STY,
    0 U8 LDY,
    BEGIN,
      BEGIN,
        MAPPTR [[U8]+Y] STA,
        INY,
      EQ UNTIL,
      MAPPTRHI [U] INC,
      DEX,
    EQ UNTIL,
    FILTMP [U] LDY,
  THEN,
  0 U8 CPY,
  NE IF,
    BEGIN,
      DEY,
      MAPPTR [[U8]+Y] STA,
      0 U8 CPY,
    EQ UNTIL,
  THEN,
  RTS,

  // Source EFT18M.ASM line 6720
  BARHERE CONSTANT STALL ( was 7200 )
    0 U8 LDA,
    BEGIN, 
      PHA, PLA, PHA, PLA, PHA, PLA,
      1 U8 ADC,
    EQ UNTIL,
    RTS,

// Source EFT18I.ASM line 11360
// displays number with leading zeroes suppressed
HEX // yes the 10s are really hex 10
BARHERE CONSTANT DNUMBR
  TAX,
  CLC,
  HDIGIT [U16+X] LDA,
  NE IF,
    10 U8 ADC,
