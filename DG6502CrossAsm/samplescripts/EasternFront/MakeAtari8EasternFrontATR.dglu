BARHERE CONSTANT UNITFLASH // this does not use the vbi routine to do the flash
  UNITNO [U] LDY,
  DEFNDR [U] STY,
  DEFNDR [U] LDX, // make combat graphics
  SWAPIT [U+X] LDA,
  PHA,
  FF U8 LDA, // solid red square
  FIRSTRUSSIANUNIT U8 CPX, // Russian unit?
  NC IF,
    7F U8 LDA, // make it white for Germans
  THEN,
  CORPS [U] STX,
  CORPSX [U+X] LDA,
  CHUNKX [U] STA,
  CORPSY [U+X] LDA,
  CHUNKY [U] STA,
  SWITCH U16 JSR,
  08 U8 LDY,
  8F U8 LDX,
  BEGIN,
    AUDC1 [U] STX,
    AUDF1 [U] STY,
    STALL U16 JSR,
    TYA,
    CLC,
    08 U8 ADC,
    TAY,
    DEX,
    7F U8 CPX,
  EQ UNTIL,

  // now replace original unit character
  SWITCH U16 JSR,
  DEFNDR [U] LDX,
  PLA,
  SWAPIT [U+X] STA,
  RTS,


// source EFT18C.ASM line 1170
HEX
BARHERE CONSTANT OCOMBAT ( 4ED8 ) ( [ARMY] [UNITNO] -mem- )

  // DrawCOMBAT U16 JSR,

  0 U8 LDA,
  VICTRY [U] STA,

  ARMY [U] LDX,
  2A U8 CPX, // Finns can't attack
  NE IF,
    28 U8 CPX,
    EQ IF,
  SWAP THEN,
    RTS,
  THEN,

  UNITFLASH U16 JSR, // sets [DEFNDR]

  // changed from original 3/14/2026 J.N. - original is not using variables correctly
  // ra=terrain code from UNITFLASH
  TRNCOD [U] STA, // J.N. added this. TERRTY needs terrain code in [TRNCOD]
  
  // - source EFT18C.ASM line 1620
  TERRTY U16 JSR, // terrain in defender's square // -reg- y=terraintype
  CSTRNG [U+X] LDA, // defender's strength // J.N. moved and changed y to x. 
  DEFNC [U+Y] LDX, // defensive bonus factor 
  // apply DEFNC bonus/penalty
  //   1 = /2
  //   2 = none
  //   3 = *2 saturated at 0xFF
  RA LSR, // this loses lo bit...
  BEGIN,
    DEX,
  NE IF,
    RA ROL,
  SWAP CS UNTIL,
  FF U8 LDA,
  THEN,

  // again, in original Y is not the unit number anymore...
  // now adjust for defender's motion 
  // if defender is moving, defender's combat strength for the attack is divided by 2
  DEFNDR [U] LDY, // added this 3/14/2026 J.N.
  // - source EFT18C.ASM line 1740
  HMORDS [U+Y] LDX, // how many orders
  NE IF,
    RA LSR, 
  THEN,

  // source EFT18C.ASM line 1780
  // evaluate defender's strike
  // is the defenders attack is >= a random number? 
  RANDOM [U] CMP,
  CS IF,
    // yes
    ARMY [U] LDX,
    MSTRNG [U+X] DEC, // muster strength?
    CSTRNG [U+X] LDA, // combat strength
    05 U8 SBC,
    CSTRNG [U+X] STA, // combat strength
    NE IF, // if combaat strenth was = 5 unit dies
      NC IF, // if combat strength was < 5 unit dies
    SWAP THEN,
        DEADSUB U16 JMP, // attacker dies
      THEN,
    BRKCHK U16 JSR, // attacker lives; does he break?
    // so... um... if attacker breaks... what happens?
  THEN,

  // source EFT18C.ASM line 1920
  // Evaluate attacker's strike
  // ATAKR
  // get attacker combat strength and
  //  if attacker is on a river, coastline, or terrain&3F=0x3F divide by 2
  ARMY [U] LDX,
  CORPSX [U+X] LDA,
  LONG [U] STA,
  CORPSY [U+X] LDA,
  LAT [U] STA,
  // changed from original 3/14/2026 J.N.
  // source EFT18C.ASM line 1920
  // TERR U16 JSR, // shouldn't this be TERRB? or SWAPIT+X [U] LDA, TRNCOD [U] STA,?
  SWAPIT [U+X] LDA,  TRNCOD [U] STA,
  TERRTY U16 JSR,
  OFFNC [U+Y] LDA,
  TAY,
  ARMY [U] LDX,
  CSTRNG [U+X] LDA,
  // see if terrain is river or coast
  DEY,
  NE IF,
    // is river or coast, divide combat strength by 2
    RA LSR, // river attack penalty
  THEN,

  // is attacker's attack >= a random number?
  RANDOM [U] CMP,
  CS IF, // to A20
    // yes - attacker strikes defender
    DEFNDR [U] LDX, 
    MSTRNG [U+X] DEC,
    CSTRNG [U+X] LDA,
    05 U8 SBC,
    CSTRNG [U+X] STA,
    NE IF,
      NC IF,
    SWAP THEN,
    DEADSUB U16 JSR, // defender dies
  SWAP THEN,
  BEGIN,
    0 U16 JMP, BARHERE CONSTANT toENDCOMa
     SWAP THEN,
    BRKCHK U16 JSR, // does the defender break?
  CS UNTIL,

  // defender breaks - try to retreat the defender
  // first retreat priority : away from attacker
  //   in other words, try to move in same direction attacker is moving
  ARMY [U] LDY,
  WHORDS [U+Y] LDA,
  03 U8 AND,
  TAY, 
  RETRET U16 JSR, // tries the direction; on failure extracts penalty and may kill unit
  CS IF, CONSTANT tovicoma  // defender died 
  // defender lives
  NE IF, CONSTANT toy27a    // defender may retreat
  // defender can't retreat 

  01 U8 LDY,                // second priority: east/west
  FIRSTRUSSIANUNIT U8 CPX,
  NC IF,
    03 U8 LDY,
  THEN,
  RETRET U16 JSR,
  CS IF, CONSTANT tovicomb  
  NE IF, CONSTANT toy27b 

  02 U8 LDY,                // third priority: north
  RETRET U16 JSR,
  CS IF, CONSTANT tovicomc 
  NE IF, CONSTANT toy27c 

  00 U8 LDY,                // fourth priority: south
  RETRET U16 JSR,
  CS IF, CONSTANT tovicomd
  NE IF, CONSTANT toy27d

  03 U8 LDY,                // last priority: west/east
  FIRSTRUSSIANUNIT U8 CPX,
  NC IF,
    01 U8 LDY,
  THEN,
  RETRET U16 JSR,
  CS IF, CONSTANT tovicome 
  EQ IF, CONSTANT toendcom // to endcom
  
  // Y27
  toy27a THEN,
  toy27b THEN,
  toy27c THEN,
  toy27d THEN,

  UNITMOVE U16 JSR,

  // VICCOM
  tovicoma THEN,
  tovicomb THEN,
  tovicomc THEN,
  tovicomd THEN,
  tovicome THEN,

  ARMY [U] LDX,
  CORPS [U] STX,
  CORPSX [U+X] LDA,
  CHUNKX [U] STA,
  CORPSY [U+X] LDA,
  CHUNKY [U] STA,

  ACCLO [U] LDA, // defender's coordinates
  LONG [U] STA,
  ACCHI [U] LDA,
  LAT [U] STA,

  FF U8 LDA,
  VICTRY [U] STA, 

  BARHERE CONSTANT ENDCOM
  toENDCOMa LONGTHEN,
  toendcom THEN,
  ARMY [U] LDX,
  EXEC [U+X] INC, // which tick to do next order
  RTS,

// J.N. added for debugging, makes sure [LONG] and [LAT] are on map
BARHERE CONSTANT CHECKCOORD // [LONG]=x [LAT]=y
  LONG [U] LDA,
  MAPWIDTH 2 - U8 CMP,
  CS IF,
    DrawBADX U16 JSR,
    CLC, BEGIN, CS UNTIL,
  THEN,
  LAT [U] LDA,
  MAPHEIGHT 1- U8 CMP,
  CS IF,
    DrawBADY U16 JSR,
    CLC, BEGIN, CS UNTIL,
  THEN,
  RTS,  

// Source EFT18M.ASM line 3760
BARHERE CONSTANT UNITARRIVE ( X=unit -reg- X=unit ) ( -flag- CS=it worked )

  CORPSX [U+X] LDA,
  CHUNKX [U] STA,
  LONG [U] STA,

  CORPSY [U+X] LDA,
  CHUNKY [U] STA,
  LAT [U] STA,

  // debugging check - J.N.
  // CHECKCOORD U16 JSR,

  CORPS [U] STX,

  CHUNKTOMAPUNITSPTR U16 JSR,
  MAPPTR [[U8]+Y] LDA,
  EQ IF,

    // there is no unit on the square already
    TXA,
    MAPPTR [[U8]+Y] STA,

    FIRSTRUSSIANUNIT U8 CPX, // russian unit check
    NC IF, // to a51
      // is a German unit... show asterix in text window - means a german unit arrived
      0A U8 LDA,
      TXTWDW 24 + [U] STA,
    THEN,

    // swap units
    SWITCH U16 JSR, // trashes X but restores it using [CORPS]
    // eliminated UNITARRIVE as culprit for corrupting map May 2, 2026
    // CHECKMAPSQUARES U16 JSR,
    
    SEC, // unit arrived
    RTS,

  THEN,
  CLC,
  RTS,

// Source EFT18M.ASM line 3720   
BARHERE CONSTANT DOARRIVALS
  NUMBEROFUNITS U8 LDX, // any reinforcements?
  BEGIN,
    // does unit arrive this turn?
    ARRIVE [U+X] LDA,
    TURN [U] CMP,
    EQ IF, // to x33
      // yes, unit arrives this turn
      UNITARRIVE U16 JSR,
      NC IF,
        TURN [U] LDA,
        CLC,
        1 U8 ADC,
        ARRIVE [U+X] STA,
      THEN,
    THEN,   
    DEX,
  EQ UNTIL,
  RTS,

