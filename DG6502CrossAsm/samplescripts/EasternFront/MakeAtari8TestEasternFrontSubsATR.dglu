BARHERE CONSTANT TESTCALCPOINTSFORGERMANPOSITION


  // clear unitx and unitmaxhp
  UNITX 8 RSHIFT U8 LDA,
  PDESTHI [U] STA,
  UNITX U8 LDA,
  PDESTLO [U] STA,
  NUMBEROFUNITS U8 LDY,
  0 U8 LDX,
  MAPWIDTH U8 LDA,
  FILLMEM U16 JSR,

  UNITMAXHP 8 RSHIFT U8 LDA,
  PDESTHI [U] STA,
  UNITMAXHP U8 LDA,
  PDESTLO [U] STA,
  NUMBEROFUNITS U8 LDY,
  0 U8 LDX,
  ERASEMEM U16 JSR,

  // test 0 case
  CALCPOINTSFORGERMANPOSITION U16 JSR,
  
  ACCHI [U] LDA,
  NE IF,
    0 U8 LDA,
  ELSE,
    1 U8 LDA,
  THEN,
  8 U8 LDX, 
  0 U8 LDY,
  TypeTestResult U16 JSR,

  MPRODHI [U] LDA,
  NE IF,
    0 U8 LDA,
  ELSE,
    1 U8 LDA,
  THEN,
  8 U8 LDX, 
  1 U8 LDY,
  TypeTestResult U16 JSR,

  MPRODLO [U] LDA,
  NE IF,
    0 U8 LDA,
  ELSE,
    1 U8 LDA,
  THEN,
  8 U8 LDX, 
  2 U8 LDY,
  TypeTestResult U16 JSR,

  // put stuff at 0, 1, FIRSTRUSSIAN-1, and FIRSTRUSSIAN
  MAPWIDTH 02 - U8 LDA,  UNITX [U] STA,
  03 2* U8 LDA,          UNITMAXHP [U] STA,
  MAPWIDTH 05 - U8 LDA,  UNITX 1+ [U] STA,
  07 2* U8 LDA,          UNITMAXHP 1+ [U] STA,
  MAPWIDTH 0B - U8 LDA,  UNITX FIRSTRUSSIANUNIT 1- + [U] STA,
  0D 2* U8 LDA,          UNITMAXHP FIRSTRUSSIANUNIT 1- + [U] STA,
  MAPWIDTH 11 - U8 LDA,  UNITX FIRSTRUSSIANUNIT + [U] STA,
  13 2* U8 LDA,          UNITMAXHP FIRSTRUSSIANUNIT + [U] STA,

  CALCPOINTSFORGERMANPOSITION U16 JSR, 

  // should be [05*07] + [0B*0D] = decimal 35 + 143 = 178 = hex B2

  MPRODHI [U] LDA,
  NE IF,
    0 U8 LDA,
  ELSE,
    1 U8 LDA,
  THEN,
  8 U8 LDX, 
  3 U8 LDY,
  TypeTestResult U16 JSR,

  MPRODLO [U] LDA,
  B2 U8 CMP,
  NE IF,
    0 U8 LDA,
  ELSE,
    1 U8 LDA,
  THEN,
  8 U8 LDX, 
  4 U8 LDY,
  TypeTestResult U16 JSR,

  ACCHI [U] LDA,
  NE IF,
    0 U8 LDA,
  ELSE,
    1 U8 LDA,
  THEN,
  8 U8 LDX, 
  5 U8 LDY,
  TypeTestResult U16 JSR,  

  RTS,


