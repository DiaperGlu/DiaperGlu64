  TypeTestResult U16 JSR,

  TRNCOD [U] LDA,
  3D U8 CMP,
  NE IF,
    0 U8 LDA,
  ELSE,
    1 U8 LDA,
  THEN,
  0B U8 LDX, 
  04 U8 LDY,
  TypeTestResult U16 JSR,

  RTS,

HEX
BARHERE CONSTANT TESTLOCTOUNIT
  4 U8 LDA,
  MAPUNITS MAPWIDTH MAPHEIGHT 1- * + // this is start of the last row
    MAPWIDTH 2 - 2 - + [U] STA,
  
  // lower right corner
  0 U8 LDA,
  LAT [U] STA,
  2 U8 LDA,
  LONG [U] STA,
  LOCTOUNIT U16 JSR,
  4 U8 CPX,
  EQ IF,
    0 U8 LDA,
  ELSE,
    1 U8 LDA,
  THEN,
  0C U8 LDX, 
  00 U8 LDY,
  TypeTestResult U16 JSR, 

  5 U8 LDA,
  MAPUNITS MAPWIDTH MAPHEIGHT 2 - * + // this is start of the 2nd to last row
    MAPWIDTH 2 - 8 - + [U] STA,

  // lower right corner
  1 U8 LDA,
  LAT [U] STA,
  8 U8 LDA,
  LONG [U] STA,
  LOCTOUNIT U16 JSR,
  5 U8 CPX,
  EQ IF,
    0 U8 LDA,
  ELSE,
    1 U8 LDA,
  THEN,
  0C U8 LDX, 
  01 U8 LDY,
  TypeTestResult U16 JSR,

  RTS,

HEX
BARHERE CONSTANT TESTSQXYTOUNIT
  4 U8 LDA,
  MAPUNITS MAPWIDTH MAPHEIGHT 1- * + // this is start of the last row
    MAPWIDTH 2 - 2 - + [U] STA,
  
  // lower right corner
  0 U8 LDA,
  SQY [U] STA,
  2 U8 LDA,
  SQX [U] STA,
  SQXYTOUNIT U16 JSR,
  4 U8 CMP,
  EQ IF,
    0 U8 LDA,
  ELSE,
    1 U8 LDA,
  THEN,
  0D U8 LDX, 
  00 U8 LDY,
  TypeTestResult U16 JSR, 

  5 U8 LDA,
  MAPUNITS MAPWIDTH MAPHEIGHT 2 - * + // this is start of the 2nd to last row
    MAPWIDTH 2 - 8 - + [U] STA,

  // lower right corner
  1 U8 LDA,
  SQY [U] STA,
  8 U8 LDA,
  SQX [U] STA,
  SQXYTOUNIT U16 JSR,
  5 U8 CMP,
  EQ IF,
    0 U8 LDA,
  ELSE,
    1 U8 LDA,
  THEN,
  0D U8 LDX, 
  01 U8 LDY,
  TypeTestResult U16 JSR,

  RTS,

HEX
BARHERE CONSTANT TESTCHECKFORRUSSIANNOTSAMEUNIT
  
  FIRSTRUSSIANUNIT U8 LDX,
  ARMY [U] STX,
  CHECKFORRUSSIANNOTSAMEUNIT U16 JSR,
  0 U8 CMP,
  EQ IF,
    0 U8 LDA,
  ELSE,
    1 U8 LDA,
  THEN,
  0E U8 LDX, 
  00 U8 LDY,
  TypeTestResult U16 JSR, 

  FIRSTRUSSIANUNIT U8 LDX,
  ARMY [U] STX,
  INX,
  CHECKFORRUSSIANNOTSAMEUNIT U16 JSR,
  FIRSTRUSSIANUNIT U8 CMP,
  EQ IF,
    0 U8 LDA,
  ELSE,
    1 U8 LDA,
  THEN,
  0E U8 LDX, 
  01 U8 LDY,
  TypeTestResult U16 JSR, 

  FIRSTRUSSIANUNIT 1- U8 LDX,
  ARMY [U] STX,
  CHECKFORRUSSIANNOTSAMEUNIT U16 JSR,
  0 U8 CMP,
  EQ IF,
    0 U8 LDA,
  ELSE,
    1 U8 LDA,
  THEN,
  0E U8 LDX, 
  02 U8 LDY,
  TypeTestResult U16 JSR,

  RTS,
  


toCode LONGTHEN,


