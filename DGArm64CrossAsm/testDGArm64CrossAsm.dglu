CRLF ." loading DGArm64 Cross Assembler"
$" DGArm64CrossAsm.dglu" INCLUDEFILE$

CRLF
CRLF ." testing DGArm64 cross assembler"

HEX
: TEST?SRCAR ( -- )
    CRLF ." testing ?SRCAR"

    R PSOURCEAMODE !
    ?SRCAR FALSE = IF
      CRLF ERROR" fail - R ?SRCAR was FALSE  " NAME>E EXIT
    THEN

    DEFAULTR PSOURCEAMODE !
    ?SRCAR FALSE = IF
      CRLF ERROR" fail - DEFAULTR ?SRCAR was FALSE  " NAME>E EXIT
    THEN

    N PSOURCEAMODE !
    ?SRCAR FALSE <> IF
      CRLF ERROR" fail - N ?SRCAR not FALSE  " NAME>E EXIT
    THEN
;

TEST?SRCAR

: TEST?SRCBR ( -- )
    CRLF ." testing ?SRCBR"

    R PSOURCEBMODE !
    ?SRCBR FALSE = IF
      CRLF ERROR" fail - R ?SRCBR was FALSE  " NAME>E EXIT
    THEN

    DEFAULTR PSOURCEBMODE !
    ?SRCBR FALSE = IF
      CRLF ERROR" fail - DEFAULTR ?SRCBR was FALSE  " NAME>E EXIT
    THEN

    N PSOURCEBMODE !
    ?SRCBR FALSE <> IF
      CRLF ERROR" fail - N ?SRCBR not FALSE  " NAME>E EXIT
    THEN
;

TEST?SRCBR

: TEST?DESTR ( -- )
    CRLF ." testing ?DESTR"

    R PDESTMODE !
    ?DESTR FALSE = IF
      CRLF ERROR" fail - R ?DESTR was FALSE  " NAME>E EXIT
    THEN

    DEFAULTR PDESTMODE !
    ?DESTR FALSE = IF
      CRLF ERROR" fail - DEFAULTR ?DESTR was FALSE  " NAME>E EXIT
    THEN

    N PDESTMODE !
    ?DESTR FALSE <> IF
      CRLF ERROR" fail - N ?DESTR not FALSE  " NAME>E EXIT
    THEN
;

TEST?DESTR

HEX
: TESTN9>= ( -- )
    CRLF ." testing N9>="

    755 ( -- stackmarker )

    0 N9>= 0<> IF
      CRLF ERROR" fail - 0 N9>= not false  " NAME>E EXIT
    THEN

    -1 N9>= 0<> IF
      CRLF ERROR" fail - -1 N9>= not false  " NAME>E EXIT
    THEN

    FF N9>= 0<> IF
      CRLF ERROR" fail - FF N9>= not false  " NAME>E EXIT
    THEN

    100 N9>= 0= IF
      CRLF ERROR" fail - 100 N9>= returned true  " NAME>E EXIT
    THEN

    -100 N9>= 0<> IF
      CRLF ERROR" fail -  -100 N9>= not false  " NAME>E EXIT
    THEN

    -101 N9>= 0= IF
      CRLF ERROR" fail -  -101 N9>= returned true  " NAME>E EXIT
    THEN

    755 <> IF 
      ERROR" stack marker incorrect " NAME>E EXIT 
    THEN
;

TESTN9>=

HEX
: TEST?MA ( -- ) 
    CRLF ." testing ?MA"

    977 ( -- stackmarker )

    R PSOURCEAMODE ! ?MA FALSE <> IF
      CRLF ERROR" fail - R PSOURCEAMODE ! ?MA ... result not FALSE " NAME>E EXIT
    THEN

    N PSOURCEAMODE ! ?MA FALSE <> IF
      CRLF ERROR" fail - N PSOURCEAMODE ! ?MA ... result not FALSE " NAME>E EXIT
    THEN

    [R] PSOURCEAMODE ! ?MA FALSE = IF
      CRLF ERROR" fail - [R] PSOURCEAMODE ! ?MA ... result is FALSE " NAME>E EXIT
    THEN

    [R+N] PSOURCEAMODE ! ?MA FALSE = IF
      CRLF ERROR" fail - [R+N] PSOURCEAMODE ! ?MA ... result is FALSE " NAME>E EXIT
    THEN

    [O] PSOURCEAMODE ! ?MA FALSE = IF
      CRLF ERROR" fail - [O] PSOURCEAMODE ! ?MA ... result is FALSE " NAME>E EXIT
    THEN

    [PC+N] PSOURCEAMODE ! ?MA FALSE = IF
      CRLF ERROR" fail - [PC+N] PSOURCEAMODE ! ?MA ... result is FALSE " NAME>E EXIT
    THEN

    [RSP+N] PSOURCEAMODE ! ?MA FALSE = IF
      CRLF ERROR" fail - [RSP+N] PSOURCEAMODE ! ?MA ... result is FALSE " NAME>E EXIT
    THEN

    [R++N] PSOURCEAMODE ! ?MA FALSE = IF
      CRLF ERROR" fail - [R++N] PSOURCEAMODE ! ?MA ... result is FALSE " NAME>E EXIT
    THEN

    [R]++N PSOURCEAMODE ! ?MA FALSE = IF
      CRLF ERROR" fail - [R]++N PSOURCEAMODE ! ?MA ... result is FALSE " NAME>E EXIT
    THEN
    

    977 <> IF 
      ERROR" stack marker incorrect " NAME>E EXIT 
    THEN
;

TEST?MA

HEX
: TEST?MB ( -- ) 
    CRLF ." testing ?MB"

    978 ( -- stackmarker )

    R PSOURCEBMODE ! ?MB FALSE <> IF
      CRLF ERROR" fail - R PSOURCEBMODE ! ?MB ... result not FALSE " NAME>E EXIT
    THEN

    N PSOURCEBMODE ! ?MB FALSE <> IF
      CRLF ERROR" fail - N PSOURCEBMODE ! ?MB ... result not FALSE " NAME>E EXIT
    THEN

    [R] PSOURCEBMODE ! ?MB FALSE = IF
