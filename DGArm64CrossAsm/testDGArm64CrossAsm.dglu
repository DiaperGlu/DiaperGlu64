      CRLF ERROR" fail - NV SHORTBRANCH, 0 RESOLVE-BRANCH compiled branch displacement not 0" NAME>E EXIT
    THEN
    ARMNOP <> IF
      CRLF ERROR" fail - NV SHORTBRANCH, 0 RESOLVE-BRANCH compiled branch opcope' not armnop" NAME>E EXIT
