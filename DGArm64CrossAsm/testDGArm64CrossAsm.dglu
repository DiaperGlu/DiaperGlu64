HEX
: TESTGETBRANCHTYPE ( -- )
    CRLF ." testing GETBRANCHTYPE"

    155 ( -- stackmarker )

    ARMNOP GETBRANCHTYPE branchtypenever <> IF
      2DROP
      CRLF ERROR" fail - ARMNOP GETBRANCHTYPE branchtype not branchtypenever" NAME>E EXIT
    THEN
    0 <> IF
      DROP
      CRLF ERROR" fail - ARMNOP GETBRANCHTYPE displacement not 0" NAME>E EXIT
    THEN
    ARMNOP <> IF
      CRLF ERROR" fail - ARMNOP GETBRANCHTYPE opcope' not armnop" NAME>E EXIT
    THEN

    ARMB GETBRANCHTYPE branchtypealways <> IF
      2DROP
      CRLF ERROR" fail - ARMB GETBRANCHTYPE branchtype not branchtypealways" NAME>E EXIT
    THEN
    0 <> IF
      DROP
      CRLF ERROR" fail - ARMB GETBRANCHTYPE displacement not 0" NAME>E EXIT
    THEN
    ARMB <> IF
      CRLF ERROR" fail - ARMB GETBRANCHTYPE opcope' not armb" NAME>E EXIT
    THEN

    ARMB.cond GETBRANCHTYPE branchtypecond <> IF
      2DROP
      CRLF ERROR" fail - ARMB.cond GETBRANCHTYPE branchtype not branchtypecond" NAME>E EXIT
    THEN
    0 <> IF
      DROP
      CRLF ERROR" fail - ARMB.cond GETBRANCHTYPE displacement not 0" NAME>E EXIT
    THEN
    ARMB.cond <> IF
      CRLF ERROR" fail - ARMB.cond GETBRANCHTYPE opcope' not armb.cond" NAME>E EXIT
    THEN

    ARMB.cond NE OR GETBRANCHTYPE branchtypecond <> IF
      2DROP
      CRLF ERROR" fail - ARMB.cond NE OR GETBRANCHTYPE branchtype not branchtypecond" NAME>E EXIT
    THEN
    0 <> IF
      DROP
      CRLF ERROR" fail - ARMB.cond NE OR GETBRANCHTYPE displacement not 0" NAME>E EXIT
    THEN
    ARMB.cond NE OR <> IF
      CRLF ERROR" fail - ARMB.cond NE OR GETBRANCHTYPE opcope' not armb.cond NE OR" NAME>E EXIT
    THEN

    // oring in a displacement
    ARMB.cond 20 OR GETBRANCHTYPE branchtypecond <> IF
      2DROP
      CRLF ERROR" fail - ARMB.cond 20 OR GETBRANCHTYPE branchtype not branchtypecond" NAME>E EXIT
    THEN
    1 <> IF
      DROP
      CRLF ERROR" fail - ARMB.cond 20 OR GETBRANCHTYPE displacement not 1" NAME>E EXIT
    THEN
    ARMB.cond <> IF
      CRLF ERROR" fail - ARMB.cond 20 OR GETBRANCHTYPE opcope' not armb.cond" NAME>E EXIT
    THEN

    155 <> IF 
      ERROR" stack marker incorrect " NAME>E EXIT 
    THEN
;

TESTGETBRANCHTYPE

HEX
: TESTSHORTBRANCH, { oldccbuf newccbuf | -- }
    CRLF ." testing SHORTBRANCH,"

    155 ( -- stackmarker )

    PCURRENTCOMPILEBUFFER @ TO oldccbuf
    1000 -1 NEWBUFFER DUP TO newccbuf
    PCURRENTCOMPILEBUFFER !

    EQ SHORTBRANCH,
    4 <> IF
      CRLF ERROR" fail - NE SHORTBRANCH, afterbranchoffset incorrect" NAME>E EXIT
    THEN

    0 PCURRENTCOMPILEBUFFER @ O>P U32@ GETBRANCHTYPE
    branchtypecond <> IF
      CRLF ERROR" fail - EQ SHORTBRANCH, compiled branch branchtype not branchtypecond" NAME>E EXIT
    THEN
    0 <> IF
      DROP
      CRLF ERROR" fail - EQ SHORTBRANCH, compiled branch displacement not 0" NAME>E EXIT
    THEN
    ARMB.cond <> IF
      CRLF ERROR" fail - EQ SHORTBRANCH, compiled branch opcope' not armnop" NAME>E EXIT
    THEN

    NE SHORTBRANCH,
    8 <> IF
      CRLF ERROR" fail - NE SHORTBRANCH, afterbranchoffset incorrect" NAME>E EXIT
    THEN

    4 PCURRENTCOMPILEBUFFER @ O>P U32@ GETBRANCHTYPE
    branchtypecond <> IF
      CRLF ERROR" fail - NE SHORTBRANCH, compiled branch branchtype not branchtypecond" NAME>E EXIT
    THEN
    0 <> IF
      DROP
      CRLF ERROR" fail - NE SHORTBRANCH, compiled branch displacement not 0" NAME>E EXIT
    THEN
    ARMB.cond NE OR <> IF
      CRLF ERROR" fail - NE SHORTBRANCH, compiled branch opcope' not armnop with NE" NAME>E EXIT
    THEN

    LE SHORTBRANCH,
    0C <> IF
      CRLF ERROR" fail - LE SHORTBRANCH, afterbranchoffset incorrect" NAME>E EXIT
    THEN

    8 PCURRENTCOMPILEBUFFER @ O>P U32@ GETBRANCHTYPE
    branchtypecond <> IF
      CRLF ERROR" fail - LE SHORTBRANCH, compiled branch branchtype not branchtypecond" NAME>E EXIT
    THEN
    0 <> IF
      DROP
      CRLF ERROR" fail - LE SHORTBRANCH, compiled branch displacement not 0" NAME>E EXIT
    THEN
    ARMB.cond LE OR <> IF
      CRLF ERROR" fail - LE SHORTBRANCH, compiled branch opcope' not armnop with LE" NAME>E EXIT
    THEN

    AL SHORTBRANCH,
    10 <> IF
      CRLF ERROR" fail - AL SHORTBRANCH, afterbranchoffset incorrect" NAME>E EXIT
    THEN

    0C PCURRENTCOMPILEBUFFER @ O>P U32@ GETBRANCHTYPE
    branchtypealways <> IF
      CRLF ERROR" fail - AL SHORTBRANCH, compiled branch branchtype not branchtypealways" NAME>E EXIT
    THEN
    0 <> IF
      DROP
      CRLF ERROR" fail - AL SHORTBRANCH, compiled branch displacement not 0" NAME>E EXIT
    THEN
    ARMB <> IF
      CRLF ERROR" fail - AL SHORTBRANCH, compiled branch opcope' not armb" NAME>E EXIT
    THEN

    NV SHORTBRANCH,
    14 <> IF
      CRLF ERROR" fail - NV SHORTBRANCH, afterbranchoffset incorrect" NAME>E EXIT
    THEN

    10 PCURRENTCOMPILEBUFFER @ O>P U32@ GETBRANCHTYPE
    branchtypenever <> IF
      CRLF ERROR" fail - NV SHORTBRANCH, compiled branch branchtype not branchtypenever" NAME>E EXIT
    THEN
    0 <> IF
      DROP
      CRLF ERROR" fail - NV SHORTBRANCH, compiled branch displacement not 0" NAME>E EXIT
    THEN
    ARMNOP <> IF
      CRLF ERROR" fail - NV SHORTBRANCH, compiled branch opcope' not armnop" NAME>E EXIT
    THEN
    
    newccbuf FREEBUFFER
    oldccbuf PCURRENTCOMPILEBUFFER !

    155 <> IF 
      ERROR" stack marker incorrect " NAME>E EXIT 
    THEN
;

TESTSHORTBRANCH,

