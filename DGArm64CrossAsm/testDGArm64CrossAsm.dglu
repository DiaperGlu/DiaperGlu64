    THEN

    [R+N] PSOURCEBMODE ! ?MB FALSE = IF
      CRLF ERROR" fail - [R+N] PSOURCEBMODE ! ?MB ... result is FALSE " NAME>E EXIT
    THEN

    [O] PSOURCEBMODE ! ?MB FALSE = IF
      CRLF ERROR" fail - [O] PSOURCEBMODE ! ?MB ... result is FALSE " NAME>E EXIT
    THEN

    [PC+N] PSOURCEBMODE ! ?MB FALSE = IF
      CRLF ERROR" fail - [PC+N] PSOURCEBMODE ! ?MB ... result is FALSE " NAME>E EXIT
    THEN

    [RSP+N] PSOURCEBMODE ! ?MB FALSE = IF
      CRLF ERROR" fail - [RSP+N] PSOURCEBMODE ! ?MB ... result is FALSE " NAME>E EXIT
    THEN

    [R++N] PSOURCEBMODE ! ?MB FALSE = IF
      CRLF ERROR" fail - [R++N] PSOURCEBMODE ! ?MB ... result is FALSE " NAME>E EXIT
    THEN

    [R]++N PSOURCEBMODE ! ?MB FALSE = IF
      CRLF ERROR" fail - [R]++N PSOURCEBMODE ! ?MB ... result is FALSE " NAME>E EXIT
    THEN
    

    978 <> IF 
      ERROR" stack marker incorrect " NAME>E EXIT 
    THEN
;

TEST?MB

HEX
: TEST?MDEST ( -- ) 
    CRLF ." testing ?MDEST"

    979 ( -- stackmarker )

    R PDESTMODE ! ?MDEST FALSE <> IF
      CRLF ERROR" fail - R PDESTMODE ! ?MB ... result not FALSE " NAME>E EXIT
    THEN

    N PDESTMODE ! ?MDEST FALSE <> IF
      CRLF ERROR" fail - N PDESTMODE ! ?MDEST ... result not FALSE " NAME>E EXIT
    THEN

    [R] PDESTMODE ! ?MDEST FALSE = IF
      CRLF ERROR" fail - [R] PDESTMODE ! ?MDEST ... result is FALSE " NAME>E EXIT
    THEN

    [R+N] PDESTMODE ! ?MDEST FALSE = IF
      CRLF ERROR" fail - [R+N] PDESTMODE ! ?MDEST ... result is FALSE " NAME>E EXIT
    THEN

    [O] PDESTMODE ! ?MDEST FALSE = IF
      CRLF ERROR" fail - [O] PDESTMODE ! ?MDEST ... result is FALSE " NAME>E EXIT
    THEN

    [PC+N] PDESTMODE ! ?MDEST FALSE = IF
      CRLF ERROR" fail - [PC+N] PDESTMODE ! ?MDEST ... result is FALSE " NAME>E EXIT
    THEN

    [RSP+N] PDESTMODE ! ?MDEST FALSE = IF
      CRLF ERROR" fail - [RSP+N] PDESTMODE ! ?MDEST ... result is FALSE " NAME>E EXIT
    THEN

    [R++N] PDESTMODE ! ?MDEST FALSE = IF
      CRLF ERROR" fail - [R++N] PDESTMODE ! ?MDEST ... result is FALSE " NAME>E EXIT
    THEN

    [R]++N PDESTMODE ! ?MDEST FALSE = IF
      CRLF ERROR" fail - [R]++N PDESTMODE ! ?MDEST ... result is FALSE " NAME>E EXIT
    THEN
    

    979 <> IF 
      ERROR" stack marker incorrect " NAME>E EXIT 
    THEN
;

TEST?MDEST

: RESETTARGET
    -1 PTARGETSIZE !
    -1 PTARGETR !
    -1 PTARGETN !
    -1 PTARGETMODE !
    -1 PPRESERVEFLAGSFLAG !
; 

HEX
: TESTPULLTARGET ( -- )
    CRLF ." testing PULLTARGET"

    975 ( -- stackmarker )

    RESETTARGET

    R0 R PULLTARGET 
    PTARGETSIZE @ 64BIT <> IF
      CRLF ERROR" fail - R0 R PULLTARGET size 64BIT " NAME>E EXIT
    THEN
    PTARGETR @ R0 <> IF
      CRLF ERROR" fail - R0 R PULLTARGET r not R0, got " PTARGETR @ U. NAME>E EXIT
    THEN
    PTARGETN @ 0 <> IF
      CRLF ERROR" fail - R0 R PULLTARGET n not 0 " NAME>E EXIT
    THEN
    PTARGETMODE @ R <> IF
      CRLF ERROR" fail - R0 R PULLTARGET mode not R " NAME>E EXIT
    THEN

    RESETTARGET

    R1 PULLTARGET 
    PTARGETSIZE @ 64BIT <> IF
      CRLF ERROR" fail - R1 PULLTARGET size not 64BIT " NAME>E EXIT
    THEN
    PTARGETR @ R1 <> IF
      CRLF ERROR" fail - R1 PULLTARGET r not R1 " NAME>E EXIT
    THEN
    PTARGETN @ 0 <> IF
      CRLF ERROR" fail - R1 PULLTARGET n not 0 " NAME>E EXIT
    THEN
    PTARGETMODE @ -1 <> IF
      CRLF ERROR" fail - R1 PULLTARGET mode not defaultr " NAME>E EXIT
    THEN  

    RESETTARGET

    R2 R PULLTARGET 
    PTARGETSIZE @ 64BIT <> IF
      CRLF ERROR" fail - R2 R PULLTARGET size 64BIT " NAME>E EXIT
    THEN
    PTARGETR @ R2 <> IF
      CRLF ERROR" fail - R2 R PULLTARGET r not R2, got " PTARGETR @ U. NAME>E EXIT
    THEN
    PTARGETN @ 0 <> IF
      CRLF ERROR" fail - R2 R PULLTARGET n not 0 " NAME>E EXIT
    THEN
    PTARGETMODE @ R <> IF
      CRLF ERROR" fail - R2 R PULLTARGET mode not R " NAME>E EXIT
    THEN

    RESETTARGET

    R3 R 32BIT PULLTARGET 
    PTARGETSIZE @ 32BIT <> IF
      CRLF ERROR" fail - R3 R 32BIT PULLTARGET size 32BIT " NAME>E EXIT
    THEN
    PTARGETR @ R3 <> IF
      CRLF ERROR" fail - R3 R 32BIT PULLTARGET r not R3, got " PTARGETR @ U. NAME>E EXIT
    THEN
    PTARGETN @ 0 <> IF
      CRLF ERROR" fail - R3 R 32BIT PULLTARGET n not 0 " NAME>E EXIT
    THEN
    PTARGETMODE @ R <> IF
      CRLF ERROR" fail - R3 R 32BIT PULLTARGET mode not R " NAME>E EXIT
    THEN

    RESETTARGET

    R3 R 16BIT PULLTARGET 
    PTARGETSIZE @ 16BIT <> IF
      CRLF ERROR" fail - R3 R 16BIT PULLTARGET size 16BIT " NAME>E EXIT
    THEN
    PTARGETR @ R3 <> IF
      CRLF ERROR" fail - R3 R 16BIT PULLTARGET r not R3, got " PTARGETR @ U. NAME>E EXIT
    THEN
    PTARGETN @ 0 <> IF
      CRLF ERROR" fail - R3 R 16BIT PULLTARGET n not 0 " NAME>E EXIT
    THEN
    PTARGETMODE @ R <> IF
      CRLF ERROR" fail - R3 R 16BIT PULLTARGET mode not R " NAME>E EXIT
    THEN

    RESETTARGET

    R3 R 8BIT PULLTARGET 
    PTARGETSIZE @ 8BIT <> IF
      CRLF ERROR" fail - R3 R 8BIT PULLTARGET size 8BIT " NAME>E EXIT
    THEN
    PTARGETR @ R3 <> IF
      CRLF ERROR" fail - R3 R 8BIT PULLTARGET r not R3, got " PTARGETR @ U. NAME>E EXIT
    THEN
    PTARGETN @ 0 <> IF
      CRLF ERROR" fail - R3 R 8BIT PULLTARGET n not 0 " NAME>E EXIT
    THEN
    PTARGETMODE @ R <> IF
      CRLF ERROR" fail - R3 R 8BIT PULLTARGET mode not R " NAME>E EXIT
    THEN  

    RESETTARGET

    5 N 64BIT PULLTARGET 
    PTARGETSIZE @ 64BIT <> IF
      CRLF ERROR" fail - 5 N 64BIT PULLTARGET size 64BIT " NAME>E EXIT
    THEN
    PTARGETR @ NOREG <> IF
      CRLF ERROR" fail - 5 N 64BIT PULLTARGET r not NOREG, got " PTARGETR @ U. NAME>E EXIT
    THEN
    PTARGETN @ 5 <> IF
      CRLF ERROR" fail - 5 N 64BIT PULLTARGET n not 5 " NAME>E EXIT
    THEN
    PTARGETMODE @ N <> IF
      CRLF ERROR" fail - 5 N 64BIT PULLTARGET mode not N " NAME>E EXIT
    THEN

    RESETTARGET

    R5 [R] PULLTARGET 
    PTARGETSIZE @ 64BIT <> IF
      CRLF ERROR" fail - R5 [R] PULLTARGET size 64BIT " NAME>E EXIT
    THEN
    PTARGETR @ R5 <> IF
      CRLF ERROR" fail - R5 [R] PULLTARGET r not R5, got " PTARGETR @ U. NAME>E EXIT
    THEN
    PTARGETN @ 0 <> IF
      CRLF ERROR" fail - R5 [R] PULLTARGET n not 0 " NAME>E EXIT
    THEN
    PTARGETMODE @ [R] <> IF
      CRLF ERROR" fail - R5 [R] PULLTARGET mode not [R] " NAME>E EXIT
    THEN

    RESETTARGET

    R6 837 [R+N] PULLTARGET 
    PTARGETSIZE @ 64BIT <> IF
      CRLF ERROR" fail - R6 837 [R+N] PULLTARGET size 64BIT " NAME>E EXIT
    THEN
    PTARGETR @ R6 <> IF
      CRLF ERROR" fail - R6 837 [R+N] PULLTARGET r not R6, got " PTARGETR @ U. NAME>E EXIT
    THEN
    PTARGETN @ 837 <> IF
      CRLF ERROR" fail - R6 837 [R+N] PULLTARGET n not 837 " NAME>E EXIT
    THEN
    PTARGETMODE @ [R+N] <> IF
      CRLF ERROR" fail - R6 837 [R+N] PULLTARGET mode not [R+N] " NAME>E EXIT
    THEN

    RESETTARGET

    32 [PC+N] PULLTARGET 
    PTARGETSIZE @ 64BIT <> IF
      CRLF ERROR" fail - 32 [PC+N] PULLTARGET size 64BIT " NAME>E EXIT
    THEN
    PTARGETR @ PC <> IF
      CRLF ERROR" fail - 32 [PC+N] PULLTARGET r not PC, got " PTARGETR @ U. NAME>E EXIT
    THEN
    PTARGETN @ 32 <> IF
      CRLF ERROR" fail - 32 [PC+N] PULLTARGET n not 32 " NAME>E EXIT
    THEN
    PTARGETMODE @ [PC+N] <> IF
      CRLF ERROR" fail - 32 [PC+N] PULLTARGET mode not [PC+N] " NAME>E EXIT
    THEN

    RESETTARGET

    99 [RSP+N] PULLTARGET 
    PTARGETSIZE @ 64BIT <> IF
      CRLF ERROR" fail - 99 [RSP+N] PULLTARGET size 64BIT " NAME>E EXIT
    THEN
    PTARGETR @ RSP <> IF
      CRLF ERROR" fail - 99 [RSP+N] PULLTARGET r not RSP, got " PTARGETR @ U. NAME>E EXIT
    THEN
    PTARGETN @ 99 <> IF
      CRLF ERROR" fail - 99 [RSP+N] PULLTARGET n not 32 " NAME>E EXIT
    THEN
    PTARGETMODE @ [RSP+N] <> IF
      CRLF ERROR" fail - 99 [RSP+N] PULLTARGET mode not [RSP+N] " NAME>E EXIT
    THEN

    RESETTARGET

    834 O PULLTARGET 
    PTARGETSIZE @ 64BIT <> IF
      CRLF ERROR" fail - 834 O PULLTARGET size 64BIT " NAME>E EXIT
    THEN
    PTARGETR @ PC <> IF
      CRLF ERROR" fail - 834 O PULLTARGET r not PC, got " PTARGETR @ U. NAME>E EXIT
    THEN
    PTARGETN @ 834 <> IF
      CRLF ERROR" fail - 834 O PULLTARGET n not 834 " NAME>E EXIT
    THEN
    PTARGETMODE @ O <> IF
      CRLF ERROR" fail - 834 O PULLTARGET mode not O " NAME>E EXIT
    THEN

    RESETTARGET

    835 [O] PULLTARGET 
    PTARGETSIZE @ 64BIT <> IF
      CRLF ERROR" fail - 835 [O] PULLTARGET size 64BIT " NAME>E EXIT
    THEN
    PTARGETR @ PC <> IF
      CRLF ERROR" fail - 835 [O] PULLTARGET r not PC, got " PTARGETR @ U. NAME>E EXIT
    THEN
    PTARGETN @ 835 <> IF
      CRLF ERROR" fail - 835 [O] PULLTARGET n not 835 " NAME>E EXIT
    THEN
    PTARGETMODE @ [O] <> IF
      CRLF ERROR" fail - 835 [O] PULLTARGET mode not [O] " NAME>E EXIT
    THEN

    836 [O] PF PULLTARGET 
    PTARGETSIZE @ 64BIT <> IF
      CRLF ERROR" fail - 836 [O] PF PULLTARGET size 64BIT " NAME>E EXIT
    THEN
    PTARGETR @ PC <> IF
      CRLF ERROR" fail - 836 [O] PF PULLTARGET r not PC, got " PTARGETR @ U. NAME>E EXIT
    THEN
    PTARGETN @ 836 <> IF
      CRLF ERROR" fail - 836 [O] PF PULLTARGET n not 836 " NAME>E EXIT
    THEN
    PTARGETMODE @ [O] <> IF
      CRLF ERROR" fail - 836 [O] PF PULLTARGET mode not [O], got " PTARGETMODE @ U. NAME>E EXIT
    THEN
    PPRESERVEFLAGSFLAG @ TRUE <> IF
      CRLF ERROR" fail - 836 [O] PF PULLTARGET preserveflagsflag not TRUE, got " PPRESERVEFLAGSFLAG @ U. NAME>E EXIT
    THEN

    837 [O] UF PULLTARGET 
    PTARGETSIZE @ 64BIT <> IF
      CRLF ERROR" fail - 837 [O] UF PULLTARGET size 64BIT " NAME>E EXIT
    THEN
    PTARGETR @ PC <> IF
      CRLF ERROR" fail - 837 [O] UF PULLTARGET r not PC, got " PTARGETR @ U. NAME>E EXIT
    THEN
    PTARGETN @ 837 <> IF
      CRLF ERROR" fail - 837 [O] UF PULLTARGET n not 835 " NAME>E EXIT
    THEN
    PTARGETMODE @ [O] <> IF
      CRLF ERROR" fail - 837 [O] UF PULLTARGET mode not [O] " NAME>E EXIT
    THEN
    PPRESERVEFLAGSFLAG @ FALSE <> IF
      CRLF ERROR" fail - 837 [O] UF PULLTARGET preserveflagsflag not FALSE, got " PPRESERVEFLAGSFLAG @ U. NAME>E EXIT
    THEN

    RESETTARGET

    R9 838 [R++N] PULLTARGET 
    PTARGETSIZE @ 64BIT <> IF
      CRLF ERROR" fail - R9 838 [R++N] PULLTARGET size 64BIT " NAME>E EXIT
    THEN
    PTARGETR @ R9 <> IF
      CRLF ERROR" fail - R9 838 [R++N] PULLTARGET r not R9, got " PTARGETR @ U. NAME>E EXIT
    THEN
    PTARGETN @ 838 <> IF
      CRLF ERROR" fail - R9 838 [R++N] PULLTARGET n not 838 " NAME>E EXIT
    THEN
    PTARGETMODE @ [R++N] <> IF
      CRLF ERROR" fail - R9 838 [R++N] PULLTARGET mode not [R++N] " NAME>E EXIT
    THEN

    RESETTARGET

    R3 839 [R]++N PULLTARGET 
    PTARGETSIZE @ 64BIT <> IF
      CRLF ERROR" fail - R3 839 [R]++N PULLTARGET size 64BIT " NAME>E EXIT
    THEN
    PTARGETR @ R3 <> IF
      CRLF ERROR" fail - R3 839 [R]++N PULLTARGET r not R3, got " PTARGETR @ U. NAME>E EXIT
    THEN
    PTARGETN @ 839 <> IF
      CRLF ERROR" fail - R3 839 [R]++N PULLTARGET n not 839 " NAME>E EXIT
    THEN
    PTARGETMODE @ [R]++N <> IF
      CRLF ERROR" fail - R3 839 [R]++N PULLTARGET mode not [R]++N " NAME>E EXIT
    THEN

    975 <> IF 
      ERROR" stack marker incorrect " NAME>E EXIT 
    THEN
;

TESTPULLTARGET

HEX
: TESTPULL3TARGETS ( -- ) // tested
    CRLF ." testing PULL3TARGETS"

    976 ( -- stackmarker )

    RESETTARGET

    R3 123 [R+N] 8BIT R4 124 [R+N] 16BIT R5 125 [R+N] 32BIT PULL3TARGETS 
    PSOURCEASIZE @ 8BIT <> IF
      CRLF ERROR" fail - R3 123 [R+N] 8BIT ... source a size not 8BIT " PSOURCEASIZE @ U. NAME>E EXIT
    THEN
    PSOURCEAR @ R3 <> IF
      CRLF ERROR" fail - R3 123 [R+N] 8BIT ... source a r not R3, got " PSOURCEAR @ U. NAME>E EXIT
    THEN
    PSOURCEAN @ 123 <> IF
      CRLF ERROR" fail - R3 123 [R+N] 8BIT ... source a n not 123 " NAME>E EXIT
    THEN
    PSOURCEAMODE @ [R+N] <> IF
      CRLF ERROR" fail - R3 123 [R+N] 8BIT ... source a mode not [R+N] " NAME>E EXIT
    THEN

    PSOURCEBSIZE @ 16BIT <> IF
      CRLF ERROR" fail - R4 124 [R+N] 16BIT ... source b size 16BIT " NAME>E EXIT
    THEN
    PSOURCEBR @ R4 <> IF
      CRLF ERROR" fail - R4 124 [R+N] 16BIT ... source b r not R4, got " PSOURCEAR @ U. NAME>E EXIT
    THEN
    PSOURCEBN @ 124 <> IF
      CRLF ERROR" fail - R4 124 [R+N] 16BIT ... source b n not 124 " NAME>E EXIT
    THEN
    PSOURCEBMODE @ [R+N] <> IF
      CRLF ERROR" fail - R4 124 [R+N] 16BIT ... source b mode not [R+N] " NAME>E EXIT
    THEN

    PDESTSIZE @ 32BIT <> IF
      CRLF ERROR" fail - R5 125 [R+N] 32BIT ... dest size 32BIT " NAME>E EXIT
    THEN
    PDESTR @ R5 <> IF
      CRLF ERROR" fail - R5 125 [R+N] 32BIT ... dest r not R5, got " PSOURCEAR @ U. NAME>E EXIT
    THEN
    PDESTN @ 125 <> IF
      CRLF ERROR" fail - R5 125 [R+N] 32BIT ... dest n not 125 " NAME>E EXIT
    THEN
    PDESTMODE @ [R+N] <> IF
      CRLF ERROR" fail - R5 125 [R+N] 32BIT ... dest mode not [R+N] " NAME>E EXIT
    THEN

    976 <> IF 
      ERROR" stack marker incorrect " NAME>E EXIT 
    THEN
;

TESTPULL3TARGETS

HEX
: TEST?U12ADDSUBOP ( -- )
    CRLF ." testing ?U12ADDSUBOP"

    955 ( -- stackmarker )

    0 IDADD ?U12ADDSUBOP TRUE <> IF
      CRLF ERROR" fail - 0 IDADD not true  " NAME>E EXIT
    THEN

    0 IDSUB ?U12ADDSUBOP TRUE <> IF
      CRLF ERROR" fail - 0 IDSUB not true  " NAME>E EXIT
    THEN

    0 IDEOR ?U12ADDSUBOP FALSE <> IF
      CRLF ERROR" fail - 0 IDSUB not true  " NAME>E EXIT
    THEN

    FFF IDADD ?U12ADDSUBOP TRUE <> IF
      CRLF ERROR" fail - FFF IDADD not true  " NAME>E EXIT
    THEN

    1000 IDADD ?U12ADDSUBOP FALSE <> IF
      CRLF ERROR" fail - 1000 IDADD not false  " NAME>E EXIT
    THEN

    -1 IDADD ?U12ADDSUBOP FALSE <> IF
      CRLF ERROR" fail - -1 IDADD not false  " NAME>E EXIT
    THEN

    FFF IDSUB ?U12ADDSUBOP TRUE <> IF
      CRLF ERROR" fail - FFF IDSUB not true  " NAME>E EXIT
    THEN

    1000 IDSUB ?U12ADDSUBOP FALSE <> IF
      CRLF ERROR" fail - 1000 IDSUB not false  " NAME>E EXIT
    THEN

    -1 IDSUB ?U12ADDSUBOP FALSE <> IF
      CRLF ERROR" fail - -1 IDSUB not false  " NAME>E EXIT
    THEN

    955 <> IF 
      ERROR" stack marker incorrect " NAME>E EXIT 
    THEN
;

TEST?U12ADDSUBOP

: TEST?U12<<12ADDSUBOP ( -- )
    CRLF ." testing ?U12<<12ADDSUBOP"

    9A55 ( -- stackmarker )

    0 IDADD ?U12<<12ADDSUBOP TRUE <> IF
      CRLF ERROR" fail - 0 IDADD not true  " NAME>E EXIT
    THEN

    0 IDSUB ?U12<<12ADDSUBOP TRUE <> IF
      CRLF ERROR" fail - 0 IDSUB not true  " NAME>E EXIT
    THEN

    0 IDEOR ?U12<<12ADDSUBOP FALSE <> IF
      CRLF ERROR" fail - 0 IDEOR not false  " NAME>E EXIT
    THEN

    1 IDADD ?U12<<12ADDSUBOP FALSE <> IF
      CRLF ERROR" fail - 1 IDADD not false  " NAME>E EXIT
    THEN

    FFF IDADD ?U12<<12ADDSUBOP FALSE <> IF
      CRLF ERROR" fail - FFF IDADD not false  " NAME>E EXIT
    THEN

    1000 IDADD ?U12<<12ADDSUBOP TRUE <> IF
      CRLF ERROR" fail - 1000 IDADD not true  " NAME>E EXIT
    THEN

    FFF000 IDADD ?U12<<12ADDSUBOP TRUE <> IF
      CRLF ERROR" fail - FFF000 IDADD not true  " NAME>E EXIT
    THEN

    1000000 IDADD ?U12<<12ADDSUBOP FALSE <> IF
      CRLF ERROR" fail - 1000000 IDADD not false  " NAME>E EXIT
    THEN

    9A55 <> IF 
      ERROR" stack marker incorrect " NAME>E EXIT 
    THEN
;

TEST?U12<<12ADDSUBOP

: TEST?U13ANDOREOROP ( -- )
    CRLF ." testing ?U13ANDOREOROP"

    9A56 ( -- stackmarker )

    0 IDADD ?U13ANDOREOROP FALSE <> IF
      CRLF ERROR" fail - 0 IDADD not false  " NAME>E EXIT
    THEN

    0 IDAND ?U13ANDOREOROP TRUE <> IF
      CRLF ERROR" fail - 0 IDAND not true  " NAME>E EXIT
    THEN

    0 IDOR ?U13ANDOREOROP TRUE <> IF
      CRLF ERROR" fail - 0 IDOR not true  " NAME>E EXIT
    THEN

    0 IDEOR ?U13ANDOREOROP TRUE <> IF
      CRLF ERROR" fail - 0 IDEOR not true  " NAME>E EXIT
    THEN

    1FFF IDEOR ?U13ANDOREOROP TRUE <> IF
      CRLF ERROR" fail - 1FFF IDEOR not true  " NAME>E EXIT
    THEN

    2000 IDEOR ?U13ANDOREOROP FALSE <> IF
      CRLF ERROR" fail - 1FFF IDEOR not false  " NAME>E EXIT
    THEN

    9A56 <> IF 
      ERROR" stack marker incorrect " NAME>E EXIT 
    THEN
;

TEST?U13ANDOREOROP

