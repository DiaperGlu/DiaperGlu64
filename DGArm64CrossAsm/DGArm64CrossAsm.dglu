0F CONSTANT IDEOR
0F CONSTANT IDXOR
10 CONSTANT IDORN
11 CONSTANT IDORR
11 CONSTANT IDOR
12 CONSTANT IDSUB
13 CONSTANT IDNAND
14 CONSTANT IDNOR

// OPID table
CODE-CREATE PIDTABLE
//   ID    noflagop            flagop                type ... bit 0 = compile invert dest flag
   ( 00 )  BOPADC CODE-U64,    BOPADCS CODE-U64,     0 CODE-U64,
   ( 01 )  BOPSBC CODE-U64,    BOPSBCS CODE-U64,     8 CODE-U64,
   ( 02 )  BOPSDIV CODE-U64,   0 CODE-U64,           8 CODE-U64,
   ( 03 )  BOPASR CODE-U64,    0 CODE-U64,           0 CODE-U64, // not sure how to do carry flag easily
   ( 04 )  BOPLSR CODE-U64,    0 CODE-U64,           0 CODE-U64, // not sure how to do carry flag easily
   ( 05 )  BOPSMULH CODE-U64,  0 CODE-U64,           0 CODE-U64,
   ( 06 )  BOPMULL CODE-U64,   0 CODE-U64,           0 CODE-U64,  // lower 64 bits is same for both signed and unsigned multiply
   ( 07 )  BOPUDIV CODE-U64,   0 CODE-U64,           8 CODE-U64,
   ( 08 )  BOPLSL CODE-U64,    0 CODE-U64,           0 CODE-U64, // not sure how to do carry flag easily
   ( 09 )  BOPROR CODE-U64,    0 CODE-U64,           0 CODE-U64, // not sure how to do carry flag easily
   ( 0A )  BOPUMULH CODE-U64,  0 CODE-U64,           0 CODE-U64,
   ( 0B )  BOPADD CODE-U64,    BOPADDS CODE-U64,     0 CODE-U64,
   ( 0C )  BOPAND CODE-U64,    BOPANDS CODE-U64,     0 CODE-U64,
   ( 0D )  BOPBIC CODE-U64,    BOPBICS CODE-U64,     8 CODE-U64,
   ( 0E )  BOPEON CODE-U64,    0 CODE-U64,           0 CODE-U64,
   ( 0F )  BOPEOR CODE-U64,    0 CODE-U64,           0 CODE-U64,
   ( 10 )  BOPORN CODE-U64,    0 CODE-U64,           8 CODE-U64,
   ( 11 )  BOPORR CODE-U64,    0 CODE-U64,           0 CODE-U64,
   ( 12 )  BOPSUB CODE-U64,    BOPSUBS CODE-U64,     8 CODE-U64,
   ( 13 )  BOPAND CODE-U64,    0 CODE-U64,           5 CODE-U64,  // NAND
   ( 14 )  BOPORR CODE-U64,    BOPBICS CODE-U64,     3 CODE-U64,  // NOR - not sure if order is important... need to check

1 CONSTANT IDTABLE.INVERTDESTMASK  // for preserve regs case
2 CONSTANT IDTABLE.INVERTSRCAMASK   // for NOR case
4 CONSTANT IDTABLE.INVERTNANDCASEMASK    // for NAND case
8 CONSTANT IDTABLE.ORDERIMPORTANT  // if not true, sources can be swapped

3 CONSTANT IDTABLE.COLUMNS
15 CONSTANT IDTABLE.ROWS
IDTABLE.COLUMNS 3 LSHIFT CONSTANT IDTABLE.ROWSIZE

: OCCBUF>P ( currentcompilebufferoffset -- poffset )
    PCURRENTCOMPILEBUFFER @ O>P
;

: ID>PROW { | ID -- prow }
    ID IDTABLE.ROWS U> IF ERROR" ID too high" NAME>E EXIT THEN
    ID IDTABLE.ROWSIZE * PIDTABLE +
;

: ID>ROWDATA { prow | ID -- NFOP CFOP TYPE }
    ID ID>PROW ?ERRORIF NAME>E EXIT THEN TO prow 
    prow @
    prow 8 + @
    prow 10 + @
;

: ID>PFOP ( ID -- PFOP )
    ID>PROW ?ERRORIF NAME>E EXIT THEN @
;

: ID>CFOP ( ID -- CFOP )
    ID>PROW ?ERRORIF NAME>E EXIT THEN 8 + @
;

HEX
: ID>TYPE ( ID -- TYPE )
    ID>PROW ?ERRORIF NAME>E EXIT THEN 10 + @
;

HEX
VARIABLE PBASEADDRESS
0 PBASEADDRESS !

: +BA ( bufferoffset -- baraddress )
    PBASEADDRESS @ +
;

: -BA ( baraddress -- bufferoffset )
    PBASEADDRESS @ - 
;

// base address relative here
: BARHERE OHERE +BA ;


: BARALIGN32 ( -- ) 4 BARHERE 3 AND - 3 AND CODE-ALLOT ;



HEX
: >U16[U] ( X U -- U16 )
    4 LSHIFT RSHIFT FFFF AND   
;

HEX
: ?N8 ( displacement -- displacement flag )
    DUP 80 + 100 U<
;

: ?U8 ( displacement -- displacement flag )
    DUP 100 U<
;

: ?ERRORU8 ( imm8 -- imm8 )
    ?U8 IF EXIT THEN
    ERROR" unsigned value larger than u8"
;

: ?ERRORN8 ( imm8 -- imm8 )
    ?N8 IF EXIT THEN
    ERROR" signed displacement larger than n8"
;

HEX
: ?N4b ( n -- n flag )  // -1; 1h to 0Fh
    DUP 1+ ( n n+1 -- )
    DUP 1 = IF DROP FALSE EXIT THEN
    11 U<
;

: ?N7b ( displacement -- displacement flag )  // -32 to 95; -20h to 60h
    DUP 20 + 80 U<
;

: ?N12 ( displacement -- displacement flag )
    DUP 800 + 1000 U<
;

: N8>= ( displacement -- flag )
    80 + 100 U>=
;

: U8>= ( displacement -- flag )
    100 U>=
;

: N9>= ( displacement -- flag )
    100 + 200 U>=
;

: U12>= ( displacement -- flag )
    1000 U>=
;

: U13>= ( displacement -- flag )
    2000 U>=
;

HEX
: ?N18 ( displacement -- displacement flag )
    DUP 20000 + 40000 U<
;

HEX
: ?N19 ( displacement -- displacement flag )
    DUP 40000 + 80000 U<
;

: N19>= ( displacement -- flag )
    40000 + 80000 U>=
;

HEX
: ?N21 ( displacement -- displacement flag )
    DUP 100000 + 200000 U< ;

: N21>= ( displacement -- flag )
    100000 + 200000 U>=
;

HEX
: ?N26 ( displacement -- displacement flag )
    DUP 2000000 + 4000000 U<
;

: N26>= ( displacement -- flag )
    2000000 + 4000000 U>=
;

: ?U12 ( displacement -- displacement flag )
    DUP 1000 U<
;

: ?ERRORU12 ( u12 -- u12 )
    ?U12 IF EXIT THEN
    ERROR" unsigned value larger than u12"
;

: ?ERRORN12 ( n12 -- n12 )
    ?N12 IF EXIT THEN
    ERROR" signed displacement larger than n12"
;

HEX
: ?256*N8 { | n32 -- n32 flag }
    n32 FF AND 0= 
    n32 100 /
    80 + 100 U< AND
    n32 SWAP
;

FFFFFFFFFFFFF000 CONSTANT 8BIT
FFFFFFFFFFFFF001 CONSTANT 16BIT
FFFFFFFFFFFFF002 CONSTANT 32BIT
FFFFFFFFFFFFF003 CONSTANT 64BIT
FFFFFFFFFFFFF000 CONSTANT U8BIT
FFFFFFFFFFFFF001 CONSTANT U16BIT
FFFFFFFFFFFFF002 CONSTANT U32BIT
FFFFFFFFFFFFF003 CONSTANT U64BIT
FFFFFFFFFFFFF080 CONSTANT N8BIT
FFFFFFFFFFFFF081 CONSTANT N16BIT
FFFFFFFFFFFFF082 CONSTANT N32BIT


: SF>SIZE 3 + 1 SWAP LSHIFT ;

HEX
0000000F CONSTANT condMASK
00FFFFE0 CONSTANT IMM19MASK
03FFFFFF CONSTANT IMM26MASK
IMM19MASK condMASK OR CONSTANT IMM19condMASK

: N19>N64 { | N19 -- N64 }
    N19 00040000 AND 0= IF
      N19 0007FFFF AND
    ELSE
      N19 FFFFFFFFFFF80000 OR
    THEN
;

: N26>N64 { | N26 -- N64 }
    N26 02000000 AND 0= IF
      N26 03FFFFFF AND
    ELSE
      N26 FFFFFFFFFC000000 OR
    THEN
;

: RD>OP     ( op rd  -- op' )     1F AND           OR ;
: RN>OP     ( op rn  -- op' )     1F AND  5 LSHIFT OR ;
: RM>OP     ( op rm  -- op' )     1F AND 10 LSHIFT OR ;
: RA>OP     ( op rm  -- op' )     1F AND 0A LSHIFT OR ;
: SF>OP     ( op sf  -- op' )      1 AND 1F LSHIFT OR ;
: SF>OPb    ( op sf  -- op' )      3 AND 1E LSHIFT OR ;
: SF>OPc    ( op sf  -- op' )      1 AND 1E LSHIFT OR ;
: SFB>OP    ( op sfb -- op' )      1 AND 1 XOR 16 LSHIFT OR ; // either 32 or 64
: IMM16>OP  ( op imm16 -- op' ) FFFF AND  5 LSHIFT OR ;
: HW>OP     ( op hw  -- op' )      3 AND 15 LSHIFT OR ;
: IMM3>OP   ( op imm3 -- op' )     7 AND 0A LSHIFT OR ;
: OPTION>OP ( op option -- op' )   7 AND 0D LSHIFT OR ;
: IMM12>OP  ( op imm12 -- op' )  FFF AND 0A LSHIFT OR ;
: SH>OP     ( op sh  -- op' )      1 AND 16 LSHIFT OR ;
: IMM6>OP   ( op imm6 -- op' )    3F AND 0A LSHIFT OR ;
: SHIFT>OP  ( op shift -- op' )    3 AND 16 LSHIFT OR ;
: IMM4>OP   ( op imm3 -- op' )    0F AND 0A LSHIFT OR ;
: IMM6>OPb  ( op imm6 -- op' )    3F AND 10 LSHIFT OR ;
: IMMHI>OP  ( op immhi -- op' ) 3FFF AND 05 LSHIFT OR ;
: IMMLO>OP  ( op immlo -- op' )    3 AND 1D LSHIFT OR ;
// : IMM21>IMMLOIMMHI ( imm21 -- immlo immhi ) DUP 7FFFF AND SWAP 180000 AND 13 RSHIFT ;
: IMM21>OP  ( op imm21 -- ) DUP >R 1FFFFC AND 3 LSHIFT OR R> 3 AND 1D LSHIFT OR ;
: IMMS>OP   ( op imms -- op' )    3F AND 0A LSHIFT OR ;
: IMMR>OP   ( op immr -- op' )    3F AND 10 LSHIFT OR ;
: N>OP      ( op n -- op' )        1 AND 16 LSHIFT OR ;
: X>OP      ( op n -- op' )        1 AND 0F LSHIFT OR ;
: NZCV>OP   ( op nzcv -- op' )    0F AND OR ;

: IMM13>OP  { | op imm13 -- op' } 
    imm13 3F AND 10 LSHIFT  
    imm13 F30 AND 4 LSHIFT OR 
    1000 AND 0A LSHIFT OR 
    op OR ; 

: OP2>OP    ( op op2 -- op' )      7 AND  5 LSHIFT OR ;
: OP1>OP    ( op op1 -- op' )      7 AND 10 LSHIFT OR ;
: O0>OP     ( op n -- op' )        1 AND 13 LSHIFT OR ;
: Z>OP      ( op n -- op' )        1 AND 0D LSHIFT OR ;
: IMM26>OP  ( op imm26 -- op' )    IMM26MASK AND OR ;
: IMM19>OP  ( op imm19 -- op' )    7FFFF AND 5 LSHIFT OR ;
: COND>OP   ( op cond -- op' )    0F AND OR ;
: IMM6>OPc  ( op imm6 -- op' )    3F AND 0F LSHIFT OR ;
: IMM9>OP   ( op imm9 -- op' )   1FF AND 05 LSHIFT OR ;
: COND>OPb  ( op cond -- op' )     7 AND 15 LSHIFT OR ;
: IMM4>OPb  ( op imm3 -- op' )    0F AND 08 LSHIFT OR ;
: COND>OPc  ( op cond -- op' )    0F AND 0C LSHIFT OR ;
: IMM9>OPb  ( op imm9 -- op' )   1FF AND 0C LSHIFT OR ;
: IMM8>OP   ( op imm9 -- op' )   0FF AND 0A LSHIFT OR ;
: CRN>OP    ( op crn -- op' )     0F AND 0C LSHIFT OR ;
: CRM>OP    ( op crn -- op' )     0F AND 08 LSHIFT OR ;
: SZ>OP     ( op sz  -- op' )      3 AND 1E LSHIFT OR ;
: IMM14>OP  ( op imm14 -- op' ) 3FFF AND 05 LSHIFT OR ;
: BIT6>OP   ( op bit6 -- op' )    DUP >R 1F AND 13 LSHIFT OR R> 20 AND 1A LSHIFT OR ;  
: IMM7>OP   ( op imm7 -- op' )    7F AND 0F LSHIFT OR ;
: CRM>OPb   ( op crm -- op' )     03 AND 09 LSHIFT OR ;
: S>OP      ( op s -- op' )       01 AND 0C LSHIFT OR ;
: Sb>OP     ( op s -- op' )      200 AND 0D LSHIFT OR ;
: RPRFOP>OP ( op s -- op' )        7 AND OR ;
: PRFOP>OP  ( op prfop -- op' )   1F AND OR ;
: SYSREG>OP ( op sysreg -- op' )  7FFF AND 05 LSHIFT OR ;


