12000000 CONSTANT ARMANDIMM
72000000 CONSTANT ARMANDSIMM
32000000 CONSTANT ARMORIMM
52000000 CONSTANT ARMEORIMM

: RNIMMRNIMMSRDSFOP, { | RN IMMR N IMMS RD SF OP -- } // N may be high bit of IMMS
  OP 
  RN      RN>OP
  IMMR    IMMR>OP
  N       N>OP
  IMMS    IMMS>OP
  RD      RD>OP
  SF      SF>OP
  CODE-U32,
;

// n = 1 then there is one 64 bit section
//  (if n = 0 highest clear bit of imms selects number of sections and size of each section)
// n = 0, bit 5 of imms is highest clear bit then there are two 32 bit sections
// n = 0, bit 4 of imms is highest clear bit then there are four 16 bit sections
// n = 0, bit 3 of imms is highest clear bit then there are eight 8 bit sections
// n = 0, bit 2 of imms is highest clear bit then there are sixteen 4 bit sections
// n = 0, bit 1 of imms is highest clear bit then there are thirtytwo 2 bit sections
// n = 0, bit 0 of imms is highest clear bit then I think this is udf
// n = 0,  no clear bits of imms then udf and length of imms is 6
// lower remaining bits of imms are length of mask - 1 (mask is imms + 1 1 bits and is right justified at lowest bit of each section before the rotate)
// same lower bits as those of imms of immr are right rotate amount
: ARMANDIMM,        ( RN IMMR N IMMS RD SF OP  -- ) ARMANDIMM  RNIMMRNIMMSRDSFOP, ; // tested  
: ARMANDSIMM,       ( RN IMMR N IMMS RD SF OP  -- ) ARMANDSIMM RNIMMRNIMMSRDSFOP, ; // tested           
: ARMEORIMM,        ( RN IMMR N IMMS RD SF OP  -- ) ARMEORIMM  RNIMMRNIMMSRDSFOP, ; // tested  
: ARMORIMM,         ( RN IMMR N IMMS RD SF OP  -- ) ARMORIMM   RNIMMRNIMMSRDSFOP, ; // tested  
SYNONYM ARMORIMM, ARMORRIMM,


: ARMMOVBITMASKIMM, { | IMMR N IMMS RD SF -- } // 64 bit tested  ( rightrotate 64bitsectionflag length-1 RD SF -- )
    R31
    IMMR
    N
    IMMS
    RD
    SF
    ARMORIMM,  ; 



HEX
