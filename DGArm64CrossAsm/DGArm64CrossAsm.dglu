  CODE-U32,
;

: ARMAUTIASPPCR,  ( RN -- ) DAC1901E RNOP, ; // FEAT_PAuth_LR ?
: ARMAUTIBSPPCR,  ( RN -- ) DAC1941E RNOP, ; // FEAT_PAuth_LR ?
: ARMBR,          ( RN -- ) D61F0000 RNOP, ; // tested
: ARMBLR,         ( RN -- ) D63F0000 RNOP, ; // tested
: ARMGCSPOPCX,    ( RN -- ) D50877A0 RNOP, ; // FEAT_GCS ?
: ARMGCSPOPM,     ( RN -- ) D52B7720 RNOP, ; // FEAT_GCS ?
: ARMGCSPOPX,     ( RN -- ) D50877C0 RNOP, ; // FEAT_GCS ?
: ARMGCSPUSHM,    ( RN -- ) D50B7700 RNOP, ; // FEAT_GCS ?
: ARMGCSPUSHX,    ( RN -- ) D5087780 RNOP, ; // FEAT_GCS ?
: ARMGCSSS1,      ( RN -- ) D50B7740 RNOP, ; // FEAT_GCS ?
: ARMGCSSS2,      ( RN -- ) D52B7760 RNOP, ; // FEAT_GCS ?
: ARMRET,         ( RN -- ) D65F0000 RNOP, ;  // tested
: ARMSETF8,       ( RN -- ) 3A00080D RNOP, ; // FEAT_FlagM tested
: ARMSETF16,      ( RN -- ) 3A00480D RNOP, ; // FEAT_FlagM tested

: OP2RDNOP, { | OP2 RD OP -- }
  OP
  OP2     OP2>OP 
  RD      RD>OP
  CODE-U32,
;

: ARMBRB,        ( OP2 RD -- ) D5097200 OP2RDNOP, ; // // FEAT_PAuth ?
  4 CONSTANT IALL
  5 CONSTANT INJ

: ARMUDF,     ( imm16 -- ) 0FFFF AND CODE-U32, ; // need test

: CRMOP, ( CRM OP -- )
  SWAP      CRM>OP
  CODE-U32,
;

: ARMISB,     ( CRM -- ) D50330DF CRMOP, ; // need test
: ARMDMB,     ( CRM -- ) D50330BF CRMOP, ; // need test
: ARMDSB,     ( CRM -- ) D503309F CRMOP, ; // need test

: CRMOPb, ( CRM OP -- )
  SWAP      CRM>OPb
  CODE-U32,
;

: ARMSMSTART,   ( CRM -- ) D503417F CRMOPb, ; // FEAT_SME ?
  3 CONSTANT SM
  5 CONSTANT ZA
  7 CONSTANT SMZA

: ARMSMSTOP,    ( CRM -- ) D503407F CRMOPb, ; // FEAT_SME ?


: NOP,       ( -- ) D503201F CODE-U32, ;  // tested
: RET,       ( -- ) D65F03C0 CODE-U32, ;  // tested

: U16>IR, ( U16 HW IR FILL0FLAG -- )
    IF
      0 ARMMOVZ,
    ELSE
      0 ARMMOVK,
    THEN
;

: !U16>IR, ( U16 HW IR FILL1FLAG -- )
    IF
      0 ARMMOVN,
    ELSE
      0 ARMMOVK,
    THEN
;

HEX 
: U>IR, TRUE { | FILL0FLAG U IR -- }
    U 0= IF
      0 0 IR 0 ARMMOVZ, EXIT
    THEN
    U FFFF AND 0<> IF 
      U FFFF AND 0 IR FILL0FLAG U16>IR,
      FALSE TO FILL0FLAG
    THEN
    U FFFF0000 AND 0<> IF 
      U FFFF0000 AND 1 IR FILL0FLAG U16>IR,
      FALSE TO FILL0FLAG
    THEN
    U FFFF00000000 AND 0<> IF 
      U FFFF00000000 AND 2 IR FILL0FLAG U16>IR,
      FALSE TO FILL0FLAG
    THEN
    U FFFF000000000000 AND 0<> IF 
      U FFFF000000000000 AND 3 IR FILL0FLAG U16>IR,
    THEN
;

// condition codes for B.cond,
00 CONSTANT EQ
00 CONSTANT ZS
01 CONSTANT NE
01 CONSTANT NZ

02 CONSTANT CS
03 CONSTANT NC

02 CONSTANT GEU // unsigned
03 CONSTANT LTU // unsigned

04 CONSTANT MI
05 CONSTANT PL

06 CONSTANT VS
07 CONSTANT VC

08 CONSTANT HI
09 CONSTANT LS

08 CONSTANT GTU // unsigned
09 CONSTANT LEU // unsigned

0A CONSTANT GE // signed
0B CONSTANT LT // signed

0C CONSTANT GT // signed
0D CONSTANT LE // signed

0E CONSTANT ALWAYS
0F CONSTANT NEVER   // NEVER is treated as ALWAYS by the ARM64 instructions. The helper control flow words like UNTIL, will compile a NOP, if needed.
                    // See section C1.2.4 of the Arm Architecture Reference Manual for A-profile architecture

0E CONSTANT AL
0F CONSTANT NV      // NEVER is treated as ALWAYS by the ARM64 instructions. The helper control flow words like UNTIL, will compile a NOP, if needed.
                    // See section C1.2.4 of the Arm Architecture Reference Manual for A-profile architecture

: OPPOSITEBRANCHCODE ( opcode -- opcode' )
   
    1 XOR
;


// compiles an unresolved shortbramch
: SHORTBRANCH, { | branchcode -- afterbranchoffset }
 
    branchcode 10 U> IF 2DROP ERROR" not a valid branch code" EXIT THEN

    branchcode ALWAYS U<
    IF 
      0 branchcode ARMB.cond,
      OHERE
      EXIT
    THEN

    branchcode ALWAYS =
    IF
      0 ARMB,
      OHERE
      EXIT
    THEN

    branchcode NEVER =
    IF
      ARMNOP,
      OHERE
      EXIT
    THEN
;

// branchtypes
0 CONSTANT branchtypenever
1 CONSTANT branchtypealways
2 CONSTANT branchtypecond
3 CONSTANT branchtypeerror

: GETBRANCHTYPE { | branchopcode -- branchopcode' displacement type }
    branchopcode ARMNOP = IF
      branchopcode 0 branchtypenever
      EXIT
    THEN
    branchopcode IMM26MASK INVERT AND ARMB = IF
      branchopcode IMM26MASK INVERT AND
      branchopcode ( IMM26MASK AND ) N26>N64
      branchtypealways
      EXIT
    THEN
    branchopcode IMM19condMASK INVERT AND ARMB.cond = IF
      branchopcode IMM19MASK INVERT AND // keep the condition code
      branchopcode ( IMM19MASK AND ) 5 RSHIFT N19>N64
      branchtypecond
      EXIT
    THEN
    ERROR" unknown branch type"
;

: RESOLVE-BRANCH { branchbaseopcode oldbranchdisplacement branchdisplacement branchtype | afterbranchoffset targetoffset -- }
  
    afterbranchoffset OCCBUF>P 4 - U32@ GETBRANCHTYPE
    TO branchtype
    TO oldbranchdisplacement
    TO branchbaseopcode

    oldbranchdisplacement 0 <> IF
      ERROR" branch already resolved"
      EXIT
    THEN

    branchtype branchtypenever = IF
      EXIT 
    THEN

    // delta offset to displacement
    targetoffset afterbranchoffset 4 - - 
    DUP 03 AND 0<> IF 
      DROP ERROR" branch displacement not aligned... code must be aligned to UINT32" EXIT
    THEN
    2/ 2/ TO branchdisplacement

    branchtype branchtypealways = IF
      // make sure displacement is in range
      branchdisplacement N26>= IF
        ERROR" always branch too far for a short branch"
        EXIT
      THEN 
     
      // assemble branch opcode
      ARMB branchdisplacement IMM26>OP

      // put assembled opcode before afterbranchoffset
      afterbranchoffset OCCBUF>P 4 - U32!
      EXIT
    THEN

    branchtype branchtypecond = IF
      // make sure displacement is in range
      branchdisplacement N19>= IF
        ERROR" .cond branch too far for a short branch"
        EXIT
      THEN 

      // assemble branch opcode
      branchbaseopcode branchdisplacement IMM19>OP
      
      // put assembled opcode before after branch offset
      afterbranchoffset OCCBUF>P 4 - U32!
      EXIT
    THEN 

    ERROR" unknown branch type" 
;

: IF, ( conditioncode -- afterbranchaddr )
   OPPOSITEBRANCHCODE SHORTBRANCH,
;

: THEN, ( afterbranchaddr -- )
    OHERE RESOLVE-BRANCH
;

: ELSE, ( iffaddr -- )
    ALWAYS SHORTBRANCH, >R
    THEN,
    R>
;

: WHILE, ( beginaddr cc -- whileaddr beginaddr )
    IF, SWAP
;

: BEGIN, ( -- beginaddr )
    OHERE
;

: UNTIL, ( beginaddr branchcode -- )
    OPPOSITEBRANCHCODE ( beginaddr oppositebranchcode -- )
    SHORTBRANCH, ( beginaddr afterbranchaddr -- ) 
    SWAP RESOLVE-BRANCH
;

: REPEAT, ( whileaddr beginaddr -- )
    NEVER UNTIL,
    THEN,
;

: ?MOVZorK, ( U I IR donefirstflag -- ) // tested
    IF
      64BIT ARMMOVK,
    ELSE
      64BIT ARMMOVZ,
    THEN
;

: ?MOVNorK, ( N I IR donefirstflag -- ) // tested
    IF
      64BIT ARMMOVK,
    ELSE
      >R >R INVERT FFFF AND R> R> 64BIT ARMMOVN,
    THEN
;

: N->IR64, { donefirstflag X | N IR -- } // tested but didn't check the compiled code for minimal size

    FALSE TO donefirstflag

    // 0 case    
    N 0= IF

      0 0 IR 64BIT ARMMOVZ,
      EXIT

    THEN

    // -1 case
    N -1 = IF

      0 0 IR 64BIT ARMMOVN,
      EXIT

    THEN

    // more 0000s than FFFFs when FFFF is hi case
    N FFFF000000000000 XOR TO X
    X FFFF0000FFFFFFFF AND 0=
    X FFFFFFFF0000FFFF AND 0= OR
    X FFFFFFFFFFFF0000 AND 0= OR IF
    THEN

      4 0 DO
        N I >U16[U] 0> IF

          N I >U16[U] I IR donefirstflag ?MOVZorK,
          TRUE TO donefirstflag

        THEN
      LOOP
      EXIT
    
    // FFFF hi case
    N 3 >U16[U] FFFF = IF

      -1 3 DO
        N I >U16[U] FFFF <> IF

          N I >U16[U] I IR donefirstflag ?MOVNorK,
          TRUE TO donefirstflag

        THEN
      -1 +LOOP
      EXIT

    THEN

    // 0000 hi case
    -1 3 DO
      N I >U16[U] 0> IF

        N I >U16[U] I IR donefirstflag ?MOVZorK,
        TRUE TO donefirstflag

      THEN
    -1 +LOOP
;

: IR64->IR64, ( srcIR64 destIR64 -- ) >R 0 0 R> 64BIT ARMADDIMM, ; // Tested. Using ARMADDIMM so that RSP works



: RSP->IR64, ( destIR64 -- ) RSP SWAP IR64->IR64, ; // tested

SYNONYM ARMRET, IR64->PC, 

: IR64->RSP, ( srcIR64 -- ) RSP IR64->IR64, ; // tested

//   will need R8U->R64 R16U->R64 R32U->R64 R8N->R64 R16N->R64 R32N->R64
// R->R, ( covers all cases )


//   use armaddimm, if N is positive and fits in 12 bits
//   use armsubimm, if N is negative and fits in 12 bits
//   use N->IR64 with destreg then armaddreg if N does not fit ( no scratch reg needed )
//     could check for shifted Ns
//   must use SCRATCHREG1 if srcreg = destreg and N doesn't fit in +-U12 
//   must use scratchret if destreg = RSP since RSP can't be index reg in ARMADDEXT,
: IR64+N->IR64, { tempIR | srcIR N destIR -- } // tested

    N ?U12 IF 
      DROP srcIR N 0 destIR 64BIT ARMADDIMM, 
      EXIT 
    THEN

    NEGATE ?U12 IF 
      DROP srcIR N NEGATE 0 destIR 64BIT ARMSUBIMM, 
      EXIT 
    THEN

    destIR TO tempIR

    destIR RSP = IF // needed because RSP can't be an index reg in ARMADDEXT
      SCRATCHREG1 TO tempIR
    THEN

    destIR srcIR = IF // don't want to trash srcIR
      SCRATCHREG1 TO tempIR
    THEN

    srcIR SCRATCHREG1 = IF // again, don't want to trash srcIR
      SCRATCHREG2 TO tempIR 
    THEN

    // srcIR destIR = IF 
    //  srcIR SCRATCHREG1 = IF
    //    SCRATCHREG2 TO tempIR
    //  ELSE
    //    SCRATCHREG1 TO tempIR
    //  THEN
    // ELSE
    //  destIR TO tempIR
    // THEN

    DROP N tempIR N->IR64, 
    srcIR tempIR UXTX 0 destIR 64BIT ARMADDEXT,
;

: PC+N->PC, { | N -- } // tested
    OHERE 3 AND 0<> IF ERROR" code not aligned to multiple of 4 bytes (trying to compile a branch)" EXIT THEN
    N 3 AND 0<> IF ERROR" jump displacement not a multiple of 4 bytes" EXIT THEN
    N 2/ 2/ ( if N is from after branch offset... may need to subtract 1 )  ?N26 IF
      ARMB,
      EXIT
    THEN

    0 SCRATCHREG1 ARMADR,
    SCRATCHREG1 N SCRATCHREG1 IR64+N->IR64,
    SCRATCHREG1 IR64->PC,
;

: PC+N->IR64, { tempIR | N destIR -- } // tested
    N N21>= IF 
      SCRATCHREG1 destIR = IF
        SCRATCHREG1 TO tempIR
      ELSE
        SCRATCHREG2 TO tempIR
      THEN  

      0 destIR ARMADR,

      N tempIR N->IR64,
      destIR tempIR UXTX  0 destIR 64BIT ARMADDEXT,
      EXIT
    THEN

    N destIR ARMADR,    
;

: PC->IR64, ( destIR64 -- ) 0 SWAP ARMADR, ; // tested

: RSP+N->IR64, ( N destIR -- ) >R >R RSP R> R> IR64+N->IR64, ; // tested

: RSP+N->RSP, ( N -- ) RSP SWAP RSP IR64+N->IR64, ; // tested

: [IR64]->IR64, ( srcIR destIR -- ) // tested
    >R R31 UXTX 0 R> 64BIT ARMLDRREG,
;

: IR64->[IR64], ( srcIR destIR -- ) // tested
    R31 UXTX 0 64BIT ARMSTRREG,  ( RS RN RM OPTION S SF -- )
;

// first src reg and dest reg can be rsp, using R32 for second src reg means second src = 0x0
: [IR64+IR64]->IR64, ( srcIRa srcIRb destIR -- ) // tested
    >R UXTX 0 R> 64BIT ARMLDRREG,
;

: [IR64+IR64]->IRSZ, { | srcIRa srcIRb destIR size -- } // tested
    size 80 AND 0= IF 
      srcIRa srcIRb UXTX 0 destIR size ARMLDRREG,
    ELSE
      srcIRa srcIRb UXTX 0 destIR size 64BIT ARMLDRSREG,
    THEN
;

: [IR64]->IRSZ, ( srcIR destIR size -- ) // tested
    >R >R R31 R> R> [IR64+IR64]->IRSZ,
;

// src reg and first dest reg can be rsp, using R32 for second dest reg means second dest = 0x0
: IR64->[IR64+IR64], ( srcIR destIRa destIRb -- ) // tested
    UXTX 0 64BIT ARMSTRREG,  ( RS RN RM OPTION S SF -- )
;

: IRSZ->[IR64+IR64], ( srcIR size destIRa destIRb -- ) // tested
    ROT >R UXTX 0 R> ARMSTRREG,  ( RS RN RM OPTION S SF -- )
;

: IRSZ->[IR64], ( srcIR size destIR -- ) // tested
    SWAP >R R31 UXTX 0 R> ARMSTRREG,  ( RS RN RM OPTION S SF -- )
;

// R+N->IR ( covers all cases )

: [PC+N]->IR64, { | N destIR -- } // tested, assumes N is a multiple of 4

    N 2/ 2/ N19>= IF
      N destIR PC+N->IR64, // is it a problem if destIR = RSP?
      destIR destIR [IR64]->IR64,
      EXIT
    THEN
     
    N 2/ 2/ destIR 64BIT ARMLDRLIT,  ( IMM19 RD SF -- ) 
;

: [PC+N]->IRSZ, { | N destIR size -- } // tested

    N 2/ 2/ N19>=
    size 3 AND 0 = OR // 8BIT or N8BIT
    size 3 AND 1 = OR // 16BIT or N16BIT
    IF
      N destIR PC+N->IR64, // is it a problem if destIR = RSP?
      destIR destIR size [IR64]->IRSZ,
      EXIT
    THEN

    size N32BIT = IF
       N 2/ 2/ destIR ARMLDRSWLIT,  ( IMM19 RD SF -- )
       EXIT
    THEN
  
    N 2/ 2/ destIR size ARMLDRLIT,  ( IMM19 RD SF -- )
;


// can do 32.... but 8 and 16 are not supported in one instruction...

: O->IR64, ( O destIR -- ) >R OHERE - R> PC+N->IR64, ; // tested
: [O]->IR64, ( O destIR -- ) >R OHERE - R> [PC+N]->IR64, ; // tested

: [O]->IRSZ, ( O destIR size -- ) >R >R OHERE - R> R> [PC+N]->IRSZ, ; // tested

// uses SCRATCHREG1 if N/8 doesn't fit into U12 and either destIR is RSP or srcIR = destIR
: [IR64+N]->IR64, { tempIR | srcIR N destIR -- } // tested 

    destIR TO tempIR

    destIR RSP = IF // needed because RSP can't be an index reg in ARMADDEXT
      SCRATCHREG1 TO tempIR
    THEN

    destIR srcIR = IF // don't want to trash srcIR
      SCRATCHREG1 TO tempIR
    THEN

    srcIR SCRATCHREG1 = IF // again, don't want to trash srcIR
      SCRATCHREG2 TO tempIR 
    THEN

    N 7 AND 0<> IF // could use one of the other loads that don't require alignment...
      ERROR" N not a multiple of 8"
      EXIT
    THEN

    N 2/ 2/ 2/ U12>= IF 
      N tempIR N->IR64,
      srcIR tempIR UXTX 0 tempIR 64BIT ARMADDEXT, ( RN RM OPTION IMM3 RD SF -- )
      tempIR 0 destIR 64BIT ARMLDRIMM,
      EXIT
    THEN

    srcIR N 2/ 2/ 2/ destIR 64BIT ARMLDRIMM, 
;

// uses SCRATCHREG1 if N/8 doesn't fit into U12 and either destIR is RSP or srcIR = destIR
: [IR64+N]->IRSZ, { tempIR | srcIR N destIR size -- } // tested except for error cases... and I only tested aligned to 8 cases

    destIR TO tempIR

    destIR RSP = IF // needed because RSP can't be an index reg in ARMADDEXT
      SCRATCHREG1 TO tempIR
    THEN

    destIR srcIR = IF // don't want to trash srcIR
      SCRATCHREG1 TO tempIR
    THEN

    srcIR SCRATCHREG1 = IF // again, don't want to trash srcIR
      SCRATCHREG2 TO tempIR 
    THEN

    size 3 AND 3 = IF
      N 7 AND 0<> IF // could use one of the other loads that don't require alignment...
        ERROR" N not a multiple of 8"
        EXIT
      THEN
    THEN

    size 3 AND 2 = IF
       N 3 AND 0<> IF // could use one of the other loads that don't require alignment...
        ERROR" N not a multiple of 4"
        EXIT
      THEN
    THEN 

    size 3 AND 1 = IF
       N 1 AND 0<> IF // could use one of the other loads that don't require alignment...
        ERROR" N not a multiple of 2"
        EXIT
      THEN
    THEN   

    N size 3 AND RSHIFT U12>= IF 
      N tempIR N->IR64,
      srcIR tempIR UXTX 0 tempIR 64BIT ARMADDEXT, ( RN RM OPTION IMM3 RD SF -- )
      size 80 AND 0= IF
        tempIR 0 destIR size ARMLDRIMM,
      ELSE
        tempIR 0 destIR size 64BIT ARMLDRSIMM,
      THEN
      EXIT
    THEN

    size 80 AND 0= IF
      srcIR N size 3 AND RSHIFT destIR size ARMLDRIMM,
    ELSE
      srcIR N size 3 AND RSHIFT destIR size 64BIT ARMLDRSIMM,
    THEN 
;

: [IR64++N]->IR64, { | srcIR N destIR -- }  // tested
  
    N N9>= IF 
      srcIR N srcIR IR64+N->IR64,
      srcIR 0 destIR 64BIT ARMLDRIMM,
      EXIT
    THEN 

    srcIR N destIR 64BIT ARMIMM++LDR, // ( RN IMM9 RT SF -- )
;

: [IR64++N]->IRSZ, { | srcIR N destIR size -- }  // tested
  
    N N9>= IF 
      srcIR N srcIR IR64+N->IR64,
      size 80 AND 0= IF
        srcIR 0 destIR size ARMLDRIMM,
      ELSE
        srcIR 0 destIR size 64BIT ARMLDRSIMM,
      THEN
      EXIT
    THEN 

    size 80 AND 0= IF
      srcIR N destIR size ARMIMM++LDR, // ( RN IMM9 RT SF -- )
    ELSE
      srcIR N destIR size 64BIT ARMIMM++LDRS,
    THEN
;

: IR64->[IR64++N], { | srcIR destIR N -- }  // tested
  
    N N9>= IF 
      destIR N destIR IR64+N->IR64,
      srcIR destIR 0 64BIT ARMSTRIMM,
      EXIT
    THEN 

    srcIR destIR N 64BIT ARMIMM++STR, // ( RN RT IMM9 SF -- )
;

: IRSZ->[IR64++N], { | srcIR size destIR N -- }  // tested
  
    N N9>= IF 
      destIR N destIR IR64+N->IR64,
      srcIR destIR 0 size ARMSTRIMM,
      EXIT
    THEN 

    srcIR destIR N size ARMIMM++STR, // ( RN RT IMM9 SF -- )
;

: [IR64]++N->IR64, { | srcIR N destIR -- }  // tested
  
    N N9>= IF 
      // there might be a more efficient way... but this minimizes the use of scratch regs and I'm guessing
      //   this won't be needed much if at all
      srcIR N srcIR IR64+N->IR64,
      srcIR 0 N - destIR [IR64+N]->IR64,
      EXIT
    THEN 

    srcIR N destIR 64BIT ARMLDRIMM++, // ( RN IMM9 RT SF -- )
;

: [IR64]++N->IRSZ, { | srcIR N destIR size -- } // tested
  
    N N9>= IF 
      // there might be a more efficient way... but this minimizes the use of scratch regs and I'm guessing
      //   this won't be needed much if at all
      srcIR N srcIR IR64+N->IR64,
      srcIR 0 N - destIR size [IR64+N]->IRSZ,
      EXIT
    THEN 

    size 80 AND 0= IF
      srcIR N destIR size ARMLDRIMM++, // ( RN IMM9 RT SF -- )
    ELSE
      srcIR N destIR size 64BIT ARMLDRSIMM++,
    THEN
;

: [RSP+N]->IR64, ( N destreg -- ) >R >R RSP R> R> [IR64+N]->IR64, ; // tested

: [RSP+N]->IRSZ, ( N destreg size -- ) >R >R >R RSP R> R> R> [IR64+N]->IRSZ, ; // tested

: IR64->[IR64+N], { | srcIR destIR N -- } // tested

    N 7 AND 0<> IF // could use one of the other loads that don't require alignment...
      ERROR" N not a multiple of 8"
      EXIT
    THEN

    N 2/ 2/ 2/ U12>= IF 
      destIR N destIR IR64+N->IR64,
      srcIR destIR 0 64BIT ARMSTRIMM,
      EXIT
    THEN

    srcIR destIR N 2/ 2/ 2/ 64BIT ARMSTRIMM,
;

: IRSZ->[IR64+N], { | srcIR size destIR N -- } // tested

    size 3 AND 1 = IF
      N 1 AND 0<> IF // could use one of the other loads that don't require alignment...
        ERROR" N not a multiple of 2"
        EXIT
      THEN
    THEN

    size 3 AND 2 = IF
      N 3 AND 0<> IF // could use one of the other loads that don't require alignment...
        ERROR" N not a multiple of 4"
        EXIT
      THEN
    THEN

    size 3 AND 3 = IF
      N 7 AND 0<> IF // could use one of the other loads that don't require alignment...
        ERROR" N not a multiple of 8"
        EXIT
      THEN
    THEN

    N size 3 AND RSHIFT U12>= IF 
      destIR N destIR IR64+N->IR64,
      srcIR destIR 0 size ARMSTRIMM,
      EXIT
    THEN

    srcIR destIR N size 3 AND RSHIFT size ARMSTRIMM,
;

: IR64->[IR64]++N, { | srcIR destIR N -- }  // tested
  
    N N9>= IF 
      // there might be a more efficient way... but this minimizes the use of scratch regs and I'm guessing
      //   this won't be needed much if at all
      srcIR destIR IR64->[IR64],
      destIR N destIR IR64+N->IR64,
      EXIT
    THEN 

    srcIR destIR N 64BIT ARMSTRIMM++, // ( RN RT IMM9 SF -- )
;

: IRSZ->[IR64]++N, { | srcIR size destIR N -- }  // tested
  
    N N9>= IF 
      // there might be a more efficient way... but this minimizes the use of scratch regs and I'm guessing
      //   this won't be needed much if at all
      srcIR size destIR IRSZ->[IR64],
      destIR N destIR IR64+N->IR64,
      EXIT
    THEN 

    srcIR destIR N size ARMSTRIMM++, // ( RN RT IMM9 SF -- )
;

: IR64->[RSP+N], ( srcIR N -- ) RSP SWAP IR64->[IR64+N], ; // tested

: IRSZ->[RSP+N], ( srcIR size N -- ) RSP SWAP IRSZ->[IR64+N], ; // tested

: IR64IR64->IR64OP, ( srcIRa srcIRb destIR baseopcode -- ) >R 64BIT R>  RNRMRDSFOP, ; // tested

// compile two register sources preserve flags instruction using instruction id
: IR64IR64->IR64IDPF, { | srcIRa srcIRb destIR OPID -- } // mostly tested
    srcIRa srcIRb destIR OPID ID>PFOP IR64IR64->IR64OP, 

    // if type bit for invert dest for preserve flags is set then xor result with -1
    //   this gets you NAND and NOR using only 2 instructions
    OPID ID>TYPE ?ERRORIF NAME>E EXIT THEN IDTABLE.INVERTDESTMASK AND 0<> IF
      destIR R31 0 LSL destIR 64BIT ARMEONSHIFTEDREG,  ( RN RM IMM6 SHIFT RD SF -- )
    THEN 
; 

// compile two register sources change flags instruction using instruction id
: IR64IR64->IR64IDCF, { | srcIRa srcIRb destIR OPID -- } 

    // if type bit for invert source for change flags is set then xor srcIRa with -1
    //   this gets you NORS using only 2 instructions unless srcIRb = destIR
    OPID ID>TYPE IDTABLE.INVERTSRCAMASK AND 0<> IF
      // NOR case
      
      // inverter case ... can use only one instruction
      srcIRa srcIRb = IF
        srcIRa R31 0 LSL destIR 64BIT ARMEONSHIFTEDREG,  ( RN RM IMM6 SHIFT RD SF -- )
        destIR 0 0 destIR 64BIT ARMADDSIMM, 
        EXIT
      THEN

      // if srcIRa is destIR then you can't use destIR as the temporary result... use SCRATCHREG1 instead
      destIR srcIRa = IF 
   
        // assumes srcIRa and srcIRb are not the same
        // assumes base opcode is BICS or that set flag opcode exists
        srcIRa R31 0 LSL SCRATCHREG1 64BIT ARMEONSHIFTEDREG,  ( RN RM IMM6 SHIFT RD SF -- )
        SCRATCHREG1 srcIRb destIR OPID ID>CFOP ?ERRORIF NAME>E EXIT THEN IR64IR64->IR64OP, 
        EXIT
      THEN

      // assumes base opcode is BICS or that set flag opcode exists
      srcIRa R31 0 LSL destIR 64BIT ARMEONSHIFTEDREG,  ( RN RM IMM6 SHIFT RD SF -- )
      destIR srcIRb destIR OPID ID>CFOP ?ERRORIF NAME>E EXIT THEN IR64IR64->IR64OP, 
      EXIT
    THEN 

    // NAND case
    OPID ID>TYPE IDTABLE.INVERTNANDCASEMASK AND 0<> IF
      // inverter case ... can use only one instruction
      srcIRa srcIRb = IF
        srcIRa R31 0 LSL destIR 64BIT ARMEONSHIFTEDREG,  ( RN RM IMM6 SHIFT RD SF -- )
        destIR 0 0 destIR 64BIT ARMADDSIMM, 
        EXIT
      THEN

      //  compile AND, -1 XOR, 0 ADDS,
      srcIRa srcIRb destIR OPID ID>PFOP IR64IR64->IR64OP,
      destIR R31 0 LSL destIR 64BIT ARMEONSHIFTEDREG,  ( RN RM IMM6 SHIFT RD SF -- )
      destIR 0 0 destIR 64BIT ARMADDSIMM, 
      EXIT
    THEN

    // if change flags opcode exists then use it
    OPID ID>CFOP 0<> IF 
      srcIRa srcIRb destIR OPID ID>CFOP ?ERRORIF NAME>E EXIT THEN IR64IR64->IR64OP, 
      EXIT 
    THEN

    // if change flags opcode does not exist then use preserve flags opcode with an adds 0 after it
    //   ***************************************************************************
    //   *** to do: this does not handle the carry flag for the shifts cases.... ***
    //         but... do you really need to do the carry flag when you have a barrel shifter?
    //   ***************************************************************************
    srcIRa srcIRb destIR OPID ID>PFOP ?ERRORIF NAME>E EXIT THEN IR64IR64->IR64OP,  
    ( RN IMM12 SH RD SF -- )
    destIR 0 0 destIR 64BIT ARMADDSIMM, 
; 


: ?U12ADDSUBOP { | U OPID -- flag }
    U U12>= IF
      FALSE
      EXIT
    THEN
    OPID IDADD = 
    OPID IDSUB = OR
;

: ?U12<<12ADDSUBOP { | U OPID -- flag }
    U FFF AND 0= IF
      U 0C RSHIFT U12>= 0= IF
        OPID IDADD = 
        OPID IDSUB = OR
        EXIT
      THEN
    THEN
    FALSE
;

: ?U13ANDOREOROP { | U OPID -- flag }
    U U13>= 0= IF
      OPID IDAND = 
      OPID IDORR = OR
      OPID IDEOR = OR
      EXIT
    THEN
    FALSE
;

: ID>ADDSUBNPFOP { | OPID -- baseop }
    OPID IDADD = IF
      ARMADDIMM EXIT
    THEN
    OPID IDSUB = IF
      ARMSUBIMM EXIT
    THEN
    ERROR" not add or sub opid" 
;

: ID>ANDOREORPFOP { | OPID -- baseop }
    OPID IDAND = IF
      ARMANDIMM EXIT
    THEN
    OPID IDOR = IF
      ARMORIMM EXIT
    THEN
    OPID IDEOR = IF
      ARMEORIMM EXIT
    THEN
    ERROR" not and or or or eor opid" 
;

: ID>ADDSUBNCFOP { | OPID -- baseop }
    OPID IDADD = IF
      ARMADDSIMM EXIT
    THEN
    OPID IDSUB = IF
      ARMSUBSIMM EXIT
    THEN
    ERROR" not add or sub opid" 
;


// compile one register one n preserve flags instruction using instruction id
: IR64N->IR64IDPF, { | srcIRa N destIR OPID -- } // tested
    N OPID ?U12ADDSUBOP IF
      srcIRa N 0 destIR 64BIT OPID ID>ADDSUBNPFOP RNIMM12SHRDSFOP, ( | RN IMM12 SH RD SF OP -- )
      EXIT
    THEN

    N OPID ?U12<<12ADDSUBOP IF
      srcIRa N 0C RSHIFT 1 destIR 64BIT OPID ID>ADDSUBNPFOP RNIMM12SHRDSFOP, ( | RN IMM12 SH RD SF OP -- )
      EXIT
    THEN

//    ANDOREOR N stuff is compilicated
//    N OPID ?U13ANDOREOROP IF
//      srcIRa N destIR 64BIT OPID ID>ANDOREORPFOP RNIMM13RDOP, ( | RN IMM13 RD SF OP -- )
//      EXIT
//    THEN

    // don't I need to check if there is a preserve regs op here?

    srcIRa SCRATCHREG1 = IF
       N SCRATCHREG2 N->IR64,
       srcIRa SCRATCHREG2 destIR OPID IR64IR64->IR64IDPF,
    ELSE
      N SCRATCHREG1 N->IR64,
      srcIRa SCRATCHREG1 destIR OPID IR64IR64->IR64IDPF,
    THEN
; 

// compile one register one n change flags instruction using instruction id
: IR64N->IR64IDCF, { | srcIRa N destIR OPID -- } // tested
    N OPID ?U12ADDSUBOP IF
      srcIRa N 0 destIR 64BIT OPID ID>ADDSUBNCFOP RNIMM12SHRDSFOP, ( | RN IMM12 SH RD SF OP -- )
      EXIT
    THEN

    N OPID ?U12<<12ADDSUBOP IF
      srcIRa N 0C RSHIFT 1 destIR 64BIT OPID ID>ADDSUBNCFOP RNIMM12SHRDSFOP, ( | RN IMM12 SH RD SF OP -- )
      EXIT
    THEN

    // don't I need to check if there is a change regs op here?

    srcIRa SCRATCHREG1 = IF
      N SCRATCHREG2 N->IR64,
      srcIRa SCRATCHREG2 destIR OPID IR64IR64->IR64IDCF,
    ELSE
      N SCRATCHREG1 N->IR64,
      srcIRa SCRATCHREG1 destIR OPID IR64IR64->IR64IDCF,
      // don't I need the test thing here?
    THEN
; 

// if source a n is not reversible, this trashes scratchreg1 or scratchreg2
: NIR64->IR64IDPF, { | N srcIRa destIR OPID -- } // tested
    OPID ID>TYPE IDTABLE.ORDERIMPORTANT AND 0= IF
      // op is reversible
      srcIRa N destIR OPID IR64N->IR64IDPF,
      EXIT
    THEN
 
    // op is not reversible
    srcIRa SCRATCHREG1 = IF
      N SCRATCHREG2 N->IR64,
      SCRATCHREG2 srcIRa destIR OPID IR64IR64->IR64IDPF,
    ELSE 
      N SCRATCHREG1 N->IR64,
      SCRATCHREG1 srcIRa destIR OPID IR64IR64->IR64IDPF,   
    THEN     
;

// if source a is not reversible, this trashes scratchreg1 or scratchreg2
// compile one register one n preserve flags instruction using instruction id
: NIR64->IR64IDCF, { | N srcIRa destIR OPID -- } // tested
    OPID ID>TYPE IDTABLE.ORDERIMPORTANT AND 0= IF
      // op is reversible
      srcIRa N destIR OPID IR64N->IR64IDCF,
      EXIT
    THEN

    srcIRa SCRATCHREG1 = IF
      N SCRATCHREG2 N->IR64,
      SCRATCHREG2 srcIRa destIR OPID IR64IR64->IR64IDCF,
    ELSE
      N SCRATCHREG1 N->IR64,
      SCRATCHREG1 srcIRa destIR OPID IR64IR64->IR64IDCF,
    THEN
;

// [N]->IR?
// IR->[PC+N] // no single instruction for this because OS usually does not allow writes to code mem... but since standard FORTH needs this...

VARIABLE POPID

VARIABLE PTARGETSIZE
VARIABLE PTARGETR
VARIABLE PTARGETN
VARIABLE PTARGETMODE

VARIABLE PSOURCEASIZE
VARIABLE PSOURCEAR
VARIABLE PSOURCEAN
VARIABLE PSOURCEAMODE

VARIABLE PSOURCEBSIZE
VARIABLE PSOURCEBR
VARIABLE PSOURCEBN
VARIABLE PSOURCEBMODE

VARIABLE PDESTSIZE
VARIABLE PDESTR
VARIABLE PDESTN
VARIABLE PDESTMODE

VARIABLE PPRESERVEFLAGSFLAG
VARIABLE PDEFAULTPRESERVEFLAGSFLAG
TRUE PDEFAULTPRESERVEFLAGSFLAG !

VARIABLE PSOURCEARTEMP
VARIABLE PSOURCEBRTEMP
VARIABLE PDESTRTEMP

: IR64IR64->IR64ID, ( -- ) // tested
    PSOURCEARTEMP @ PSOURCEBRTEMP @ PDESTRTEMP @ POPID @

    PPRESERVEFLAGSFLAG @ 0= IF 
      IR64IR64->IR64IDCF,
    ELSE
      IR64IR64->IR64IDPF,
    THEN
;

: IR64N->IR64ID, ( -- ) // tested
    PSOURCEARTEMP @ PSOURCEBN @ PDESTRTEMP @ POPID @

    PPRESERVEFLAGSFLAG @ 0= IF 
      IR64N->IR64IDCF,
    ELSE
      IR64N->IR64IDPF,
    THEN
;

: NIR64->IR64ID, ( -- ) // tested
    PSOURCEAN @ PSOURCEBRTEMP @ PDESTRTEMP @ POPID @

    PPRESERVEFLAGSFLAG @ 0= IF 
      NIR64->IR64IDCF,
    ELSE
      NIR64->IR64IDPF,
    THEN
;

-1 CONSTANT DEFAULTR
-2 CONSTANT R
-3 CONSTANT N
-4 CONSTANT [R]
-5 CONSTANT [R+N]
-6 CONSTANT O
-7 CONSTANT [O]
-8 CONSTANT [PC+N]
-9 CONSTANT [RSP+N]
-0A CONSTANT PF
-0A CONSTANT PRESERVEFLAGS
-0B CONSTANT UF
-0B CONSTANT UPDATEFLAGS
-0C CONSTANT [R++N]
-0D CONSTANT [R]++N

// need preserveflags and updateflags

: PULLTARGET { PULLONCE MODE | -- } ( R|N| MODE|R -- ) // tested
    NOREG PTARGETR !
    0 PTARGETN !
    64BIT PTARGETSIZE !

    BEGIN
      ?ERRORIF NAME>E EXIT THEN
  
      TRUE TO PULLONCE

      [ EMES, ]

          ( 0 8BIT ) 
          8BIT PTARGETSIZE !
          FALSE TO PULLONCE

        [ EME, ]

          ( 1 16BIT )
          16BIT PTARGETSIZE !
          FALSE TO PULLONCE

        [ EME, ]

          ( 2 32BIT )
          32BIT PTARGETSIZE !
          FALSE TO PULLONCE

        [ EME, ]

          ( 3 64BIT )
          64BIT PTARGETSIZE !
          FALSE TO PULLONCE

        [ EME, ]

          ( 4 R )
          PTARGETR !
          R PTARGETMODE !

        [ EME, ]

          ( 5 N )
          PTARGETN !
          N PTARGETMODE !

        [ EME, ]

          ( 6 [R] )
          PTARGETR !
          [R] PTARGETMODE !

        [ EME, ]

          ( 7 [R+N] )
          PTARGETN !
          PTARGETR !
          [R+N] PTARGETMODE !

        [ EME, ]

          ( 8 [PC+N] )
          PTARGETN !
          PC PTARGETR !  // this may not be needed...
          [PC+N] PTARGETMODE !

        [ EME, ]

          ( 9 [RSP+N] )
          PTARGETN !
          RSP PTARGETR !
          [RSP+N] PTARGETMODE ! // use [R+N] instead?

        [ EME, ]

          ( 0A O )
          PTARGETN !
          PC PTARGETR !
          O PTARGETMODE !  // use N instead?

        [ EME, ]

          ( 0B [O] )
          PTARGETN !
          PC PTARGETR !
          [O] PTARGETMODE !

        [ EME, ]

          ( 0C PF )
          TRUE PPRESERVEFLAGSFLAG !
          FALSE TO PULLONCE

        [ EME, ]

          ( 0D UF )
          FALSE PPRESERVEFLAGSFLAG !
          FALSE TO PULLONCE

        [ EME, ]

          ( 0E [R++N] )
          PTARGETN !
          PTARGETR !
          [R++N] PTARGETMODE !

        [ EME, ]

          ( 0F [R]++N )
          PTARGETN !
          PTARGETR !
          [R]++N PTARGETMODE !

        [ EME, ]

          ( 10 N8BIT ) 
          N8BIT PTARGETSIZE !
          FALSE TO PULLONCE

        [ EME, ]

          ( 11 N16BIT ) 
          N16BIT PTARGETSIZE !
          FALSE TO PULLONCE

        [ EME, ]

          ( 12 N32BIT ) 
          N32BIT PTARGETSIZE !
          FALSE TO PULLONCE

      [ ENDEMES, ]

      [ 8BIT 16BIT 32BIT 64BIT R N [R] [R+N] [PC+N] [RSP+N] O [O] PF UF [R++N] [R]++N N8BIT N16BIT N32BIT 13 CASES, ]

        // default case: if not a reg, push an error, otherwise set up a reg
        // ?ISNOTREG IF ERROR" PULLTARGET - target type or default reg not found" EXIT THEN
        ( don't need to do drop, unknown mode is target reg ) PTARGETR !
        DEFAULTR PTARGETMODE !

      [ ENDCASES, ]

      PULLONCE

    UNTIL
;

: ?RR->R ( -- flag )
    PSOURCEAMODE @ R =
    PSOURCEBMODE @ R = AND
    PDESTMODE @ R = AND
;

: ?RN->R ( -- flag )
    PSOURCEAMODE @ R =
    PSOURCEBMODE @ N = AND
    PDESTMODE @ R = AND
;

: ?NR->R ( -- flag )
    PSOURCEAMODE @ N =
    PSOURCEBMODE @ R = AND
    PDESTMODE @ R = AND
;

: ?[R]R->R ( -- flag )
    PSOURCEAMODE @ [R] =
    PSOURCEBMODE @ R = AND
    PDESTMODE @ R = AND
;

: ?R[R]->R ( -- flag )
    PSOURCEAMODE @ R =
    PSOURCEBMODE @ [R] = AND
    PDESTMODE @ R = AND
;

: ?RR->[R] ( -- flag )
    PSOURCEAMODE @ R =
    PSOURCEBMODE @ [R] = AND
    PDESTMODE @ R = AND
;

: PULL3TARGETS ( -- ) // tested

    PULLTARGET ?ERRORIF NAME>E EXIT THEN
    PTARGETR @ PDESTR !
    PTARGETN @ PDESTN !
    PTARGETMODE @ PDESTMODE !
    PTARGETSIZE @ PDESTSIZE !

    PULLTARGET ?ERRORIF NAME>E EXIT THEN
    PTARGETR @ PSOURCEBR !
    PTARGETN @ PSOURCEBN !
    PTARGETMODE @ PSOURCEBMODE !
    PTARGETSIZE @ PSOURCEBSIZE !

    PULLTARGET ?ERRORIF NAME>E EXIT THEN
    PTARGETR @ PSOURCEAR !
    PTARGETN @ PSOURCEAN !
    PTARGETMODE @ PSOURCEAMODE !
    PTARGETSIZE @ PSOURCEASIZE !    
;

: ?MA ( -- flag ) // tested
    PSOURCEAMODE @

    [ EMES, ]

        ( 0 [R] ) 
        TRUE

      [ EME, ]

        ( 1 [R+N] )
        TRUE

      [ EME, ]

        ( 2 [O] )
        TRUE

      [ EME, ]

        ( 3 [PC+N] )
        TRUE

      [ EME, ]

        ( 4 [RSP+N] )
        TRUE 

      [ EME, ]

        ( 5 [R++N] )
        TRUE 

      [ EME, ]

        ( 6 [R]++N )
        TRUE

      [ ENDEMES, ]

      [ [R] [R+N] [O] [PC+N] [RSP+N] [R++N] [R]++N 7 CASES, ]

        DROP FALSE

      [ ENDCASES, ] 
;

: MA->SCRATCHREG2, ( -- ) // tested
    
    PSOURCEAMODE @

    [ EMES, ]

        ( 0 [R] ) 
        PSOURCEAR @ SCRATCHREG2 [IR64]->IR64,

      [ EME, ]

        ( 1 [R+N] )
        PSOURCEAR @ PSOURCEAN @ SCRATCHREG2 [IR64+N]->IR64,

      [ EME, ]

        ( 2 [O] )
        PSOURCEAN @ SCRATCHREG2 [O]->IR64,

      [ EME, ]

        ( 3 [PC+N] )
        PSOURCEAN @ SCRATCHREG2 [PC+N]->IR64, // not sure how someone will use this mode easily when it compiles multiple instructions...

      [ EME, ]

        ( 4 [RSP+N] )
        PSOURCEAN @ SCRATCHREG2 [RSP+N]->IR64, 

      [ EME, ]

        ( 5 [R++N] )
        PSOURCEAR @ PSOURCEAN @ SCRATCHREG2 [IR64++N]->IR64,

      [ EME, ]

        ( 6 [R]++N )
        PSOURCEAR @ PSOURCEAN @ SCRATCHREG2 [IR64]++N->IR64,

      [ ENDEMES, ]

      [ [R] [R+N] [O] [PC+N] [RSP+N] [R++N] [R]++N 7 CASES, ]

        DROP // do nothing if source not mem

      [ ENDCASES, ]
;

: MA->SCRATCHREG2SZ, ( -- ) // tested
    
    PSOURCEAMODE @

    [ EMES, ]

        ( 0 [R] ) 
        PSOURCEAR @ SCRATCHREG2 PSOURCEASIZE @ [IR64]->IRSZ,

      [ EME, ]

        ( 1 [R+N] )
        PSOURCEAR @ PSOURCEAN @ SCRATCHREG2 PSOURCEASIZE @ [IR64+N]->IRSZ,

      [ EME, ]

        ( 2 [O] )
        PSOURCEAN @ SCRATCHREG2 PSOURCEASIZE @ [O]->IRSZ,

      [ EME, ]

        ( 3 [PC+N] )
        PSOURCEAN @ SCRATCHREG2 PSOURCEASIZE @ [PC+N]->IRSZ, // not sure how someone will use this mode easily when it compiles multiple instructions...

      [ EME, ]

        ( 4 [RSP+N] )
        PSOURCEAN @ SCRATCHREG2 PSOURCEASIZE @ [RSP+N]->IRSZ, 

      [ EME, ]

        ( 5 [R++N] )
        PSOURCEAR @ PSOURCEAN @ SCRATCHREG2 PSOURCEASIZE @ [IR64++N]->IRSZ,

      [ EME, ]

        ( 6 [R]++N )
        PSOURCEAR @ PSOURCEAN @ SCRATCHREG2 PSOURCEASIZE @ [IR64]++N->IRSZ,

      [ ENDEMES, ]

      [ [R] [R+N] [O] [PC+N] [RSP+N] [R++N] [R]++N 7 CASES, ]

        DROP // do nothing if source not mem

      [ ENDCASES, ]
;

: ?MB ( -- flag ) // tested
    PSOURCEBMODE @

    [ EMES, ]

        ( 0 [R] ) 
        TRUE

      [ EME, ]

        ( 1 [R+N] )
        TRUE

      [ EME, ]

        ( 2 [O] )
        TRUE

      [ EME, ]

        ( 3 [PC+N] )
        TRUE

      [ EME, ]

        ( 4 [RSP+N] )
        TRUE 

      [ EME, ]

        ( 5 [R++N] )
        TRUE

      [ EME, ]

        ( 6 [R]++N )
        TRUE

      [ ENDEMES, ]

      [ [R] [R+N] [O] [PC+N] [RSP+N] [R++N] [R]++N 7 CASES, ]

        DROP FALSE

      [ ENDCASES, ] 
;

: MB->SCRATCHREG1, ( -- ) // tested
    
    PSOURCEBMODE @

    [ EMES, ]

        ( 0 [R] ) 
        PSOURCEBR @ SCRATCHREG1 [IR64]->IR64,

      [ EME, ]

        ( 1 [R+N] )
        PSOURCEBR @ PSOURCEBN @ SCRATCHREG1 [IR64+N]->IR64,

      [ EME, ]

        ( 2 [O] )
        PSOURCEBN @ SCRATCHREG1 [O]->IR64,

      [ EME, ]

        ( 3 [PC+N] )
        PSOURCEBN @ SCRATCHREG1 [PC+N]->IR64, // not sure how someone will use this mode easily when it compiles multiple instructions...

      [ EME, ]

        ( 4 [RSP+N] )
        PSOURCEBN @ SCRATCHREG1 [RSP+N]->IR64, 

      [ EME, ]

        ( 5 [R++N] )
        PSOURCEBR @ PSOURCEBN @ SCRATCHREG1 [IR64++N]->IR64,

      [ EME, ]

        ( 6 [R]++N )
        PSOURCEBR @ PSOURCEBN @ SCRATCHREG1 [IR64]++N->IR64,

      [ ENDEMES, ]

      [ [R] [R+N] [O] [PC+N] [RSP+N] [R++N] [R]++N 7 CASES, ]

        DROP // do nothing if source not mem

      [ ENDCASES, ]
;

: MB->IRSZ, { | destir -- }  // sz here means the fetch uses the source's size
    
    PSOURCEBMODE @

    [ EMES, ]

        ( 0 [R] ) 
        PSOURCEBR @ destir PSOURCEBSIZE @ [IR64]->IRSZ,

      [ EME, ]

        ( 1 [R+N] )
        PSOURCEBR @ PSOURCEBN @ destir PSOURCEBSIZE @ [IR64+N]->IRSZ,

      [ EME, ]

        ( 2 [O] )
        PSOURCEBN @ destir PSOURCEBSIZE @ [O]->IRSZ,

      [ EME, ]

        ( 3 [PC+N] )
        PSOURCEBN @ destir PSOURCEBSIZE @ [PC+N]->IRSZ, // not sure how someone will use this mode easily when it compiles multiple instructions...

      [ EME, ]

        ( 4 [RSP+N] )
        PSOURCEBN @ destir PSOURCEBSIZE @ [RSP+N]->IRSZ, 

      [ EME, ]

        ( 5 [R++N] )
        PSOURCEBR @ PSOURCEBN @ destir PSOURCEBSIZE @ [IR64++N]->IRSZ,

      [ EME, ]

        ( 6 [R]++N )
        PSOURCEBR @ PSOURCEBN @ destir PSOURCEBSIZE @ [IR64]++N->IRSZ,

      [ ENDEMES, ]

      [ [R] [R+N] [O] [PC+N] [RSP+N] [R++N] [R]++N 7 CASES, ]

        DROP // do nothing if source not mem

      [ ENDCASES, ]
;

: MB->SCRATCHREG1SZ, ( -- ) // tested // SZ means the fetch uses the source's size

    SCRATCHREG1 MB->IRSZ,

;
    
// : MB->SCRATCHREG1SZ, ( -- ) // tested fetches size from MB

//     PSOURCEBMODE @

//     [ EMES, ]

//         ( 0 [R] ) 
//         PSOURCEBR @ SCRATCHREG1 PSOURCEBSIZE @ [IR64]->IRSZ,

//       [ EME, ]

//         ( 1 [R+N] )
//         PSOURCEBR @ PSOURCEBN @ SCRATCHREG1 PSOURCEBSIZE @ [IR64+N]->IRSZ,

//       [ EME, ]

//         ( 2 [O] )
//         PSOURCEBN @ SCRATCHREG1 PSOURCEBSIZE @ [O]->IRSZ,

//       [ EME, ]

//         ( 3 [PC+N] )
//         PSOURCEBN @ SCRATCHREG1 PSOURCEBSIZE @ [PC+N]->IRSZ, // not sure how someone will use this mode easily when it compiles multiple instructions...

//       [ EME, ]

//         ( 4 [RSP+N] )
//         PSOURCEBN @ SCRATCHREG1 PSOURCEBSIZE @ [RSP+N]->IRSZ, 

//       [ EME, ]

//         ( 5 [R++N] )
//         PSOURCEBR @ PSOURCEBN @ SCRATCHREG1 PSOURCEBSIZE @ [IR64++N]->IRSZ,

//       [ EME, ]

//         ( 6 [R]++N )
//         PSOURCEBR @ PSOURCEBN @ SCRATCHREG1 PSOURCEBSIZE @ [IR64]++N->IRSZ,

//       [ ENDEMES, ]

//       [ [R] [R+N] [O] [PC+N] [RSP+N] [R++N] [R]++N 7 CASES, ]

//         DROP // do nothing if source not mem

//       [ ENDCASES, ]
// ;

: ?MDEST ( -- flag ) // tested

    PDESTMODE @

    [ EMES, ]

        ( 0 [R] ) 
        TRUE

      [ EME, ]

        ( 1 [R+N] )
        TRUE

      [ EME, ]

        ( 2 [O] )
        TRUE

      [ EME, ]

        ( 3 [PC+N] )
        TRUE

      [ EME, ]

        ( 4 [RSP+N] )
        TRUE 

      [ EME, ]

        ( 5 [R++N] )
        TRUE

      [ EME, ]

        ( 6 [R]++N )
        TRUE

      [ ENDEMES, ]

      [ [R] [R+N] [O] [PC+N] [RSP+N] [R++N] [R]++N 7 CASES, ]

        DROP FALSE

      [ ENDCASES, ] 
;

: SCRATCHREG2->MDEST, ( -- ) // tested

    PDESTMODE @

    [ EMES, ]

        ( 0 [R] ) 
        SCRATCHREG2 PDESTR @ IR64->[IR64],

      [ EME, ]

        ( 1 [R+N] )
        SCRATCHREG2 PDESTR @ PDESTN @  IR64->[IR64+N],

      [ EME, ]

        ( 2 [O] )
        ERROR" writing to a .o code buffer is an os security violation... use [R] if you are going disable write protection on code buffers"

      [ EME, ]

        ( 3 [PC+N] )
        ERROR" writing to a .o code buffer is an os security violation... use [R] if you are going disable write protection on code buffers"

      [ EME, ]

        ( 4 [RSP+N] )
        SCRATCHREG2 PDESTN @ IR64->[RSP+N], 

      [ EME, ]

        ( 5 [R++N] )
        SCRATCHREG2 PDESTR @ PDESTN @  IR64->[IR64++N],

      [ EME, ]

        ( 6 [R]++N )
        SCRATCHREG2 PDESTR @ PDESTN @  IR64->[IR64]++N,

      [ ENDEMES, ]

      [ [R] [R+N] [O] [PC+N] [RSP+N] [R++N] [R]++N 7 CASES, ]

        DROP // do nothing if dest not mem

      [ ENDCASES, ]
;

: IR->MDESTSZ, { | srcir -- } // stores dest size to MDEST

    PDESTMODE @

    [ EMES, ]

        ( 0 [R] ) 
        srcir PDESTSIZE @ PDESTR @ IRSZ->[IR64],

      [ EME, ]

        ( 1 [R+N] )
        srcir PDESTSIZE @ PDESTR @ PDESTN @  IRSZ->[IR64+N],

      [ EME, ]

        ( 2 [O] )
        ERROR" writing to a .o code buffer is an os security violation... use [R] if you are going disable write protection on code buffers"

      [ EME, ]

        ( 3 [PC+N] )
        ERROR" writing to a .o code buffer is an os security violation... use [R] if you are going disable write protection on code buffers"

      [ EME, ]

        ( 4 [RSP+N] )
        srcir PDESTSIZE @ PDESTN @ IRSZ->[RSP+N], 

      [ EME, ]

        ( 5 [R++N] )
        srcir PDESTSIZE @ PDESTR @ PDESTN @  IRSZ->[IR64++N],

      [ EME, ]

        ( 6 [R]++N )
        srcir PDESTSIZE @ PDESTR @ PDESTN @  IRSZ->[IR64]++N,

    [ ENDEMES, ]

    [ [R] [R+N] [O] [PC+N] [RSP+N] [R++N] [R]++N 7 CASES, ]

      DROP // do nothing if dest not mem

    [ ENDCASES, ]
;

: SCRATCHREG2->MDESTSZ, ( -- ) // stores dest size to MDEST
    SCRATCHREG2 IR->MDESTSZ,
;

// : SCRATCHREG2->MDESTSZ, ( -- ) // tested

//    PDESTMODE @

//    [ EMES, ]

//        ( 0 [R] ) 
//        SCRATCHREG2 PDESTSIZE @ PDESTR @ IRSZ->[IR64],

//      [ EME, ]

//        ( 1 [R+N] )
//        SCRATCHREG2 PDESTSIZE @ PDESTR @ PDESTN @  IRSZ->[IR64+N],

//      [ EME, ]

//        ( 2 [O] )
//        ERROR" writing to a .o code buffer is an os security violation... use [R] if you are going disable write protection on code buffers"

//      [ EME, ]

//        ( 3 [PC+N] )
//        ERROR" writing to a .o code buffer is an os security violation... use [R] if you are going disable write protection on code buffers"

//      [ EME, ]

//        ( 4 [RSP+N] )
//        SCRATCHREG2 PDESTSIZE @ PDESTN @ IRSZ->[RSP+N], 

//      [ EME, ]
//
//        ( 5 [R++N] )
//        SCRATCHREG2 PDESTSIZE @ PDESTR @ PDESTN @  IRSZ->[IR64++N],

//      [ EME, ]

//        ( 6 [R]++N )
//        SCRATCHREG2 PDESTSIZE @ PDESTR @ PDESTN @  IRSZ->[IR64]++N,

//    [ ENDEMES, ]

//    [ [R] [R+N] [O] [PC+N] [RSP+N] [R++N] [R]++N 7 CASES, ]

//      DROP // do nothing if dest not mem

//    [ ENDCASES, ]
// ;

: ?SRCAR ( -- flag ) // tested
    PSOURCEAMODE @ DUP R = 
    SWAP DEFAULTR = OR
;

: ?SRCBR ( -- flag ) // tested
    PSOURCEBMODE @ DUP R = 
    SWAP DEFAULTR = OR
;

: ?DESTR ( -- flag ) // tested
    PDESTMODE @ DUP R = 
    SWAP DEFAULTR = OR
;

: IRSZ->IR64, { | rsource size rdest -- } // assumes reg is not rsp ... tested
    size 80 AND 0= IF
      // unsigned
      size 3 AND
      [ EMES, ]  
          ( 0 8BIT ) rsource rdest ARMUXTB,
        [ EME, ] 
          ( 1 16BIT ) rsource rdest ARMUXTH,
        [ EME, ]
          ( 2 32BIT ) rsource rdest 32BIT ARMMOVREG, // can you use ARMSXTW with bit 31 = 0 instead?
      [ ENDEMES, ]

      [ UJUMP, 
         DEFAULTDROPJUMP, ]
         // is 64bits, and same reg do nothing otherwise do a move
         rsource rdest <> IF
           rsource rdest IR64->IR64,
         THEN
      [ ENDUJUMP, ]
    ELSE
      // signed
      size 3 AND
      [ EMES, ]  
          ( 0 8BIT ) rsource rdest 64BIT ARMSXTB,
        [ EME, ] 
          ( 1 16BIT ) rsource rdest 64BIT ARMSXTH,
        [ EME, ]
          ( 2 32BIT ) rsource rdest ARMSXTW, 
      [ ENDEMES, ]

      [ UJUMP, 
         DEFAULTDROPJUMP, ]
         // is 64bits, and same reg do nothing otherwise do a move
         rsource rdest <> IF
           rsource rdest IR64->IR64,
         THEN
      [ ENDUJUMP, ]
    THEN
;

// cases will be R N or M
//   M can be [N] [R] [R+N] for now and will be handled as a sub
//     N as dest is an error
//     two N sources is an error
//     that leaves:
//       N R -> R  // use N R -> R op
//       N R -> M  // use N R -> R op  then R -> M
//       N M -> R  // use M -> SCRATCHREG1 then N R -> R op then R->M
//       N M -> M  // do above then R -> M
//       R N -> R  // use R N -> R op
//       R N -> M  // do above then R->M
//       R R -> R // normal case
//       R R -> M // do above to a SCRATCHREG1 then R->M
//       R M -> R // to M -> a SCRATCHREG1 then to above
//       R M -> M // do above then to R->M
//       M N -> R 
//       M N -> M
//       M R -> R
//       M R -> M
//       M M -> R
//       M M -> M
       
: 2SOURCE1DESTOPID, ( opid -- ) // mostly tested I think...
    POPID !
    PULL3TARGETS

    // if dest is N then that is an error
    PDESTMODE @ N = IF ERROR" N can't be a destination" NAME>E EXIT THEN

    // if dest is O then that is an error
    PDESTMODE @ O = IF ERROR" O can't be a destination" NAME>E EXIT THEN

    // both sources can't be N or O
    PSOURCEAMODE @ DUP N = SWAP O = OR
    PSOURCEBMODE @ DUP N = SWAP O = OR AND IF ERROR" both sources can't be N or O, please do the math and use a move" NAME>E EXIT THEN
   
    // if source a is R then compile code to sign extend R if needed using IRSZ->IR64, ( sourcer size destr -- )
    ?SRCAR IF
      PSOURCEAR @ PSOURCEASIZE @ OVER IRSZ->IR64,
    THEN

    // if source b is R then compile code to sign extend R if needed
    ?SRCBR IF
      PSOURCEBR @ PSOURCEBSIZE @ OVER IRSZ->IR64,
    THEN
    
    // if sourcea M->R then do MA->SCRATCHREG2,
    ?MA IF
      // MA->SCRATCHREG2,
      MA->SCRATCHREG2SZ,
      SCRATCHREG2 PSOURCEARTEMP !
    ELSE
      // if source a is O then compile code to move o to scratchreg2
      PSOURCEAMODE @ O = IF
        PSOURCEAN @ SCRATCHREG2 O->IR64,  // size not supported for O... I could put it in .... but who'd ever need it?
        SCRATCHREG2 PSOURCEARTEMP !
      ELSE
        PSOURCEAR @ PSOURCEARTEMP !
        // probably should check for scratchreg and give error...
      THEN
    THEN

    // if sourceb M->R then do MB->SCRATCHREG1,
    ?MB IF
      MB->SCRATCHREG1SZ, // fetches size from MB
      SCRATCHREG1 PSOURCEBRTEMP !
    ELSE
      // if source b is O then compile code to move o to scratchreg1
      PSOURCEBMODE @ O = IF
        PSOURCEBN @ SCRATCHREG1 O->IR64, // size not supported for O... I could put it in .... but who'd ever need it?
        SCRATCHREG1 PSOURCEBRTEMP !
      ELSE
        PSOURCEBR @ PSOURCEBRTEMP !
      THEN
    THEN 

    // if dest is M then set destr to SCRATCHREG2 otherwise use PDESTR
    ?MDEST IF
      SCRATCHREG2 PDESTRTEMP !
    ELSE
      PDESTR @ PDESTRTEMP ! // is it ok for destreg to be a scratchreg? probably...
    THEN
 
    // at this point there are 3 cases, source a = n, source b = n, or everything else
    
    PSOURCEBMODE @ N = IF
      IR64N->IR64ID, // case rn->r
    ELSE
      PSOURCEAMODE @ N = IF
        NIR64->IR64ID, // case nr->r
      ELSE
        IR64IR64->IR64ID, // case rr->r
      THEN
    THEN

    ?MDEST IF
      SCRATCHREG2->MDESTSZ, // stores size to mdest
    THEN

    // if dest is R then compile code to sign extend R if needed
    ?DESTR IF
      PDESTR @ PDESTSIZE @ OVER IRSZ->IR64,
    THEN
;

: 2SOURCE1DESTOPIDDEFAULTF, ( opid -- ) // mostly tested I think...
    PDEFAULTPRESERVEFLAGSFLAG @ PPRESERVEFLAGSFLAG !
    2SOURCE1DESTOPID,
;


: ADC,   IDADC   2SOURCE1DESTOPIDDEFAULTF, ;
: SBC,   IDSBC   2SOURCE1DESTOPIDDEFAULTF, ;
: SDIV,  IDSDIV  2SOURCE1DESTOPIDDEFAULTF, ;
: ASR,   IDASR   2SOURCE1DESTOPIDDEFAULTF, ;
: LSR,   IDLSR   2SOURCE1DESTOPIDDEFAULTF, ;
: SMULH, IDSMULH 2SOURCE1DESTOPIDDEFAULTF, ;
: MUL,   IDMUL   2SOURCE1DESTOPIDDEFAULTF, ; // lower 64 bits are same for both signed and unsigned multiply
: UDIV,  IDUDIV  2SOURCE1DESTOPIDDEFAULTF, ;
: LSL,   IDLSL   2SOURCE1DESTOPIDDEFAULTF, ;
: ROR,   IDROR   2SOURCE1DESTOPIDDEFAULTF, ;
: UMULH, IDUMULH 2SOURCE1DESTOPIDDEFAULTF, ;
: ADD,   IDADD   2SOURCE1DESTOPIDDEFAULTF, ;
: AND,   IDAND   2SOURCE1DESTOPIDDEFAULTF, ;
: BIC,   IDBIC   2SOURCE1DESTOPIDDEFAULTF, ;
: EON,   IDEON   2SOURCE1DESTOPIDDEFAULTF, ;
: XNOR,  IDXNOR  2SOURCE1DESTOPIDDEFAULTF, ;
: EOR,   IDEOR   2SOURCE1DESTOPIDDEFAULTF, ;
: XOR,   IDXOR   2SOURCE1DESTOPIDDEFAULTF, ;
: ORN,   IDORN   2SOURCE1DESTOPIDDEFAULTF, ;
: ORR,   IDORR   2SOURCE1DESTOPIDDEFAULTF, ;
: OR,    IDOR    2SOURCE1DESTOPIDDEFAULTF, ;
: SUB,   IDSUB   2SOURCE1DESTOPIDDEFAULTF, ;
: NAND,  IDNAND  2SOURCE1DESTOPIDDEFAULTF, ;
: NOR,   IDNOR   2SOURCE1DESTOPIDDEFAULTF, ;


: NSOURCEDESTOPID, ( nx opid -- ) // mostly tested I think...
    POPID !

    NOREG PSOURCEAR !
    ( nx ) PSOURCEAN !
    N PSOURCEAMODE !
    64BIT PSOURCEASIZE !   
    
    PULLTARGET ?ERRORIF NAME>E EXIT THEN
    PTARGETR @ PDESTR !
    PTARGETN @ PDESTN !
    PTARGETMODE @ PDESTMODE !
    PTARGETSIZE @ PDESTSIZE !

    PULLTARGET ?ERRORIF NAME>E EXIT THEN
    PTARGETR @ PSOURCEBR !
    PTARGETN @ PSOURCEBN !
    PTARGETMODE @ PSOURCEBMODE !
    PTARGETSIZE @ PSOURCEBSIZE !

    // if dest is N then that is an error
    PDESTMODE @ N = IF ERROR" N can't be a destination" NAME>E EXIT THEN

    // if dest is O then that is an error
    PDESTMODE @ O = IF ERROR" O can't be a destination" NAME>E EXIT THEN

    // both sources can't be N
    PSOURCEBMODE @ N = IF ERROR" source can't be N, please do the math and use a move" NAME>E EXIT THEN

    // both sources can't be O
    PSOURCEBMODE @ O = IF ERROR" source can't be O, please do the math and use a move" NAME>E EXIT THEN

    // if source b is R then compile code to sign extend R if needed
    ?SRCBR IF
      PSOURCEBR @ PSOURCEBSIZE @ OVER IRSZ->IR64,
    THEN

    // if sourceb M->R then do MB->SCRATCHREG1,
    ?MB IF
      MB->SCRATCHREG1SZ, // fetches size from MB
      SCRATCHREG1 PSOURCEBRTEMP !
    ELSE
      PSOURCEBR @ PSOURCEBRTEMP !
    THEN 

    // if dest is M then set destr to SCRATCHREG2 otherwise use PDESTR
    ?MDEST IF
      SCRATCHREG2 PDESTRTEMP !
    ELSE
      PDESTR @ PDESTRTEMP ! // is it ok for destreg to be a scratchreg? probably...
    THEN
 
    NIR64->IR64ID, // case nr->r
      
    ?MDEST IF
      SCRATCHREG2->MDESTSZ, // stores size to mdest
    THEN

     // if dest is R then compile code to sign extend R if needed
    ?DESTR IF
      PDESTR @ PDESTSIZE @ OVER IRSZ->IR64,
    THEN
;

: NSOURCEDESTOPIDDEFAULTF, ( opid -- ) 
    PDEFAULTPRESERVEFLAGSFLAG @ PPRESERVEFLAGSFLAG !
    NSOURCEDESTOPID,
;

: NEG, 0 IDSUB NSOURCEDESTOPIDDEFAULTF, ; // tested
: NOT, -1 IDXOR NSOURCEDESTOPIDDEFAULTF, ; // tested
: INC, 1 IDADD NSOURCEDESTOPIDDEFAULTF, ; // tested ... not sure if this is most effecient for uf case
: DEC, -1 IDADD NSOURCEDESTOPIDDEFAULTF, ; // tested ... would sub be better?  ... not sure if best for uf case


: MOV,

    // for r->r case
    IDOR POPID !
    
    NOREG PSOURCEAR !
    0 PSOURCEAN !
    N PSOURCEAMODE !
    64BIT PSOURCEASIZE !  
    
    PULLTARGET ?ERRORIF NAME>E EXIT THEN
    PTARGETR @ PDESTR !
    PTARGETN @ PDESTN !
    PTARGETMODE @ PDESTMODE !
    PTARGETSIZE @ PDESTSIZE !

    PULLTARGET ?ERRORIF NAME>E EXIT THEN
    PTARGETR @ PSOURCEBR !
    PTARGETN @ PSOURCEBN !
    PTARGETMODE @ PSOURCEBMODE !
    PTARGETSIZE @ PSOURCEBSIZE !

    // if dest is N then that is an error
    PDESTMODE @ N = IF ERROR" N can't be a destination" NAME>E EXIT THEN

    // if dest is O then that is an error
    PDESTMODE @ O = IF ERROR" O can't be a destination" NAME>E EXIT THEN

    // cases: N->R N->M R->R R->M M->R M->M
    // more cases: O->R O->M

    // source is O
    PSOURCEBMODE @ O = IF

      ?MDEST IF
        PSOURCEBN @ SCRATCHREG2 O->IR64, // case o->m
        SCRATCHREG2->MDESTSZ, // stores size to mdest
      ELSE 
        PSOURCEBN @ PDESTR @ O->IR64, // case o->r
        PDESTR @ PDESTSIZE @ OVER IRSZ->IR64, // not sure why anyone would ever do this... but just in case.... (didn't test this yet..)
      THEN

      EXIT
    THEN

    // source is N
    PSOURCEBMODE @ N = IF

      ?MDEST IF
        PSOURCEBN @ SCRATCHREG2 N->IR64, // case n->m
        SCRATCHREG2->MDESTSZ, // stores size to mdest
      ELSE 
        PSOURCEBN @ PDESTR @ N->IR64, // case n->r
        PDESTR @ PDESTSIZE @ OVER IRSZ->IR64,
      THEN

      EXIT
    THEN

    // source is R
    ?SRCBR IF

      ?MDEST IF
        PSOURCEBR @ PSOURCEBSIZE @ OVER IRSZ->IR64, // extend if necessary 
        PSOURCEBR @ IR->MDESTSZ, // case r->m  stores destsize to mdest
      ELSE
        // could give error if both sizes are different and not 64BIT...
        PDESTSIZE @ 64BIT = IF
          PSOURCEBR @ PSOURCEBSIZE @ PDESTR @ IRSZ->IR64,
        ELSE
          PSOURCEBR @ PDESTSIZE @ PDESTR @ IRSZ->IR64,
        THEN
        
      THEN

      EXIT
    THEN

    // source is M
    ?MDEST IF
      MB->SCRATCHREG1SZ, // fetches size from MB
      SCRATCHREG1 IR->MDESTSZ, // case m->m  stores dest size to mdest
    ELSE
      PDESTR @ MB->IRSZ, // case m->r fetches size from MB
    THEN
; 

: 2SOURCEOPID, ( opid -- ) // assumes this will only be used with opids that have dedicated update flags instructions so that esp does not get trashed...
    POPID !  

    R31 ( probably should use NOREG ) PDESTR ! // for no destination
    0 PDESTN !
    R PDESTMODE !
    64BIT PDESTSIZE !

    PULLTARGET ?ERRORIF NAME>E EXIT THEN
    PTARGETR @ PSOURCEBR !
    PTARGETN @ PSOURCEBN !
    PTARGETMODE @ PSOURCEBMODE !
    PTARGETSIZE @ PSOURCEBSIZE !

    PULLTARGET ?ERRORIF NAME>E EXIT THEN
    PTARGETR @ PSOURCEAR !
    PTARGETN @ PSOURCEAN !
    PTARGETMODE @ PSOURCEAMODE !
    PTARGETSIZE @ PSOURCEASIZE !

    // going to ignore if someone tries to preserve flags
    FALSE PPRESERVEFLAGSFLAG !

    // if dest is N then that is an error
    PDESTMODE @ N = IF ERROR" N can't be a destination" NAME>E EXIT THEN

    // if dest is O then that is an error
    PDESTMODE @ O = IF ERROR" O can't be a destination" NAME>E EXIT THEN

    // both sources can't be N or O
    PSOURCEAMODE @ DUP N = SWAP O = OR
    PSOURCEBMODE @ DUP N = SWAP O = OR AND IF ERROR" both sources can't be N or O, please do the math and use a move" NAME>E EXIT THEN

    // if source a is O then compile code to move o to scratchreg2
    PSOURCEAMODE @ O = IF
      PSOURCEAN @ SCRATCHREG2 O->IR64,
      SCRATCHREG2 PSOURCEARTEMP !
    THEN 

    // if source b is R then compile code to sign extend R if needed
    ?SRCAR IF
      PSOURCEAR @ PSOURCEASIZE @ OVER IRSZ->IR64,
    THEN

    // if source b is R then compile code to sign extend R if needed
    ?SRCBR IF
      PSOURCEBR @ PSOURCEBSIZE @ OVER IRSZ->IR64,
    THEN

    // if sourcea M->R then do MA->SCRATCHREG2,
    ?MA IF
      // MA->SCRATCHREG2,
      MA->SCRATCHREG2SZ,
      SCRATCHREG2 PSOURCEARTEMP !
    ELSE
      // if source a is O then compile code to move o to scratchreg2
      PSOURCEAMODE @ O = IF
        PSOURCEAN @ SCRATCHREG2 O->IR64,  // size not supported for O... I could put it in .... but who'd ever need it?
        SCRATCHREG2 PSOURCEARTEMP !
      ELSE
        PSOURCEAR @ PSOURCEARTEMP !
        // probably should check for scratchreg and give error...
      THEN
    THEN

    // if sourceb M->R then do MB->SCRATCHREG1,
    ?MB IF
      MB->SCRATCHREG1SZ, // fetches size from MB
      SCRATCHREG1 PSOURCEBRTEMP !
    ELSE
      // if source b is O then compile code to move o to scratchreg1
      PSOURCEBMODE @ O = IF
        PSOURCEBN @ SCRATCHREG1 O->IR64,
        SCRATCHREG1 PSOURCEBRTEMP !
      ELSE
        PSOURCEBR @ PSOURCEBRTEMP !
      THEN
    THEN 

    // dest is always r31
    PDESTR @ PDESTRTEMP ! // is it ok for destreg to be a scratchreg? probably...
    
 
    // at this point there are 3 cases, source a = n, source b = n, or everything else
    
    PSOURCEBMODE @ N = IF
      IR64N->IR64ID, // case rn->r
    ELSE
      PSOURCEAMODE @ N = IF
        NIR64->IR64ID, // case nr->r
      ELSE
        IR64IR64->IR64ID, // case rr->r
      THEN
    THEN
;

: TST, ( -- ) IDAND 2SOURCEOPID, ; // tested
: CMP, ( -- ) IDSUB 2SOURCEOPID, ; // tested
// could have a compare that can be chained using sbc,

: ENTER-FRAME, ( -- )
    RSP 10 N RSP SUB,
    X29 X30 RSP 0 64BIT ARMSTP,
;

: EXIT-FRAME, ( -- )
    RSP 0 X29 X30 64BIT ARMLDP,
    RSP 10 N RSP ADD,
;

: CLRC, ( -- ) R31 0 2 ARMRMIF, ; // clear carry flag
: CLRV, ( -- ) R31 0 1 ARMRMIF, ; // clear overflow flag
: CLRZ, ( -- ) R31 0 4 ARMRMIF, ; // clear zero flag  
: CLRN, ( -- ) R31 0 8 ARMRMIF, ; // clear minus flag

SYNONYM OSYMBOL EXPORT // adds an element to EH[TOP] with value = ohere and name = next word in cib  

// adds an element to EH[1] with value = ohere and name = next word in cib
: IMPORT OHERE >NEW$ PARSE-NAME S>NEW$ 1 EH[ND] NEW-ELEMENT DROP ;

// adds an element to EH[1] with value = ohere and name = next word in cib and compiles code for an uninitialized call
: CALLIMPORT, IMPORT 0 ARMBL, ;

HEX
: CHECKSTACK 55 <> IF 
    ERROR" stack check failed after compiling arm64 cross assembler"
    TRUE ?END-EVALUATE // I think the error does this, so TRUE ?END-EVALUATE is not needed
  THEN
;

CHECKSTACK


TRUE ?END-EVALUATE

