HEX
: RNRDSFOP, { | RN RD SF OP -- }
  OP 
  RD RD>OP   // dest reg 0-31
  RN RN>OP   // source reg 0-31  
  SF SF>OP   // 0 = 32bit, 1 = 64bit
  CODE-U32,
; 

: ARMABS,   ( RN RD SF -- ) 5AC02000 RNRDSFOP, ; // FEAT_CSSC not implemented on my m4 arm
: ARMMOVSP, ( RN RD SF -- ) 11000000 RNRDSFOP, ; // tested
: ARMCLS,   ( RN RD SF -- ) 5AC01400 RNRDSFOP, ; // tested. count does not include sign bit
: ARMCLZ,   ( RN RD SF -- ) 5AC01000 RNRDSFOP, ; // tested
: ARMCNT,   ( RN RD SF -- ) 5AC01C00 RNRDSFOP, ; // FEAT_CSSC not implemented on my m4 arm mac
: ARMCTZ,   ( RN RD SF -- ) 5AC01800 RNRDSFOP, ; // FEAT_CSSC not implemented on my m4 arm mac
: ARMRBIT,  ( RN RD SF -- ) 5AC00000 RNRDSFOP, ; // tested
: ARMREV,   ( RN RD SF -- ) DUP 1 AND 0> IF DAC00C00 ELSE 5AC00800 THEN RNRDSFOP, ; // 64 bit tested
: ARMREV16, ( RN RD SF -- ) 5AC00400 RNRDSFOP, ;    // tested
: ARMREV32, ( RN RD -- ) 64BIT DAC00800 RNRDSFOP, ; // tested
: ARMREV64, ( RN RD -- ) 64BIT DAC00C00 RNRDSFOP, ; // tested






HEX
: RMRDSFOP, { | RM RD SF OP -- }
  OP 
  RD RD>OP   // dest reg 0-31
  RM RM>OP   // source reg 0-31  
  SF SF>OP   // 0 = 32bit, 1 = 64bit
  CODE-U32,
; 

: ARMMOVREG,  ( RM RD SF -- ) 2A0003E0 RMRDSFOP, ; // 64 bit tested - does not support sp (use movsp instead)
: ARMNGC,     ( RM RD SF -- ) 5A0003E0 RMRDSFOP, ; // 64 bit tested
: ARMNGCS,    ( RM RD SF -- ) 7A0003E0 RMRDSFOP, ; // 64 bit tested

