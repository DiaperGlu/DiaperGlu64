5555 ?MARKER

//  smin smax umin umax not implemented yet....

// restoring old currrent compile buffer
myoldcurrentcompilebufferid PCURRENTCOMPILEBUFFER !
  
mytestbufid GETSBUFFER
testrootelement testhlist
makeexpdotobuf CONSTANT myexpdotobuf
myexpdotobuf $" testexp.o" SAVEFILE$

myexpdotobuf FREEBUFFER
mytestbufid FREEBUFFER
testhlist FREE-HLIST


TRUE ?END-EVALUATE

// FEAT_LSCP not supported on M4 Mac
