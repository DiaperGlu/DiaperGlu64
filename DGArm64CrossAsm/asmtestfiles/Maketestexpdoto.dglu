  RSP 10 0 RSP 64BIT ARMSUBIMM,  // rsp -= 10
  8643 0 X1 64BIT ARMMOVZ,           
  X1 RSP -10 64BIT ARMIMM++STR,        // push 8643  signed immediate value is not scaled
  1537 0 X1 64BIT ARMMOVZ,             // put 1537 after 8643
  X1 RSP 01 64BIT ARMSTRIMM,           // unsigned immediate value is scaled by data size
  RSP 01 X0 64BIT ARMLDRIMM,           // get 1537  unsigned immediate value is scaled by data size
  RSP 20 0 RSP 64BIT ARMADDIMM,  // rsp += 20
  RET,


OHERE >NEW$ $" testarmstrimm2" testrootelement testhlist NEW-ELEMENT DROP

  RSP 10 0 RSP 64BIT ARMSUBIMM,  // rsp -= 10
  RSP X0 64BIT ARMMOVSP,               // rsp -> X0
  0 0 X2 64BIT ARMMOVZ,
  8742 0 X1 64BIT ARMMOVZ,
  X1 X0 X2 U64X 0 64BIT ARMSTRREG,     // X1 -> [X0 + X2*1]
  1284 0 X1 64BIT ARMMOVZ,
  8 0 X2 64BIT ARMMOVZ,
  X1 X0 X2 U64X 0 64BIT ARMSTRREG,     // X1 -> [X0 + X2*1]
  2398 0 X1 64BIT ARMMOVZ,         
  X1 RSP -10 64BIT ARMIMM++STR,        // push 2398 and leave rsp+8 undefined signed immediate value is not scaled
  1637 0 X1 64BIT ARMMOVZ,             // put 1637 after 8643
  X1 RSP 01 64BIT ARMSTRIMM,           // unsigned immediate value is scaled by size
  // at this point RSP should be initial value - 20
  //   and 2398 1637 1284 8742 should be on stack
  RSP 00 X0 64BIT ARMLDRIMM,           // get 8643 unsigned immediate value is scaled by size
  RSP 20 0 RSP 64BIT ARMADDIMM,  // rsp += 20
  RET,

