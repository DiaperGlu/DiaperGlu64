  X1 RSP IR64->[IR64],
  1249 X1 N->IR64,
  X1 RSP 8 IR64->[IR64+N],

  RSP X2 64BIT ARMMOVSP,
 
  [R+N] PSOURCEAMODE !
  X2 PSOURCEAR !
  8 PSOURCEAN !
  64BIT PSOURCEASIZE !
  MA->SCRATCHREG2,

