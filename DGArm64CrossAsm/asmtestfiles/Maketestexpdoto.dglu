  // push stuff to retstack
  RSP 10 0 RSP 64BIT ARMSUBIMM,  // rsp -= 10
  1239 X1 N->IR64,
  X1 RSP IR64->[IR64],
  1249 X1 N->IR64,
  X1 RSP 8 IR64->[IR64+N],

  RSP X2 64BIT ARMMOVSP,
 
  [R] PSOURCEAMODE !
  X2 PSOURCEAR !
  8 PSOURCEAN !
  64BIT PSOURCEASIZE !
  MA->SCRATCHREG2,

  SCRATCHREG2 X0 IR64->IR64,
  RSP 10 0 RSP 64BIT ARMADDIMM,  // rsp += 20
  RET,

