  // push stuff to retstack
  RSP 10 0 RSP 64BIT ARMSUBIMM,  // rsp -= 10
  123456789ABCDEFA X1 N->IR64,
  313233343536373A X2 N->IR64,
  X1 X2 RSP ARMSTLP,
  RSP X0 [IR64]->IR64,
  RSP 10 0 RSP 64BIT ARMADDIMM,  // rsp += 10
  RET,

