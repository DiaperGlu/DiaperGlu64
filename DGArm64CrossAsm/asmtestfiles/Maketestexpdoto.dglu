$" ../DGMachoDotoMaker.dglu" INCLUDEFILE$
$" ../DGArm64CrossAsm.dglu" INCLUDEFILE$

// Arm calling convention:
//
//   Ints:
//     passed in X0 X1 X2 X3 X4 X5 X6 X7 
//     passed out in X0 X1
//     must be preserved X19 - X28
//     linker special use X16 X17 ( linkers may corrupt these between a call and first instruction of a subroutine )
//     X9 is the indirect result register, points to caller allocated memory used to return structures 
//     X29 is the frame pointer
//     X30 is the link register for function calls
//
//   Floats:
//     passed in D0 D1 D2 D3 D4 D5 D6 D7
//     passed out D0 D1 D2 D3 D4 D5 D6 D7
//
// Mac calling convention:
//
//    Ints:
//      X18 platforms reserve register, must not be used.
//      X29 frame pointer register, must always point to a valid frame record 
//

HEX
5555 // stack marker
0 PBASEADDRESS ! 

// saving old current compile buffer
PCURRENTCOMPILEBUFFER @ CONSTANT myoldcurrentcompilebufferid

// Creating a separate compile buffer is needed to avoid the problem
//   where the buffer moves while executing a word in that buffer.
//   In other words, don't use compiling words to compile to the same buffer
//    they are in if that buffer can grow. 
PAGESIZE -1 NEWBUFFER CONSTANT mytestbufid
mytestbufid PCURRENTCOMPILEBUFFER !

// making the export symbol list
NEW-HLIST CONSTANT testhlist
NEW$ $" root" -1 testhlist NEW-ELEMENT CONSTANT testrootelement 

// adding an exported symbol for a function that just returns
OHERE >NEW$ $" testarmret" testrootelement testhlist NEW-ELEMENT DROP

  RET,

// adding an exported symbol for a function that does nop
OHERE >NEW$ $" testarmnop" testrootelement testhlist NEW-ELEMENT DROP

  ARMNOP,
  RET,

OHERE >NEW$ $" testarmmovz1" testrootelement testhlist NEW-ELEMENT DROP

  1234 0 0 64BIT ARMMOVZ,
  RET,

OHERE >NEW$ $" testarmmovz2" testrootelement testhlist NEW-ELEMENT DROP

  1234 1 0 64BIT ARMMOVZ,
  RET,

OHERE >NEW$ $" testarmmovz3" testrootelement testhlist NEW-ELEMENT DROP

  1234 2 0 64BIT ARMMOVZ,
  RET,

OHERE >NEW$ $" testarmmovz4" testrootelement testhlist NEW-ELEMENT DROP

