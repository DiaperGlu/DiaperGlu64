$" ../DGMachoDotoMaker.dglu" INCLUDEFILE$

HEX
CREATEOC obtestcode  ( -- offset bufferid ) 

D2824680 CODE-U32,  // 1234 X0 MOVZ,
D65F03C0 CODE-U32,  // RET,
D2822440 CODE-U32,  // 1122 X0 MOVZ, 
D503201F CODE-U32,  // NOP,
D503201F CODE-U32,  // NOP,
D503201F CODE-U32,  // NOP,
D65F03C0 CODE-U32,  // RET, 
  
OHERE obtestcode  DROP - CONSTANT obtestcode.size

NEW-HLIST CONSTANT testhlist
NEW$ $" root" -1 testhlist NEW-ELEMENT CONSTANT testrootelement 
0 >NEW$ $" dg_testasm1" testrootelement testhlist NEW-ELEMENT DROP
8 >NEW$ $" dg_testasm2" testrootelement testhlist NEW-ELEMENT DROP

obtestcode O>P obtestcode.size
testrootelement testhlist
makeexpdotobuf CONSTANT myexpdotobuf
myexpdotobuf $" testexpdglu.o" SAVEFILE$

myexpdotobuf FREEBUFFER
testhlist FREE-HLIST


TRUE ?END-EVALUATE



